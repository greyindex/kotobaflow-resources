{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 66.161,
 "source_chapter": 24,
 "sentence_intervals": [
  {
   "sentence_id": "C24-B001-S01",
   "section": "B",
   "text": "ピアノの授業は十月十日から十二月十二日まで、毎週土曜日の十時から十一時までです。",
   "start_sec": 0.0,
   "end_sec": 8.781
  },
  {
   "sentence_id": "C24-B001-S02",
   "section": "B",
   "text": "教室でも家のパソコンでも参加できます。",
   "start_sec": 8.981,
   "end_sec": 12.274
  },
  {
   "sentence_id": "C24-B001-S03",
   "section": "B",
   "text": "一回五百円で、動画は全員が一週間見られます。",
   "start_sec": 12.474,
   "end_sec": 17.389
  },
  {
   "sentence_id": "C24-B002-S01",
   "section": "B",
   "text": "教室には八人しか入れません。",
   "start_sec": 17.839,
   "end_sec": 20.412
  },
  {
   "sentence_id": "C24-B002-S02",
   "section": "B",
   "text": "入口に段差はありません。",
   "start_sec": 20.612,
   "end_sec": 22.646
  },
  {
   "sentence_id": "C24-B002-S03",
   "section": "B",
   "text": "車椅子でも入れます。",
   "start_sec": 22.846,
   "end_sec": 24.37
  },
  {
   "sentence_id": "C24-B002-S04",
   "section": "B",
   "text": "座席は受付で選んでください。",
   "start_sec": 24.57,
   "end_sec": 27.126
  },
  {
   "sentence_id": "C24-B002-S05",
   "section": "B",
   "text": "廊下には手すりがあります。",
   "start_sec": 27.326,
   "end_sec": 29.546
  },
  {
   "sentence_id": "C24-B002-S06",
   "section": "B",
   "text": "家では音量の設定や文字の拡大ができます。",
   "start_sec": 29.746,
   "end_sec": 33.851
  },
  {
   "sentence_id": "C24-B002-S07",
   "section": "B",
   "text": "画面には先生の手が見えます。",
   "start_sec": 34.051,
   "end_sec": 36.804
  },
  {
   "sentence_id": "C24-B002-S08",
   "section": "B",
   "text": "字幕は先生の声の文字です。",
   "start_sec": 37.004,
   "end_sec": 39.878
  },
  {
   "sentence_id": "C24-B002-S09",
   "section": "B",
   "text": "ピアノの音の案内はありません。",
   "start_sec": 40.078,
   "end_sec": 42.683
  },
  {
   "sentence_id": "C24-B003-S01",
   "section": "B",
   "text": "操作や設定の使い方は受付で案内します。",
   "start_sec": 43.133,
   "end_sec": 46.977
  },
  {
   "sentence_id": "C24-B003-S02",
   "section": "B",
   "text": "手話には対応していませんが、紙に書いて相談することができます。",
   "start_sec": 47.177,
   "end_sec": 52.422
  },
  {
   "sentence_id": "C24-B003-S03",
   "section": "B",
   "text": "練習のピアノは土曜日の午後一時から五時まで、一時間二百円で使えます。",
   "start_sec": 52.622,
   "end_sec": 59.457
  },
  {
   "sentence_id": "C24-B003-S04",
   "section": "B",
   "text": "受付は十月七日の午後五時までです。",
   "start_sec": 59.657,
   "end_sec": 63.55
  },
  {
   "sentence_id": "C24-B003-S05",
   "section": "B",
   "text": "受付で名前を書いてください。",
   "start_sec": 63.75,
   "end_sec": 66.155
  }
 ]
}
