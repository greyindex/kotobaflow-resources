{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 66.407,
 "source_chapter": 26,
 "sentence_intervals": [
  {
   "sentence_id": "C26-A001-S01",
   "section": "A",
   "text": "今日、友達と植物園に行った。",
   "start_sec": 0.0,
   "end_sec": 2.753
  },
  {
   "sentence_id": "C26-A001-S02",
   "section": "A",
   "text": "朝、出かけるとき、雨が降っていた。",
   "start_sec": 2.953,
   "end_sec": 6.367
  },
  {
   "sentence_id": "C26-A001-S03",
   "section": "A",
   "text": "急いでいたので、傘を家に忘れた。",
   "start_sec": 6.567,
   "end_sec": 9.593
  },
  {
   "sentence_id": "C26-A001-S04",
   "section": "A",
   "text": "植物園前駅に着いたとき、出口を間違えた。",
   "start_sec": 9.793,
   "end_sec": 14.035
  },
  {
   "sentence_id": "C26-A001-S05",
   "section": "A",
   "text": "西口にはカリムさんがいなかった。",
   "start_sec": 14.235,
   "end_sec": 17.108
  },
  {
   "sentence_id": "C26-A002-S01",
   "section": "A",
   "text": "西川さんに電話した。",
   "start_sec": 17.558,
   "end_sec": 19.41
  },
  {
   "sentence_id": "C26-A002-S02",
   "section": "A",
   "text": "西川さんは「時計の下で待ってください」と言った。",
   "start_sec": 19.61,
   "end_sec": 23.47
  },
  {
   "sentence_id": "C26-A002-S03",
   "section": "A",
   "text": "五分後に、カリムさんが迎えに来てくれた。",
   "start_sec": 23.67,
   "end_sec": 27.132
  },
  {
   "sentence_id": "C26-A002-S04",
   "section": "A",
   "text": "東口で西川さんが予備の傘を貸してくれた。",
   "start_sec": 27.332,
   "end_sec": 31.484
  },
  {
   "sentence_id": "C26-A002-S05",
   "section": "A",
   "text": "家に戻らなくても大丈夫だった。",
   "start_sec": 31.684,
   "end_sec": 34.197
  },
  {
   "sentence_id": "C26-A003-S01",
   "section": "A",
   "text": "午前は雨が止まなかったので、温室で花を見た。",
   "start_sec": 34.647,
   "end_sec": 38.72
  },
  {
   "sentence_id": "C26-A003-S02",
   "section": "A",
   "text": "温室では、カリムさんと一緒に写真を撮った。",
   "start_sec": 38.92,
   "end_sec": 42.514
  },
  {
   "sentence_id": "C26-A003-S03",
   "section": "A",
   "text": "カリムさんは花の名前を教えてくれた。",
   "start_sec": 42.714,
   "end_sec": 46.064
  },
  {
   "sentence_id": "C26-A003-S04",
   "section": "A",
   "text": "温室の隣の部屋で昼ご飯を食べた。",
   "start_sec": 46.264,
   "end_sec": 49.523
  },
  {
   "sentence_id": "C26-A003-S05",
   "section": "A",
   "text": "一時に雨が止んだ。",
   "start_sec": 49.723,
   "end_sec": 51.597
  },
  {
   "sentence_id": "C26-A003-S06",
   "section": "A",
   "text": "西川さんは朝、「雨が止んだら、屋外に出ます」と言った。",
   "start_sec": 51.797,
   "end_sec": 56.471
  },
  {
   "sentence_id": "C26-A003-S07",
   "section": "A",
   "text": "午後は屋外の花を見た。",
   "start_sec": 56.671,
   "end_sec": 59.244
  },
  {
   "sentence_id": "C26-A003-S08",
   "section": "A",
   "text": "今日の写真を家族に見せたい。",
   "start_sec": 59.444,
   "end_sec": 62.6
  },
  {
   "sentence_id": "C26-A003-S09",
   "section": "A",
   "text": "もし次も雨だったら、また温室に行きたい。",
   "start_sec": 62.8,
   "end_sec": 66.4
  }
 ]
}
