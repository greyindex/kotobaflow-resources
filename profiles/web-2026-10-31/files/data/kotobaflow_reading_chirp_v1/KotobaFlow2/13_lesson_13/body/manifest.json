 "sentence_intervals": [
  {
   "sentence_id": "C31-A001-S01",
   "section": "A",
   "text": "サミと中村さんは、土曜日の読書会で使うスピーカーを選びます。",
   "start_sec": 0.0,
   "end_sec": 5.176
  },
  {
   "sentence_id": "C31-A001-S02",
   "section": "A",
   "text": "予算は交通費も入れて三千円です。",
   "start_sec": 5.376,
   "end_sec": 9.471
  },
  {
   "sentence_id": "C31-A001-S03",
   "section": "A",
   "text": "複数の案を比べて、品質と値段を確認します。",
   "start_sec": 9.671,
   "end_sec": 14.145
  },
  {
   "sentence_id": "C31-A001-S04",
   "section": "A",
   "text": "同じ品物でも二つの店の条件は違います。",
   "start_sec": 14.345,
   "end_sec": 18.172
  },
  {
   "sentence_id": "C31-A001-S05",
   "section": "A",
   "text": "安さばかりで決めません。",
   "start_sec": 18.372,
   "end_sec": 20.328
  },
  {
   "sentence_id": "C31-A001-S06",
   "section": "A",
   "text": "その後で、サミは自分のお金で服を買います。",
   "start_sec": 20.528,
   "end_sec": 24.573
  },
  {
   "sentence_id": "C31-A001-S07",
   "section": "A",
   "text": "読書会の予算とは別です。",
   "start_sec": 24.773,
   "end_sec": 26.807
  },
  {
   "sentence_id": "C31-A001-S08",
   "section": "A",
   "text": "音や重さ、服のサイズなど、用途に適当かどうかも大切です。",
   "start_sec": 27.007,
   "end_sec": 32.4
  }
 ]
}
