{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 85.302,
 "source_chapter": 22,
 "sentence_intervals": [
  {
   "sentence_id": "C22-B001-S01",
   "section": "B",
   "text": "みなと公民館には、週末のグループが三つあります。",
   "start_sec": 0.0,
   "end_sec": 4.237
  },
  {
   "sentence_id": "C22-B001-S02",
   "section": "B",
   "text": "参加費は一度の参加で300円です。",
   "start_sec": 4.437,
   "end_sec": 8.143
  },
  {
   "sentence_id": "C22-B001-S03",
   "section": "B",
   "text": "初めての人も大丈夫です。",
   "start_sec": 8.343,
   "end_sec": 10.376
  },
  {
   "sentence_id": "C22-B001-S04",
   "section": "B",
   "text": "活動を体験するいい機会です。",
   "start_sec": 10.576,
   "end_sec": 13.149
  },
  {
   "sentence_id": "C22-B002-S01",
   "section": "B",
   "text": "写真散歩は9月12日と26日の土曜日、午前9時から11時までです。",
   "start_sec": 13.599,
   "end_sec": 21.082
  },
  {
   "sentence_id": "C22-B002-S02",
   "section": "B",
   "text": "公民館の前に来てください。",
   "start_sec": 21.282,
   "end_sec": 23.315
  },
  {
   "sentence_id": "C22-B002-S03",
   "section": "B",
   "text": "海の近くの公園で写真を撮ります。",
   "start_sec": 23.515,
   "end_sec": 26.268
  },
  {
   "sentence_id": "C22-B002-S04",
   "section": "B",
   "text": "昔の映画館の写真も見ます。",
   "start_sec": 26.468,
   "end_sec": 29.335
  },
  {
   "sentence_id": "C22-B002-S05",
   "section": "B",
   "text": "10月には公民館で写真の展覧会があります。",
   "start_sec": 29.535,
   "end_sec": 33.968
  },
  {
   "sentence_id": "C22-B002-S06",
   "section": "B",
   "text": "国内の旅行や海外の旅行の写真もあります。",
   "start_sec": 34.168,
   "end_sec": 37.941
  },
  {
   "sentence_id": "C22-B003-S01",
   "section": "B",
   "text": "釣りは9月6日と20日の日曜日、午前7時から10時までです。",
   "start_sec": 38.392,
   "end_sec": 43.005
  },
  {
   "sentence_id": "C22-B003-S02",
   "section": "B",
   "text": "みなと公園で釣りをします。",
   "start_sec": 43.205,
   "end_sec": 45.825
  },
  {
   "sentence_id": "C22-B003-S03",
   "section": "B",
   "text": "公民館の道具を使ってもいいです。",
   "start_sec": 46.025,
   "end_sec": 48.838
  },
  {
   "sentence_id": "C22-B004-S01",
   "section": "B",
   "text": "音楽のグループは毎週日曜日の午後3時から4時半までです。",
   "start_sec": 49.288,
   "end_sec": 54.861
  },
  {
   "sentence_id": "C22-B004-S02",
   "section": "B",
   "text": "一緒に歌ったり、踊ったりします。",
   "start_sec": 55.061,
   "end_sec": 57.815
  },
  {
   "sentence_id": "C22-B004-S03",
   "section": "B",
   "text": "手作りの楽器の演奏もあります。",
   "start_sec": 58.015,
   "end_sec": 60.768
  },
  {
   "sentence_id": "C22-B004-S04",
   "section": "B",
   "text": "10月18日のお祭りにも参加します。",
   "start_sec": 60.968,
   "end_sec": 64.374
  },
  {
   "sentence_id": "C22-B004-S05",
   "section": "B",
   "text": "11月には近くの山で登山もします。",
   "start_sec": 64.574,
   "end_sec": 67.987
  },
  {
   "sentence_id": "C22-B004-S06",
   "section": "B",
   "text": "楽器作りでは色々な音を楽しみます。",
   "start_sec": 68.187,
   "end_sec": 71.361
  },
  {
   "sentence_id": "C22-B005-S01",
   "section": "B",
   "text": "申し込みは公民館の受付でお願いします。",
   "start_sec": 71.811,
   "end_sec": 75.764
  },
  {
   "sentence_id": "C22-B005-S02",
   "section": "B",
   "text": "受付の時間は毎日午前9時から午後5時までです。",
   "start_sec": 75.964,
   "end_sec": 80.962
  },
  {
   "sentence_id": "C22-B005-S03",
   "section": "B",
   "text": "申し込みは、参加する前の日の午後5時までです。",
   "start_sec": 81.162,
   "end_sec": 85.296
  }
 ]
}
