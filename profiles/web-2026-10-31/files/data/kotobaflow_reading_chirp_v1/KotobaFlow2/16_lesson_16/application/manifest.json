{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 105.17,
 "source_chapter": 34,
 "sentence_intervals": [
  {
   "sentence_id": "C34-B001-S01",
   "section": "B",
   "text": "今日の読書会は十時から十一時半までです。",
   "start_sec": 0.0,
   "end_sec": 4.313
  },
  {
   "sentence_id": "C34-B001-S02",
   "section": "B",
   "text": "準備は九時に始めます。",
   "start_sec": 4.513,
   "end_sec": 6.485
  },
  {
   "sentence_id": "C34-B001-S03",
   "section": "B",
   "text": "森は印刷、サミは配布を担当します。",
   "start_sec": 6.685,
   "end_sec": 10.447
  },
  {
   "sentence_id": "C34-B001-S04",
   "section": "B",
   "text": "資料は三ページで一部、全部で十部です。",
   "start_sec": 10.647,
   "end_sec": 14.383
  },
  {
   "sentence_id": "C34-B001-S05",
   "section": "B",
   "text": "名前とページを確認してから印刷してください。",
   "start_sec": 14.583,
   "end_sec": 18.04
  },
  {
   "sentence_id": "C34-B001-S06",
   "section": "B",
   "text": "印刷には六分ぐらいかかります。",
   "start_sec": 18.24,
   "end_sec": 21.451
  },
  {
   "sentence_id": "C34-B001-S07",
   "section": "B",
   "text": "九時五十分までに資料の準備を終えて、十時までには入口へ戻ってください。",
   "start_sec": 21.651,
   "end_sec": 27.904
  },
  {
   "sentence_id": "C34-B002-S01",
   "section": "B",
   "text": "移動の途中でスマートフォンを見ないでください。",
   "start_sec": 28.354,
   "end_sec": 31.48
  },
  {
   "sentence_id": "C34-B002-S02",
   "section": "B",
   "text": "連絡は歩く前か後でしましょう。",
   "start_sec": 31.68,
   "end_sec": 34.896
  },
  {
   "sentence_id": "C34-B002-S03",
   "section": "B",
   "text": "片づけと確認は一緒に始めないで、確認を優先してください。",
   "start_sec": 35.096,
   "end_sec": 40.009
  },
  {
   "sentence_id": "C34-B002-S04",
   "section": "B",
   "text": "読書会の後、サミはコップを洗って、森は机を片づけます。",
   "start_sec": 40.209,
   "end_sec": 46.478
  },
  {
   "sentence_id": "C34-B002-S05",
   "section": "B",
   "text": "十二時までに鍵を返してください。",
   "start_sec": 46.678,
   "end_sec": 49.472
  },
  {
   "sentence_id": "C34-B002-S06",
   "section": "B",
   "text": "作業記録の提出の締切は月曜日の十八時です。",
   "start_sec": 49.672,
   "end_sec": 54.338
  },
  {
   "sentence_id": "C34-B002-S07",
   "section": "B",
   "text": "中断した時間も書いてください。",
   "start_sec": 54.538,
   "end_sec": 56.452
  },
  {
   "sentence_id": "C34-B003-S01",
   "section": "B",
   "text": "次回の音楽会はまだ相談中です。",
   "start_sec": 56.902,
   "end_sec": 60.075
  },
  {
   "sentence_id": "C34-B003-S02",
   "section": "B",
   "text": "プログラムには歌と朗読を入れます。",
   "start_sec": 60.275,
   "end_sec": 63.399
  },
  {
   "sentence_id": "C34-B003-S03",
   "section": "B",
   "text": "歌手を呼ぶお金はないので、町の二人組に合唱曲を披露してもらう案があります。",
   "start_sec": 63.599,
   "end_sec": 69.653
  },
  {
   "sentence_id": "C34-B003-S04",
   "section": "B",
   "text": "独唱とバイオリンも候補です。",
   "start_sec": 69.853,
   "end_sec": 72.066
  },
  {
   "sentence_id": "C34-B003-S05",
   "section": "B",
   "text": "曲目ごとに時間を調べて、静かな楽曲と明るい曲のバランスを考えます。",
   "start_sec": 72.266,
   "end_sec": 78.859
  },
  {
   "sentence_id": "C34-B003-S06",
   "section": "B",
   "text": "出し物をいっぺんに決めないでください。",
   "start_sec": 79.059,
   "end_sec": 81.813
  },
  {
   "sentence_id": "C34-B004-S01",
   "section": "B",
   "text": "招待状には入場の時刻を書きます。",
   "start_sec": 82.263,
   "end_sec": 86.276
  },
  {
   "sentence_id": "C34-B004-S02",
   "section": "B",
   "text": "チケットは無料の入場券で、飲み物の券ではありません。",
   "start_sec": 86.476,
   "end_sec": 91.269
  },
  {
   "sentence_id": "C34-B004-S03",
   "section": "B",
   "text": "飾りつけの前にカーテンを開けて、部屋の明るさを確認します。",
   "start_sec": 91.469,
   "end_sec": 96.317
  },
  {
   "sentence_id": "C34-B004-S04",
   "section": "B",
   "text": "装飾には紙の花を使います。",
   "start_sec": 96.517,
   "end_sec": 99.39
  },
  {
   "sentence_id": "C34-B004-S05",
   "section": "B",
   "text": "入口を飾る人と案内役を決めてから、歓迎の言葉を練習しましょう。",
   "start_sec": 99.59,
   "end_sec": 105.164
  }
 ]
}
