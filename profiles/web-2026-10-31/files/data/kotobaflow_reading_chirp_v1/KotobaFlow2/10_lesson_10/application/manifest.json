{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 113.543,
 "source_chapter": 28,
 "sentence_intervals": [
  {
   "sentence_id": "C28-B001-S01",
   "section": "B",
   "text": "場所は東町公民館の第二会議室です。",
   "start_sec": 0.0,
   "end_sec": 4.409
  },
  {
   "sentence_id": "C28-B001-S02",
   "section": "B",
   "text": "今日は十二人で動画を見ます。",
   "start_sec": 4.609,
   "end_sec": 7.602
  },
  {
   "sentence_id": "C28-B001-S03",
   "section": "B",
   "text": "準備の係の三人もこの十二人に入ります。",
   "start_sec": 7.802,
   "end_sec": 11.871
  },
  {
   "sentence_id": "C28-B001-S04",
   "section": "B",
   "text": "係は十二時半に集合してください。",
   "start_sec": 12.071,
   "end_sec": 15.615
  },
  {
   "sentence_id": "C28-B001-S05",
   "section": "B",
   "text": "動画を見る時間は一時から三時までです。",
   "start_sec": 15.815,
   "end_sec": 19.79
  },
  {
   "sentence_id": "C28-B001-S06",
   "section": "B",
   "text": "まず短い動画を見ます。",
   "start_sec": 19.99,
   "end_sec": 22.423
  },
  {
   "sentence_id": "C28-B001-S07",
   "section": "B",
   "text": "それから感想を話します。",
   "start_sec": 22.623,
   "end_sec": 24.896
  },
  {
   "sentence_id": "C28-B001-S08",
   "section": "B",
   "text": "二時に屋外で写真を撮ります。",
   "start_sec": 25.096,
   "end_sec": 27.631
  },
  {
   "sentence_id": "C28-B001-S09",
   "section": "B",
   "text": "雨が降ったら、屋内で撮ります。",
   "start_sec": 27.831,
   "end_sec": 30.345
  },
  {
   "sentence_id": "C28-B001-S10",
   "section": "B",
   "text": "雨でも、一時からの予定は変えません。",
   "start_sec": 30.545,
   "end_sec": 33.63
  },
  {
   "sentence_id": "C28-B001-S11",
   "section": "B",
   "text": "三時から三時半までは片づけの時間です。",
   "start_sec": 33.83,
   "end_sec": 37.51
  },
  {
   "sentence_id": "C28-B002-S01",
   "section": "B",
   "text": "リーは椅子と案内の紙を準備します。",
   "start_sec": 37.96,
   "end_sec": 41.455
  },
  {
   "sentence_id": "C28-B002-S02",
   "section": "B",
   "text": "青木は機械の操作が得意なので、動画と音の準備をします。",
   "start_sec": 41.655,
   "end_sec": 46.569
  },
  {
   "sentence_id": "C28-B002-S03",
   "section": "B",
   "text": "小野は受付の係です。",
   "start_sec": 46.769,
   "end_sec": 48.982
  },
  {
   "sentence_id": "C28-B002-S04",
   "section": "B",
   "text": "役割は相談して変えてもいいです。",
   "start_sec": 49.182,
   "end_sec": 51.976
  },
  {
   "sentence_id": "C28-B002-S05",
   "section": "B",
   "text": "仕事の負担が大きかったら、小野に話してください。",
   "start_sec": 52.176,
   "end_sec": 55.77
  },
  {
   "sentence_id": "C28-B002-S06",
   "section": "B",
   "text": "苦手な仕事は一人でしなくてもいいです。",
   "start_sec": 55.97,
   "end_sec": 59.263
  },
  {
   "sentence_id": "C28-B002-S07",
   "section": "B",
   "text": "個人の事情も話さなくてもいいです。",
   "start_sec": 59.463,
   "end_sec": 62.276
  },
  {
   "sentence_id": "C28-B002-S08",
   "section": "B",
   "text": "できる仕事を一緒に考えましょう。",
   "start_sec": 62.476,
   "end_sec": 65.605
  },
  {
   "sentence_id": "C28-B002-S09",
   "section": "B",
   "text": "動画を見る前に、席から字幕と音を確認してください。",
   "start_sec": 65.805,
   "end_sec": 70.633
  },
  {
   "sentence_id": "C28-B002-S10",
   "section": "B",
   "text": "字幕が見えないときは、前の席を選んでもいいです。",
   "start_sec": 70.833,
   "end_sec": 75.038
  },
  {
   "sentence_id": "C28-B002-S11",
   "section": "B",
   "text": "音が聞こえないときは、青木に話してください。",
   "start_sec": 75.238,
   "end_sec": 79.114
  },
  {
   "sentence_id": "C28-B003-S01",
   "section": "B",
   "text": "飲み物はこの部屋に運んでもいいですが、食べ物は運んではいけません。",
   "start_sec": 79.564,
   "end_sec": 84.958
  },
  {
   "sentence_id": "C28-B003-S02",
   "section": "B",
   "text": "窓の前に荷物を運ばないでください。",
   "start_sec": 85.158,
   "end_sec": 88.434
  },
  {
   "sentence_id": "C28-B003-S03",
   "section": "B",
   "text": "使った椅子は机の隣に運ばなければなりません。",
   "start_sec": 88.634,
   "end_sec": 92.707
  },
  {
   "sentence_id": "C28-B003-S04",
   "section": "B",
   "text": "部屋にごみがあったら、掃除してください。",
   "start_sec": 92.907,
   "end_sec": 95.95
  },
  {
   "sentence_id": "C28-B003-S05",
   "section": "B",
   "text": "使わなかった机は運ばなくてもいいです。",
   "start_sec": 96.15,
   "end_sec": 99.143
  },
  {
   "sentence_id": "C28-B003-S06",
   "section": "B",
   "text": "機械と鍵を返す期限は四時です。",
   "start_sec": 99.343,
   "end_sec": 102.372
  },
  {
   "sentence_id": "C28-B003-S07",
   "section": "B",
   "text": "機械を返す責任は青木に、鍵を返す責任は小野にあります。",
   "start_sec": 102.572,
   "end_sec": 108.566
  },
  {
   "sentence_id": "C28-B003-S08",
   "section": "B",
   "text": "三時半に片づけが終わった後で、受付に返してください。",
   "start_sec": 108.766,
   "end_sec": 113.537
  }
 ]
}
