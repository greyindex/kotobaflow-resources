 "duration_sec": 46.059,
 "source_chapter": 28,
 "sentence_intervals": [
  {
   "sentence_id": "C28-A001-S01",
   "section": "A",
   "text": "一月十六日、東町公民館の第二会議室で動画を見ました。",
   "start_sec": 0.0,
   "end_sec": 6.353
  },
  {
   "sentence_id": "C28-A001-S02",
   "section": "A",
   "text": "リー、青木、小野は十二時半から準備をしました。",
   "start_sec": 6.553,
   "end_sec": 11.047
  },
  {
   "sentence_id": "C28-A001-S03",
   "section": "A",
   "text": "リーは椅子を運べますが、大きい机は運べません。",
   "start_sec": 11.247,
   "end_sec": 15.848
  },
  {
   "sentence_id": "C28-A001-S04",
   "section": "A",
   "text": "青木が手伝ってくれました。",
   "start_sec": 16.047,
   "end_sec": 17.901
  },
  {
   "sentence_id": "C28-A001-S05",
   "section": "A",
   "text": "小野は受付の係でした。",
   "start_sec": 18.101,
   "end_sec": 20.241
  },
  {
   "sentence_id": "C28-A002-S01",
   "section": "A",
   "text": "リーの席からは字幕が見えませんでした。",
   "start_sec": 20.691,
   "end_sec": 23.984
  },
  {
   "sentence_id": "C28-A002-S02",
   "section": "A",
   "text": "前の席では見えましたが、音が聞こえませんでした。",
   "start_sec": 24.184,
   "end_sec": 28.409
  },
  {
   "sentence_id": "C28-A002-S03",
   "section": "A",
   "text": "青木に音量を変えてもらって、リーも動画を見ることができました。",
   "start_sec": 28.609,
   "end_sec": 33.129
  },
  {
   "sentence_id": "C28-A003-S01",
   "section": "A",
   "text": "二時には雨が降っていたので、屋内で写真を撮りました。",
   "start_sec": 33.579,
   "end_sec": 38.188
  },
  {
   "sentence_id": "C28-A003-S02",
   "section": "A",
   "text": "三時から全員で部屋を片づけました。",
   "start_sec": 38.388,
   "end_sec": 41.472
  },
  {
   "sentence_id": "C28-A003-S03",
   "section": "A",
   "text": "最後に青木が機械を、小野が鍵を返しました。",
   "start_sec": 41.672,
   "end_sec": 46.052
  }
 ]
}
