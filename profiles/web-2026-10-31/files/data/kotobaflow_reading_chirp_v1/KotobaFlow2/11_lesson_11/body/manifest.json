{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 63.304,
 "source_chapter": 29,
 "sentence_intervals": [
  {
   "sentence_id": "C29-A001-S01",
   "section": "A",
   "text": "一月十六日の朝、リナは森さんと一緒に仕事をする部屋へ行きました。",
   "start_sec": 0.0,
   "end_sec": 5.693
  },
  {
   "sentence_id": "C29-A001-S02",
   "section": "A",
   "text": "原稿の確認は午後一時の予定でした。",
   "start_sec": 5.893,
   "end_sec": 9.507
  },
  {
   "sentence_id": "C29-A001-S03",
   "section": "A",
   "text": "でも、朝から頭とのどが痛くて、体の具合が悪かったんです。",
   "start_sec": 9.707,
   "end_sec": 15.223
  },
  {
   "sentence_id": "C29-A001-S04",
   "section": "A",
   "text": "昨日の夜は家で原稿を書いて、四時間しか寝ませんでした。",
   "start_sec": 15.423,
   "end_sec": 20.679
  },
  {
   "sentence_id": "C29-A002-S01",
   "section": "A",
   "text": "リナは森さんに「今日は長い文章が読みにくいんです」と言いました。",
   "start_sec": 21.129,
   "end_sec": 27.197
  },
  {
   "sentence_id": "C29-A002-S02",
   "section": "A",
   "text": "森さんは「疲れていますね。今は休んだほうがいいですよ。午後の確認は私がします」と言いました。",
   "start_sec": 27.397,
   "end_sec": 36.09
  },
  {
   "sentence_id": "C29-A002-S03",
   "section": "A",
   "text": "リナは午後の仕事を森さんに頼みました。",
   "start_sec": 36.29,
   "end_sec": 39.629
  },
  {
   "sentence_id": "C29-A003-S01",
   "section": "A",
   "text": "二人は短いメモで仕事を確認しました。",
   "start_sec": 40.079,
   "end_sec": 43.312
  },
  {
   "sentence_id": "C29-A003-S02",
   "section": "A",
   "text": "確認は五分で終わり、リナは十時半に部屋を出ました。",
   "start_sec": 43.512,
   "end_sec": 47.699
  },
  {
   "sentence_id": "C29-A003-S03",
   "section": "A",
   "text": "家に帰って昼ご飯を食べて、布団で一眠りしました。",
   "start_sec": 47.899,
   "end_sec": 52.337
  },
  {
   "sentence_id": "C29-A003-S04",
   "section": "A",
   "text": "新しいシーツは気持ちがよくて、体が少し楽でした。",
   "start_sec": 52.537,
   "end_sec": 56.851
  },
  {
   "sentence_id": "C29-A003-S05",
   "section": "A",
   "text": "夜にお礼のメッセージを送りました。",
   "start_sec": 57.051,
   "end_sec": 59.924
  },
  {
   "sentence_id": "C29-A003-S06",
   "section": "A",
   "text": "次の仕事の日はまだ決めていません。",
   "start_sec": 60.124,
   "end_sec": 63.297
  }
 ]
}
