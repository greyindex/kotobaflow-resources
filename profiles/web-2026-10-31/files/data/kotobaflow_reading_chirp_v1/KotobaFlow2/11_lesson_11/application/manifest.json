{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 75.796,
 "source_chapter": 29,
 "sentence_intervals": [
  {
   "sentence_id": "C29-B001-S01",
   "section": "B",
   "text": "一月十六日の連絡です。",
   "start_sec": 0.0,
   "end_sec": 2.538
  },
  {
   "sentence_id": "C29-B001-S02",
   "section": "B",
   "text": "リナさんは体調がよくないので、十時半に帰ります。",
   "start_sec": 2.738,
   "end_sec": 7.192
  },
  {
   "sentence_id": "C29-B001-S03",
   "section": "B",
   "text": "午後一時の原稿の確認は森がします。",
   "start_sec": 7.392,
   "end_sec": 11.765
  },
  {
   "sentence_id": "C29-B001-S04",
   "section": "B",
   "text": "原稿は送らなくてもいいです。",
   "start_sec": 11.965,
   "end_sec": 14.201
  },
  {
   "sentence_id": "C29-B001-S05",
   "section": "B",
   "text": "返事は明日で大丈夫です。",
   "start_sec": 14.401,
   "end_sec": 16.674
  },
  {
   "sentence_id": "C29-B001-S06",
   "section": "B",
   "text": "次の仕事の日はまだ決めていません。",
   "start_sec": 16.874,
   "end_sec": 20.343
  },
  {
   "sentence_id": "C29-B002-S01",
   "section": "B",
   "text": "休む時間と仕事の予定を知らせてください。",
   "start_sec": 20.793,
   "end_sec": 24.387
  },
  {
   "sentence_id": "C29-B002-S02",
   "section": "B",
   "text": "詳しい症状は書かなくてもいいです。",
   "start_sec": 24.587,
   "end_sec": 27.46
  },
  {
   "sentence_id": "C29-B002-S03",
   "section": "B",
   "text": "長すぎるメモは読みにくいので、短い文章でお願いします。",
   "start_sec": 27.66,
   "end_sec": 31.913
  },
  {
   "sentence_id": "C29-B002-S04",
   "section": "B",
   "text": "健康は大事です。",
   "start_sec": 32.114,
   "end_sec": 33.987
  },
  {
   "sentence_id": "C29-B002-S05",
   "section": "B",
   "text": "無理をしないでください。",
   "start_sec": 34.187,
   "end_sec": 35.801
  },
  {
   "sentence_id": "C29-B003-S01",
   "section": "B",
   "text": "受付で使う日本語の紙と薬局の地図は机の上です。",
   "start_sec": 36.251,
   "end_sec": 41.827
  },
  {
   "sentence_id": "C29-B003-S02",
   "section": "B",
   "text": "診察で使う例は「胃が痛み出しました」です。",
   "start_sec": 42.027,
   "end_sec": 45.921
  },
  {
   "sentence_id": "C29-B003-S03",
   "section": "B",
   "text": "「吐き気もします」も使えます。",
   "start_sec": 46.121,
   "end_sec": 48.154
  },
  {
   "sentence_id": "C29-B003-S04",
   "section": "B",
   "text": "「胃潰瘍」は病気の名前ですが、この紙で診断はできません。",
   "start_sec": 48.354,
   "end_sec": 53.008
  },
  {
   "sentence_id": "C29-B003-S05",
   "section": "B",
   "text": "保険証など、必要な物は病院に確認してください。",
   "start_sec": 53.208,
   "end_sec": 57.442
  },
  {
   "sentence_id": "C29-B003-S06",
   "section": "B",
   "text": "薬のアレルギーは医者に伝えてください。",
   "start_sec": 57.642,
   "end_sec": 60.816
  },
  {
   "sentence_id": "C29-B004-S01",
   "section": "B",
   "text": "紙の体温37.5度と体重52.5キロは会話の例で、リナさんの数字ではありません。",
   "start_sec": 61.266,
   "end_sec": 69.571
  },
  {
   "sentence_id": "C29-B004-S02",
   "section": "B",
   "text": "古い体温の書き方「三十七度五分」も37.5度です。",
   "start_sec": 69.771,
   "end_sec": 75.789
  }
 ]
}
