{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 82.347,
 "source_chapter": 30,
 "sentence_intervals": [
  {
   "sentence_id": "C30-B001-S01",
   "section": "B",
   "text": "ミナさん、林さん、アキさんへ。",
   "start_sec": 0.0,
   "end_sec": 2.753
  },
  {
   "sentence_id": "C30-B001-S02",
   "section": "B",
   "text": "明日は九時四十分に中央公園の入口で会いましょう。",
   "start_sec": 2.953,
   "end_sec": 8.221
  },
  {
   "sentence_id": "C30-B001-S03",
   "section": "B",
   "text": "私とみなさんの四人で、十時から十一時まで公園の教室で写真を見ます。",
   "start_sec": 8.421,
   "end_sec": 14.475
  },
  {
   "sentence_id": "C30-B001-S04",
   "section": "B",
   "text": "教室ではお金を払わなくてもいいです。",
   "start_sec": 14.675,
   "end_sec": 17.848
  },
  {
   "sentence_id": "C30-B001-S05",
   "section": "B",
   "text": "十一時に屋外の様子を見て、散歩の予定を決めます。",
   "start_sec": 18.048,
   "end_sec": 22.662
  },
  {
   "sentence_id": "C30-B001-S06",
   "section": "B",
   "text": "雨が降ったら散歩はしません。",
   "start_sec": 22.862,
   "end_sec": 25.748
  },
  {
   "sentence_id": "C30-B002-S01",
   "section": "B",
   "text": "次の天気予報は練習用です。",
   "start_sec": 26.198,
   "end_sec": 28.993
  },
  {
   "sentence_id": "C30-B002-S02",
   "section": "B",
   "text": "本当の予測ではありません。",
   "start_sec": 29.193,
   "end_sec": 31.106
  },
  {
   "sentence_id": "C30-B002-S03",
   "section": "B",
   "text": "十九日は曇り、最高気温は三十度、最低気温は二十三度です。",
   "start_sec": 31.306,
   "end_sec": 38.068
  },
  {
   "sentence_id": "C30-B002-S04",
   "section": "B",
   "text": "朝の湿度は八十パーセント、午後の降水確率は四十パーセントです。",
   "start_sec": 38.268,
   "end_sec": 44.981
  },
  {
   "sentence_id": "C30-B002-S05",
   "section": "B",
   "text": "午後は暑いでしょう。",
   "start_sec": 45.181,
   "end_sec": 46.795
  },
  {
   "sentence_id": "C30-B002-S06",
   "section": "B",
   "text": "夕立があるかもしれません。",
   "start_sec": 46.995,
   "end_sec": 49.148
  },
  {
   "sentence_id": "C30-B002-S07",
   "section": "B",
   "text": "この確率だけでは雨の時刻は分かりません。",
   "start_sec": 49.348,
   "end_sec": 53.281
  },
  {
   "sentence_id": "C30-B002-S08",
   "section": "B",
   "text": "台風三号の古い資料も教室で見ますが、今日の情報ではありません。",
   "start_sec": 53.481,
   "end_sec": 59.055
  },
  {
   "sentence_id": "C30-B003-S01",
   "section": "B",
   "text": "水と傘を持ってきてください。",
   "start_sec": 59.505,
   "end_sec": 61.633
  },
  {
   "sentence_id": "C30-B003-S02",
   "section": "B",
   "text": "晴れ間が見えても、後で雨が降る可能性があります。",
   "start_sec": 61.833,
   "end_sec": 65.966
  },
  {
   "sentence_id": "C30-B003-S03",
   "section": "B",
   "text": "元気そうな人にも体調を確認します。",
   "start_sec": 66.166,
   "end_sec": 69.253
  },
  {
   "sentence_id": "C30-B003-S04",
   "section": "B",
   "text": "見た目だけで決めません。",
   "start_sec": 69.453,
   "end_sec": 71.066
  },
  {
   "sentence_id": "C30-B003-S05",
   "section": "B",
   "text": "心配な人は十一時に帰ってもいいです。",
   "start_sec": 71.266,
   "end_sec": 75.1
  },
  {
   "sentence_id": "C30-B003-S06",
   "section": "B",
   "text": "散歩に参加したくなかったら、私に言ってください。",
   "start_sec": 75.3,
   "end_sec": 78.954
  },
  {
   "sentence_id": "C30-B003-S07",
   "section": "B",
   "text": "無理に参加しなくてもいいです。",
   "start_sec": 79.154,
   "end_sec": 81.307
  },
  {
   "sentence_id": "C30-B003-S08",
   "section": "B",
   "text": "佐藤",
   "start_sec": 81.507,
   "end_sec": 82.34
  }
 ]
}
