 "duration_sec": 60.082,
 "source_chapter": 32,
 "sentence_intervals": [
  {
   "sentence_id": "C32-A001-S01",
   "section": "A",
   "text": "仕事から帰って、来月の予定表を見ました。",
   "start_sec": 0.0,
   "end_sec": 3.894
  },
  {
   "sentence_id": "C32-A001-S02",
   "section": "A",
   "text": "将来は旅行の写真で本を作りたいです。",
   "start_sec": 4.094,
   "end_sec": 8.107
  },
  {
   "sentence_id": "C32-A001-S03",
   "section": "A",
   "text": "小学生の時から写真家に憧れています。",
   "start_sec": 8.307,
   "end_sec": 12.139
  },
  {
   "sentence_id": "C32-A001-S04",
   "section": "A",
   "text": "小学校の卒業の日に撮った写真は、今も宝物です。",
   "start_sec": 12.339,
   "end_sec": 16.867
  },
  {
   "sentence_id": "C32-A001-S05",
   "section": "A",
   "text": "でも、夢の実現には長期の計画と短期の目標が必要です。",
   "start_sec": 17.067,
   "end_sec": 23.076
  },
  {
   "sentence_id": "C32-A002-S01",
   "section": "A",
   "text": "まず、南町市民センターの写真講座に申し込むつもりです。",
   "start_sec": 23.526,
   "end_sec": 28.319
  },
  {
   "sentence_id": "C32-A002-S02",
   "section": "A",
   "text": "期間は二月六日から二十日までです。",
   "start_sec": 28.519,
   "end_sec": 32.115
  },
  {
   "sentence_id": "C32-A002-S03",
   "section": "A",
   "text": "新しいカメラは買わないつもりです。",
   "start_sec": 32.315,
   "end_sec": 35.461
  },
  {
   "sentence_id": "C32-A002-S04",
   "section": "A",
   "text": "給料から少しずつ貯金しています。",
   "start_sec": 35.661,
   "end_sec": 38.474
  },
  {
   "sentence_id": "C32-A002-S05",
   "section": "A",
   "text": "数年後の旅行を夢見ていますが、今度は三枚の写真と説明が目標です。",
   "start_sec": 38.674,
   "end_sec": 45.027
  },
  {
   "sentence_id": "C32-A003-S01",
   "section": "A",
   "text": "田辺さんと明日、日程を確認することにしました。",
   "start_sec": 45.477,
   "end_sec": 49.491
  },
  {
   "sentence_id": "C32-A003-S02",
   "section": "A",
   "text": "まだ申し込んでいません。",
   "start_sec": 49.691,
   "end_sec": 51.656
  },
  {
   "sentence_id": "C32-A003-S03",
   "section": "A",
   "text": "計画的に勉強を続けようと思います。",
   "start_sec": 51.856,
   "end_sec": 55.103
  },
  {
   "sentence_id": "C32-A003-S04",
   "section": "A",
   "text": "来年の話は、その後で考えます。",
   "start_sec": 55.303,
   "end_sec": 58.116
  },
  {
   "sentence_id": "C32-A003-S05",
   "section": "A",
   "text": "小さな第一歩です。",
   "start_sec": 58.316,
   "end_sec": 60.075
  }
 ]
}
