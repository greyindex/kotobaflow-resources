{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 66.147,
 "source_chapter": 32,
 "sentence_intervals": [
  {
   "sentence_id": "C32-B001-S01",
   "section": "B",
   "text": "南町市民センター主催の写真講座は、二月六日、十三日、二十日の十四時から十六時です。",
   "start_sec": 0.0,
   "end_sec": 8.755
  },
  {
   "sentence_id": "C32-B001-S02",
   "section": "B",
   "text": "教室は二階の第二教室、定員は八人、料金は三回で千五百円です。",
   "start_sec": 8.955,
   "end_sec": 16.605
  },
  {
   "sentence_id": "C32-B001-S03",
   "section": "B",
   "text": "参加者を募集しています。",
   "start_sec": 16.805,
   "end_sec": 18.419
  },
  {
   "sentence_id": "C32-B001-S04",
   "section": "B",
   "text": "初めての人も参加できます。",
   "start_sec": 18.619,
   "end_sec": 20.772
  },
  {
   "sentence_id": "C32-B002-S01",
   "section": "B",
   "text": "第一回はスマートフォンの使い方、第二回は庭で撮影、第三回は写真三枚と説明の準備をします。",
   "start_sec": 21.222,
   "end_sec": 31.032
  },
  {
   "sentence_id": "C32-B002-S02",
   "section": "B",
   "text": "雨の日は教室を使うことになっています。",
   "start_sec": 31.232,
   "end_sec": 34.465
  },
  {
   "sentence_id": "C32-B002-S03",
   "section": "B",
   "text": "申込みは一月二十八日まで、一階の受付でお願いします。",
   "start_sec": 34.665,
   "end_sec": 40.958
  },
  {
   "sentence_id": "C32-B002-S04",
   "section": "B",
   "text": "電話で予約はできません。",
   "start_sec": 41.158,
   "end_sec": 43.38
  },
  {
   "sentence_id": "C32-B003-S01",
   "section": "B",
   "text": "隣では進路相談を受け付けています。",
   "start_sec": 43.83,
   "end_sec": 46.704
  },
  {
   "sentence_id": "C32-B003-S02",
   "section": "B",
   "text": "進学・就職・留学の計画、資格や入試の情報を相談できます。",
   "start_sec": 46.904,
   "end_sec": 53.693
  },
  {
   "sentence_id": "C32-B003-S03",
   "section": "B",
   "text": "二月中旬には高校生への説明会も開始します。",
   "start_sec": 53.893,
   "end_sec": 58.493
  },
  {
   "sentence_id": "C32-B003-S04",
   "section": "B",
   "text": "志願者への面接の案内は、近く発表します。",
   "start_sec": 58.693,
   "end_sec": 62.647
  },
  {
   "sentence_id": "C32-B003-S05",
   "section": "B",
   "text": "写真講座には試験も面接もありません。",
   "start_sec": 62.847,
   "end_sec": 66.14
  }
 ]
}
