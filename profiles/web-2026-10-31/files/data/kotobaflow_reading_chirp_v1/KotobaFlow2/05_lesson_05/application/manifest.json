 "sentence_intervals": [
  {
   "sentence_id": "C23-B001-S01",
   "section": "B",
   "text": "9月22日。",
   "start_sec": 0.0,
   "end_sec": 1.613
  },
  {
   "sentence_id": "C23-B001-S02",
   "section": "B",
   "text": "20日の釣りの後で、教室に落とし物がありました。",
   "start_sec": 1.813,
   "end_sec": 6.127
  },
  {
   "sentence_id": "C23-B001-S03",
   "section": "B",
   "text": "紺色の帽子が二つあります。",
   "start_sec": 6.327,
   "end_sec": 8.36
  },
  {
   "sentence_id": "C23-B001-S04",
   "section": "B",
   "text": "中に名前がありますが、字がはっきり分かりません。",
   "start_sec": 8.56,
   "end_sec": 12.513
  },
  {
   "sentence_id": "C23-B001-S05",
   "section": "B",
   "text": "持ち主がだれか、まだ分かりません。",
   "start_sec": 12.713,
   "end_sec": 15.587
  },
  {
   "sentence_id": "C23-B001-S06",
   "section": "B",
   "text": "受付で帽子の特徴を話してください。",
   "start_sec": 15.787,
   "end_sec": 19.123
  },
  {
   "sentence_id": "C23-B001-S07",
   "section": "B",
   "text": "受付は毎日9時から17時までです。",
   "start_sec": 19.323,
   "end_sec": 22.993
  },
  {
   "sentence_id": "C23-B001-S08",
   "section": "B",
   "text": "帽子は10月4日まで受付にあります。",
   "start_sec": 23.193,
   "end_sec": 26.519
  },
  {
   "sentence_id": "C23-B002-S01",
   "section": "B",
   "text": "26日は海辺公園の工事の日なので、写真散歩を10月3日に延期します。",
   "start_sec": 26.969,
   "end_sec": 34.857
  },
  {
   "sentence_id": "C23-B002-S02",
   "section": "B",
   "text": "時間は9時から11時までです。",
   "start_sec": 35.057,
   "end_sec": 37.808
  },
  {
   "sentence_id": "C23-B002-S03",
   "section": "B",
   "text": "公民館の前に来てください。",
   "start_sec": 38.008,
   "end_sec": 39.921
  },
  {
   "sentence_id": "C23-B002-S04",
   "section": "B",
   "text": "都合がよくない人は受付で予定の変更を伝えてください。",
   "start_sec": 40.121,
   "end_sec": 45.063
  },
  {
   "sentence_id": "C23-B003-S01",
   "section": "B",
   "text": "10月4日は7時から10時まで釣りをします。",
   "start_sec": 45.513,
   "end_sec": 49.436
  },
  {
   "sentence_id": "C23-B003-S02",
   "section": "B",
   "text": "行きたい人は3日に電話をしてください。",
   "start_sec": 49.636,
   "end_sec": 52.964
  },
  {
   "sentence_id": "C23-B003-S03",
   "section": "B",
   "text": "雨の日の予定はまだ決めていません。",
   "start_sec": 53.164,
   "end_sec": 56.339
  },
  {
   "sentence_id": "C23-B003-S04",
   "section": "B",
   "text": "3日に電話で確認してください。",
   "start_sec": 56.539,
   "end_sec": 59.325
  }
 ]
}
