{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 100.225,
 "source_chapter": 71,
 "sentence_intervals": [
  {
   "sentence_id": "C71-A001-S01",
   "section": "A",
   "text": "四十歳になった今年、高校のアルバムを見つけた。",
   "start_sec": 0.0,
   "end_sec": 4.393
  },
  {
   "sentence_id": "C71-A001-S02",
   "section": "A",
   "text": "懐かしくて、しばらく思い出に浸った。",
   "start_sec": 4.593,
   "end_sec": 7.735
  },
  {
   "sentence_id": "C71-A001-S03",
   "section": "A",
   "text": "かつて私は、友達の美咲と毎週土曜日に町を歩いたものだ。",
   "start_sec": 7.935,
   "end_sec": 13.448
  },
  {
   "sentence_id": "C71-A001-S04",
   "section": "A",
   "text": "古くからある店を背景に、肩を並べて撮った写真もある。",
   "start_sec": 13.648,
   "end_sec": 18.505
  },
  {
   "sentence_id": "C71-A001-S05",
   "section": "A",
   "text": "意気が合う二人にとって、たわいのない話をする時間が青春の楽しみだった。",
   "start_sec": 18.704,
   "end_sec": 24.833
  },
  {
   "sentence_id": "C71-A002-S01",
   "section": "A",
   "text": "二年生の秋、展覧会に出した一枚が暗すぎて選ばれなかった。",
   "start_sec": 25.283,
   "end_sec": 30.366
  },
  {
   "sentence_id": "C71-A002-S02",
   "section": "A",
   "text": "何度見直したことか。",
   "start_sec": 30.566,
   "end_sec": 32.0
  },
  {
   "sentence_id": "C71-A002-S03",
   "section": "A",
   "text": "悔しくてたまらなくて、「もう二度と撮るものか」と強がりを言った。",
   "start_sec": 32.2,
   "end_sec": 36.805
  },
  {
   "sentence_id": "C71-A002-S04",
   "section": "A",
   "text": "悲しい気持ちを隠していたが、美咲は「ここ、いい光ではないか」と小さい窓を指した。",
   "start_sec": 37.005,
   "end_sec": 44.644
  },
  {
   "sentence_id": "C71-A002-S05",
   "section": "A",
   "text": "今、そのきらめきより、隣にいてくれた友達の心が胸に迫る。",
   "start_sec": 44.844,
   "end_sec": 51.115
  },
  {
   "sentence_id": "C71-A003-S01",
   "section": "A",
   "text": "写真の裏の「帰りのパンもおいしかった」という文字に、驚きと喜びを感じた。",
   "start_sec": 51.565,
   "end_sec": 58.35
  },
  {
   "sentence_id": "C71-A003-S02",
   "section": "A",
   "text": "私はパンを噛み締めながら泣くのを我慢し、別れ際に涙を拭ったのだった。",
   "start_sec": 58.55,
   "end_sec": 65.268
  },
  {
   "sentence_id": "C71-A003-S03",
   "section": "A",
   "text": "その記憶まで残っていたとは。",
   "start_sec": 65.468,
   "end_sec": 67.744
  },
  {
   "sentence_id": "C71-A003-S04",
   "section": "A",
   "text": "次の土曜日も一緒に撮影に出かけた。",
   "start_sec": 67.944,
   "end_sec": 71.418
  },
  {
   "sentence_id": "C71-A003-S05",
   "section": "A",
   "text": "今も連絡できるのは有難い。",
   "start_sec": 71.618,
   "end_sec": 74.715
  },
  {
   "sentence_id": "C71-A003-S06",
   "section": "A",
   "text": "一枚への愛着は、友情への感謝でもある。",
   "start_sec": 74.915,
   "end_sec": 78.869
  },
  {
   "sentence_id": "C71-A004-S01",
   "section": "A",
   "text": "人の気持ちは変わるものだと、しみじみ実感する。",
   "start_sec": 79.319,
   "end_sec": 83.486
  },
  {
   "sentence_id": "C71-A004-S02",
   "section": "A",
   "text": "人生を振り返ると、寂しい思い出も大切な宝物に変わることがある。",
   "start_sec": 83.686,
   "end_sec": 89.439
  },
  {
   "sentence_id": "C71-A004-S03",
   "section": "A",
   "text": "ただ、失敗が必ず成長につながるとは限らない。",
   "start_sec": 89.639,
   "end_sec": 93.592
  },
  {
   "sentence_id": "C71-A004-S04",
   "section": "A",
   "text": "友達の親切を思い出すだけでもいい。",
   "start_sec": 93.792,
   "end_sec": 96.906
  },
  {
   "sentence_id": "C71-A004-S05",
   "section": "A",
   "text": "私は美咲に電話をしたくなった。",
   "start_sec": 97.106,
   "end_sec": 100.219
  }
 ]
}
