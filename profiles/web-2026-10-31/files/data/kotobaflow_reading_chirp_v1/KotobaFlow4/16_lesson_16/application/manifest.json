{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 241.883,
 "source_chapter": 72,
 "sentence_intervals": [
  {
   "sentence_id": "C72-B001-S01",
   "section": "B",
   "text": "【担当者研修・本人の言葉から始める】社交的な人でも、親しい人にしか相談できないことがあります。",
   "start_sec": 0.0,
   "end_sec": 8.393
  },
  {
   "sentence_id": "C72-B001-S02",
   "section": "B",
   "text": "短気だ、負けず嫌いだと性格を決めつけ、黙っている人を素直だと評価するのは避けましょう。",
   "start_sec": 8.593,
   "end_sec": 15.907
  },
  {
   "sentence_id": "C72-B001-S03",
   "section": "B",
   "text": "物知りな担当者でも、本人が何を求めるかは聞く必要があります。",
   "start_sec": 16.107,
   "end_sec": 21.372
  },
  {
   "sentence_id": "C72-B001-S04",
   "section": "B",
   "text": "意思の疎通には、知識より聞く姿勢が役立つ場合があります。",
   "start_sec": 21.572,
   "end_sec": 26.596
  },
  {
   "sentence_id": "C72-B002-S01",
   "section": "B",
   "text": "【救護室での記録】階段で転んだ松田さんに職員が駆け寄ると、指から血が出ていました。",
   "start_sec": 27.046,
   "end_sec": 34.244
  },
  {
   "sentence_id": "C72-B002-S02",
   "section": "B",
   "text": "松田さんは「腕と胸も痛い。",
   "start_sec": 34.444,
   "end_sec": 37.257
  },
  {
   "sentence_id": "C72-B002-S03",
   "section": "B",
   "text": "背中には触らないでほしい」と言いました。",
   "start_sec": 37.457,
   "end_sec": 41.106
  },
  {
   "sentence_id": "C72-B002-S04",
   "section": "B",
   "text": "職員は患者の希望を伝えるため、救護室の担当者を呼びました。",
   "start_sec": 41.306,
   "end_sec": 47.224
  },
  {
   "sentence_id": "C72-B002-S05",
   "section": "B",
   "text": "検査が必要かどうかは医療の担当者が判断します。",
   "start_sec": 47.424,
   "end_sec": 51.858
  },
  {
   "sentence_id": "C72-B002-S06",
   "section": "B",
   "text": "周りの人は大けがかどうかを決めつけたり、勝手に両腕を引いたりしませんでした。",
   "start_sec": 52.058,
   "end_sec": 58.301
  },
  {
   "sentence_id": "C72-B002-S07",
   "section": "B",
   "text": "その後、松田さんは付き添いを希望し、職員が受付まで送り届けました。",
   "start_sec": 58.501,
   "end_sec": 65.398
  },
  {
   "sentence_id": "C72-B002-S08",
   "section": "B",
   "text": "松田さんは「手を差し延べる前に聞いてくれて安心した」と、付き添いの配慮を評価しました。",
   "start_sec": 65.598,
   "end_sec": 72.672
  },
  {
   "sentence_id": "C72-B003-S01",
   "section": "B",
   "text": "【相談を受けるとき】「手足が冷たい」「足の裏が痛い」という説明は、そのまま担当者に伝えます。",
   "start_sec": 73.122,
   "end_sec": 81.047
  },
  {
   "sentence_id": "C72-B003-S02",
   "section": "B",
   "text": "つま先と足首では場所が違うので、分からなければ指してもらいます。",
   "start_sec": 81.247,
   "end_sec": 86.776
  },
  {
   "sentence_id": "C72-B003-S03",
   "section": "B",
   "text": "額に手を伸ばす前にも、声をかけてください。",
   "start_sec": 86.976,
   "end_sec": 90.805
  },
  {
   "sentence_id": "C72-B003-S04",
   "section": "B",
   "text": "体を支える助けを求められたら、担当者に方法を確認します。",
   "start_sec": 91.005,
   "end_sec": 96.458
  },
  {
   "sentence_id": "C72-B003-S05",
   "section": "B",
   "text": "人の世話をする経験だけを頼りに、骨の状態や薬の効果を判断してはいけません。",
   "start_sec": 96.658,
   "end_sec": 103.985
  },
  {
   "sentence_id": "C72-B003-S06",
   "section": "B",
   "text": "錠剤や目薬を渡す仕事は、ここでの案内には含まれません。",
   "start_sec": 104.185,
   "end_sec": 108.978
  },
  {
   "sentence_id": "C72-B004-S01",
   "section": "B",
   "text": "【気持ちを推測しすぎない】「さぞお困りでしょう」という同情は、本人の希望の確認とは別です。",
   "start_sec": 109.428,
   "end_sec": 117.042
  },
  {
   "sentence_id": "C72-B004-S02",
   "section": "B",
   "text": "「可哀相だから」と親しげに頭を撫でることも、相手は望まないかもしれません。",
   "start_sec": 117.242,
   "end_sec": 122.996
  },
  {
   "sentence_id": "C72-B004-S03",
   "section": "B",
   "text": "相手を思いやるなら、断った返事も受け止めましょう。",
   "start_sec": 123.196,
   "end_sec": 127.209
  },
  {
   "sentence_id": "C72-B004-S04",
   "section": "B",
   "text": "「気が利く人」と思われるための過剰な心遣いは、助けになりません。",
   "start_sec": 127.409,
   "end_sec": 132.722
  },
  {
   "sentence_id": "C72-B004-S05",
   "section": "B",
   "text": "相手のニーズに応えることと、自分の面子を守ることは違います。",
   "start_sec": 132.922,
   "end_sec": 137.776
  },
  {
   "sentence_id": "C72-B004-S06",
   "section": "B",
   "text": "そっと椅子を用意し、本人の判断を待つこともできます。",
   "start_sec": 137.976,
   "end_sec": 142.851
  },
  {
   "sentence_id": "C72-B004-S07",
   "section": "B",
   "text": "「いつでも相談できます」という力強い言葉が、支えになることもあります。",
   "start_sec": 143.051,
   "end_sec": 148.545
  },
  {
   "sentence_id": "C72-B005-S01",
   "section": "B",
   "text": "【断れる案内へ】勧誘を断り、参加を辞退した人に、理由を何度も聞かないでください。",
   "start_sec": 148.995,
   "end_sec": 156.729
  },
  {
   "sentence_id": "C72-B005-S02",
   "section": "B",
   "text": "義理や負い目から参加させるのは、自由な相談という建前に反します。",
   "start_sec": 156.929,
   "end_sec": 162.408
  },
  {
   "sentence_id": "C72-B005-S03",
   "section": "B",
   "text": "表向きは自由でも、恩返しを求められれば相談の敷居が高くなります。",
   "start_sec": 162.608,
   "end_sec": 168.507
  },
  {
   "sentence_id": "C72-B005-S04",
   "section": "B",
   "text": "言外に別の本音があると決めて、しつこい勧誘を続けないようにしましょう。",
   "start_sec": 168.707,
   "end_sec": 174.47
  },
  {
   "sentence_id": "C72-B005-S05",
   "section": "B",
   "text": "間接的な言い方だけでは伝わらないときは、ストレートに希望を確認できます。",
   "start_sec": 174.67,
   "end_sec": 180.728
  },
  {
   "sentence_id": "C72-B005-S06",
   "section": "B",
   "text": "遠回しな返事をした人も、「説明だけで十分です」と言い直せます。",
   "start_sec": 180.928,
   "end_sec": 186.428
  },
  {
   "sentence_id": "C72-B006-S01",
   "section": "B",
   "text": "【坂井から佐藤さんへ】「先日は希望を確かめずに入力を始め、お詫び申し上げます。",
   "start_sec": 186.878,
   "end_sec": 194.427
  },
  {
   "sentence_id": "C72-B006-S02",
   "section": "B",
   "text": "説明をもとに資料を作りました。",
   "start_sec": 194.627,
   "end_sec": 197.514
  },
  {
   "sentence_id": "C72-B006-S03",
   "section": "B",
   "text": "気兼ねなく利用できる窓口にするため、お気づきの点があれば教えてください。",
   "start_sec": 197.714,
   "end_sec": 203.703
  },
  {
   "sentence_id": "C72-B006-S04",
   "section": "B",
   "text": "ただし、資料の確認は断っても大丈夫です。",
   "start_sec": 203.903,
   "end_sec": 208.194
  },
  {
   "sentence_id": "C72-B006-S05",
   "section": "B",
   "text": "このお願いに応じてくださるかどうかにかかわらず、今後は先に希望を伺います。」",
   "start_sec": 208.394,
   "end_sec": 214.327
  },
  {
   "sentence_id": "C72-B007-S01",
   "section": "B",
   "text": "【佐藤さんからの返信】「心を込めたお手紙をありがとうございます。",
   "start_sec": 214.777,
   "end_sec": 220.068
  },
  {
   "sentence_id": "C72-B007-S02",
   "section": "B",
   "text": "今回は確認を辞退しますが、私の言葉を気にかけてくださったことが何より嬉しいです。",
   "start_sec": 220.268,
   "end_sec": 227.341
  },
  {
   "sentence_id": "C72-B007-S03",
   "section": "B",
   "text": "過失を償うための特別な援助は望んでいません。",
   "start_sec": 227.541,
   "end_sec": 231.686
  },
  {
   "sentence_id": "C72-B007-S04",
   "section": "B",
   "text": "平凡なお願いですが、必要なときだけ質問に答えてください。",
   "start_sec": 231.886,
   "end_sec": 236.883
  },
  {
   "sentence_id": "C72-B007-S05",
   "section": "B",
   "text": "自分でできる部分を認めてもらえたことが、私には救いでした。」",
   "start_sec": 237.083,
   "end_sec": 241.876
  }
 ]
}
