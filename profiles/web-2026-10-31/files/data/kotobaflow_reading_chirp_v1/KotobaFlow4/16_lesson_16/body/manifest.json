{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 88.605,
 "source_chapter": 72,
 "sentence_intervals": [
  {
   "sentence_id": "C72-A001-S01",
   "section": "A",
   "text": "緑町地区センターでは、希望する人に申込み画面の使い方を案内している。",
   "start_sec": 0.0,
   "end_sec": 6.298
  },
  {
   "sentence_id": "C72-A001-S02",
   "section": "A",
   "text": "担当の坂井は優しい人で、「困っている人を見ると、助けずにはいられません」と話す。",
   "start_sec": 6.498,
   "end_sec": 13.325
  },
  {
   "sentence_id": "C72-A001-S03",
   "section": "A",
   "text": "ある日、佐藤さんが文字を何度も直しているのを見て、代わりの入力を申し出た。",
   "start_sec": 13.525,
   "end_sec": 20.524
  },
  {
   "sentence_id": "C72-A001-S04",
   "section": "A",
   "text": "坂井は借りたスマートフォンに名前を入力したが、送信はしなかった。",
   "start_sec": 20.724,
   "end_sec": 26.279
  },
  {
   "sentence_id": "C72-A002-S01",
   "section": "A",
   "text": "しかし、佐藤さんは「自分で練習したかったんです」と言った。",
   "start_sec": 26.729,
   "end_sec": 31.525
  },
  {
   "sentence_id": "C72-A002-S02",
   "section": "A",
   "text": "佐藤さんは真面目な勉強家で、操作の記録を毎日つけていた。",
   "start_sec": 31.725,
   "end_sec": 38.219
  },
  {
   "sentence_id": "C72-A002-S03",
   "section": "A",
   "text": "坂井は気遣いが伝わったと思ったが、本人が望んでいたのは説明だった。",
   "start_sec": 38.419,
   "end_sec": 44.733
  },
  {
   "sentence_id": "C72-A002-S04",
   "section": "A",
   "text": "「断るのは申し訳ないと思って、我慢していました。」",
   "start_sec": 44.933,
   "end_sec": 48.586
  },
  {
   "sentence_id": "C72-A003-S01",
   "section": "A",
   "text": "坂井は「謝罪せずにはいられませんでした」と振り返る。",
   "start_sec": 49.036,
   "end_sec": 52.998
  },
  {
   "sentence_id": "C72-A003-S02",
   "section": "A",
   "text": "佐藤さんは「助けてくださったことには感謝しています。",
   "start_sec": 53.198,
   "end_sec": 57.091
  },
  {
   "sentence_id": "C72-A003-S03",
   "section": "A",
   "text": "でも、先に希望を確認してほしいです」と伝えた。",
   "start_sec": 57.291,
   "end_sec": 61.5
  },
  {
   "sentence_id": "C72-A003-S04",
   "section": "A",
   "text": "坂井はその言葉を受け止めて電話を返し、その後は入力することなく、隣で質問に答えた。",
   "start_sec": 61.7,
   "end_sec": 69.178
  },
  {
   "sentence_id": "C72-A004-S01",
   "section": "A",
   "text": "佐藤さんが自身のペースで覚えたいという気持ちに、坂井は共感した。",
   "start_sec": 69.628,
   "end_sec": 74.871
  },
  {
   "sentence_id": "C72-A004-S02",
   "section": "A",
   "text": "性格を知っているつもりでも、希望までは分からない。",
   "start_sec": 75.071,
   "end_sec": 78.979
  },
  {
   "sentence_id": "C72-A004-S03",
   "section": "A",
   "text": "応援したいという善意も、押し付ければ負担になる。",
   "start_sec": 79.179,
   "end_sec": 82.945
  },
  {
   "sentence_id": "C72-A004-S04",
   "section": "A",
   "text": "必要なのは、相手を急き立てることではなく、返事を待つことだった。",
   "start_sec": 83.145,
   "end_sec": 88.598
  }
 ]
}
