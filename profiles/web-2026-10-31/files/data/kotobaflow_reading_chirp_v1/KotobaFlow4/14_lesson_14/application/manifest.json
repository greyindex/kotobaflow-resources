{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 398.634,
 "source_chapter": 70,
 "sentence_intervals": [
  {
   "sentence_id": "C70-B011-S01",
   "section": "B",
   "text": "二〇二七年三月四日、緑町地区センターの野口は、二月に更新した案内図の調査報告をまとめた。",
   "start_sec": 0.0,
   "end_sec": 10.188
  },
  {
   "sentence_id": "C70-B011-S02",
   "section": "B",
   "text": "二月二十二日から二十六日までの平日に二十八人に聞き、二十人が回答し、十六人が分かりやすい、四人が分かりにくいと答えた。",
   "start_sec": 10.388,
   "end_sec": 22.474
  },
  {
   "sentence_id": "C70-B011-S03",
   "section": "B",
   "text": "三人は字の小ささ、一人は矢印の方向を問題にした。",
   "start_sec": 22.674,
   "end_sec": 28.657
  },
  {
   "sentence_id": "C70-B011-S04",
   "section": "B",
   "text": "二人の職員の集計は一致し、回答者の八十パーセントが「分かりやすい」と答えたことは疑いないが、初訪問かどうかは未確認で、八人の未回答の理由も不明だ。",
   "start_sec": 28.857,
   "end_sec": 42.473
  },
  {
   "sentence_id": "C70-B011-S05",
   "section": "B",
   "text": "休日に迷う人が多いという話にはまだ裏付けがなく、次の調査の日程、人数、方法も未定である。",
   "start_sec": 42.673,
   "end_sec": 51.642
  },
  {
   "sentence_id": "C70-B011-S06",
   "section": "B",
   "text": "移動時間の観測は候補だが、感想だけから迷う確率を推定することはできない。",
   "start_sec": 51.842,
   "end_sec": 58.453
  },
  {
   "sentence_id": "C70-B011-S07",
   "section": "B",
   "text": "回答用紙は人数を確かめる確かな証拠だが、効果の証明とは別である。",
   "start_sec": 58.653,
   "end_sec": 65.16
  },
  {
   "sentence_id": "C70-B012-S01",
   "section": "B",
   "text": "その午後、林梅はこの経験を読書会の紹介文にも生かそうと考えた。",
   "start_sec": 65.61,
   "end_sec": 72.648
  },
  {
   "sentence_id": "C70-B012-S02",
   "section": "B",
   "text": "会では架空の小説『炉端の筆』と、その漫画版、劇映画版を比較する。",
   "start_sec": 72.848,
   "end_sec": 79.242
  },
  {
   "sentence_id": "C70-B012-S03",
   "section": "B",
   "text": "題名の「筆」は、主人公が祖父から受け取る毛筆を指す。",
   "start_sec": 79.442,
   "end_sec": 84.72
  },
  {
   "sentence_id": "C70-B012-S04",
   "section": "B",
   "text": "これは林梅の愛読書で、文学に親しむ入口になった読物だが、他人にも同じ効果があるとは限らない。",
   "start_sec": 84.92,
   "end_sec": 93.61
  },
  {
   "sentence_id": "C70-B013-S01",
   "section": "B",
   "text": "物語の粗筋は単純だ。",
   "start_sec": 94.06,
   "end_sec": 96.393
  },
  {
   "sentence_id": "C70-B013-S02",
   "section": "B",
   "text": "大昔の村で、柴を売る若者が土間で古い手紙を見つけ、囲炉裏のそばで祖父と読み解く。",
   "start_sec": 96.593,
   "end_sec": 104.027
  },
  {
   "sentence_id": "C70-B013-S03",
   "section": "B",
   "text": "漢学を学んだ祖父は「わしにも読めない字がある」と言い、豊富な知識だけでは謎を解けない。",
   "start_sec": 104.227,
   "end_sec": 111.9
  },
  {
   "sentence_id": "C70-B013-S04",
   "section": "B",
   "text": "若者の頓智と祖父の年の功が結び付き、二人は手紙が宝の場所ではなく、村の水路を示すと気付く。",
   "start_sec": 112.1,
   "end_sec": 120.373
  },
  {
   "sentence_id": "C70-B013-S05",
   "section": "B",
   "text": "恋愛も描かれるが、ラブストーリーだけではなく、世代間の協力が中心のモチーフになっている。",
   "start_sec": 120.573,
   "end_sec": 128.625
  },
  {
   "sentence_id": "C70-B013-S06",
   "section": "B",
   "text": "二人が炉端に座って手紙を広げる場面は、表紙にも使われている。",
   "start_sec": 128.825,
   "end_sec": 134.081
  },
  {
   "sentence_id": "C70-B014-S01",
   "section": "B",
   "text": "紹介文の初稿には「一流の役者が出るから映画は優れているに決まっている」とあった。",
   "start_sec": 134.531,
   "end_sec": 141.836
  },
  {
   "sentence_id": "C70-B014-S02",
   "section": "B",
   "text": "しかし、芸能記事で脚光を浴びる人が出演しても、筋の説明が分かりやすいとは限らない。",
   "start_sec": 142.036,
   "end_sec": 149.892
  },
  {
   "sentence_id": "C70-B014-S03",
   "section": "B",
   "text": "映画の長所は、巨大な水路が現れる大迫力のシーンと、若者が腰を抜かすユーモラスな演技だ。",
   "start_sec": 150.092,
   "end_sec": 158.816
  },
  {
   "sentence_id": "C70-B014-S04",
   "section": "B",
   "text": "一方、手紙の内容を示す時間はほんの数秒で、初見では追いにくい。",
   "start_sec": 159.016,
   "end_sec": 165.644
  },
  {
   "sentence_id": "C70-B014-S05",
   "section": "B",
   "text": "「百聞は一見に如かず」と勧めるだけでなく、鑑賞前に知っておくとよい点を伝えたい。",
   "start_sec": 165.844,
   "end_sec": 173.236
  },
  {
   "sentence_id": "C70-B015-S01",
   "section": "B",
   "text": "漫画は単行本一冊にまとまり、空想の世界を多彩な色で描いている。",
   "start_sec": 173.686,
   "end_sec": 179.525
  },
  {
   "sentence_id": "C70-B015-S02",
   "section": "B",
   "text": "表紙は上品で洗練されているが、それだけで中身もよいというものではない。",
   "start_sec": 179.725,
   "end_sec": 186.006
  },
  {
   "sentence_id": "C70-B015-S03",
   "section": "B",
   "text": "林梅は、手紙の文字に赤いアクセントを付け、読者が自分で謎を考えられる構成を評価した。",
   "start_sec": 186.206,
   "end_sec": 193.946
  },
  {
   "sentence_id": "C70-B015-S04",
   "section": "B",
   "text": "映画より静かな表現だから見劣りがする、という評価には賛成しなかった。",
   "start_sec": 194.146,
   "end_sec": 201.387
  },
  {
   "sentence_id": "C70-B015-S05",
   "section": "B",
   "text": "「比べ物にならない」と切り捨てず、媒体ごとに何が伝わるかを見る。",
   "start_sec": 201.587,
   "end_sec": 206.374
  },
  {
   "sentence_id": "C70-B016-S01",
   "section": "B",
   "text": "映画の主題歌は若いファンの間でヒット曲になったという設定だ。",
   "start_sec": 206.824,
   "end_sec": 212.254
  },
  {
   "sentence_id": "C70-B016-S02",
   "section": "B",
   "text": "作曲を担当した新人と、歌詞を書いた作詞担当者は別の人である。",
   "start_sec": 212.454,
   "end_sec": 218.93
  },
  {
   "sentence_id": "C70-B016-S03",
   "section": "B",
   "text": "話題曲が満載の娯楽作品として大ブレークした、と宣伝には書かれている。",
   "start_sec": 219.13,
   "end_sec": 224.967
  },
  {
   "sentence_id": "C70-B016-S04",
   "section": "B",
   "text": "だが、「絶大な人気」という表現には、いつ、誰に人気があるかという情報が欠けている。",
   "start_sec": 225.167,
   "end_sec": 233.01
  },
  {
   "sentence_id": "C70-B016-S05",
   "section": "B",
   "text": "大衆的で受けがよいことと、全員が好きなことは同じではない。",
   "start_sec": 233.21,
   "end_sec": 238.343
  },
  {
   "sentence_id": "C70-B017-S01",
   "section": "B",
   "text": "担当者は原作のコミックな場面を朗読用のドラマに直し、舞台で紹介する案も出した。",
   "start_sec": 238.793,
   "end_sec": 246.347
  },
  {
   "sentence_id": "C70-B017-S02",
   "section": "B",
   "text": "幕が開く直前、役者は口拍子でリズムを確かめるという演出だ。",
   "start_sec": 246.547,
   "end_sec": 252.223
  },
  {
   "sentence_id": "C70-B017-S03",
   "section": "B",
   "text": "真面目くさった顔で宝の場所を言い間違える場面は、単なる笑い話ではなく、聞き違いが起こる理由を考える入口になる。",
   "start_sec": 252.423,
   "end_sec": 262.197
  },
  {
   "sentence_id": "C70-B017-S04",
   "section": "B",
   "text": "ただ、笑わせようと間を短くすると、かえって間が抜けた演技になりかねない。",
   "start_sec": 262.397,
   "end_sec": 268.809
  },
  {
   "sentence_id": "C70-B017-S05",
   "section": "B",
   "text": "朗読が十八番だという参加者についても、練習なしで成功するとは断定できない。",
   "start_sec": 269.009,
   "end_sec": 275.281
  },
  {
   "sentence_id": "C70-B018-S01",
   "section": "B",
   "text": "ここで林梅は、宣伝と批評の違いに気付いた。",
   "start_sec": 275.731,
   "end_sec": 280.164
  },
  {
   "sentence_id": "C70-B018-S02",
   "section": "B",
   "text": "「失敗したら一巻の終わりだ」「舞台に慣れていない人にはできっこない」という言い方は、人の可能性を早く決めすぎる。",
   "start_sec": 280.364,
   "end_sec": 289.788
  },
  {
   "sentence_id": "C70-B018-S03",
   "section": "B",
   "text": "芸をマスターするには練習も必要だが、「習うより慣れよ」を理由に説明を省くのも適切ではない。",
   "start_sec": 289.988,
   "end_sec": 297.286
  },
  {
   "sentence_id": "C70-B018-S04",
   "section": "B",
   "text": "エンターテイメントの楽しさを守りながら、参加しやすい条件を整えたい。",
   "start_sec": 297.486,
   "end_sec": 302.96
  },
  {
   "sentence_id": "C70-B019-S01",
   "section": "B",
   "text": "会で使う資料には絵本、童話、アニメの比較例もあるが、いずれも今回の原作とは別の作品だ。",
   "start_sec": 303.41,
   "end_sec": 312.932
  },
  {
   "sentence_id": "C70-B019-S02",
   "section": "B",
   "text": "バラエティーに富んだ資料でも、使う目的が曖昧なら無用の長物になる。",
   "start_sec": 313.132,
   "end_sec": 318.885
  },
  {
   "sentence_id": "C70-B019-S03",
   "section": "B",
   "text": "資料を減らせば、その分、一つの作品について話す時間が増える。",
   "start_sec": 319.085,
   "end_sec": 324.69
  },
  {
   "sentence_id": "C70-B019-S04",
   "section": "B",
   "text": "ごく短い紹介でも、評価の理由を示せば、よりよい対話につながるはずだ。",
   "start_sec": 324.89,
   "end_sec": 331.263
  },
  {
   "sentence_id": "C70-B020-S01",
   "section": "B",
   "text": "最終稿では、作品がヒットしたという設定と、書き手の感想を分けた。",
   "start_sec": 331.713,
   "end_sec": 337.885
  },
  {
   "sentence_id": "C70-B020-S02",
   "section": "B",
   "text": "「面白いに違いない」は予想にほかならないので、実際に読んだ感想とは区別する。",
   "start_sec": 338.085,
   "end_sec": 344.499
  },
  {
   "sentence_id": "C70-B020-S03",
   "section": "B",
   "text": "「下らない」「話にならない」という短い否定も、判断力の証明にはならない。",
   "start_sec": 344.699,
   "end_sec": 350.392
  },
  {
   "sentence_id": "C70-B020-S04",
   "section": "B",
   "text": "良かれ悪しかれ、強い言葉は読者の印象を左右する。",
   "start_sec": 350.592,
   "end_sec": 355.455
  },
  {
   "sentence_id": "C70-B020-S05",
   "section": "B",
   "text": "評価の一般化が妥当かを検証する姿勢は、案内図の調査にも作品紹介にも必要である。",
   "start_sec": 355.655,
   "end_sec": 363.149
  },
  {
   "sentence_id": "C70-B021-S01",
   "section": "B",
   "text": "林梅は初稿を削った理由も記録した。",
   "start_sec": 363.599,
   "end_sec": 367.55
  },
  {
   "sentence_id": "C70-B021-S02",
   "section": "B",
   "text": "限られた経験から一般的な傾向を推測することには限界がある。",
   "start_sec": 367.75,
   "end_sec": 373.024
  },
  {
   "sentence_id": "C70-B021-S03",
   "section": "B",
   "text": "「恐らく」という言葉を足すだけでは、証拠が不十分な点は変わらない。",
   "start_sec": 373.224,
   "end_sec": 379.027
  },
  {
   "sentence_id": "C70-B021-S04",
   "section": "B",
   "text": "反対の感想も必ずしも矛盾ではなく、期待の違いを示す例外かもしれない。",
   "start_sec": 379.227,
   "end_sec": 386.06
  },
  {
   "sentence_id": "C70-B021-S05",
   "section": "B",
   "text": "普遍的な評価を確定する前に留保を置き、不確かな仮説は実証された説明と区別する。",
   "start_sec": 386.26,
   "end_sec": 393.874
  },
  {
   "sentence_id": "C70-B021-S06",
   "section": "B",
   "text": "断片的な発言だけで、その人の好みを決めてはいけない。",
   "start_sec": 394.074,
   "end_sec": 398.627
  }
 ]
}
