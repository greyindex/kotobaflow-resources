{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 58.36,
 "source_chapter": 68,
 "sentence_intervals": [
  {
   "sentence_id": "C68-A001-S01",
   "section": "A",
   "text": "一月十四日午前十時ごろ、緑町地区センターの印刷機が止まり、午後一時に復旧しました。",
   "start_sec": 0.0,
   "end_sec": 7.956
  },
  {
   "sentence_id": "C68-A001-S02",
   "section": "A",
   "text": "支援金の申請窓口は開いていました。",
   "start_sec": 8.156,
   "end_sec": 11.209
  },
  {
   "sentence_id": "C68-A001-S03",
   "section": "A",
   "text": "本サイトの十一時の記事は「申請が停止」と伝えましたが、誤りでした。",
   "start_sec": 11.409,
   "end_sec": 17.283
  },
  {
   "sentence_id": "C68-A001-S04",
   "section": "A",
   "text": "窓口の状態を確認しないまま伝えたためです。",
   "start_sec": 17.483,
   "end_sec": 21.703
  },
  {
   "sentence_id": "C68-A001-S05",
   "section": "A",
   "text": "午後五時、見出しと記事を訂正しました。",
   "start_sec": 21.903,
   "end_sec": 24.971
  },
  {
   "sentence_id": "C68-A002-S01",
   "section": "A",
   "text": "停止を目撃した佐藤さんは「印刷を始めたとたん、紙が途中で止まりました」と話しています。",
   "start_sec": 25.421,
   "end_sec": 32.794
  },
  {
   "sentence_id": "C68-A002-S02",
   "section": "A",
   "text": "担当者の野口さんは午後二時に窓口の状況を発表しました。",
   "start_sec": 32.994,
   "end_sec": 38.148
  },
  {
   "sentence_id": "C68-A002-S03",
   "section": "A",
   "text": "原因は調査中で、分かり次第知らせるということです。",
   "start_sec": 38.348,
   "end_sec": 42.685
  },
  {
   "sentence_id": "C68-A003-S01",
   "section": "A",
   "text": "窓口で相談できた人がいる一方で、印刷を待って困った人もいました。",
   "start_sec": 43.135,
   "end_sec": 48.528
  },
  {
   "sentence_id": "C68-A003-S02",
   "section": "A",
   "text": "全員が用事を済ませたかどうかは未確認です。",
   "start_sec": 48.728,
   "end_sec": 52.501
  },
  {
   "sentence_id": "C68-A003-S03",
   "section": "A",
   "text": "申請方法の変更について合意ができたとは、発表されていません。",
   "start_sec": 52.701,
   "end_sec": 58.353
  }
 ]
}
