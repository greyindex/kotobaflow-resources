{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 186.201,
 "source_chapter": 65,
 "sentence_intervals": [
  {
   "sentence_id": "C65-B001-S01",
   "section": "B",
   "text": "緑町センター通知・二〇二六年十二月十八日。",
   "start_sec": 0.0,
   "end_sec": 5.399
  },
  {
   "sentence_id": "C65-B001-S02",
   "section": "B",
   "text": "十二日の意見をもとに活動の両立を図る包括的な案です。",
   "start_sec": 5.599,
   "end_sec": 11.185
  },
  {
   "sentence_id": "C65-B001-S03",
   "section": "B",
   "text": "試行期間は二〇二七年一月九日から三月二十七日。",
   "start_sec": 11.385,
   "end_sec": 17.918
  },
  {
   "sentence_id": "C65-B001-S04",
   "section": "B",
   "text": "四月以降の決定ではありません。",
   "start_sec": 18.118,
   "end_sec": 20.831
  },
  {
   "sentence_id": "C65-B002-S01",
   "section": "B",
   "text": "第二・第四土曜の一月九日・二十三日、二月十三日・二十七日、三月十三日・二十七日は、一階を十時から十二時まで交流会、十三時から十五時まで合唱が使います。",
   "start_sec": 21.281,
   "end_sec": 40.408
  },
  {
   "sentence_id": "C65-B002-S02",
   "section": "B",
   "text": "他の土曜十時から十二時は従来どおり合唱です。",
   "start_sec": 40.608,
   "end_sec": 45.156
  },
  {
   "sentence_id": "C65-B003-S01",
   "section": "B",
   "text": "六日分はセンターが確保し、両団体の窓口予約は不要です。",
   "start_sec": 45.606,
   "end_sec": 51.179
  },
  {
   "sentence_id": "C65-B003-S02",
   "section": "B",
   "text": "先着順では平日に働く人に公平とは言えません。",
   "start_sec": 51.379,
   "end_sec": 55.933
  },
  {
   "sentence_id": "C65-B003-S03",
   "section": "B",
   "text": "活動中は窓を閉め、終了時刻までに片付けて退室してください。",
   "start_sec": 56.133,
   "end_sec": 61.49
  },
  {
   "sentence_id": "C65-B004-S01",
   "section": "B",
   "text": "森田さんが参加できるのは、この案の利点です。",
   "start_sec": 61.94,
   "end_sec": 65.593
  },
  {
   "sentence_id": "C65-B004-S02",
   "section": "B",
   "text": "その反面、合唱の七人は月二回参加できないという欠点があります。",
   "start_sec": 65.793,
   "end_sec": 72.118
  },
  {
   "sentence_id": "C65-B004-S03",
   "section": "B",
   "text": "合唱側は不安を感じつつも協力しますが、全員満足の合意ではありません。",
   "start_sec": 72.318,
   "end_sec": 78.912
  },
  {
   "sentence_id": "C65-B004-S04",
   "section": "B",
   "text": "どちらを午後にしても負担は残ります。",
   "start_sec": 79.112,
   "end_sec": 82.645
  },
  {
   "sentence_id": "C65-B005-S01",
   "section": "B",
   "text": "七月以降苦情はありません。",
   "start_sec": 83.095,
   "end_sec": 85.939
  },
  {
   "sentence_id": "C65-B005-S02",
   "section": "B",
   "text": "とはいえ、午後の音は未確認です。",
   "start_sec": 86.139,
   "end_sec": 89.394
  },
  {
   "sentence_id": "C65-B005-S03",
   "section": "B",
   "text": "一月九日以降、近隣住民にも確認を依頼します。",
   "start_sec": 89.594,
   "end_sec": 94.627
  },
  {
   "sentence_id": "C65-B005-S04",
   "section": "B",
   "text": "厚いカーテンの予算とエレベーターの設置は未定。",
   "start_sec": 94.827,
   "end_sec": 98.606
  },
  {
   "sentence_id": "C65-B005-S05",
   "section": "B",
   "text": "二月中に両団体と住民で話し合い、日付は後日通知します。",
   "start_sec": 98.806,
   "end_sec": 104.414
  },
  {
   "sentence_id": "C65-B005-S06",
   "section": "B",
   "text": "三月の会議で四月以降を決めます。",
   "start_sec": 104.614,
   "end_sec": 108.03
  },
  {
   "sentence_id": "C65-B006-S01",
   "section": "B",
   "text": "意見は一月六日水曜までに用紙かメールで野口へ。",
   "start_sec": 108.48,
   "end_sec": 113.592
  },
  {
   "sentence_id": "C65-B006-S02",
   "section": "B",
   "text": "理由と代案も書いてください。",
   "start_sec": 113.792,
   "end_sec": 116.141
  },
  {
   "sentence_id": "C65-B006-S03",
   "section": "B",
   "text": "十二月二十九日から一月三日は休みです。",
   "start_sec": 116.341,
   "end_sec": 120.886
  },
  {
   "sentence_id": "C65-B006-S04",
   "section": "B",
   "text": "送ったにもかかわらず返信がない場合、一月四日以降に電話してください。",
   "start_sec": 121.086,
   "end_sec": 127.019
  },
  {
   "sentence_id": "C65-B007-S01",
   "section": "B",
   "text": "写真展のお願い：写真を見つつ説明を書き、名前の掲載は本人に確認してください。",
   "start_sec": 127.469,
   "end_sec": 135.436
  },
  {
   "sentence_id": "C65-B007-S02",
   "section": "B",
   "text": "夫婦にしても恋人にしても、二人の関係を公表するかは本人が決めます。",
   "start_sec": 135.636,
   "end_sec": 142.205
  },
  {
   "sentence_id": "C65-B007-S03",
   "section": "B",
   "text": "別姓だから夫婦ではない、という推測は禁物です。",
   "start_sec": 142.405,
   "end_sec": 146.935
  },
  {
   "sentence_id": "C65-B007-S04",
   "section": "B",
   "text": "うちの集団の常識だけでは理解し合うことはできません。",
   "start_sec": 147.135,
   "end_sec": 151.716
  },
  {
   "sentence_id": "C65-B008-S01",
   "section": "B",
   "text": "実子か養子か、家柄や人種を無断で記すと、自尊心を傷つけます。",
   "start_sec": 152.166,
   "end_sec": 158.457
  },
  {
   "sentence_id": "C65-B008-S02",
   "section": "B",
   "text": "男女や育ちによって役割を決めず、思い思いの説明を認めます。",
   "start_sec": 158.657,
   "end_sec": 163.93
  },
  {
   "sentence_id": "C65-B008-S03",
   "section": "B",
   "text": "「よそ者」と呼んで排除せず、友好と和を大切にしましょう。",
   "start_sec": 164.13,
   "end_sec": 168.504
  },
  {
   "sentence_id": "C65-B009-S01",
   "section": "B",
   "text": "子どもが写真をほしがる場合も、持ち主に聞きます。",
   "start_sec": 168.954,
   "end_sec": 173.087
  },
  {
   "sentence_id": "C65-B009-S02",
   "section": "B",
   "text": "いじめる行為を「仲がよいから」とかばうのは思いやりではありません。",
   "start_sec": 173.287,
   "end_sec": 178.773
  },
  {
   "sentence_id": "C65-B009-S03",
   "section": "B",
   "text": "いくら親しくても同意は必要です。",
   "start_sec": 178.973,
   "end_sec": 182.281
  },
  {
   "sentence_id": "C65-B009-S04",
   "section": "B",
   "text": "付き合いを保ちつつ、いやなことは断れます。",
   "start_sec": 182.481,
   "end_sec": 186.195
  }
 ]
}
