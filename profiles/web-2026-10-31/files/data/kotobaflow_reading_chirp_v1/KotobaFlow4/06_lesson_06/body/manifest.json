{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 86.941,
 "source_chapter": 62,
 "sentence_intervals": [
  {
   "sentence_id": "C62-A001-S01",
   "section": "A",
   "text": "団体プランとは、５人から１０人で同じ講座を利用する方法です。",
   "start_sec": 0.0,
   "end_sec": 5.938
  },
  {
   "sentence_id": "C62-A001-S02",
   "section": "A",
   "text": "会社に限らず、学校のグループも対象です。",
   "start_sec": 6.138,
   "end_sec": 9.611
  },
  {
   "sentence_id": "C62-A001-S03",
   "section": "A",
   "text": "講座は動画で提供します。",
   "start_sec": 9.811,
   "end_sec": 11.845
  },
  {
   "sentence_id": "C62-A001-S04",
   "section": "A",
   "text": "月６０００円、講師への質問は別に１回５００円です。",
   "start_sec": 12.045,
   "end_sec": 18.069
  },
  {
   "sentence_id": "C62-A001-S05",
   "section": "A",
   "text": "利用は申し込んだ月の次の月の１日からです。",
   "start_sec": 18.269,
   "end_sec": 22.463
  },
  {
   "sentence_id": "C62-A002-S01",
   "section": "A",
   "text": "１２月２０日までに申し込んだ初回利用の団体は、最初の月が無料です。",
   "start_sec": 22.913,
   "end_sec": 29.203
  },
  {
   "sentence_id": "C62-A002-S02",
   "section": "A",
   "text": "「初回利用」というのは、同じ会社や学校の中で、一度もこのプランを使っていないことです。",
   "start_sec": 29.403,
   "end_sec": 36.599
  },
  {
   "sentence_id": "C62-A002-S03",
   "section": "A",
   "text": "別の部署が使った場合も対象外です。",
   "start_sec": 36.799,
   "end_sec": 40.37
  },
  {
   "sentence_id": "C62-A003-S01",
   "section": "A",
   "text": "規約で決められた利用の範囲は、登録した参加者のみです。",
   "start_sec": 40.82,
   "end_sec": 45.535
  },
  {
   "sentence_id": "C62-A003-S02",
   "section": "A",
   "text": "代表者が料金を払う責任を持ちます。",
   "start_sec": 45.735,
   "end_sec": 49.208
  },
  {
   "sentence_id": "C62-A003-S03",
   "section": "A",
   "text": "システムの欠陥で１日以上使えなかった場合は、使えなかった日の料金を次の月の料金から引いて補償します。",
   "start_sec": 49.408,
   "end_sec": 58.976
  },
  {
   "sentence_id": "C62-A003-S04",
   "section": "A",
   "text": "参加者のパソコンの故障は対象外です。",
   "start_sec": 59.176,
   "end_sec": 62.469
  },
  {
   "sentence_id": "C62-A004-S01",
   "section": "A",
   "text": "質問の傾向に基づいて、一年に一度、内容を見直します。",
   "start_sec": 62.919,
   "end_sec": 68.581
  },
  {
   "sentence_id": "C62-A004-S02",
   "section": "A",
   "text": "講座の追加に伴って、２０２７年４月から料金を変える予定です。",
   "start_sec": 68.781,
   "end_sec": 75.735
  },
  {
   "sentence_id": "C62-A004-S03",
   "section": "A",
   "text": "新料金は２月に発表します。",
   "start_sec": 75.935,
   "end_sec": 78.688
  },
  {
   "sentence_id": "C62-A004-S04",
   "section": "A",
   "text": "３月までの料金は変わりません。",
   "start_sec": 78.888,
   "end_sec": 81.401
  },
  {
   "sentence_id": "C62-A004-S05",
   "section": "A",
   "text": "変更後も利用する場合は、新料金を確認してから申し込んでください。",
   "start_sec": 81.601,
   "end_sec": 86.935
  }
 ]
}
