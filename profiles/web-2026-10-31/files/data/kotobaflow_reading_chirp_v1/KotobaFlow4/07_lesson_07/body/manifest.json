{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 93.635,
 "source_chapter": 63,
 "sentence_intervals": [
  {
   "sentence_id": "C63-A001-S01",
   "section": "A",
   "text": "12月7日から13日まで生活を記録しました。",
   "start_sec": 0.0,
   "end_sec": 3.953
  },
  {
   "sentence_id": "C63-A001-S02",
   "section": "A",
   "text": "月曜から木曜は提案資料の準備で睡眠が平均5時間、コーヒーは一日4杯、いつもの2倍でした。",
   "start_sec": 4.153,
   "end_sec": 13.387
  },
  {
   "sentence_id": "C63-A001-S03",
   "section": "A",
   "text": "帰りの電車はすし詰めで身動きもできず、疲労が溜まりました。",
   "start_sec": 13.587,
   "end_sec": 18.74
  },
  {
   "sentence_id": "C63-A001-S04",
   "section": "A",
   "text": "ハードな日が続くと、何もかも面倒臭くなりがちです。",
   "start_sec": 18.94,
   "end_sec": 23.432
  },
  {
   "sentence_id": "C63-A002-S01",
   "section": "A",
   "text": "木曜は寝不足気味で、机はメモだらけでした。",
   "start_sec": 23.882,
   "end_sec": 27.708
  },
  {
   "sentence_id": "C63-A002-S02",
   "section": "A",
   "text": "電話がじゃんじゃん鳴り、いらいらして、資料の間違いが気になってしょうがありませんでした。",
   "start_sec": 27.908,
   "end_sec": 35.161
  },
  {
   "sentence_id": "C63-A002-S03",
   "section": "A",
   "text": "金曜に提出するとほっとしました。",
   "start_sec": 35.361,
   "end_sec": 37.934
  },
  {
   "sentence_id": "C63-A002-S04",
   "section": "A",
   "text": "何日も走り続けたかのような気分で、午後は眠くて堪りませんでした。",
   "start_sec": 38.134,
   "end_sec": 43.648
  },
  {
   "sentence_id": "C63-A003-S01",
   "section": "A",
   "text": "平日は散歩できませんでしたが、土曜は9時間寝て30分歩きました。",
   "start_sec": 44.098,
   "end_sec": 50.202
  },
  {
   "sentence_id": "C63-A003-S02",
   "section": "A",
   "text": "排気ガスの多い道を避けると気持ちがよく、何となく歩いていた時とは違う発見がありました。",
   "start_sec": 50.402,
   "end_sec": 57.783
  },
  {
   "sentence_id": "C63-A003-S03",
   "section": "A",
   "text": "日曜は家で骨休めをして調子が回復しました。",
   "start_sec": 57.983,
   "end_sec": 62.536
  },
  {
   "sentence_id": "C63-A003-S04",
   "section": "A",
   "text": "ストレスの解消には、私なりの休息も必要だと感じました。",
   "start_sec": 62.736,
   "end_sec": 67.589
  },
  {
   "sentence_id": "C63-A004-S01",
   "section": "A",
   "text": "一週間だけでは長期の傾向は分かりません。",
   "start_sec": 68.039,
   "end_sec": 72.149
  },
  {
   "sentence_id": "C63-A004-S02",
   "section": "A",
   "text": "14日からは生活のリズムを整えるため夜のコーヒーを控え、一日2杯までにし、夜12時までに寝ます。",
   "start_sec": 72.349,
   "end_sec": 81.797
  },
  {
   "sentence_id": "C63-A004-S03",
   "section": "A",
   "text": "運動不足も悩みなので、朝20分の散歩を週3回に戻します。",
   "start_sec": 81.997,
   "end_sec": 88.446
  },
  {
   "sentence_id": "C63-A004-S04",
   "section": "A",
   "text": "体重の変化も記録しますが、痩せることを目標にはしません。",
   "start_sec": 88.646,
   "end_sec": 93.629
  }
 ]
}
