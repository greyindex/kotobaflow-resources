{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 82.987,
 "source_chapter": 61,
 "sentence_intervals": [
  {
   "sentence_id": "C61-A001-S01",
   "section": "A",
   "text": "12月2日、林梅から学習会の皆さんへ。",
   "start_sec": 0.0,
   "end_sec": 4.133
  },
  {
   "sentence_id": "C61-A001-S02",
   "section": "A",
   "text": "一番の懸念は申し込みの日です。",
   "start_sec": 4.333,
   "end_sec": 7.18
  },
  {
   "sentence_id": "C61-A001-S03",
   "section": "A",
   "text": "定員20人の公民館講座は15日締め切りですが、14日まで待つと席を失いかねません。",
   "start_sec": 7.38,
   "end_sec": 16.12
  },
  {
   "sentence_id": "C61-A001-S04",
   "section": "A",
   "text": "危険は認めざるを得ません。",
   "start_sec": 16.32,
   "end_sec": 18.456
  },
  {
   "sentence_id": "C61-A001-S05",
   "section": "A",
   "text": "締め切りが迫っているので、返事を待ってばかりはいられません。",
   "start_sec": 18.656,
   "end_sec": 23.108
  },
  {
   "sentence_id": "C61-A002-S01",
   "section": "A",
   "text": "「学習の窓」なら8人全員が参加できます。",
   "start_sec": 23.558,
   "end_sec": 27.352
  },
  {
   "sentence_id": "C61-A002-S02",
   "section": "A",
   "text": "ただ、初めて利用する団体として会社が認められるか、会社の学習費で払えるかは未定です。",
   "start_sec": 27.552,
   "end_sec": 35.399
  },
  {
   "sentence_id": "C61-A002-S03",
   "section": "A",
   "text": "会社が実際に負担する額は、返事なしでは確かめようがありません。",
   "start_sec": 35.599,
   "end_sec": 40.77
  },
  {
   "sentence_id": "C61-A002-S04",
   "section": "A",
   "text": "二つの返事を待ちながら席を確保するのは困難です。",
   "start_sec": 40.97,
   "end_sec": 45.661
  },
  {
   "sentence_id": "C61-A003-S01",
   "section": "A",
   "text": "土曜午前に参加できる6人は先に申し込み、別の案に決まったら15日までに取り消します。",
   "start_sec": 46.111,
   "end_sec": 54.441
  },
  {
   "sentence_id": "C61-A003-S02",
   "section": "A",
   "text": "他の人への影響もあり、早く連絡しないわけにはいきません。",
   "start_sec": 54.641,
   "end_sec": 59.544
  },
  {
   "sentence_id": "C61-A003-S03",
   "section": "A",
   "text": "3日までに同意を知らせてください。",
   "start_sec": 59.744,
   "end_sec": 62.324
  },
  {
   "sentence_id": "C61-A004-S01",
   "section": "A",
   "text": "残りの2人は仕事や家の事情で参加できません。",
   "start_sec": 62.774,
   "end_sec": 67.056
  },
  {
   "sentence_id": "C61-A004-S02",
   "section": "A",
   "text": "本でも一緒に勉強できるようにします。",
   "start_sec": 67.256,
   "end_sec": 70.461
  },
  {
   "sentence_id": "C61-A004-S03",
   "section": "A",
   "text": "学ぶ機会を閉ざすのは避けたいからです。",
   "start_sec": 70.661,
   "end_sec": 73.834
  },
  {
   "sentence_id": "C61-A004-S04",
   "section": "A",
   "text": "講座の見本は環境と生活のリスクを比べる表です。",
   "start_sec": 74.034,
   "end_sec": 78.588
  },
  {
   "sentence_id": "C61-A004-S05",
   "section": "A",
   "text": "対策も読み、14日に全員で判断しましょう。",
   "start_sec": 78.788,
   "end_sec": 82.981
  }
 ]
}
