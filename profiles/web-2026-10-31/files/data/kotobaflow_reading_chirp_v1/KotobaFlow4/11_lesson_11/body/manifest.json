{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 143.114,
 "source_chapter": 67,
 "sentence_intervals": [
  {
   "sentence_id": "C67-A001-S01",
   "section": "A",
   "text": "二十三日午後二時六分、緑町図書館で停電が発生した。",
   "start_sec": 0.0,
   "end_sec": 6.397
  },
  {
   "sentence_id": "C67-A001-S02",
   "section": "A",
   "text": "館内の照明が消え、貸出用の設備とパソコンが停止した。",
   "start_sec": 6.597,
   "end_sec": 11.552
  },
  {
   "sentence_id": "C67-A001-S03",
   "section": "A",
   "text": "図書館によると、けがをした人はいなかったということだ。",
   "start_sec": 11.752,
   "end_sec": 15.881
  },
  {
   "sentence_id": "C67-A001-S04",
   "section": "A",
   "text": "電気は十二分後に復旧したが、貸出とパソコンの利用が同時に再開したわけではない。",
   "start_sec": 16.081,
   "end_sec": 23.312
  },
  {
   "sentence_id": "C67-A002-S01",
   "section": "A",
   "text": "その時、林梅さんは窓の近くの席で本を読み始めるところだった。",
   "start_sec": 23.762,
   "end_sec": 30.775
  },
  {
   "sentence_id": "C67-A002-S02",
   "section": "A",
   "text": "「本を開いたとたん、突然暗くなりました」と話す。",
   "start_sec": 30.975,
   "end_sec": 34.929
  },
  {
   "sentence_id": "C67-A002-S03",
   "section": "A",
   "text": "受付では、職員が貸出方法を説明している最中に、画面が消えた。",
   "start_sec": 35.129,
   "end_sec": 42.174
  },
  {
   "sentence_id": "C67-A002-S04",
   "section": "A",
   "text": "別の利用者からは「照明が一度明るくなったかと思うと、すぐに消えた」という証言もあった。",
   "start_sec": 42.374,
   "end_sec": 49.761
  },
  {
   "sentence_id": "C67-A003-S01",
   "section": "A",
   "text": "発生直後、職員は窓の近くへ利用者を案内した。",
   "start_sec": 50.211,
   "end_sec": 55.233
  },
  {
   "sentence_id": "C67-A003-S02",
   "section": "A",
   "text": "林さんは覚えているうちに、見たことを手帳に書いた。",
   "start_sec": 55.433,
   "end_sec": 59.733
  },
  {
   "sentence_id": "C67-A003-S03",
   "section": "A",
   "text": "しかし、停電の瞬間には時計を見ていなかったため、「二時前後」と記録した。",
   "start_sec": 59.933,
   "end_sec": 65.922
  },
  {
   "sentence_id": "C67-A003-S04",
   "section": "A",
   "text": "後で図書館の発表を見て正確な時刻を確認した。",
   "start_sec": 66.122,
   "end_sec": 70.886
  },
  {
   "sentence_id": "C67-A003-S05",
   "section": "A",
   "text": "記録を読み比べているうちに、確かな時刻と推測の違いが見えてきた。",
   "start_sec": 71.086,
   "end_sec": 76.968
  },
  {
   "sentence_id": "C67-A004-S01",
   "section": "A",
   "text": "午後二時十八分に照明が戻り、職員は設備の状態を調べ始めた。",
   "start_sec": 77.418,
   "end_sec": 83.351
  },
  {
   "sentence_id": "C67-A004-S02",
   "section": "A",
   "text": "貸出は二時三十五分、パソコンの利用は三時十分に再開した。",
   "start_sec": 83.551,
   "end_sec": 89.244
  },
  {
   "sentence_id": "C67-A004-S03",
   "section": "A",
   "text": "途中まで書いた文章を保存できないまま帰った人もいた。",
   "start_sec": 89.444,
   "end_sec": 94.118
  },
  {
   "sentence_id": "C67-A004-S04",
   "section": "A",
   "text": "その文章が残っているかどうかは、まだ確認中だ。",
   "start_sec": 94.318,
   "end_sec": 98.742
  },
  {
   "sentence_id": "C67-A005-S01",
   "section": "A",
   "text": "最初の速報は、復旧の時刻を貸出とパソコンの利用の再開時刻として伝えた。",
   "start_sec": 99.192,
   "end_sec": 106.516
  },
  {
   "sentence_id": "C67-A005-S02",
   "section": "A",
   "text": "午後四時の続報でこの情報を訂正した。",
   "start_sec": 106.716,
   "end_sec": 110.599
  },
  {
   "sentence_id": "C67-A005-S03",
   "section": "A",
   "text": "停電の原因は調査中で、図書館は結果が分かり次第、発表するということだ。",
   "start_sec": 110.799,
   "end_sec": 118.05
  },
  {
   "sentence_id": "C67-A005-S04",
   "section": "A",
   "text": "現場の証言から経過の一部は分かるものの、それだけで原因まで判断することはできない。",
   "start_sec": 118.25,
   "end_sec": 125.923
  },
  {
   "sentence_id": "C67-A006-S01",
   "section": "A",
   "text": "停電の直前の混雑についても調べている。",
   "start_sec": 126.373,
   "end_sec": 129.8
  },
  {
   "sentence_id": "C67-A006-S02",
   "section": "A",
   "text": "入口には物が接触した跡があったが、その場面を目撃した人はまだ見つかっていない。",
   "start_sec": 130.0,
   "end_sec": 137.674
  },
  {
   "sentence_id": "C67-A006-S03",
   "section": "A",
   "text": "荷物の行方を尋ねる利用者もいて、職員が確認を続けている。",
   "start_sec": 137.874,
   "end_sec": 143.108
  }
 ]
}
