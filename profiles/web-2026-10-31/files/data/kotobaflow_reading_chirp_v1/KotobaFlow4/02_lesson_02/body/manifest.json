{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 111.449,
 "source_chapter": 58,
 "sentence_intervals": [
  {
   "sentence_id": "C58-A001-S01",
   "section": "A",
   "text": "この図書館のサイトでは、ウェブで公開された膨大な文献を居ながらにして検索できます。",
   "start_sec": 0.0,
   "end_sec": 7.058
  },
  {
   "sentence_id": "C58-A001-S02",
   "section": "A",
   "text": "しかし、検索結果の上にある情報が正確だとは言えません。",
   "start_sec": 7.258,
   "end_sec": 12.149
  },
  {
   "sentence_id": "C58-A001-S03",
   "section": "A",
   "text": "匿名の投稿や広告には偏りもあります。",
   "start_sec": 12.349,
   "end_sec": 16.237
  },
  {
   "sentence_id": "C58-A001-S04",
   "section": "A",
   "text": "学者の名前があっても、出典と引用の範囲を確かめなければ、信頼できるとは思えません。",
   "start_sec": 16.437,
   "end_sec": 23.51
  },
  {
   "sentence_id": "C58-A001-S05",
   "section": "A",
   "text": "情報量より、判断の根拠に目を向けましょう。",
   "start_sec": 23.71,
   "end_sec": 27.691
  },
  {
   "sentence_id": "C58-A002-S01",
   "section": "A",
   "text": "緑町図書館では、古い音声資料をデジタル・メディアに置き換える作業を始めました。",
   "start_sec": 28.141,
   "end_sec": 35.346
  },
  {
   "sentence_id": "C58-A002-S02",
   "section": "A",
   "text": "カセットなどのアナログ・メディアは、再生を繰り返すと傷むことがあります。",
   "start_sec": 35.546,
   "end_sec": 41.412
  },
  {
   "sentence_id": "C58-A002-S03",
   "section": "A",
   "text": "デジタル化で持ち運ぶ負担は減りますが、必ず高音質になるわけではありません。",
   "start_sec": 41.612,
   "end_sec": 47.923
  },
  {
   "sentence_id": "C58-A002-S04",
   "section": "A",
   "text": "元の録音をもとにしたコピーだからです。",
   "start_sec": 48.123,
   "end_sec": 51.647
  },
  {
   "sentence_id": "C58-A002-S05",
   "section": "A",
   "text": "機械の性能と、内容の価値は別の問題です。",
   "start_sec": 51.847,
   "end_sec": 56.12
  },
  {
   "sentence_id": "C58-A003-S01",
   "section": "A",
   "text": "公開にあたって、製作者の許可と著作権を確認しました。",
   "start_sec": 56.57,
   "end_sec": 61.387
  },
  {
   "sentence_id": "C58-A003-S02",
   "section": "A",
   "text": "動画に人の顔が映る場合は肖像権にも注意します。",
   "start_sec": 61.587,
   "end_sec": 66.141
  },
  {
   "sentence_id": "C58-A003-S03",
   "section": "A",
   "text": "内容を加工して発信する前に、原資料と比べた上で検証します。",
   "start_sec": 66.341,
   "end_sec": 71.614
  },
  {
   "sentence_id": "C58-A003-S04",
   "section": "A",
   "text": "古い月刊誌の付録を聞くと、当時はテレビとうからの電波が話題だったことが分かります。",
   "start_sec": 71.814,
   "end_sec": 78.626
  },
  {
   "sentence_id": "C58-A003-S05",
   "section": "A",
   "text": "今の通信衛星の記事とは、対象も年代も違います。",
   "start_sec": 78.826,
   "end_sec": 84.019
  },
  {
   "sentence_id": "C58-A004-S01",
   "section": "A",
   "text": "一口に便利なツールといっても、携帯性を重視する人と、ビジュアルな説明を求める人では選択が違います。",
   "start_sec": 84.469,
   "end_sec": 93.162
  },
  {
   "sentence_id": "C58-A004-S02",
   "section": "A",
   "text": "総じて、デジタル資料は探しやすいと言えますが、非公開の資料もあります。",
   "start_sec": 93.362,
   "end_sec": 98.936
  },
  {
   "sentence_id": "C58-A004-S03",
   "section": "A",
   "text": "確実な判断には、管理方法の確認が欠かせません。",
   "start_sec": 99.136,
   "end_sec": 103.449
  },
  {
   "sentence_id": "C58-A004-S04",
   "section": "A",
   "text": "記録の上では作業が終わっていても、音が欠けていないかは聞いて確かめる必要があります。",
   "start_sec": 103.649,
   "end_sec": 111.442
  }
 ]
}
