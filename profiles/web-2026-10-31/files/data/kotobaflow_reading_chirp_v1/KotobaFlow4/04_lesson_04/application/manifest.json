{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 171.607,
 "source_chapter": 60,
 "sentence_intervals": [
  {
   "sentence_id": "C60-B001-S01",
   "section": "B",
   "text": "以下は架空の案内です。",
   "start_sec": 0.0,
   "end_sec": 2.532
  },
  {
   "sentence_id": "C60-B001-S02",
   "section": "B",
   "text": "料金だけでなく利用条件も確認してください。",
   "start_sec": 2.732,
   "end_sec": 6.539
  },
  {
   "sentence_id": "C60-B002-S01",
   "section": "B",
   "text": "緑町公民館の表計算講座：1月9・16・23・30日（土）10～12時、2階。",
   "start_sec": 6.989,
   "end_sec": 19.706
  },
  {
   "sentence_id": "C60-B002-S02",
   "section": "B",
   "text": "町内に住む・働く・学ぶ方が対象で、それ以外は対象外。",
   "start_sec": 19.906,
   "end_sec": 25.932
  },
  {
   "sentence_id": "C60-B002-S03",
   "section": "B",
   "text": "定員20人、申込順です。",
   "start_sec": 26.132,
   "end_sec": 29.175
  },
  {
   "sentence_id": "C60-B003-S01",
   "section": "B",
   "text": "4回で一人1,500円、教材込みです。",
   "start_sec": 29.625,
   "end_sec": 34.425
  },
  {
   "sentence_id": "C60-B003-S02",
   "section": "B",
   "text": "貸出パソコンは15台のみ。",
   "start_sec": 34.625,
   "end_sec": 37.198
  },
  {
   "sentence_id": "C60-B003-S03",
   "section": "B",
   "text": "持参可。",
   "start_sec": 37.398,
   "end_sec": 38.292
  },
  {
   "sentence_id": "C60-B003-S04",
   "section": "B",
   "text": "教材は在庫がある場合、一冊500円で追加購入できます。",
   "start_sec": 38.492,
   "end_sec": 44.422
  },
  {
   "sentence_id": "C60-B004-S01",
   "section": "B",
   "text": "申込期限は12月15日。",
   "start_sec": 44.872,
   "end_sec": 48.269
  },
  {
   "sentence_id": "C60-B004-S02",
   "section": "B",
   "text": "窓口か電話で全員の名前をお伝えください。",
   "start_sec": 48.469,
   "end_sec": 52.324
  },
  {
   "sentence_id": "C60-B005-S01",
   "section": "B",
   "text": "「まなびのまど」：団体の人数は下限5人、上限10人で、月6,000円です。",
   "start_sec": 52.774,
   "end_sec": 60.255
  },
  {
   "sentence_id": "C60-B005-S02",
   "section": "B",
   "text": "代表者の会員登録が必要です。",
   "start_sec": 60.455,
   "end_sec": 63.621
  },
  {
   "sentence_id": "C60-B006-S01",
   "section": "B",
   "text": "12月20日までに申し込む初回利用の団体に限り、初月無料。",
   "start_sec": 64.071,
   "end_sec": 69.91
  },
  {
   "sentence_id": "C60-B006-S02",
   "section": "B",
   "text": "例外はありません。",
   "start_sec": 70.11,
   "end_sec": 71.643
  },
  {
   "sentence_id": "C60-B006-S03",
   "section": "B",
   "text": "翌月1日開始。",
   "start_sec": 71.843,
   "end_sec": 73.276
  },
  {
   "sentence_id": "C60-B007-S01",
   "section": "B",
   "text": "質問は別料金で一回500円の有料サービスです。",
   "start_sec": 73.726,
   "end_sec": 78.565
  },
  {
   "sentence_id": "C60-B007-S02",
   "section": "B",
   "text": "年間申込は一割引です。",
   "start_sec": 78.765,
   "end_sec": 81.467
  },
  {
   "sentence_id": "C60-B007-S03",
   "section": "B",
   "text": "動画の視聴時間は制限なしです。",
   "start_sec": 81.667,
   "end_sec": 84.777
  },
  {
   "sentence_id": "C60-B008-S01",
   "section": "B",
   "text": "林のメモ：1～3月は特典ありで12,000円、なしで18,000円。",
   "start_sec": 85.227,
   "end_sec": 92.975
  },
  {
   "sentence_id": "C60-B008-S02",
   "section": "B",
   "text": "会社の初回資格と支払いの許可は未確認です。",
   "start_sec": 93.175,
   "end_sec": 96.888
  },
  {
   "sentence_id": "C60-B008-S03",
   "section": "B",
   "text": "年間申込は考えません。",
   "start_sec": 97.088,
   "end_sec": 99.362
  },
  {
   "sentence_id": "C60-B009-S01",
   "section": "B",
   "text": "地域衣料室からのお願い：洋服をはじめ、着物も再利用しています。",
   "start_sec": 99.812,
   "end_sec": 105.792
  },
  {
   "sentence_id": "C60-B009-S02",
   "section": "B",
   "text": "婦人服と婦人バッグの寄付が増え、衣服の保管場所が足りません。",
   "start_sec": 105.992,
   "end_sec": 111.125
  },
  {
   "sentence_id": "C60-B009-S03",
   "section": "B",
   "text": "毛皮は手入れの費用が高いため、現在は受け付けていません。",
   "start_sec": 111.325,
   "end_sec": 116.414
  },
  {
   "sentence_id": "C60-B009-S04",
   "section": "B",
   "text": "送る前に写真で相談してください。",
   "start_sec": 116.614,
   "end_sec": 119.607
  },
  {
   "sentence_id": "C60-B010-S01",
   "section": "B",
   "text": "布地の傷みも確認します。",
   "start_sec": 120.057,
   "end_sec": 122.331
  },
  {
   "sentence_id": "C60-B010-S02",
   "section": "B",
   "text": "絹の振袖は袖に穴があっても、帯や小物に作り直せる場合があります。",
   "start_sec": 122.531,
   "end_sec": 129.181
  },
  {
   "sentence_id": "C60-B010-S03",
   "section": "B",
   "text": "金糸や銀糸を使った部分は別に残します。",
   "start_sec": 129.381,
   "end_sec": 132.674
  },
  {
   "sentence_id": "C60-B010-S04",
   "section": "B",
   "text": "紫の羽織も、裏の布が使えます。",
   "start_sec": 132.874,
   "end_sec": 136.445
  },
  {
   "sentence_id": "C60-B010-S05",
   "section": "B",
   "text": "浴衣に使う木綿地は、手ぬぐいにすると洗いやすくなります。",
   "start_sec": 136.644,
   "end_sec": 141.584
  },
  {
   "sentence_id": "C60-B011-S01",
   "section": "B",
   "text": "体験会では着物姿の写真を撮れます。",
   "start_sec": 142.034,
   "end_sec": 145.748
  },
  {
   "sentence_id": "C60-B011-S02",
   "section": "B",
   "text": "袴と扇子も借りられますが、日本髪にするサービスはありません。",
   "start_sec": 145.948,
   "end_sec": 151.011
  },
  {
   "sentence_id": "C60-B011-S03",
   "section": "B",
   "text": "鬘の持込みは可能です。",
   "start_sec": 151.211,
   "end_sec": 153.304
  },
  {
   "sentence_id": "C60-B011-S04",
   "section": "B",
   "text": "服装だけじゃなくて、扱い方まで学べます。",
   "start_sec": 153.504,
   "end_sec": 156.798
  },
  {
   "sentence_id": "C60-B011-S05",
   "section": "B",
   "text": "布は一反全部でなく、必要な量だけ持参してください。",
   "start_sec": 156.998,
   "end_sec": 161.765
  },
  {
   "sentence_id": "C60-B012-S01",
   "section": "B",
   "text": "品物の価値は古さだけでは分かりません。",
   "start_sec": 162.215,
   "end_sec": 165.587
  },
  {
   "sentence_id": "C60-B012-S02",
   "section": "B",
   "text": "処分を急がず、使える物を捨てるのはもったいないと感じたら、まず相談を。",
   "start_sec": 165.787,
   "end_sec": 171.601
  }
 ]
}
