 "duration_sec": 56.241,
 "source_chapter": 74,
 "sentence_intervals": [
  {
   "sentence_id": "C74-A001-01",
   "section": "A",
   "text": "林梅とハサンは、佐藤の司会で交換会について議論した。",
   "start_sec": 0.0,
   "end_sec": 5.204
  },
  {
   "sentence_id": "C74-A001-02",
   "section": "A",
   "text": "六か月の計画の最初の活動だが、日程は未定だ。",
   "start_sec": 5.404,
   "end_sec": 10.437
  },
  {
   "sentence_id": "C74-A001-03",
   "section": "A",
   "text": "今回は古い道具と年中行事を紹介する展示も話題になった。",
   "start_sec": 10.637,
   "end_sec": 15.851
  },
  {
   "sentence_id": "C74-A001-04",
   "section": "A",
   "text": "伝統を伝えるという提案に賛成しても、すべての行事を実演することへの賛成とは限らない。",
   "start_sec": 16.051,
   "end_sec": 23.364
  },
  {
   "sentence_id": "C74-A001-05",
   "section": "A",
   "text": "佐藤は発言の意図を確かめ、反対の理由にも耳を傾けた。",
   "start_sec": 23.564,
   "end_sec": 28.822
  },
  {
   "sentence_id": "C74-A002-01",
   "section": "A",
   "text": "補足や言い直した部分も記録すると、意見が変わった経緯が分かる。",
   "start_sec": 29.272,
   "end_sec": 34.426
  },
  {
   "sentence_id": "C74-A002-02",
   "section": "A",
   "text": "聞き取れなかったところは聞き返す。",
   "start_sec": 34.626,
   "end_sec": 37.483
  },
  {
   "sentence_id": "C74-A002-03",
   "section": "A",
   "text": "最終確認では、提案と合意の相違に注意した。",
   "start_sec": 37.683,
   "end_sec": 42.216
  },
  {
   "sentence_id": "C74-A002-04",
   "section": "A",
   "text": "三人のコンセンサスは、案Ｂの条件を先に調べることだった。",
   "start_sec": 42.416,
   "end_sec": 47.608
  },
  {
   "sentence_id": "C74-A002-05",
   "section": "A",
   "text": "展示も暫定案であり、予約はまだだ。",
   "start_sec": 47.808,
   "end_sec": 51.317
  },
  {
   "sentence_id": "C74-A002-06",
   "section": "A",
   "text": "各自の役割と未確認の要望を分けて記録した。",
   "start_sec": 51.517,
   "end_sec": 56.235
  }
 ]
}
