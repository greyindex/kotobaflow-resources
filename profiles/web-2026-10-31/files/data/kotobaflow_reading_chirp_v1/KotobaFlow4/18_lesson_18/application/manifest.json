{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 166.074,
 "source_chapter": 74,
 "sentence_intervals": [
  {
   "sentence_id": "C74-B001-01",
   "section": "B",
   "text": "【教材用の架空資料一・会場比較】計画は六か月。",
   "start_sec": 0.0,
   "end_sec": 5.667
  },
  {
   "sentence_id": "C74-B001-02",
   "section": "B",
   "text": "週二回以上、月総額六万円以内、段差のない経路が条件です。",
   "start_sec": 5.867,
   "end_sec": 12.22
  },
  {
   "sentence_id": "C74-B001-03",
   "section": "B",
   "text": "案Ａは駅近くの固定の部屋で週三回、家賃だけで月六万円。",
   "start_sec": 12.42,
   "end_sec": 18.893
  },
  {
   "sentence_id": "C74-B001-04",
   "section": "B",
   "text": "設備の追加料金と経路は未確認です。",
   "start_sec": 19.093,
   "end_sec": 22.386
  },
  {
   "sentence_id": "C74-B001-05",
   "section": "B",
   "text": "案Ｂは公共施設で週二回、月の会場費三万円と設備費の見積もり五千円で計三万五千円。",
   "start_sec": 22.586,
   "end_sec": 31.4
  },
  {
   "sentence_id": "C74-B001-06",
   "section": "B",
   "text": "差額二万五千円は自由に使える額ではなく、他の必要経費も調べます。",
   "start_sec": 31.6,
   "end_sec": 38.477
  },
  {
   "sentence_id": "C74-B002-01",
   "section": "B",
   "text": "Ｂは会場が毎月変わる可能性があり、各経路、人数上限、備品の範囲、雨天の搬入、設営・撤去の時間と方法は未確認です。",
   "start_sec": 38.927,
   "end_sec": 52.809
  },
  {
   "sentence_id": "C74-B002-02",
   "section": "B",
   "text": "現利用者二十四人の自発的な調査では十四人が場所の固定、十人が低料金を優先しました。",
   "start_sec": 53.009,
   "end_sec": 62.482
  },
  {
   "sentence_id": "C74-B002-03",
   "section": "B",
   "text": "地域全体の意見でも会場の定員でもありません。",
   "start_sec": 62.682,
   "end_sec": 67.061
  },
  {
   "sentence_id": "C74-B002-04",
   "section": "B",
   "text": "三か月目の末に参加状況と負担を調べ、後半を調整します。",
   "start_sec": 67.261,
   "end_sec": 72.936
  },
  {
   "sentence_id": "C74-B002-05",
   "section": "B",
   "text": "改善の実績はまだありません。",
   "start_sec": 73.136,
   "end_sec": 75.53
  },
  {
   "sentence_id": "C74-B003-01",
   "section": "B",
   "text": "【資料二・展示の提案】交換する物に思い出のカードを添え、写真で季節をたどります。",
   "start_sec": 75.98,
   "end_sec": 84.273
  },
  {
   "sentence_id": "C74-B003-02",
   "section": "B",
   "text": "最初の応募者は、大みそかの年越しそばと、除夜の鐘を聞いた思い出を書きました。",
   "start_sec": 84.473,
   "end_sec": 91.066
  },
  {
   "sentence_id": "C74-B003-03",
   "section": "B",
   "text": "元旦の朝の雑煮やおせち料理の写真には、家ごとに違う味の説明があります。",
   "start_sec": 91.266,
   "end_sec": 98.515
  },
  {
   "sentence_id": "C74-B003-04",
   "section": "B",
   "text": "年賀状は住所を隠して展示します。",
   "start_sec": 98.715,
   "end_sec": 102.099
  },
  {
   "sentence_id": "C74-B003-05",
   "section": "B",
   "text": "新年に寺や神社へ初詣に行く写真もありますが、参拝は参加条件ではありません。",
   "start_sec": 102.299,
   "end_sec": 110.273
  },
  {
   "sentence_id": "C74-B004-01",
   "section": "B",
   "text": "春の棚には、ひな祭りのひな人形の写真と、花見で使った弁当箱を置く案です。",
   "start_sec": 110.723,
   "end_sec": 117.941
  },
  {
   "sentence_id": "C74-B004-02",
   "section": "B",
   "text": "鯉幟は大きいので写真にします。",
   "start_sec": 118.141,
   "end_sec": 121.553
  },
  {
   "sentence_id": "C74-B004-03",
   "section": "B",
   "text": "七夕の飾りや月見の器は、持ち主が由来を説明します。",
   "start_sec": 121.753,
   "end_sec": 126.935
  },
  {
   "sentence_id": "C74-B004-04",
   "section": "B",
   "text": "お中元とお歳暮の空き箱も再利用できますが、贈り物を求める企画ではありません。",
   "start_sec": 127.135,
   "end_sec": 133.917
  },
  {
   "sentence_id": "C74-B004-05",
   "section": "B",
   "text": "クリスマスイブの写真には十二月二十四日、クリスマスの写真には二十五日と書き、日付の混同を防ぎます。",
   "start_sec": 134.117,
   "end_sec": 143.814
  },
  {
   "sentence_id": "C74-B005-01",
   "section": "B",
   "text": "春節を旧正月とも呼ぶ応募者は、爆竹の音が苦手な家族の話も添えました。",
   "start_sec": 144.264,
   "end_sec": 151.817
  },
  {
   "sentence_id": "C74-B005-02",
   "section": "B",
   "text": "祭りの楽しさだけでなく、音への配慮も伝える展示です。",
   "start_sec": 152.017,
   "end_sec": 156.688
  },
  {
   "sentence_id": "C74-B005-03",
   "section": "B",
   "text": "メーデーの行進や大学祭の模擬店の写真は、個人が分からないものを選びます。",
   "start_sec": 156.888,
   "end_sec": 162.857
  },
  {
   "sentence_id": "C74-B005-04",
   "section": "B",
   "text": "掲載の許可はこれから確認します。",
   "start_sec": 163.057,
   "end_sec": 166.067
  }
 ]
}
