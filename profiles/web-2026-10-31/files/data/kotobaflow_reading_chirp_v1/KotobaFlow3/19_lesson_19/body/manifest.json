{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 108.504,
 "source_chapter": 55,
 "sentence_intervals": [
  {
   "sentence_id": "C55-A001-1",
   "section": "A",
   "text": "ミンはアナ、佐藤と、授業用に作られた学習室の調査資料を読んだ。",
   "start_sec": 0.0,
   "end_sec": 6.577
  },
  {
   "sentence_id": "C55-A001-2",
   "section": "A",
   "text": "名前は書かれていない。",
   "start_sec": 6.777,
   "end_sec": 8.501
  },
  {
   "sentence_id": "C55-A001-3",
   "section": "A",
   "text": "本当の施設の調査ではない。",
   "start_sec": 8.701,
   "end_sec": 10.854
  },
  {
   "sentence_id": "C55-A001-4",
   "section": "A",
   "text": "一週間だけ使える時間を長くした試行で、前の基準週も試行週も、自分の意思で参加した同じ二十人が対象だった。",
   "start_sec": 11.054,
   "end_sec": 20.528
  },
  {
   "sentence_id": "C55-A001-5",
   "section": "A",
   "text": "三人は説明に従って、数値を比べる方法を確認した。",
   "start_sec": 20.728,
   "end_sec": 25.997
  },
  {
   "sentence_id": "C55-A002-1",
   "section": "A",
   "text": "週三日以上使った人は八人から十二人になった。",
   "start_sec": 26.447,
   "end_sec": 31.105
  },
  {
   "sentence_id": "C55-A002-2",
   "section": "A",
   "text": "割合は四〇パーセントから六〇パーセントになったわけだ。",
   "start_sec": 31.305,
   "end_sec": 36.134
  },
  {
   "sentence_id": "C55-A002-3",
   "section": "A",
   "text": "差は二〇ポイント、元の割合に比べて五〇パーセントの増加で、一・五倍である。",
   "start_sec": 36.334,
   "end_sec": 43.457
  },
  {
   "sentence_id": "C55-A002-4",
   "section": "A",
   "text": "同じ変化でも説明の方法によって印象が違う。",
   "start_sec": 43.657,
   "end_sec": 48.34
  },
  {
   "sentence_id": "C55-A002-5",
   "section": "A",
   "text": "ミンは、人数と割合を別々に書いて誤解を防ごうと考えた。",
   "start_sec": 48.54,
   "end_sec": 54.358
  },
  {
   "sentence_id": "C55-A003-1",
   "section": "A",
   "text": "しかし、試行週の平均使用時間は不明だった。",
   "start_sec": 54.808,
   "end_sec": 59.208
  },
  {
   "sentence_id": "C55-A003-2",
   "section": "A",
   "text": "使った日が増えても、一回の時間が長くなったと判断できるわけではない。",
   "start_sec": 59.408,
   "end_sec": 65.087
  },
  {
   "sentence_id": "C55-A003-3",
   "section": "A",
   "text": "また、時間を長くしたおかげで人数が増えた、と原因まで判断する根拠もない。",
   "start_sec": 65.287,
   "end_sec": 71.784
  },
  {
   "sentence_id": "C55-A003-4",
   "section": "A",
   "text": "三人は数値を確かめた上で、分からないことを記録した。",
   "start_sec": 71.984,
   "end_sec": 76.682
  },
  {
   "sentence_id": "C55-A004-1",
   "section": "A",
   "text": "アナは長期の変更に期待していた。",
   "start_sec": 77.132,
   "end_sec": 80.467
  },
  {
   "sentence_id": "C55-A004-2",
   "section": "A",
   "text": "佐藤は安全を判断の基準にするべきだと言った。",
   "start_sec": 80.667,
   "end_sec": 84.868
  },
  {
   "sentence_id": "C55-A004-3",
   "section": "A",
   "text": "意見が違っても、説明を聞かずに決めてはいけない。",
   "start_sec": 85.068,
   "end_sec": 88.961
  },
  {
   "sentence_id": "C55-A004-4",
   "section": "A",
   "text": "三人は、参加しなかった人の希望と、担当者の人数、予算を確認することに合意した。",
   "start_sec": 89.161,
   "end_sec": 96.8
  },
  {
   "sentence_id": "C55-A004-5",
   "section": "A",
   "text": "問題を解決するために相談を続けるが、長期の変更はまだ決めていない。",
   "start_sec": 97.0,
   "end_sec": 102.691
  },
  {
   "sentence_id": "C55-A004-6",
   "section": "A",
   "text": "ミンは、合意した点と残った問題が分かるように記録を分けた。",
   "start_sec": 102.891,
   "end_sec": 108.497
  }
 ]
}
