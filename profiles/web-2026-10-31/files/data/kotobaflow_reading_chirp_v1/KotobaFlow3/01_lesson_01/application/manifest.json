{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 187.33,
 "source_chapter": 37,
 "sentence_intervals": [
  {
   "sentence_id": "C37-B001-S01",
   "section": "B",
   "text": "十月二日（金）、写真の会は十八時から二十一時まで。",
   "start_sec": 0.0,
   "end_sec": 5.933
  },
  {
   "sentence_id": "C37-B001-S02",
   "section": "B",
   "text": "原が二十時五十分に記録し、五十五分に写真を二枚撮りました。",
   "start_sec": 6.133,
   "end_sec": 11.853
  },
  {
   "sentence_id": "C37-B001-S03",
   "section": "B",
   "text": "窓を閉め、電気を消しました。",
   "start_sec": 12.053,
   "end_sec": 14.507
  },
  {
   "sentence_id": "C37-B001-S04",
   "section": "B",
   "text": "壁に写真が二枚掛けてあります。",
   "start_sec": 14.707,
   "end_sec": 17.285
  },
  {
   "sentence_id": "C37-B001-S05",
   "section": "B",
   "text": "日曜日の予定を白板に残してあります。",
   "start_sec": 17.485,
   "end_sec": 20.838
  },
  {
   "sentence_id": "C37-B001-S06",
   "section": "B",
   "text": "電源は切りましたが、プロジェクターのランプはついています。",
   "start_sec": 21.038,
   "end_sec": 25.149
  },
  {
   "sentence_id": "C37-B001-S07",
   "section": "B",
   "text": "これは正常で、故障ではありません。",
   "start_sec": 25.349,
   "end_sec": 28.162
  },
  {
   "sentence_id": "C37-B002-S01",
   "section": "B",
   "text": "展示のテーマは「町と暮らし」です。",
   "start_sec": 28.612,
   "end_sec": 31.534
  },
  {
   "sentence_id": "C37-B002-S02",
   "section": "B",
   "text": "市の西部に建つ家を撮りました。",
   "start_sec": 31.734,
   "end_sec": 34.608
  },
  {
   "sentence_id": "C37-B002-S03",
   "section": "B",
   "text": "一軒の家を木が取り囲んでいます。",
   "start_sec": 34.808,
   "end_sec": 37.949
  },
  {
   "sentence_id": "C37-B002-S04",
   "section": "B",
   "text": "深い池を囲む道を車が走っています。",
   "start_sec": 38.149,
   "end_sec": 41.863
  },
  {
   "sentence_id": "C37-B002-S05",
   "section": "B",
   "text": "写真の上下を確認し、裏に番号を付けました。",
   "start_sec": 42.063,
   "end_sec": 46.294
  },
  {
   "sentence_id": "C37-B002-S06",
   "section": "B",
   "text": "実物の道具も展示します。",
   "start_sec": 46.494,
   "end_sec": 48.879
  },
  {
   "sentence_id": "C37-B002-S07",
   "section": "B",
   "text": "小振りのグラスセットは一箱にまとめ、布を敷き詰めた箱に入れました。",
   "start_sec": 49.079,
   "end_sec": 54.833
  },
  {
   "sentence_id": "C37-B002-S08",
   "section": "B",
   "text": "割れやすいので、上に物を重ねないでください。",
   "start_sec": 55.033,
   "end_sec": 58.626
  },
  {
   "sentence_id": "C37-B003-S01",
   "section": "B",
   "text": "十月三日（土）、八時五十五分、アナが記録。",
   "start_sec": 59.076,
   "end_sec": 64.403
  },
  {
   "sentence_id": "C37-B003-S02",
   "section": "B",
   "text": "右の窓は開き、左は閉まっています。",
   "start_sec": 64.603,
   "end_sec": 68.616
  },
  {
   "sentence_id": "C37-B003-S03",
   "section": "B",
   "text": "窓がガタガタ鳴り、机の上の紙が動いています。",
   "start_sec": 68.816,
   "end_sec": 72.77
  },
  {
   "sentence_id": "C37-B003-S04",
   "section": "B",
   "text": "写真が一枚掛かり、片方のフレームは床で破損しています。",
   "start_sec": 72.97,
   "end_sec": 78.257
  },
  {
   "sentence_id": "C37-B003-S05",
   "section": "B",
   "text": "壇の外側にも水が溜まり、缶が転がっています。",
   "start_sec": 78.457,
   "end_sec": 83.251
  },
  {
   "sentence_id": "C37-B003-S06",
   "section": "B",
   "text": "瓶は空です。",
   "start_sec": 83.451,
   "end_sec": 85.465
  },
  {
   "sentence_id": "C37-B003-S07",
   "section": "B",
   "text": "布が床にへばりつき、端が黒ずんでいます。",
   "start_sec": 85.665,
   "end_sec": 89.484
  },
  {
   "sentence_id": "C37-B003-S08",
   "section": "B",
   "text": "水の原因はまだ不明です。",
   "start_sec": 89.684,
   "end_sec": 91.837
  },
  {
   "sentence_id": "C37-B004-S01",
   "section": "B",
   "text": "九時四十分、西田が確認。",
   "start_sec": 92.287,
   "end_sec": 94.861
  },
  {
   "sentence_id": "C37-B004-S02",
   "section": "B",
   "text": "窓は閉まり、目に見える異常はありません。",
   "start_sec": 95.061,
   "end_sec": 98.458
  },
  {
   "sentence_id": "C37-B004-S03",
   "section": "B",
   "text": "月曜日に設備の会社が点検します。",
   "start_sec": 98.658,
   "end_sec": 102.011
  },
  {
   "sentence_id": "C37-B004-S04",
   "section": "B",
   "text": "流しの管が詰まり、下から水が漏れています。",
   "start_sec": 102.211,
   "end_sec": 106.136
  },
  {
   "sentence_id": "C37-B004-S05",
   "section": "B",
   "text": "水は濁っています。",
   "start_sec": 106.336,
   "end_sec": 107.829
  },
  {
   "sentence_id": "C37-B004-S06",
   "section": "B",
   "text": "水を止め、道具を隣の一部屋に移しました。",
   "start_sec": 108.029,
   "end_sec": 112.145
  },
  {
   "sentence_id": "C37-B004-S07",
   "section": "B",
   "text": "濡れた箱は傷みやすいので、底を支えて箱ごと運びます。",
   "start_sec": 112.345,
   "end_sec": 118.072
  },
  {
   "sentence_id": "C37-B004-S08",
   "section": "B",
   "text": "古い布は洗った後で縮むことがあるので、先に大きさを測ります。",
   "start_sec": 118.272,
   "end_sec": 123.905
  },
  {
   "sentence_id": "C37-B004-S09",
   "section": "B",
   "text": "乾くまで展示に使いません。",
   "start_sec": 124.105,
   "end_sec": 126.559
  },
  {
   "sentence_id": "C37-B005-S01",
   "section": "B",
   "text": "道具の操作も確認しました。",
   "start_sec": 127.009,
   "end_sec": 129.282
  },
  {
   "sentence_id": "C37-B005-S02",
   "section": "B",
   "text": "模型の車は発条で走ります。",
   "start_sec": 129.482,
   "end_sec": 132.335
  },
  {
   "sentence_id": "C37-B005-S03",
   "section": "B",
   "text": "エンジンはありません。",
   "start_sec": 132.535,
   "end_sec": 134.328
  },
  {
   "sentence_id": "C37-B005-S04",
   "section": "B",
   "text": "ボディー後部のボタンを押したら、タイヤが回ります。",
   "start_sec": 134.528,
   "end_sec": 138.485
  },
  {
   "sentence_id": "C37-B005-S05",
   "section": "B",
   "text": "ブレーキの部分に不具合があり、止まりません。",
   "start_sec": 138.685,
   "end_sec": 142.348
  },
  {
   "sentence_id": "C37-B005-S06",
   "section": "B",
   "text": "無理に引いたら糸が切れます。",
   "start_sec": 142.548,
   "end_sec": 145.121
  },
  {
   "sentence_id": "C37-B005-S07",
   "section": "B",
   "text": "「取り出し」のボタンは別の録音機のものです。",
   "start_sec": 145.321,
   "end_sec": 148.794
  },
  {
   "sentence_id": "C37-B005-S08",
   "section": "B",
   "text": "機械を振らないで、担当に聞いてください。",
   "start_sec": 148.994,
   "end_sec": 152.443
  },
  {
   "sentence_id": "C37-B005-S09",
   "section": "B",
   "text": "入口のチャイムは自動、教室の照明は手動です。",
   "start_sec": 152.643,
   "end_sec": 157.196
  },
  {
   "sentence_id": "C37-B006-S01",
   "section": "B",
   "text": "原さんには九時十二分に連絡しました。",
   "start_sec": 157.646,
   "end_sec": 161.066
  },
  {
   "sentence_id": "C37-B006-S02",
   "section": "B",
   "text": "原さんは「帰る前に窓を閉めました」と言っています。",
   "start_sec": 161.266,
   "end_sec": 165.479
  },
  {
   "sentence_id": "C37-B006-S03",
   "section": "B",
   "text": "夜の記録は月曜日に調べます。",
   "start_sec": 165.679,
   "end_sec": 168.553
  },
  {
   "sentence_id": "C37-B006-S04",
   "section": "B",
   "text": "日曜日の十時に原さんと修理か交換かを相談します。",
   "start_sec": 168.753,
   "end_sec": 173.726
  },
  {
   "sentence_id": "C37-B006-S05",
   "section": "B",
   "text": "道具は向きをそろえ、記録は一冊にまとめます。",
   "start_sec": 173.926,
   "end_sec": 177.879
  },
  {
   "sentence_id": "C37-B006-S06",
   "section": "B",
   "text": "原因と責任は未確定です。",
   "start_sec": 178.079,
   "end_sec": 180.737
  },
  {
   "sentence_id": "C37-B006-S07",
   "section": "B",
   "text": "次の担当は、状態の記録と今後の予定を別々に読んでください。",
   "start_sec": 180.937,
   "end_sec": 187.323
  }
 ]
}
