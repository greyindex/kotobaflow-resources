{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 136.008,
 "source_chapter": 42,
 "sentence_intervals": [
  {
   "sentence_id": "C42-B001-S01",
   "section": "B",
   "text": "確認記録。",
   "start_sec": 0.0,
   "end_sec": 1.133
  },
  {
   "sentence_id": "C42-B001-S02",
   "section": "B",
   "text": "十一月一日十四時、西田。",
   "start_sec": 1.333,
   "end_sec": 4.087
  },
  {
   "sentence_id": "C42-B001-S03",
   "section": "B",
   "text": "十月三十一日九時半、原さんが二番のカメラを借りた。",
   "start_sec": 4.287,
   "end_sec": 9.161
  },
  {
   "sentence_id": "C42-B001-S04",
   "section": "B",
   "text": "村上さんの記録には「ふたが閉まる」と書いてある。",
   "start_sec": 9.361,
   "end_sec": 12.954
  },
  {
   "sentence_id": "C42-B001-S05",
   "section": "B",
   "text": "十六時五十分に原さんが返した。",
   "start_sec": 13.154,
   "end_sec": 16.392
  },
  {
   "sentence_id": "C42-B001-S06",
   "section": "B",
   "text": "村上さんはそのとき写真を撮っておいた。",
   "start_sec": 16.592,
   "end_sec": 20.126
  },
  {
   "sentence_id": "C42-B001-S07",
   "section": "B",
   "text": "写真ではかばんが閉まっていて、中は見えない。",
   "start_sec": 20.326,
   "end_sec": 23.919
  },
  {
   "sentence_id": "C42-B001-S08",
   "section": "B",
   "text": "ふたを確認した記録はない。",
   "start_sec": 24.119,
   "end_sec": 26.349
  },
  {
   "sentence_id": "C42-B002-S01",
   "section": "B",
   "text": "十一月一日十時、西田が点検した。",
   "start_sec": 26.799,
   "end_sec": 30.776
  },
  {
   "sentence_id": "C42-B002-S02",
   "section": "B",
   "text": "ふたが開いていて、電池が少し出ていた。",
   "start_sec": 30.976,
   "end_sec": 34.501
  },
  {
   "sentence_id": "C42-B002-S03",
   "section": "B",
   "text": "日付の設定は一月一日になっていた。",
   "start_sec": 34.701,
   "end_sec": 38.62
  },
  {
   "sentence_id": "C42-B002-S04",
   "section": "B",
   "text": "ふたを閉めても、軽く振るとまた開く。",
   "start_sec": 38.82,
   "end_sec": 42.055
  },
  {
   "sentence_id": "C42-B002-S05",
   "section": "B",
   "text": "ふたが壊れているようだ。",
   "start_sec": 42.255,
   "end_sec": 44.091
  },
  {
   "sentence_id": "C42-B002-S06",
   "section": "B",
   "text": "確認の準備をした。",
   "start_sec": 44.291,
   "end_sec": 46.085
  },
  {
   "sentence_id": "C42-B002-S07",
   "section": "B",
   "text": "前の日の写真をパソコンに保存しておいた。",
   "start_sec": 46.285,
   "end_sec": 49.722
  },
  {
   "sentence_id": "C42-B002-S08",
   "section": "B",
   "text": "最後の写真の日付と時間は十月三十一日十五時四十二分だった。",
   "start_sec": 49.922,
   "end_sec": 57.012
  },
  {
   "sentence_id": "C42-B003-S01",
   "section": "B",
   "text": "村上さんの十月三十一日十七時の伝言には「原さんの話では、カメラを落としたそうです」と書いてある。",
   "start_sec": 57.462,
   "end_sec": 65.737
  },
  {
   "sentence_id": "C42-B003-S02",
   "section": "B",
   "text": "十一月一日十二時半、原さんに確認した。",
   "start_sec": 65.937,
   "end_sec": 70.109
  },
  {
   "sentence_id": "C42-B003-S03",
   "section": "B",
   "text": "原さんによると、前の日の十五時ごろ、小川さんがうっかりカメラを落としたということだ。",
   "start_sec": 70.309,
   "end_sec": 77.31
  },
  {
   "sentence_id": "C42-B003-S04",
   "section": "B",
   "text": "カメラはかばんの中にあった。",
   "start_sec": 77.51,
   "end_sec": 80.028
  },
  {
   "sentence_id": "C42-B003-S05",
   "section": "B",
   "text": "その後も写真は撮れたそうだ。",
   "start_sec": 80.228,
   "end_sec": 82.655
  },
  {
   "sentence_id": "C42-B003-S06",
   "section": "B",
   "text": "十五時四十五分ごろ、小川さんが電池を取り替えた。",
   "start_sec": 82.855,
   "end_sec": 87.468
  },
  {
   "sentence_id": "C42-B003-S07",
   "section": "B",
   "text": "原さんは小川さんから「ふたは閉めたと思う」と聞いた。",
   "start_sec": 87.668,
   "end_sec": 92.2
  },
  {
   "sentence_id": "C42-B003-S08",
   "section": "B",
   "text": "これは小川さんからの情報の引用で、ふたを見て確認した事実ではない。",
   "start_sec": 92.4,
   "end_sec": 98.151
  },
  {
   "sentence_id": "C42-B004-S01",
   "section": "B",
   "text": "使用の案内によると、電池がない状態が十分続くと、日付は一月一日に戻る。",
   "start_sec": 98.601,
   "end_sec": 105.934
  },
  {
   "sentence_id": "C42-B004-S02",
   "section": "B",
   "text": "しかし、途中で設定を直したかどうかは未確認だ。",
   "start_sec": 106.134,
   "end_sec": 110.771
  },
  {
   "sentence_id": "C42-B004-S03",
   "section": "B",
   "text": "写真だけでは、電池が出た時間は判断できない。",
   "start_sec": 110.971,
   "end_sec": 114.998
  },
  {
   "sentence_id": "C42-B004-S04",
   "section": "B",
   "text": "落としたときに壊れたのかもしれない。",
   "start_sec": 115.198,
   "end_sec": 117.798
  },
  {
   "sentence_id": "C42-B004-S05",
   "section": "B",
   "text": "電池を取り替えたときかもしれない。",
   "start_sec": 117.998,
   "end_sec": 120.212
  },
  {
   "sentence_id": "C42-B004-S06",
   "section": "B",
   "text": "どちらも推測だ。",
   "start_sec": 120.412,
   "end_sec": 121.969
  },
  {
   "sentence_id": "C42-B004-S07",
   "section": "B",
   "text": "原因を判断する根拠はまだ足りない。",
   "start_sec": 122.169,
   "end_sec": 124.982
  },
  {
   "sentence_id": "C42-B004-S08",
   "section": "B",
   "text": "借りる前の状態も、詳しくはわからない。",
   "start_sec": 125.182,
   "end_sec": 128.355
  },
  {
   "sentence_id": "C42-B004-S09",
   "section": "B",
   "text": "今の情報では原因と責任は不明だ。",
   "start_sec": 128.555,
   "end_sec": 132.372
  },
  {
   "sentence_id": "C42-B004-S10",
   "section": "B",
   "text": "修理が終わるまで、このカメラは使わない。",
   "start_sec": 132.572,
   "end_sec": 136.002
  }
 ]
}
