{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 152.55,
 "source_chapter": 43,
 "sentence_intervals": [
  {
   "sentence_id": "C43-B001-S01",
   "section": "B",
   "text": "「ほんの森」の担当の方へ。",
   "start_sec": 0.0,
   "end_sec": 2.248
  },
  {
   "sentence_id": "C43-B001-S02",
   "section": "B",
   "text": "十一月四日に写真集『川のある町』を一冊注文したアナ・ロペスです。",
   "start_sec": 2.448,
   "end_sec": 9.531
  },
  {
   "sentence_id": "C43-B001-S03",
   "section": "B",
   "text": "番号は0715です。",
   "start_sec": 9.731,
   "end_sec": 12.305
  },
  {
   "sentence_id": "C43-B001-S04",
   "section": "B",
   "text": "差出人は「ほんの森」、受取人は「さくら荘203号室、アナ・ロペス」と箱に書いてあります。",
   "start_sec": 12.505,
   "end_sec": 20.778
  },
  {
   "sentence_id": "C43-B001-S05",
   "section": "B",
   "text": "注文した商品は届きましたが、配送と商品の状態に問題があります。",
   "start_sec": 20.978,
   "end_sec": 27.197
  },
  {
   "sentence_id": "C43-B002-S01",
   "section": "B",
   "text": "さくら配送が七日の午前中に手渡しで配達する予定でした。",
   "start_sec": 27.647,
   "end_sec": 32.615
  },
  {
   "sentence_id": "C43-B002-S02",
   "section": "B",
   "text": "九時から十二時まで家にいましたが、だれも来ませんでした。",
   "start_sec": 32.815,
   "end_sec": 36.968
  },
  {
   "sentence_id": "C43-B002-S03",
   "section": "B",
   "text": "十二時半に記録を見ると「十時十二分、郵便受けに入れました」とありました。",
   "start_sec": 37.168,
   "end_sec": 43.407
  },
  {
   "sentence_id": "C43-B002-S04",
   "section": "B",
   "text": "私の郵便受けは空でした。",
   "start_sec": 43.607,
   "end_sec": 45.64
  },
  {
   "sentence_id": "C43-B002-S05",
   "section": "B",
   "text": "十二時四十分に受付へ電話し、「確かめて連絡します」と言われましたが、今夜も連絡がありません。",
   "start_sec": 45.84,
   "end_sec": 53.574
  },
  {
   "sentence_id": "C43-B003-S01",
   "section": "B",
   "text": "十七時半、302号室の田中さんが届けてくれました。",
   "start_sec": 54.024,
   "end_sec": 58.577
  },
  {
   "sentence_id": "C43-B003-S02",
   "section": "B",
   "text": "田中さんの郵便受けに入っていたそうで、誤配だと思います。",
   "start_sec": 58.777,
   "end_sec": 63.21
  },
  {
   "sentence_id": "C43-B003-S03",
   "section": "B",
   "text": "田中さんも「知らない荷物を入れられて困りました」と話していました。",
   "start_sec": 63.41,
   "end_sec": 68.633
  },
  {
   "sentence_id": "C43-B003-S04",
   "section": "B",
   "text": "休みの邪魔をし、迷惑をかけてしまいました。",
   "start_sec": 68.833,
   "end_sec": 72.466
  },
  {
   "sentence_id": "C43-B003-S05",
   "section": "B",
   "text": "箱は濡れて壊れ、カバーも濡れて三センチほど破れています。",
   "start_sec": 72.666,
   "end_sec": 77.473
  },
  {
   "sentence_id": "C43-B003-S06",
   "section": "B",
   "text": "中は濡れていません。",
   "start_sec": 77.673,
   "end_sec": 79.685
  },
  {
   "sentence_id": "C43-B003-S07",
   "section": "B",
   "text": "写真を三枚送ります。",
   "start_sec": 79.885,
   "end_sec": 81.991
  },
  {
   "sentence_id": "C43-B003-S08",
   "section": "B",
   "text": "だれかが破ったのか、踏んだのかは見ていません。",
   "start_sec": 82.191,
   "end_sec": 86.107
  },
  {
   "sentence_id": "C43-B003-S09",
   "section": "B",
   "text": "どこでどう扱われたのか確認してください。",
   "start_sec": 86.307,
   "end_sec": 90.08
  },
  {
   "sentence_id": "C43-B004-S01",
   "section": "B",
   "text": "十三日に友達と読むので、十二日までに新しい本を受け取りたいです。",
   "start_sec": 90.53,
   "end_sec": 97.228
  },
  {
   "sentence_id": "C43-B004-S02",
   "section": "B",
   "text": "交換できなければ返品と返金をお願いします。",
   "start_sec": 97.428,
   "end_sec": 101.261
  },
  {
   "sentence_id": "C43-B004-S03",
   "section": "B",
   "text": "領収書は保管しています。",
   "start_sec": 101.461,
   "end_sec": 103.675
  },
  {
   "sentence_id": "C43-B004-S04",
   "section": "B",
   "text": "宅配のサービスを選んだのは、前に店へ行く途中でひどい目に遭ったからです。",
   "start_sec": 103.875,
   "end_sec": 110.048
  },
  {
   "sentence_id": "C43-B004-S05",
   "section": "B",
   "text": "駅前で泥棒らしい人がこっそり財布を掏り、すたすたと歩いて逃げ出しました。",
   "start_sec": 110.248,
   "end_sec": 116.347
  },
  {
   "sentence_id": "C43-B004-S06",
   "section": "B",
   "text": "「すりだ」と叫ぶ声で気づきましたが、私は追わないで、警察に連絡しました。",
   "start_sec": 116.547,
   "end_sec": 123.171
  },
  {
   "sentence_id": "C43-B004-S07",
   "section": "B",
   "text": "店の入口では人に押され、足を踏まれました。",
   "start_sec": 123.371,
   "end_sec": 127.264
  },
  {
   "sentence_id": "C43-B004-S08",
   "section": "B",
   "text": "今回は家で受け取りたいです。",
   "start_sec": 127.464,
   "end_sec": 130.217
  },
  {
   "sentence_id": "C43-B005-S01",
   "section": "B",
   "text": "交換するなら必ず手渡しにしてください。",
   "start_sec": 130.667,
   "end_sec": 133.721
  },
  {
   "sentence_id": "C43-B005-S02",
   "section": "B",
   "text": "月曜日から金曜日は十九時から家にいます。",
   "start_sec": 133.921,
   "end_sec": 137.934
  },
  {
   "sentence_id": "C43-B005-S03",
   "section": "B",
   "text": "破れた本をどうするかも教えてください。",
   "start_sec": 138.134,
   "end_sec": 141.307
  },
  {
   "sentence_id": "C43-B005-S04",
   "section": "B",
   "text": "文句を言うだけではなく、今後のトラブルを防ぎたいと思います。",
   "start_sec": 141.507,
   "end_sec": 146.061
  },
  {
   "sentence_id": "C43-B005-S05",
   "section": "B",
   "text": "原因がわかったらメールで知らせてください。",
   "start_sec": 146.261,
   "end_sec": 149.59
  },
  {
   "sentence_id": "C43-B005-S06",
   "section": "B",
   "text": "この苦情への対応をお願いします。",
   "start_sec": 149.79,
   "end_sec": 152.543
  }
 ]
}
