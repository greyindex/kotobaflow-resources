{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 134.009,
 "source_chapter": 46,
 "sentence_intervals": [
  {
   "sentence_id": "C46-B001-S01",
   "section": "B",
   "text": "12月22日夜　アナから青木様へ\n",
   "start_sec": 0.0,
   "end_sec": 3.533
  },
  {
   "sentence_id": "C46-B001-S02",
   "section": "B",
   "text": "年末でお忙しいことと存じます。",
   "start_sec": 3.733,
   "end_sec": 6.427
  },
  {
   "sentence_id": "C46-B001-S03",
   "section": "B",
   "text": "午後はお電話をくださり、ありがとうございました。",
   "start_sec": 6.627,
   "end_sec": 10.16
  },
  {
   "sentence_id": "C46-B001-S04",
   "section": "B",
   "text": "1泊での参加をご検討いただき、お礼を申し上げます。",
   "start_sec": 10.36,
   "end_sec": 14.675
  },
  {
   "sentence_id": "C46-B001-S05",
   "section": "B",
   "text": "1月30日から31日まで、料金は5,000円ですね。",
   "start_sec": 14.875,
   "end_sec": 20.664
  },
  {
   "sentence_id": "C46-B001-S06",
   "section": "B",
   "text": "本人が申込書の「希望」欄に「1泊」と書いて申し込みます。",
   "start_sec": 20.864,
   "end_sec": 26.454
  },
  {
   "sentence_id": "C46-B002-S01",
   "section": "B",
   "text": "参加者がまだ決まっていないので、あいにく30日夜の紹介は準備できません。",
   "start_sec": 26.904,
   "end_sec": 33.409
  },
  {
   "sentence_id": "C46-B002-S02",
   "section": "B",
   "text": "代わりにチラシを30枚配らせていただけませんか。",
   "start_sec": 33.609,
   "end_sec": 38.081
  },
  {
   "sentence_id": "C46-B002-S03",
   "section": "B",
   "text": "難しければ遠慮なくおっしゃってください。",
   "start_sec": 38.281,
   "end_sec": 41.034
  },
  {
   "sentence_id": "C46-B002-S04",
   "section": "B",
   "text": "お手数をかけて申し訳ありません。",
   "start_sec": 41.234,
   "end_sec": 43.508
  },
  {
   "sentence_id": "C46-B002-S05",
   "section": "B",
   "text": "催促ではありませんが、いつご返信いただけるか教えていただけますか。",
   "start_sec": 43.708,
   "end_sec": 48.681
  },
  {
   "sentence_id": "C46-B003-S01",
   "section": "B",
   "text": "12月24日　青木からアナ様へ\n",
   "start_sec": 49.131,
   "end_sec": 52.724
  },
  {
   "sentence_id": "C46-B003-S02",
   "section": "B",
   "text": "ご確認の内容で結構です。",
   "start_sec": 52.924,
   "end_sec": 55.606
  },
  {
   "sentence_id": "C46-B003-S03",
   "section": "B",
   "text": "紹介をしないことは承知しました。",
   "start_sec": 55.806,
   "end_sec": 58.702
  },
  {
   "sentence_id": "C46-B003-S04",
   "section": "B",
   "text": "チラシは紹介の時間の最初に配れます。",
   "start_sec": 58.902,
   "end_sec": 62.916
  },
  {
   "sentence_id": "C46-B003-S05",
   "section": "B",
   "text": "窓口にも1枚いただけますか。",
   "start_sec": 63.116,
   "end_sec": 65.538
  },
  {
   "sentence_id": "C46-B003-S06",
   "section": "B",
   "text": "申込書を添付して送信してください。",
   "start_sec": 65.738,
   "end_sec": 68.492
  },
  {
   "sentence_id": "C46-B003-S07",
   "section": "B",
   "text": "ほかの書類は不要です。",
   "start_sec": 68.692,
   "end_sec": 70.562
  },
  {
   "sentence_id": "C46-B003-S08",
   "section": "B",
   "text": "会社名は勤務先がある方だけ、署名は全員にお願いします。",
   "start_sec": 70.762,
   "end_sec": 76.695
  },
  {
   "sentence_id": "C46-B003-S09",
   "section": "B",
   "text": "取消は1月22日までです。",
   "start_sec": 76.895,
   "end_sec": 80.249
  },
  {
   "sentence_id": "C46-B003-S10",
   "section": "B",
   "text": "それより後のキャンセルは返金できません。",
   "start_sec": 80.449,
   "end_sec": 84.125
  },
  {
   "sentence_id": "C46-B003-S11",
   "section": "B",
   "text": "写真の使用に同意した方にだけ名前を書いていただき、その方の写真を2月号に使わせていただきます。",
   "start_sec": 84.325,
   "end_sec": 92.873
  },
  {
   "sentence_id": "C46-B004-S01",
   "section": "B",
   "text": "受付時間は平日9時から17時です。",
   "start_sec": 93.323,
   "end_sec": 97.091
  },
  {
   "sentence_id": "C46-B004-S02",
   "section": "B",
   "text": "送金先の口座は申込書にあります。",
   "start_sec": 97.291,
   "end_sec": 100.884
  },
  {
   "sentence_id": "C46-B004-S03",
   "section": "B",
   "text": "お支払いの明細書は保管してください。",
   "start_sec": 101.084,
   "end_sec": 104.358
  },
  {
   "sentence_id": "C46-B004-S04",
   "section": "B",
   "text": "宿泊時の身分の確認には、身分証明書をご用意ください。",
   "start_sec": 104.558,
   "end_sec": 109.591
  },
  {
   "sentence_id": "C46-B004-S05",
   "section": "B",
   "text": "海外から来る方のビザやパスポートの有効期限、航空券は旅行社にご相談ください。",
   "start_sec": 109.791,
   "end_sec": 117.164
  },
  {
   "sentence_id": "C46-B004-S06",
   "section": "B",
   "text": "センターでは手配しません。",
   "start_sec": 117.364,
   "end_sec": 119.539
  },
  {
   "sentence_id": "C46-B004-S07",
   "section": "B",
   "text": "国際空港のインフォメーションでも交通案内を受けられます。",
   "start_sec": 119.739,
   "end_sec": 124.053
  },
  {
   "sentence_id": "C46-B004-S08",
   "section": "B",
   "text": "診療や医療費の相談は市役所をご利用ください。",
   "start_sec": 124.253,
   "end_sec": 128.556
  },
  {
   "sentence_id": "C46-B004-S09",
   "section": "B",
   "text": "役所などの公共機関が休みの日には、相談できないことがあります。",
   "start_sec": 128.756,
   "end_sec": 134.002
  }
 ]
}
