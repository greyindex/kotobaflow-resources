{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 81.859,
 "source_chapter": 39,
 "sentence_intervals": [
  {
   "sentence_id": "C39-A001-S01",
   "section": "A",
   "text": "十月九日、会議室Bで日本語の勉強会がありました。",
   "start_sec": 0.0,
   "end_sec": 4.793
  },
  {
   "sentence_id": "C39-A001-S02",
   "section": "A",
   "text": "五時半に来て、西田さんが七日に作った設備案内を読みました。",
   "start_sec": 4.993,
   "end_sec": 9.895
  },
  {
   "sentence_id": "C39-A001-S03",
   "section": "A",
   "text": "今日のテーマは旅先の生き物と風景です。",
   "start_sec": 10.095,
   "end_sec": 13.568
  },
  {
   "sentence_id": "C39-A001-S04",
   "section": "A",
   "text": "最初の写真には、庭園の池を泳ぐ鯉と金魚が写っていました。",
   "start_sec": 13.768,
   "end_sec": 19.613
  },
  {
   "sentence_id": "C39-A001-S05",
   "section": "A",
   "text": "私は写真を見せながら、旅の思い出を話しました。",
   "start_sec": 19.813,
   "end_sec": 24.126
  },
  {
   "sentence_id": "C39-A001-S06",
   "section": "A",
   "text": "旅先で塔に上ると、美しい海岸線が見えました。",
   "start_sec": 24.326,
   "end_sec": 28.88
  },
  {
   "sentence_id": "C39-A001-S07",
   "section": "A",
   "text": "その景色をしばらく眺めました。",
   "start_sec": 29.08,
   "end_sec": 31.784
  },
  {
   "sentence_id": "C39-A002-S01",
   "section": "A",
   "text": "七時から七時半までは話し合いでした。",
   "start_sec": 32.234,
   "end_sec": 35.733
  },
  {
   "sentence_id": "C39-A002-S02",
   "section": "A",
   "text": "パソコンとの接続をやめると、十五分後にプロジェクターが自動的に止まりました。",
   "start_sec": 35.933,
   "end_sec": 42.914
  },
  {
   "sentence_id": "C39-A002-S03",
   "section": "A",
   "text": "故障ではなく、設定どおりの反応です。",
   "start_sec": 43.114,
   "end_sec": 46.662
  },
  {
   "sentence_id": "C39-A002-S04",
   "section": "A",
   "text": "七時半に電源ボタンを押すと、三十秒ほどしてまた動きました。",
   "start_sec": 46.862,
   "end_sec": 52.088
  },
  {
   "sentence_id": "C39-A002-S05",
   "section": "A",
   "text": "次の写真に進むと、仲間が「この浜辺で貝殻を拾いました」と話し始めました。",
   "start_sec": 52.288,
   "end_sec": 59.396
  },
  {
   "sentence_id": "C39-A003-S01",
   "section": "A",
   "text": "会の後で案内書を開いたら、同じ場所の夜景も載っていました。",
   "start_sec": 59.846,
   "end_sec": 65.0
  },
  {
   "sentence_id": "C39-A003-S02",
   "section": "A",
   "text": "案内書には、夕もやの中の塔も見どころだと書いてありました。",
   "start_sec": 65.2,
   "end_sec": 69.993
  },
  {
   "sentence_id": "C39-A003-S03",
   "section": "A",
   "text": "写真では道の状態まではわかりません。",
   "start_sec": 70.193,
   "end_sec": 73.666
  },
  {
   "sentence_id": "C39-A003-S04",
   "section": "A",
   "text": "次の旅は、天気や道の条件を確かめてから決めようと思いました。",
   "start_sec": 73.866,
   "end_sec": 79.14
  },
  {
   "sentence_id": "C39-A003-S05",
   "section": "A",
   "text": "先に道も撮ればよかったです。",
   "start_sec": 79.34,
   "end_sec": 81.853
  }
 ]
}
