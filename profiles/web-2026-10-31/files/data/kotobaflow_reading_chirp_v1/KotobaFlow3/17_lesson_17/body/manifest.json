{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 59.95,
 "source_chapter": 53,
 "sentence_intervals": [
  {
   "sentence_id": "C53-A001-S01",
   "section": "A",
   "text": "相談会の後、アナ、ミン、佐藤はメールの記録を確認した。",
   "start_sec": 0.0,
   "end_sec": 6.098
  },
  {
   "sentence_id": "C53-A001-S02",
   "section": "A",
   "text": "申し込んだ人は二十四人で、送信リストにも二十四人の名前があった。",
   "start_sec": 6.298,
   "end_sec": 12.773
  },
  {
   "sentence_id": "C53-A001-S03",
   "section": "A",
   "text": "しかし、六人は受け取ったことを確認できていないと言った。",
   "start_sec": 12.973,
   "end_sec": 17.556
  },
  {
   "sentence_id": "C53-A001-S04",
   "section": "A",
   "text": "六人のうち何人が参加したかは不明だった。",
   "start_sec": 17.756,
   "end_sec": 21.849
  },
  {
   "sentence_id": "C53-A001-S05",
   "section": "A",
   "text": "この現状にミンは驚いた。",
   "start_sec": 22.049,
   "end_sec": 24.622
  },
  {
   "sentence_id": "C53-A002-S01",
   "section": "A",
   "text": "ミンは担当者が送るのを忘れたと思ったが、記録で送信操作は確認できた。",
   "start_sec": 25.072,
   "end_sec": 31.416
  },
  {
   "sentence_id": "C53-A002-S02",
   "section": "A",
   "text": "届いたかどうかは別だ。",
   "start_sec": 31.616,
   "end_sec": 33.35
  },
  {
   "sentence_id": "C53-A002-S03",
   "section": "A",
   "text": "佐藤の説明のおかげで思い違いに気づき、解釈を訂正した。",
   "start_sec": 33.55,
   "end_sec": 38.944
  },
  {
   "sentence_id": "C53-A002-S04",
   "section": "A",
   "text": "送信と受け取りを直接結び付けることが、誤解の元だった。",
   "start_sec": 39.144,
   "end_sec": 44.15
  },
  {
   "sentence_id": "C53-A003-S01",
   "section": "A",
   "text": "結局、三人は連絡の不便について謝ることにした。",
   "start_sec": 44.6,
   "end_sec": 49.763
  },
  {
   "sentence_id": "C53-A003-S02",
   "section": "A",
   "text": "原因が不明だからこそ、事実と推測を分ける必要がある。",
   "start_sec": 49.963,
   "end_sec": 54.864
  },
  {
   "sentence_id": "C53-A003-S03",
   "section": "A",
   "text": "アナは金曜日までに記録をさらに確認すると約束した。",
   "start_sec": 55.064,
   "end_sec": 59.944
  }
 ]
}
