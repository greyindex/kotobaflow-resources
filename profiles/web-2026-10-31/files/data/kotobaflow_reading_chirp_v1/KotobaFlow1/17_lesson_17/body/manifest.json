{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 65.643,
 "source_chapter": 17,
 "sentence_intervals": [
  {
   "sentence_id": "C17-A001-S01",
   "section": "A",
   "text": "日曜日、マテオとリンはみどりセンターの部屋で日本語を勉強します。",
   "start_sec": 0.0,
   "end_sec": 5.993
  },
  {
   "sentence_id": "C17-A001-S02",
   "section": "A",
   "text": "二人は毎週、短いメッセージを送っています。",
   "start_sec": 6.193,
   "end_sec": 9.979
  },
  {
   "sentence_id": "C17-A001-S03",
   "section": "A",
   "text": "今週はパクにも連絡しました。",
   "start_sec": 10.179,
   "end_sec": 12.512
  },
  {
   "sentence_id": "C17-A001-S04",
   "section": "A",
   "text": "パクからもう返事が来ました。",
   "start_sec": 12.712,
   "end_sec": 14.686
  },
  {
   "sentence_id": "C17-A001-S05",
   "section": "A",
   "text": "午後は用事があるから、今日は来ません。",
   "start_sec": 14.886,
   "end_sec": 17.759
  },
  {
   "sentence_id": "C17-A001-S06",
   "section": "A",
   "text": "来週の予定はまだメッセージに書いていません。",
   "start_sec": 17.959,
   "end_sec": 21.072
  },
  {
   "sentence_id": "C17-A002-S01",
   "section": "A",
   "text": "勉強は午後二時から四時までです。",
   "start_sec": 21.522,
   "end_sec": 24.654
  },
  {
   "sentence_id": "C17-A002-S02",
   "section": "A",
   "text": "準備は一時半からです。",
   "start_sec": 24.854,
   "end_sec": 27.315
  },
  {
   "sentence_id": "C17-A002-S03",
   "section": "A",
   "text": "リンは準備を手伝いに来ます。",
   "start_sec": 27.515,
   "end_sec": 30.192
  },
  {
   "sentence_id": "C17-A002-S04",
   "section": "A",
   "text": "マテオはもう中村さんに連絡しました。",
   "start_sec": 30.392,
   "end_sec": 34.104
  },
  {
   "sentence_id": "C17-A002-S05",
   "section": "A",
   "text": "今、中村さんが机を運んでいます。",
   "start_sec": 34.304,
   "end_sec": 37.238
  },
  {
   "sentence_id": "C17-A002-S06",
   "section": "A",
   "text": "入口は危険ですから、マテオは受付の前で待っています。",
   "start_sec": 37.438,
   "end_sec": 41.882
  },
  {
   "sentence_id": "C17-A003-S01",
   "section": "A",
   "text": "マテオは部屋に入る前に、注意を読みます。",
   "start_sec": 42.332,
   "end_sec": 46.197
  },
  {
   "sentence_id": "C17-A003-S02",
   "section": "A",
   "text": "一時半にリンと会います。",
   "start_sec": 46.397,
   "end_sec": 48.744
  },
  {
   "sentence_id": "C17-A003-S03",
   "section": "A",
   "text": "二人は先に机を運びます。",
   "start_sec": 48.944,
   "end_sec": 51.518
  },
  {
   "sentence_id": "C17-A003-S04",
   "section": "A",
   "text": "その後で、椅子を運びます。",
   "start_sec": 51.718,
   "end_sec": 54.033
  },
  {
   "sentence_id": "C17-A003-S05",
   "section": "A",
   "text": "準備の後で、水を飲みます。",
   "start_sec": 54.233,
   "end_sec": 56.747
  },
  {
   "sentence_id": "C17-A003-S06",
   "section": "A",
   "text": "部屋では飲んではいけません。",
   "start_sec": 56.947,
   "end_sec": 58.96
  },
  {
   "sentence_id": "C17-A003-S07",
   "section": "A",
   "text": "廊下で飲みます。",
   "start_sec": 59.16,
   "end_sec": 60.773
  },
  {
   "sentence_id": "C17-A003-S08",
   "section": "A",
   "text": "それから、一緒にメッセージを読んで、日本語を勉強します。",
   "start_sec": 60.973,
   "end_sec": 65.637
  }
 ]
}
