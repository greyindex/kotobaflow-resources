{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 55.669,
 "source_chapter": 13,
 "sentence_intervals": [
  {
   "sentence_id": "C13-B001-S01",
   "section": "B",
   "text": "準備は順に進めてください。",
   "start_sec": 0.0,
   "end_sec": 2.393
  },
  {
   "sentence_id": "C13-B001-S02",
   "section": "B",
   "text": "まず石けんで手を洗って、机を拭いてください。",
   "start_sec": 2.593,
   "end_sec": 6.291
  },
  {
   "sentence_id": "C13-B001-S03",
   "section": "B",
   "text": "食事用の机は窓の前です。",
   "start_sec": 6.491,
   "end_sec": 9.485
  },
  {
   "sentence_id": "C13-B001-S04",
   "section": "B",
   "text": "冷蔵庫からパンとスープを出してください。",
   "start_sec": 9.685,
   "end_sec": 13.638
  },
  {
   "sentence_id": "C13-B001-S05",
   "section": "B",
   "text": "パンを皿に載せて、コップとスプーンも並べてください。",
   "start_sec": 13.838,
   "end_sec": 18.209
  },
  {
   "sentence_id": "C13-B001-S06",
   "section": "B",
   "text": "最後に全部チェックしてください。",
   "start_sec": 18.409,
   "end_sec": 20.855
  },
  {
   "sentence_id": "C13-B002-S01",
   "section": "B",
   "text": "注意。",
   "start_sec": 21.305,
   "end_sec": 22.034
  },
  {
   "sentence_id": "C13-B002-S02",
   "section": "B",
   "text": "ここでは火を使ってはいけません。",
   "start_sec": 22.234,
   "end_sec": 24.508
  },
  {
   "sentence_id": "C13-B002-S03",
   "section": "B",
   "text": "電子レンジは係と使ってください。",
   "start_sec": 24.708,
   "end_sec": 27.581
  },
  {
   "sentence_id": "C13-B002-S04",
   "section": "B",
   "text": "ポットのお湯は熱いです。",
   "start_sec": 27.781,
   "end_sec": 30.042
  },
  {
   "sentence_id": "C13-B002-S05",
   "section": "B",
   "text": "気をつけてください。",
   "start_sec": 30.242,
   "end_sec": 31.725
  },
  {
   "sentence_id": "C13-B002-S06",
   "section": "B",
   "text": "ナイフはパン用です。",
   "start_sec": 31.925,
   "end_sec": 34.063
  },
  {
   "sentence_id": "C13-B002-S07",
   "section": "B",
   "text": "ナイフの刃に触ってはいけません。",
   "start_sec": 34.263,
   "end_sec": 36.416
  },
  {
   "sentence_id": "C13-B003-S01",
   "section": "B",
   "text": "教室の大きいドアは閉めてください。",
   "start_sec": 36.866,
   "end_sec": 39.86
  },
  {
   "sentence_id": "C13-B003-S02",
   "section": "B",
   "text": "小さいドアの先はベランダです。",
   "start_sec": 40.06,
   "end_sec": 42.67
  },
  {
   "sentence_id": "C13-B003-S03",
   "section": "B",
   "text": "危険です。",
   "start_sec": 42.87,
   "end_sec": 43.764
  },
  {
   "sentence_id": "C13-B003-S04",
   "section": "B",
   "text": "入ってはいけません。",
   "start_sec": 43.964,
   "end_sec": 45.337
  },
  {
   "sentence_id": "C13-B003-S05",
   "section": "B",
   "text": "質問は係に聞いてください。",
   "start_sec": 45.537,
   "end_sec": 47.69
  },
  {
   "sentence_id": "C13-B003-S06",
   "section": "B",
   "text": "本に名前を書いてはいけません。",
   "start_sec": 47.89,
   "end_sec": 50.464
  },
  {
   "sentence_id": "C13-B003-S07",
   "section": "B",
   "text": "最後に本を入口の机に置いて、電気を消してください。",
   "start_sec": 50.664,
   "end_sec": 55.663
  }
 ]
}
