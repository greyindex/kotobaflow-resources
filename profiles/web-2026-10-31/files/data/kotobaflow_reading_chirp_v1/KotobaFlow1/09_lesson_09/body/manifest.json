 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 40.225,
 "source_chapter": 9,
 "sentence_intervals": [
  {
   "sentence_id": "C09-A001-S01",
   "section": "A",
   "text": "夕べ、日記帳に日記を書きました。",
   "start_sec": 0.0,
   "end_sec": 3.106
  },
  {
   "sentence_id": "C09-A001-S02",
   "section": "A",
   "text": "昨日は日曜日でした。",
   "start_sec": 3.306,
   "end_sec": 5.253
  },
  {
   "sentence_id": "C09-A001-S03",
   "section": "A",
   "text": "午前中は雨で、家で半日休みました。",
   "start_sec": 5.453,
   "end_sec": 8.986
  },
  {
   "sentence_id": "C09-A001-S04",
   "section": "A",
   "text": "七時に起きました。",
   "start_sec": 9.186,
   "end_sec": 10.661
  },
  {
   "sentence_id": "C09-A001-S05",
   "section": "A",
   "text": "日本語を勉強しませんでした。",
   "start_sec": 10.861,
   "end_sec": 12.954
  },
  {
   "sentence_id": "C09-A002-S01",
   "section": "A",
   "text": "午後は雨ではありませんでした。",
   "start_sec": 13.404,
   "end_sec": 15.438
  },
  {
   "sentence_id": "C09-A002-S02",
   "section": "A",
   "text": "まず、一時に港駅でリンさんと会いました。",
   "start_sec": 15.638,
   "end_sec": 19.289
  },
  {
   "sentence_id": "C09-A002-S03",
   "section": "A",
   "text": "それから、駅の前で映画を見ました。",
   "start_sec": 19.489,
   "end_sec": 22.601
  },
  {
   "sentence_id": "C09-A002-S04",
   "section": "A",
   "text": "二時に始まりました。",
   "start_sec": 22.801,
   "end_sec": 24.294
  },
  {
   "sentence_id": "C09-A002-S05",
   "section": "A",
   "text": "四時に終わりました。",
   "start_sec": 24.494,
   "end_sec": 25.962
  },
  {
   "sentence_id": "C09-A002-S06",
   "section": "A",
   "text": "おもしろくて、よく笑いました。",
   "start_sec": 26.162,
   "end_sec": 28.315
  },
  {
   "sentence_id": "C09-A003-S01",
   "section": "A",
   "text": "それから、公園で散歩しました。",
   "start_sec": 28.765,
   "end_sec": 31.564
  },
  {
   "sentence_id": "C09-A003-S02",
   "section": "A",
   "text": "最後に、小さい店でパンを買いました。",
   "start_sec": 31.764,
   "end_sec": 34.877
  },
  {
   "sentence_id": "C09-A003-S03",
   "section": "A",
   "text": "安くて、おいしかったです。",
   "start_sec": 35.077,
   "end_sec": 37.565
  },
  {
   "sentence_id": "C09-A003-S04",
   "section": "A",
   "text": "今朝は六時半に起きました。",
   "start_sec": 37.765,
   "end_sec": 40.218
  }
 ]
}
