{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 73.07,
 "source_chapter": 18,
 "sentence_intervals": [
  {
   "sentence_id": "C18-B001-S01",
   "section": "B",
   "text": "マテオさんへ。",
   "start_sec": 0.0,
   "end_sec": 1.253
  },
  {
   "sentence_id": "C18-B001-S02",
   "section": "B",
   "text": "明日の予定です。",
   "start_sec": 1.453,
   "end_sec": 2.707
  },
  {
   "sentence_id": "C18-B001-S03",
   "section": "B",
   "text": "集まりは午後二時から三時までです。",
   "start_sec": 2.907,
   "end_sec": 5.744
  },
  {
   "sentence_id": "C18-B001-S04",
   "section": "B",
   "text": "教室は入口の右の受付の隣です。",
   "start_sec": 5.944,
   "end_sec": 9.657
  },
  {
   "sentence_id": "C18-B001-S05",
   "section": "B",
   "text": "受付で名前を書いてください。",
   "start_sec": 9.857,
   "end_sec": 12.165
  },
  {
   "sentence_id": "C18-B001-S06",
   "section": "B",
   "text": "私もそこにいます。",
   "start_sec": 12.365,
   "end_sec": 14.153
  },
  {
   "sentence_id": "C18-B001-S07",
   "section": "B",
   "text": "教室の注意です。",
   "start_sec": 14.353,
   "end_sec": 15.846
  },
  {
   "sentence_id": "C18-B001-S08",
   "section": "B",
   "text": "水は飲んでもいいです。",
   "start_sec": 16.046,
   "end_sec": 17.66
  },
  {
   "sentence_id": "C18-B001-S09",
   "section": "B",
   "text": "パンは食べてはいけません。",
   "start_sec": 17.86,
   "end_sec": 20.175
  },
  {
   "sentence_id": "C18-B001-S10",
   "section": "B",
   "text": "公園は図書館の隣です。",
   "start_sec": 20.375,
   "end_sec": 23.068
  },
  {
   "sentence_id": "C18-B001-S11",
   "section": "B",
   "text": "パンは公園で食べてください。",
   "start_sec": 23.268,
   "end_sec": 25.421
  },
  {
   "sentence_id": "C18-B001-S12",
   "section": "B",
   "text": "港図書館・中村。",
   "start_sec": 25.621,
   "end_sec": 27.893
  },
  {
   "sentence_id": "C18-B002-S01",
   "section": "B",
   "text": "リンへ。",
   "start_sec": 28.343,
   "end_sec": 29.223
  },
  {
   "sentence_id": "C18-B002-S02",
   "section": "B",
   "text": "もう中村さんに電話したよ。",
   "start_sec": 29.423,
   "end_sec": 31.749
  },
  {
   "sentence_id": "C18-B002-S03",
   "section": "B",
   "text": "明日は一時三十分に駅の出口で会いましょう。",
   "start_sec": 31.949,
   "end_sec": 36.305
  },
  {
   "sentence_id": "C18-B002-S04",
   "section": "B",
   "text": "一時四十分ではないよ。",
   "start_sec": 36.505,
   "end_sec": 38.702
  },
  {
   "sentence_id": "C18-B002-S05",
   "section": "B",
   "text": "理由は買い物だよ。",
   "start_sec": 38.902,
   "end_sec": 40.617
  },
  {
   "sentence_id": "C18-B002-S06",
   "section": "B",
   "text": "図書館へ行く前に、駅の隣の店でパンと水を買いましょう。",
   "start_sec": 40.818,
   "end_sec": 46.314
  },
  {
   "sentence_id": "C18-B002-S07",
   "section": "B",
   "text": "パクさんは仕事があるから、来ないよ。",
   "start_sec": 46.514,
   "end_sec": 49.757
  },
  {
   "sentence_id": "C18-B002-S08",
   "section": "B",
   "text": "私とリンの二人だね。",
   "start_sec": 49.957,
   "end_sec": 51.571
  },
  {
   "sentence_id": "C18-B003-S01",
   "section": "B",
   "text": "店のメニューを見たよ。",
   "start_sec": 52.021,
   "end_sec": 53.754
  },
  {
   "sentence_id": "C18-B003-S02",
   "section": "B",
   "text": "パン一つ二百円、水一本百円。",
   "start_sec": 53.954,
   "end_sec": 57.427
  },
  {
   "sentence_id": "C18-B003-S03",
   "section": "B",
   "text": "パンを二つ、水を二本買います。",
   "start_sec": 57.627,
   "end_sec": 60.705
  },
  {
   "sentence_id": "C18-B003-S04",
   "section": "B",
   "text": "値段は六百円です。",
   "start_sec": 60.905,
   "end_sec": 62.79
  },
  {
   "sentence_id": "C18-B003-S05",
   "section": "B",
   "text": "準備の順番は、まず買い物、次に地図を見て図書館へ行きます。",
   "start_sec": 62.99,
   "end_sec": 69.163
  },
  {
   "sentence_id": "C18-B003-S06",
   "section": "B",
   "text": "パンと水はまだ買っていないよ。",
   "start_sec": 69.363,
   "end_sec": 71.937
  },
  {
   "sentence_id": "C18-B003-S07",
   "section": "B",
   "text": "マテオ。",
   "start_sec": 72.137,
   "end_sec": 73.064
  }
 ]
}
