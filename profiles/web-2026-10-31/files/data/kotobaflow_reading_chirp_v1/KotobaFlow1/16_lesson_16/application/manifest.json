{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 59.085,
 "source_chapter": 16,
 "sentence_intervals": [
  {
   "sentence_id": "C16-B001-S01",
   "section": "B",
   "text": "日曜日の練習は十時から十二時までです。",
   "start_sec": 0.0,
   "end_sec": 3.855
  },
  {
   "sentence_id": "C16-B001-S02",
   "section": "B",
   "text": "準備の間は窓を開けます。",
   "start_sec": 4.055,
   "end_sec": 6.706
  },
  {
   "sentence_id": "C16-B001-S03",
   "section": "B",
   "text": "始めは二人で会話です。",
   "start_sec": 6.906,
   "end_sec": 9.059
  },
  {
   "sentence_id": "C16-B001-S04",
   "section": "B",
   "text": "次は一人で朗読です。",
   "start_sec": 9.259,
   "end_sec": 11.881
  },
  {
   "sentence_id": "C16-B001-S05",
   "section": "B",
   "text": "終わりはもう一度会話です。",
   "start_sec": 12.081,
   "end_sec": 14.654
  },
  {
   "sentence_id": "C16-B001-S06",
   "section": "B",
   "text": "順番は黒板を見てください。",
   "start_sec": 14.854,
   "end_sec": 17.688
  },
  {
   "sentence_id": "C16-B001-S07",
   "section": "B",
   "text": "会話の前にノートを読みましょう。",
   "start_sec": 17.888,
   "end_sec": 20.402
  },
  {
   "sentence_id": "C16-B001-S08",
   "section": "B",
   "text": "教室では食べてはいけません。",
   "start_sec": 20.602,
   "end_sec": 22.875
  },
  {
   "sentence_id": "C16-B001-S09",
   "section": "B",
   "text": "練習の後で窓を閉めてください。",
   "start_sec": 23.075,
   "end_sec": 25.654
  },
  {
   "sentence_id": "C16-B002-S01",
   "section": "B",
   "text": "駅からセンターへ：駅の出口は二階です。",
   "start_sec": 26.104,
   "end_sec": 29.853
  },
  {
   "sentence_id": "C16-B002-S02",
   "section": "B",
   "text": "エスカレーターで一階へ下りてください。",
   "start_sec": 30.053,
   "end_sec": 32.984
  },
  {
   "sentence_id": "C16-B002-S03",
   "section": "B",
   "text": "左手に券売機、右手に自動販売機があります。",
   "start_sec": 33.184,
   "end_sec": 37.55
  },
  {
   "sentence_id": "C16-B002-S04",
   "section": "B",
   "text": "飲み物はこの自販機で買います。",
   "start_sec": 37.75,
   "end_sec": 40.203
  },
  {
   "sentence_id": "C16-B002-S05",
   "section": "B",
   "text": "券売機の右隣は案内所です。",
   "start_sec": 40.403,
   "end_sec": 43.471
  },
  {
   "sentence_id": "C16-B003-S01",
   "section": "B",
   "text": "センターの入口は建物の横です。",
   "start_sec": 43.921,
   "end_sec": 47.434
  },
  {
   "sentence_id": "C16-B003-S02",
   "section": "B",
   "text": "入口と教室の間に受付があります。",
   "start_sec": 47.634,
   "end_sec": 51.227
  },
  {
   "sentence_id": "C16-B003-S03",
   "section": "B",
   "text": "教室の両隣は事務室です。",
   "start_sec": 51.427,
   "end_sec": 54.18
  },
  {
   "sentence_id": "C16-B003-S04",
   "section": "B",
   "text": "廊下の端にコンピューターがあります。",
   "start_sec": 54.38,
   "end_sec": 57.085
  },
  {
   "sentence_id": "C16-B003-S05",
   "section": "B",
   "text": "授業後も使っていいです。",
   "start_sec": 57.285,
   "end_sec": 59.078
  }
 ]
}
