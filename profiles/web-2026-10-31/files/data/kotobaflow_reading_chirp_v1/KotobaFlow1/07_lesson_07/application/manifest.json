 "sentence_intervals": [
  {
   "sentence_id": "C07-B001-S01",
   "section": "B",
   "text": "パク：毎朝六時に起きます。",
   "start_sec": 0.0,
   "end_sec": 2.79
  },
  {
   "sentence_id": "C07-B001-S02",
   "section": "B",
   "text": "朝ご飯を食べません。",
   "start_sec": 2.99,
   "end_sec": 4.483
  },
  {
   "sentence_id": "C07-B001-S03",
   "section": "B",
   "text": "駅でお茶と切符を買います。",
   "start_sec": 4.683,
   "end_sec": 7.497
  },
  {
   "sentence_id": "C07-B001-S04",
   "section": "B",
   "text": "七時半に電車に乗ります。",
   "start_sec": 7.697,
   "end_sec": 9.766
  },
  {
   "sentence_id": "C07-B001-S05",
   "section": "B",
   "text": "電車の中で新聞を読みます。",
   "start_sec": 9.966,
   "end_sec": 12.703
  },
  {
   "sentence_id": "C07-B001-S06",
   "section": "B",
   "text": "九時から五時半まで会社で働きます。",
   "start_sec": 12.903,
   "end_sec": 15.776
  },
  {
   "sentence_id": "C07-B001-S07",
   "section": "B",
   "text": "木曜日の夜、センターで日本語を勉強します。",
   "start_sec": 15.976,
   "end_sec": 19.689
  },
  {
   "sentence_id": "C07-B002-S01",
   "section": "B",
   "text": "アナンド：七時に起きます。",
   "start_sec": 20.139,
   "end_sec": 22.424
  },
  {
   "sentence_id": "C07-B002-S02",
   "section": "B",
   "text": "八時に三番のバスで会社へ行きます。",
   "start_sec": 22.624,
   "end_sec": 25.738
  },
  {
   "sentence_id": "C07-B002-S03",
   "section": "B",
   "text": "月曜日から土曜日まで働きます。",
   "start_sec": 25.938,
   "end_sec": 28.751
  },
  {
   "sentence_id": "C07-B002-S04",
   "section": "B",
   "text": "毎晩、うちで晩ご飯を食べます。",
   "start_sec": 28.951,
   "end_sec": 31.704
  },
  {
   "sentence_id": "C07-B002-S05",
   "section": "B",
   "text": "十二時に寝ます。",
   "start_sec": 31.904,
   "end_sec": 33.415
  },
  {
   "sentence_id": "C07-B003-S01",
   "section": "B",
   "text": "リン：七時に起きます。",
   "start_sec": 33.865,
   "end_sec": 36.057
  },
  {
   "sentence_id": "C07-B003-S02",
   "section": "B",
   "text": "自転車で大学へ行きます。",
   "start_sec": 36.257,
   "end_sec": 38.77
  },
  {
   "sentence_id": "C07-B003-S03",
   "section": "B",
   "text": "大学で友達と昼ご飯を食べます。",
   "start_sec": 38.97,
   "end_sec": 42.143
  },
  {
   "sentence_id": "C07-B003-S04",
   "section": "B",
   "text": "うちから大学まで二キロです。",
   "start_sec": 42.343,
   "end_sec": 44.953
  },
  {
   "sentence_id": "C07-B003-S05",
   "section": "B",
   "text": "十一時に寝ます。",
   "start_sec": 45.153,
   "end_sec": 46.744
  }
 ]
}
