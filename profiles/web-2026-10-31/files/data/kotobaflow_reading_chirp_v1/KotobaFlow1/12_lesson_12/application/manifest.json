{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 48.86,
 "source_chapter": 12,
 "sentence_intervals": [
  {
   "sentence_id": "C12-B001-S01",
   "section": "B",
   "text": "十一月のスケジュール：四日（水曜日）は日本語の勉強。",
   "start_sec": 0.0,
   "end_sec": 5.665
  },
  {
   "sentence_id": "C12-B001-S02",
   "section": "B",
   "text": "五日（木曜日）と六日（金曜日）は仕事。",
   "start_sec": 5.865,
   "end_sec": 10.52
  },
  {
   "sentence_id": "C12-B001-S03",
   "section": "B",
   "text": "七日（土曜日）は一日、家で休みます。",
   "start_sec": 10.72,
   "end_sec": 14.657
  },
  {
   "sentence_id": "C12-B001-S04",
   "section": "B",
   "text": "午後は音楽を聞きます。",
   "start_sec": 14.857,
   "end_sec": 16.875
  },
  {
   "sentence_id": "C12-B001-S05",
   "section": "B",
   "text": "この週は連休がありません。",
   "start_sec": 17.075,
   "end_sec": 19.588
  },
  {
   "sentence_id": "C12-B002-S01",
   "section": "B",
   "text": "八日（日曜日）の午前は仕事、午後は料理の会。",
   "start_sec": 20.038,
   "end_sec": 25.971
  },
  {
   "sentence_id": "C12-B002-S02",
   "section": "B",
   "text": "一時から準備、二時から四時まで料理とパーティー。",
   "start_sec": 26.171,
   "end_sec": 30.457
  },
  {
   "sentence_id": "C12-B002-S03",
   "section": "B",
   "text": "飲み物はお茶かジュースです。",
   "start_sec": 30.657,
   "end_sec": 33.231
  },
  {
   "sentence_id": "C12-B002-S04",
   "section": "B",
   "text": "お茶で乾杯しましょう。",
   "start_sec": 33.431,
   "end_sec": 35.305
  },
  {
   "sentence_id": "C12-B002-S05",
   "section": "B",
   "text": "今度の会の料理は皆、野菜の料理です。",
   "start_sec": 35.505,
   "end_sec": 38.798
  },
  {
   "sentence_id": "C12-B003-S01",
   "section": "B",
   "text": "次回は映画か音楽の会です。",
   "start_sec": 39.248,
   "end_sec": 42.334
  },
  {
   "sentence_id": "C12-B003-S02",
   "section": "B",
   "text": "気軽な会です。",
   "start_sec": 42.534,
   "end_sec": 43.787
  },
  {
   "sentence_id": "C12-B003-S03",
   "section": "B",
   "text": "是非一緒に参加しましょう。",
   "start_sec": 43.987,
   "end_sec": 45.901
  },
  {
   "sentence_id": "C12-B003-S04",
   "section": "B",
   "text": "日は今度、皆で相談します。",
   "start_sec": 46.101,
   "end_sec": 48.854
  }
 ]
}
