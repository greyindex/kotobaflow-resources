{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 53.945,
 "source_chapter": 12,
 "sentence_intervals": [
  {
   "sentence_id": "C12-A001-S01",
   "section": "A",
   "text": "私はマテオです。",
   "start_sec": 0.0,
   "end_sec": 1.589
  },
  {
   "sentence_id": "C12-A001-S02",
   "section": "A",
   "text": "今日は十一月一日、日曜日です。",
   "start_sec": 1.789,
   "end_sec": 4.782
  },
  {
   "sentence_id": "C12-A001-S03",
   "section": "A",
   "text": "今度の週末はリンさんと一緒に料理をしたいです。",
   "start_sec": 4.982,
   "end_sec": 9.235
  },
  {
   "sentence_id": "C12-A001-S04",
   "section": "A",
   "text": "今月八日の料理の会に大勢の人が集まります。",
   "start_sec": 9.435,
   "end_sec": 13.749
  },
  {
   "sentence_id": "C12-A001-S05",
   "section": "A",
   "text": "皆で野菜の料理を作ります。",
   "start_sec": 13.949,
   "end_sec": 16.762
  },
  {
   "sentence_id": "C12-A001-S06",
   "section": "A",
   "text": "友達も誘います。",
   "start_sec": 16.962,
   "end_sec": 18.395
  },
  {
   "sentence_id": "C12-A002-S01",
   "section": "A",
   "text": "リンさんは土曜日に仕事があります。",
   "start_sec": 18.845,
   "end_sec": 22.016
  },
  {
   "sentence_id": "C12-A002-S02",
   "section": "A",
   "text": "日曜日は暇です。",
   "start_sec": 22.216,
   "end_sec": 23.71
  },
  {
   "sentence_id": "C12-A002-S03",
   "section": "A",
   "text": "会は午後二時から四時まで、ちょうど二時間です。",
   "start_sec": 23.91,
   "end_sec": 28.06
  },
  {
   "sentence_id": "C12-A002-S04",
   "section": "A",
   "text": "私は一時にリンさんとキッチンで待ち合わせます。",
   "start_sec": 28.26,
   "end_sec": 32.273
  },
  {
   "sentence_id": "C12-A002-S05",
   "section": "A",
   "text": "準備を手伝います。",
   "start_sec": 32.473,
   "end_sec": 33.961
  },
  {
   "sentence_id": "C12-A002-S06",
   "section": "A",
   "text": "四時に家に帰ります。",
   "start_sec": 34.161,
   "end_sec": 36.171
  },
  {
   "sentence_id": "C12-A003-S01",
   "section": "A",
   "text": "今年の私の誕生日は今月十日です。",
   "start_sec": 36.621,
   "end_sec": 39.914
  },
  {
   "sentence_id": "C12-A003-S02",
   "section": "A",
   "text": "九日と十日は仕事です。",
   "start_sec": 40.114,
   "end_sec": 42.327
  },
  {
   "sentence_id": "C12-A003-S03",
   "section": "A",
   "text": "八日はセンターに友達を招きます。",
   "start_sec": 42.527,
   "end_sec": 45.504
  },
  {
   "sentence_id": "C12-A003-S04",
   "section": "A",
   "text": "料理の会で小さなパーティーもします。",
   "start_sec": 45.704,
   "end_sec": 48.812
  },
  {
   "sentence_id": "C12-A003-S05",
   "section": "A",
   "text": "ケーキもあります。",
   "start_sec": 49.012,
   "end_sec": 50.625
  },
  {
   "sentence_id": "C12-A003-S06",
   "section": "A",
   "text": "皆さんとの時間を楽しみにしています。",
   "start_sec": 50.825,
   "end_sec": 53.939
  }
 ]
}
