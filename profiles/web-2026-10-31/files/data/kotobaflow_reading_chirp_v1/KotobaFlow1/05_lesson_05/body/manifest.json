 "sentence_intervals": [
  {
   "sentence_id": "C05-A001-S01",
   "section": "A",
   "text": "今日は十月二日、金曜日です。",
   "start_sec": 0.0,
   "end_sec": 3.413
  },
  {
   "sentence_id": "C05-A001-S02",
   "section": "A",
   "text": "この写真は昨日の日本語クラスの写真です。",
   "start_sec": 3.613,
   "end_sec": 7.747
  },
  {
   "sentence_id": "C05-A001-S03",
   "section": "A",
   "text": "森先生とパクさんとアナンドさんの写真です。",
   "start_sec": 7.947,
   "end_sec": 11.78
  },
  {
   "sentence_id": "C05-A002-S01",
   "section": "A",
   "text": "木曜日のクラスは夜です。",
   "start_sec": 12.23,
   "end_sec": 14.383
  },
  {
   "sentence_id": "C05-A002-S02",
   "section": "A",
   "text": "午後七時から八時半までです。",
   "start_sec": 14.583,
   "end_sec": 16.978
  },
  {
   "sentence_id": "C05-A002-S03",
   "section": "A",
   "text": "教室は図書館の隣にあります。",
   "start_sec": 17.178,
   "end_sec": 19.991
  },
  {
   "sentence_id": "C05-A003-S01",
   "section": "A",
   "text": "パクさんの仕事は月曜日から金曜日までです。",
   "start_sec": 20.441,
   "end_sec": 24.335
  },
  {
   "sentence_id": "C05-A003-S02",
   "section": "A",
   "text": "朝九時から午後五時半までです。",
   "start_sec": 24.535,
   "end_sec": 27.712
  },
  {
   "sentence_id": "C05-A003-S03",
   "section": "A",
   "text": "土曜日は時間があります。",
   "start_sec": 27.912,
   "end_sec": 30.149
  },
  {
   "sentence_id": "C05-A003-S04",
   "section": "A",
   "text": "アナンドさんは土曜日も仕事です。",
   "start_sec": 30.349,
   "end_sec": 32.71
  },
  {
   "sentence_id": "C05-A003-S05",
   "section": "A",
   "text": "仕事は朝九時から午後五時までです。",
   "start_sec": 32.91,
   "end_sec": 36.424
  },
  {
   "sentence_id": "C05-A004-S01",
   "section": "A",
   "text": "明日は三日です。",
   "start_sec": 36.874,
   "end_sec": 38.349
  },
  {
   "sentence_id": "C05-A004-S02",
   "section": "A",
   "text": "午前十時に日本語クラスがあります。",
   "start_sec": 38.549,
   "end_sec": 41.542
  },
  {
   "sentence_id": "C05-A004-S03",
   "section": "A",
   "text": "十一時半までです。",
   "start_sec": 41.742,
   "end_sec": 43.501
  },
  {
   "sentence_id": "C05-A004-S04",
   "section": "A",
   "text": "ユーリ先生のクラスです。",
   "start_sec": 43.701,
   "end_sec": 45.434
  },
  {
   "sentence_id": "C05-A004-S05",
   "section": "A",
   "text": "私は土曜日はいつも図書館にいます。",
   "start_sec": 45.634,
   "end_sec": 48.927
  }
 ]
}
