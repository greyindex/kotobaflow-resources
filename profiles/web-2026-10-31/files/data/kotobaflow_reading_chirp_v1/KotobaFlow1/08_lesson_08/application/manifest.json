 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 52.752,
 "source_chapter": 8,
 "sentence_intervals": [
  {
   "sentence_id": "C08-B001-S01",
   "section": "B",
   "text": "入口の机の上にわすれものがあります。",
   "start_sec": 0.0,
   "end_sec": 3.201
  },
  {
   "sentence_id": "C08-B001-S02",
   "section": "B",
   "text": "時計の番号は数字です。",
   "start_sec": 3.401,
   "end_sec": 5.734
  },
  {
   "sentence_id": "C08-B001-S03",
   "section": "B",
   "text": "一は大きい時計です。",
   "start_sec": 5.934,
   "end_sec": 8.131
  },
  {
   "sentence_id": "C08-B001-S04",
   "section": "B",
   "text": "新しいです。",
   "start_sec": 8.331,
   "end_sec": 9.879
  },
  {
   "sentence_id": "C08-B001-S05",
   "section": "B",
   "text": "二は小さい時計です。",
   "start_sec": 10.079,
   "end_sec": 11.818
  },
  {
   "sentence_id": "C08-B001-S06",
   "section": "B",
   "text": "古いです。",
   "start_sec": 12.018,
   "end_sec": 12.912
  },
  {
   "sentence_id": "C08-B001-S07",
   "section": "B",
   "text": "三も小さい時計です。",
   "start_sec": 13.112,
   "end_sec": 14.905
  },
  {
   "sentence_id": "C08-B001-S08",
   "section": "B",
   "text": "新しいです。",
   "start_sec": 15.105,
   "end_sec": 16.37
  },
  {
   "sentence_id": "C08-B001-S09",
   "section": "B",
   "text": "本と鍵もあります。",
   "start_sec": 16.57,
   "end_sec": 18.2
  },
  {
   "sentence_id": "C08-B001-S10",
   "section": "B",
   "text": "本はあまり新しくないです。",
   "start_sec": 18.4,
   "end_sec": 20.593
  },
  {
   "sentence_id": "C08-B001-S11",
   "section": "B",
   "text": "鍵は小さいです。",
   "start_sec": 20.793,
   "end_sec": 22.496
  },
  {
   "sentence_id": "C08-B001-S12",
   "section": "B",
   "text": "机の前に中村さんがいます。",
   "start_sec": 22.696,
   "end_sec": 25.27
  },
  {
   "sentence_id": "C08-B002-S01",
   "section": "B",
   "text": "図書館には易しい日本語の本と難しい本があります。",
   "start_sec": 25.72,
   "end_sec": 30.033
  },
  {
   "sentence_id": "C08-B002-S02",
   "section": "B",
   "text": "漢字の本もあります。",
   "start_sec": 30.233,
   "end_sec": 31.786
  },
  {
   "sentence_id": "C08-B002-S03",
   "section": "B",
   "text": "図書館は午後四時までです。",
   "start_sec": 31.986,
   "end_sec": 34.722
  },
  {
   "sentence_id": "C08-B002-S04",
   "section": "B",
   "text": "夜は広い教室で本を読みます。",
   "start_sec": 34.922,
   "end_sec": 38.515
  },
  {
   "sentence_id": "C08-B002-S05",
   "section": "B",
   "text": "教室は明るいです。",
   "start_sec": 38.715,
   "end_sec": 40.209
  },
  {
   "sentence_id": "C08-B003-S01",
   "section": "B",
   "text": "十月の午後は暖かいです。",
   "start_sec": 40.659,
   "end_sec": 43.046
  },
  {
   "sentence_id": "C08-B003-S02",
   "section": "B",
   "text": "夜は涼しいです。",
   "start_sec": 43.246,
   "end_sec": 45.22
  },
  {
   "sentence_id": "C08-B003-S03",
   "section": "B",
   "text": "駅の前の店はパンが有名です。",
   "start_sec": 45.42,
   "end_sec": 48.52
  },
  {
   "sentence_id": "C08-B003-S04",
   "section": "B",
   "text": "特に柔らかいパンがおいしいです。",
   "start_sec": 48.72,
   "end_sec": 51.235
  },
  {
   "sentence_id": "C08-B003-S05",
   "section": "B",
   "text": "安いですよ。",
   "start_sec": 51.435,
   "end_sec": 52.745
  }
 ]
}
