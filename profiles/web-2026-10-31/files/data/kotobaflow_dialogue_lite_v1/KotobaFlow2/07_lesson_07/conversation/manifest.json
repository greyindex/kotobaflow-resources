   "end_sec": 189.243,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D043-S01",
   "unit_id": "C25-D043",
   "section": "D",
   "speaker": "レン",
   "text": "はい。",
   "start_sec": 189.593,
   "end_sec": 190.551,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D043-S02",
   "unit_id": "C25-D043",
   "section": "D",
   "speaker": "レン",
   "text": "とてもおいしかったです。",
