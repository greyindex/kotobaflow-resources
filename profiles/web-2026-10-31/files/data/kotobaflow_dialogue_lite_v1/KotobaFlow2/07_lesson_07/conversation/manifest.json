   "end_sec": 182.994,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D041-S02",
   "unit_id": "C25-D041",
   "section": "D",
   "speaker": "レン",
   "text": "今日はご馳走になって、すみません。",
