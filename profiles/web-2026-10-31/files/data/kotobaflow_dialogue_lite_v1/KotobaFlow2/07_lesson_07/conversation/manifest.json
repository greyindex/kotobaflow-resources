  }
 ],
 "sentence_intervals": [
  {
   "sentence_id": "C25-D001-S01",
   "unit_id": "C25-D001",
   "section": "D",
   "speaker": "小野",
   "text": "おはようございます。",
   "start_sec": 0.0,
   "end_sec": 1.272,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D001-S02",
   "unit_id": "C25-D001",
   "section": "D",
   "speaker": "小野",
   "text": "バザー係の小野です。",
   "start_sec": 1.422,
   "end_sec": 2.899,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D002-S01",
   "unit_id": "C25-D002",
   "section": "D",
   "speaker": "リー",
   "text": "リーです。",
   "start_sec": 3.249,
   "end_sec": 3.922,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D002-S02",
   "unit_id": "C25-D002",
   "section": "D",
   "speaker": "リー",
   "text": "本を十冊届けに来ました。",
   "start_sec": 4.072,
   "end_sec": 5.786,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D002-S03",
   "unit_id": "C25-D002",
   "section": "D",
   "speaker": "リー",
   "text": "六日の準備を引き受けたいんです。",
   "start_sec": 5.936,
   "end_sec": 7.89,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D003-S01",
   "unit_id": "C25-D003",
   "section": "D",
   "speaker": "小野",
   "text": "助かります。",
   "start_sec": 8.24,
   "end_sec": 9.372,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D003-S02",
   "unit_id": "C25-D003",
   "section": "D",
   "speaker": "小野",
   "text": "十八時に入口に来て、荷物を運んでいただけませんか。",
   "start_sec": 9.522,
   "end_sec": 13.456,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D004-S01",
   "unit_id": "C25-D004",
   "section": "D",
   "speaker": "リー",
   "text": "はい。",
   "start_sec": 13.806,
   "end_sec": 14.265,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D004-S02",
   "unit_id": "C25-D004",
   "section": "D",
   "speaker": "リー",
   "text": "台車を借りてもいいですか。",
   "start_sec": 14.415,
   "end_sec": 15.737,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D005-S01",
   "unit_id": "C25-D005",
   "section": "D",
   "speaker": "小野",
   "text": "どうぞ。",
   "start_sec": 16.087,
   "end_sec": 16.844,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D005-S02",
   "unit_id": "C25-D005",
   "section": "D",
   "speaker": "小野",
   "text": "台車は入口です。",
   "start_sec": 16.994,
   "end_sec": 18.363,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D005-S03",
   "unit_id": "C25-D005",
   "section": "D",
   "speaker": "小野",
   "text": "机は青木さんから二台借ります。",
   "start_sec": 18.513,
   "end_sec": 20.831,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D005-S04",
   "unit_id": "C25-D005",
   "section": "D",
   "speaker": "小野",
   "text": "あと三台はわたしが探します。",
   "start_sec": 20.981,
   "end_sec": 23.231,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D006-S01",
   "unit_id": "C25-D006",
   "section": "D",
   "speaker": "リー",
   "text": "では、荷物はわたしに任せてください。",
   "start_sec": 23.581,
   "end_sec": 26.551,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D006-S02",
   "unit_id": "C25-D006",
   "section": "D",
   "speaker": "リー",
   "text": "七日は十時に駅で友達を迎えます。",
   "start_sec": 26.701,
   "end_sec": 29.795,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D006-S03",
   "unit_id": "C25-D006",
   "section": "D",
   "speaker": "リー",
   "text": "午後は手伝えます。",
   "start_sec": 29.945,
   "end_sec": 31.133,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D007-S01",
   "unit_id": "C25-D007",
   "section": "D",
   "speaker": "小野",
   "text": "十二時半から十五時までの受付と会計をお願いします。",
   "start_sec": 31.483,
   "end_sec": 35.551,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D007-S02",
   "unit_id": "C25-D007",
   "section": "D",
   "speaker": "小野",
   "text": "午前は別の人に頼みます。",
   "start_sec": 35.701,
   "end_sec": 37.789,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D008-S01",
   "unit_id": "C25-D008",
   "section": "D",
   "speaker": "リー",
   "text": "会計の仕事を教えていただけませんか。",
   "start_sec": 38.139,
   "end_sec": 40.616,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D009-S01",
   "unit_id": "C25-D009",
   "section": "D",
   "speaker": "小野",
   "text": "六日の準備の後で教えます。",
   "start_sec": 40.966,
   "end_sec": 42.999,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D009-S02",
   "unit_id": "C25-D009",
   "section": "D",
   "speaker": "小野",
   "text": "値段を見て、お金を受け取ります。",
   "start_sec": 43.149,
   "end_sec": 45.776,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D009-S03",
   "unit_id": "C25-D009",
   "section": "D",
   "speaker": "小野",
   "text": "難しい仕事はわたしがします。",
   "start_sec": 45.926,
   "end_sec": 47.896,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D010-S01",
   "unit_id": "C25-D010",
   "section": "D",
   "speaker": "リー",
   "text": "それは有り難いです。",
   "start_sec": 48.246,
   "end_sec": 49.947,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D010-S02",
   "unit_id": "C25-D010",
   "section": "D",
   "speaker": "リー",
   "text": "わたしにもできる仕事があって、うれしいです。",
   "start_sec": 50.096,
   "end_sec": 52.719,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D011-S01",
   "unit_id": "C25-D011",
   "section": "D",
   "speaker": "小野",
   "text": "皆さんには気持ちよく参加してほしいです。",
   "start_sec": 53.069,
   "end_sec": 55.655,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D011-S02",
   "unit_id": "C25-D011",
   "section": "D",
   "speaker": "小野",
   "text": "無理をしてほしくないです。",
   "start_sec": 55.805,
   "end_sec": 57.257,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D012-S01",
   "unit_id": "C25-D012",
   "section": "D",
   "speaker": "リー",
   "text": "わたしは友達にも来てほしいです。",
   "start_sec": 57.607,
   "end_sec": 60.304,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D012-S02",
   "unit_id": "C25-D012",
   "section": "D",
   "speaker": "リー",
   "text": "午後、連れてきてもいいですか。",
   "start_sec": 60.454,
   "end_sec": 62.156,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D013-S01",
   "unit_id": "C25-D013",
   "section": "D",
   "speaker": "小野",
   "text": "もちろんです。",
   "start_sec": 62.506,
   "end_sec": 63.648,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D013-S02",
   "unit_id": "C25-D013",
   "section": "D",
   "speaker": "小野",
   "text": "友達に何かあげますか。",
   "start_sec": 63.798,
   "end_sec": 65.786,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D014-S01",
   "unit_id": "C25-D014",
   "section": "D",
   "speaker": "リー",
   "text": "プレゼントに本を買います。",
   "start_sec": 66.136,
   "end_sec": 67.877,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D014-S02",
   "unit_id": "C25-D014",
   "section": "D",
   "speaker": "リー",
   "text": "友達に新しい仕事が決まったんです。",
   "start_sec": 68.027,
   "end_sec": 70.866,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D015-S01",
   "unit_id": "C25-D015",
   "section": "D",
   "speaker": "小野",
   "text": "おめでたいですね。",
   "start_sec": 71.216,
   "end_sec": 72.596,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D015-S02",
   "unit_id": "C25-D015",
   "section": "D",
   "speaker": "小野",
   "text": "わたしもお祝いを言いたいです。",
   "start_sec": 72.746,
   "end_sec": 74.5,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D016-S01",
   "unit_id": "C25-D016",
   "section": "D",
   "speaker": "リー",
   "text": "ありがとうございます。",
   "start_sec": 74.85,
   "end_sec": 76.038,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D016-S02",
   "unit_id": "C25-D016",
   "section": "D",
   "speaker": "リー",
   "text": "七日の昼、青木さんが差し入れを届けてくれますね。",
   "start_sec": 76.188,
   "end_sec": 79.64,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D017-S01",
   "unit_id": "C25-D017",
   "section": "D",
   "speaker": "小野",
   "text": "はい、お茶です。",
   "start_sec": 79.99,
   "end_sec": 81.194,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D017-S02",
   "unit_id": "C25-D017",
   "section": "D",
   "speaker": "小野",
   "text": "青木さんにも手伝ってもらいます。",
   "start_sec": 81.344,
   "end_sec": 83.735,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D017-S03",
   "unit_id": "C25-D017",
   "section": "D",
   "speaker": "小野",
   "text": "明日、当番の紙の写真を送りましょうか。",
   "start_sec": 83.885,
   "end_sec": 86.572,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D018-S01",
   "unit_id": "C25-D018",
   "section": "D",
   "speaker": "リー",
   "text": "お願いします。",
   "start_sec": 86.922,
   "end_sec": 87.898,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D018-S02",
   "unit_id": "C25-D018",
   "section": "D",
   "speaker": "リー",
   "text": "今日は青木さんを訪ねて、直接お礼を言います。",
   "start_sec": 88.048,
   "end_sec": 91.374,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D023-S01",
   "unit_id": "C25-D023",
   "section": "D",
   "speaker": "リー",
   "text": "ごめんください。",
   "start_sec": 92.274,
   "end_sec": 93.427,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D023-S02",
   "unit_id": "C25-D023",
   "section": "D",
   "speaker": "リー",
   "text": "リーです。",
   "start_sec": 93.577,
   "end_sec": 94.652,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D024-S01",
   "unit_id": "C25-D024",
   "section": "D",
   "speaker": "青木",
   "text": "いらっしゃい。",
   "start_sec": 95.002,
   "end_sec": 96.187,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D024-S02",
   "unit_id": "C25-D024",
   "section": "D",
   "speaker": "青木",
   "text": "入口まで出迎えに行きますね。",
   "start_sec": 96.337,
   "end_sec": 98.59,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D024-S03",
   "unit_id": "C25-D024",
   "section": "D",
   "speaker": "青木",
   "text": "元気ですか。",
   "start_sec": 98.74,
   "end_sec": 99.783,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D025-S01",
   "unit_id": "C25-D025",
   "section": "D",
   "speaker": "リー",
   "text": "おかげさまで元気です。",
   "start_sec": 100.133,
   "end_sec": 101.92,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D025-S02",
   "unit_id": "C25-D025",
   "section": "D",
   "speaker": "リー",
   "text": "これは手みやげです。",
   "start_sec": 102.07,
   "end_sec": 103.358,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D025-S03",
   "unit_id": "C25-D025",
   "section": "D",
   "speaker": "リー",
   "text": "ささやかな贈り物ですが、どうぞ。",
   "start_sec": 103.508,
   "end_sec": 106.104,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D026-S01",
   "unit_id": "C25-D026",
   "section": "D",
   "speaker": "青木",
   "text": "ありがとう。",
   "start_sec": 106.454,
   "end_sec": 107.76,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D026-S02",
   "unit_id": "C25-D026",
   "section": "D",
   "speaker": "青木",
   "text": "この包みはお菓子ですか。",
   "start_sec": 107.91,
   "end_sec": 109.79,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D026-S03",
   "unit_id": "C25-D026",
   "section": "D",
   "speaker": "青木",
   "text": "わたしの大好物です。",
   "start_sec": 109.94,
   "end_sec": 111.466,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D026-S04",
   "unit_id": "C25-D026",
   "section": "D",
   "speaker": "青木",
   "text": "お茶をどうぞ。",
   "start_sec": 111.616,
   "end_sec": 112.6,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D027-S01",
   "unit_id": "C25-D027",
   "section": "D",
   "speaker": "リー",
   "text": "ありがとうございます。",
   "start_sec": 112.95,
   "end_sec": 114.241,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D027-S02",
   "unit_id": "C25-D027",
   "section": "D",
   "speaker": "リー",
   "text": "でも、どうぞおかまいなく。",
   "start_sec": 114.391,
   "end_sec": 116.095,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D027-S03",
   "unit_id": "C25-D027",
   "section": "D",
   "speaker": "リー",
   "text": "今日はお願いがあります。",
   "start_sec": 116.245,
   "end_sec": 117.952,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D028-S01",
   "unit_id": "C25-D028",
   "section": "D",
   "speaker": "青木",
   "text": "何ですか。",
   "start_sec": 118.302,
   "end_sec": 119.259,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D028-S02",
   "unit_id": "C25-D028",
   "section": "D",
   "speaker": "青木",
   "text": "今は時間がありますよ。",
   "start_sec": 119.409,
   "end_sec": 122.295,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D029-S01",
   "unit_id": "C25-D029",
   "section": "D",
   "speaker": "リー",
   "text": "七日の午後、友達をここに連れてきてもいいですか。",
   "start_sec": 122.645,
   "end_sec": 126.676,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D029-S02",
   "unit_id": "C25-D029",
   "section": "D",
   "speaker": "リー",
   "text": "新しい仕事のお祝いに本をプレゼントします。",
   "start_sec": 126.826,
   "end_sec": 129.921,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D030-S01",
   "unit_id": "C25-D030",
   "section": "D",
   "speaker": "青木",
   "text": "ええ、わたしも一緒に祝いたいです。",
   "start_sec": 130.271,
   "end_sec": 132.178,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D030-S02",
   "unit_id": "C25-D030",
   "section": "D",
   "speaker": "青木",
   "text": "夕飯をごちそうします。",
   "start_sec": 132.328,
   "end_sec": 133.945,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D030-S03",
   "unit_id": "C25-D030",
   "section": "D",
   "speaker": "青木",
   "text": "お客さんをもてなすのが好きなんです。",
   "start_sec": 134.095,
   "end_sec": 136.217,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D031-S01",
   "unit_id": "C25-D031",
   "section": "D",
   "speaker": "リー",
   "text": "ありがとうございます。",
   "start_sec": 136.567,
   "end_sec": 137.634,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D031-S02",
   "unit_id": "C25-D031",
   "section": "D",
   "speaker": "リー",
   "text": "ご招待を受けます。",
   "start_sec": 137.784,
   "end_sec": 139.318,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D031-S03",
   "unit_id": "C25-D031",
   "section": "D",
   "speaker": "リー",
   "text": "友達はキッチンの仕事をします。",
   "start_sec": 139.468,
   "end_sec": 141.778,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D032-S01",
   "unit_id": "C25-D032",
   "section": "D",
   "speaker": "青木",
   "text": "では、料理の話ができますね。",
   "start_sec": 142.128,
   "end_sec": 144.567,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D032-S02",
   "unit_id": "C25-D032",
   "section": "D",
   "speaker": "青木",
   "text": "先輩にもらった本も見せます。",
   "start_sec": 144.717,
   "end_sec": 146.702,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D033-S01",
   "unit_id": "C25-D033",
   "section": "D",
   "speaker": "リー",
   "text": "でも、帰りは引き止めないでほしいです。",
   "start_sec": 147.052,
   "end_sec": 149.605,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D033-S02",
   "unit_id": "C25-D033",
   "section": "D",
   "speaker": "リー",
   "text": "友達は翌朝、早く起きますから。",
   "start_sec": 149.755,
   "end_sec": 151.97,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D034-S01",
   "unit_id": "C25-D034",
   "section": "D",
   "speaker": "青木",
   "text": "わかりました。",
   "start_sec": 152.32,
   "end_sec": 153.246,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D034-S02",
   "unit_id": "C25-D034",
   "section": "D",
   "speaker": "青木",
   "text": "駅まで見送ります。",
   "start_sec": 153.396,
   "end_sec": 154.799,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D035-S01",
   "unit_id": "C25-D035",
   "section": "D",
   "speaker": "リー",
   "text": "いつも助けてもらって、すみません。",
   "start_sec": 155.149,
   "end_sec": 156.936,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D036-S01",
   "unit_id": "C25-D036",
   "section": "D",
   "speaker": "青木",
   "text": "お互い様ですよ。",
   "start_sec": 157.286,
   "end_sec": 158.919,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D036-S02",
   "unit_id": "C25-D036",
   "section": "D",
   "speaker": "青木",
   "text": "わたしも駅の地図を見せてもらいました。",
   "start_sec": 159.069,
   "end_sec": 161.739,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D037-S01",
   "unit_id": "C25-D037",
   "section": "D",
   "speaker": "リー",
   "text": "では、七日に来ます。",
   "start_sec": 162.089,
   "end_sec": 163.612,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D037-S02",
   "unit_id": "C25-D037",
   "section": "D",
   "speaker": "リー",
   "text": "お邪魔しました。",
   "start_sec": 163.762,
   "end_sec": 164.744,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D038-S01",
   "unit_id": "C25-D038",
   "section": "D",
   "speaker": "青木",
   "text": "お疲れ様でした。",
   "start_sec": 165.644,
   "end_sec": 167.109,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D038-S02",
   "unit_id": "C25-D038",
   "section": "D",
   "speaker": "青木",
   "text": "レンさん、新しい仕事、おめでとうございます。",
   "start_sec": 167.259,
   "end_sec": 170.438,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D039-S01",
   "unit_id": "C25-D039",
   "section": "D",
   "speaker": "レン",
   "text": "ありがとうございます。",
   "start_sec": 170.788,
   "end_sec": 172.222,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D039-S02",
   "unit_id": "C25-D039",
   "section": "D",
   "speaker": "レン",
   "text": "皆さんの祝福がうれしいです。",
   "start_sec": 172.372,
   "end_sec": 175.003,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D039-S03",
   "unit_id": "C25-D039",
   "section": "D",
   "speaker": "レン",
   "text": "この本もお祝いですか。",
   "start_sec": 175.153,
   "end_sec": 177.061,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D040-S01",
   "unit_id": "C25-D040",
   "section": "D",
   "speaker": "リー",
   "text": "はい。",
   "start_sec": 177.411,
   "end_sec": 178.249,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D040-S02",
   "unit_id": "C25-D040",
   "section": "D",
   "speaker": "リー",
   "text": "ギフトの包みを開けてください。",
   "start_sec": 178.399,
   "end_sec": 180.048,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C25-D040-S03",
   "unit_id": "C25-D040",
   "section": "D",
   "speaker": "リー",
   "text": "料理の本です。",
