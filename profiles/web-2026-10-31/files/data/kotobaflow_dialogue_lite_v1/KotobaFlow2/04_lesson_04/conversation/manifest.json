   "replacement": null
  },
  {
   "sentence_id": "C22-D004-S01",
   "unit_id": "C22-D004",
   "section": "D",
   "speaker": "ウェン",
   "text": "私はバドミントンに興味があります。",
   "start_sec": 30.161,
   "end_sec": 33.423,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D004-S02",
   "unit_id": "C22-D004",
   "section": "D",
   "speaker": "ウェン",
   "text": "テニスも一度やりましたが、ボールが速くて難しかったです。",
   "start_sec": 33.573,
   "end_sec": 37.954,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D004-S03",
   "unit_id": "C22-D004",
   "section": "D",
   "speaker": "ウェン",
   "text": "二人で何か始めたいですね。",
   "start_sec": 38.104,
   "end_sec": 40.34,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D005-S01",
   "unit_id": "C22-D005",
   "section": "D",
   "speaker": "田村",
   "text": "公民館ではピンポンとか太極拳とかも体験します。",
   "start_sec": 40.69,
   "end_sec": 44.374,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D005-S02",
   "unit_id": "C22-D005",
   "section": "D",
   "speaker": "田村",
   "text": "でも私は外に行きたいです。",
   "start_sec": 44.524,
   "end_sec": 46.805,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D005-S03",
   "unit_id": "C22-D005",
   "section": "D",
   "speaker": "田村",
   "text": "あの公園では何度も釣りをしたことがあります。",
   "start_sec": 46.955,
   "end_sec": 49.86,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D005-S04",
   "unit_id": "C22-D005",
   "section": "D",
   "speaker": "田村",
   "text": "10歳の時、家族と初めてしました。",
   "start_sec": 50.01,
   "end_sec": 52.65,
