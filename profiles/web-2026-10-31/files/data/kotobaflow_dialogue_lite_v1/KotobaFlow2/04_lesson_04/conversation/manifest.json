   "start_sec": 11.973,
   "end_sec": 14.776,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D002-S03",
   "unit_id": "C22-D002",
   "section": "D",
   "speaker": "ウェン",
   "text": "私の趣味は写真です。",
   "start_sec": 14.926,
   "end_sec": 17.107,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D002-S04",
   "unit_id": "C22-D002",
   "section": "D",
   "speaker": "ウェン",
   "text": "田村さんは今もスポーツをしていますか。",
   "start_sec": 17.257,
   "end_sec": 19.769,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D003-S01",
   "unit_id": "C22-D003",
   "section": "D",
   "speaker": "田村",
   "text": "最近はあまりしませんが、クラブの案内を見ています。",
   "start_sec": 20.119,
   "end_sec": 23.712,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D003-S02",
   "unit_id": "C22-D003",
   "section": "D",
   "speaker": "田村",
   "text": "バスケットボールは人気がありますね。",
   "start_sec": 23.862,
   "end_sec": 26.126,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D003-S03",
   "unit_id": "C22-D003",
   "section": "D",
