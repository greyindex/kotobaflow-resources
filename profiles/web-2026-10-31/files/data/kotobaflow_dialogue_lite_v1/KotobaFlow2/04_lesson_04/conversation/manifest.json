   "replacement": null
  },
  {
   "sentence_id": "C22-D006-S01",
   "unit_id": "C22-D006",
   "section": "D",
   "speaker": "ウェン",
   "text": "いい思い出ですね。",
   "start_sec": 53.0,
   "end_sec": 55.101,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D006-S02",
   "unit_id": "C22-D006",
   "section": "D",
   "speaker": "ウェン",
   "text": "私は昔の旅行の写真を集めています。",
   "start_sec": 55.251,
   "end_sec": 58.422,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D006-S03",
   "unit_id": "C22-D006",
   "section": "D",
   "speaker": "ウェン",
   "text": "これは2024年5月です。",
   "start_sec": 58.572,
   "end_sec": 61.518,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D006-S04",
   "unit_id": "C22-D006",
   "section": "D",
   "speaker": "ウェン",
   "text": "友達と山に登って、上の宿に泊まりました。",
   "start_sec": 61.668,
   "end_sec": 64.98,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D007-S01",
   "unit_id": "C22-D007",
   "section": "D",
   "speaker": "田村",
   "text": "私は登山の経験がありません。",
   "start_sec": 65.33,
   "end_sec": 67.653,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D007-S02",
   "unit_id": "C22-D007",
   "section": "D",
   "speaker": "田村",
   "text": "先日、写真の本を開きました。",
   "start_sec": 67.803,
   "end_sec": 70.52,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D007-S03",
   "unit_id": "C22-D007",
   "section": "D",
   "speaker": "田村",
   "text": "山の写真に夢中で、二時間も見ていました。",
   "start_sec": 70.67,
   "end_sec": 73.441,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D008-S01",
   "unit_id": "C22-D008",
   "section": "D",
   "speaker": "ウェン",
   "text": "私も写真の本が好きです。",
   "start_sec": 73.791,
   "end_sec": 75.853,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D008-S02",
   "unit_id": "C22-D008",
   "section": "D",
   "speaker": "ウェン",
   "text": "この間、公園で本を読んでいました。",
   "start_sec": 76.003,
   "end_sec": 78.734,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D008-S03",
   "unit_id": "C22-D008",
   "section": "D",
   "speaker": "ウェン",
   "text": "そこへ友達が来ました。",
   "start_sec": 78.884,
   "end_sec": 80.79,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D008-S04",
   "unit_id": "C22-D008",
   "section": "D",
   "speaker": "ウェン",
   "text": "一緒に近くの公園を巡って、記念の写真を撮りました。",
   "start_sec": 80.94,
   "end_sec": 84.789,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D009-S01",
   "unit_id": "C22-D009",
   "section": "D",
   "speaker": "田村",
   "text": "その友達とはどこで出会ったんですか。",
   "start_sec": 85.139,
   "end_sec": 87.773,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D009-S02",
   "unit_id": "C22-D009",
   "section": "D",
   "speaker": "田村",
   "text": "私の友達にも写真が好きな人がいます。",
   "start_sec": 87.923,
   "end_sec": 90.733,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D010-S01",
   "unit_id": "C22-D010",
   "section": "D",
   "speaker": "ウェン",
   "text": "友達の結婚式です。",
   "start_sec": 91.083,
   "end_sec": 93.328,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D010-S02",
   "unit_id": "C22-D010",
   "section": "D",
   "speaker": "ウェン",
   "text": "その人は碁や将棋も好きですが、私は写真だけです。",
   "start_sec": 93.478,
   "end_sec": 97.996,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D010-S03",
   "unit_id": "C22-D010",
   "section": "D",
   "speaker": "ウェン",
   "text": "田村さんは公民館のグループに参加したことがありますか。",
   "start_sec": 98.146,
   "end_sec": 102.147,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D011-S01",
   "unit_id": "C22-D011",
   "section": "D",
   "speaker": "田村",
   "text": "はい。",
   "start_sec": 102.497,
   "end_sec": 103.238,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D011-S02",
   "unit_id": "C22-D011",
   "section": "D",
   "speaker": "田村",
   "text": "去年、音楽のグループに一度参加しました。",
   "start_sec": 103.388,
   "end_sec": 106.357,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D011-S03",
   "unit_id": "C22-D011",
   "section": "D",
   "speaker": "田村",
   "text": "お祭りで歌ったり、踊ったりしました。",
   "start_sec": 106.507,
   "end_sec": 109.055,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D011-S04",
   "unit_id": "C22-D011",
   "section": "D",
   "speaker": "田村",
   "text": "紙で楽器も作りました。",
   "start_sec": 109.205,
   "end_sec": 111.019,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D011-S05",
   "unit_id": "C22-D011",
   "section": "D",
   "speaker": "田村",
   "text": "これがその写真です。",
   "start_sec": 111.169,
   "end_sec": 112.664,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D012-S01",
   "unit_id": "C22-D012",
   "section": "D",
   "speaker": "ウェン",
   "text": "珍しい形ですね。",
   "start_sec": 113.014,
   "end_sec": 115.051,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D012-S02",
   "unit_id": "C22-D012",
   "section": "D",
   "speaker": "ウェン",
   "text": "手作りの楽器ですか。",
   "start_sec": 115.201,
   "end_sec": 117.527,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D012-S03",
   "unit_id": "C22-D012",
   "section": "D",
   "speaker": "ウェン",
   "text": "私も切紙で花を作ったことがありますが、楽器はありません。",
   "start_sec": 117.677,
   "end_sec": 124.107,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D013-S01",
   "unit_id": "C22-D013",
   "section": "D",
   "speaker": "田村",
   "text": "はい。",
   "start_sec": 124.457,
   "end_sec": 125.106,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D013-S02",
   "unit_id": "C22-D013",
   "section": "D",
   "speaker": "田村",
   "text": "演奏もしました。",
   "start_sec": 125.256,
   "end_sec": 126.522,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D013-S03",
   "unit_id": "C22-D013",
   "section": "D",
   "speaker": "田村",
   "text": "楽しかったです。",
   "start_sec": 126.672,
   "end_sec": 128.016,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D013-S04",
   "unit_id": "C22-D013",
   "section": "D",
   "speaker": "田村",
   "text": "10月には公民館で写真の展覧会を開きますよ。",
   "start_sec": 128.166,
   "end_sec": 132.366,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D013-S05",
   "unit_id": "C22-D013",
   "section": "D",
   "speaker": "田村",
   "text": "写真なんかも出したいですね。",
   "start_sec": 132.516,
   "end_sec": 134.584,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D014-S01",
   "unit_id": "C22-D014",
   "section": "D",
   "speaker": "ウェン",
   "text": "まず写真散歩に行きたいです。",
   "start_sec": 134.934,
   "end_sec": 138.205,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D014-S02",
   "unit_id": "C22-D014",
   "section": "D",
   "speaker": "ウェン",
   "text": "9月12日に一緒に行きませんか。",
   "start_sec": 138.355,
   "end_sec": 141.835,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D014-S03",
   "unit_id": "C22-D014",
   "section": "D",
   "speaker": "ウェン",
   "text": "海で泳ぐのは好きではありませんが、海の写真は好きです。",
   "start_sec": 141.985,
   "end_sec": 146.828,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D015-S01",
   "unit_id": "C22-D015",
   "section": "D",
   "speaker": "田村",
   "text": "12日は朝から用事があるんです。",
   "start_sec": 147.178,
   "end_sec": 150.192,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D015-S02",
   "unit_id": "C22-D015",
   "section": "D",
   "speaker": "田村",
   "text": "26日はまだ決めていません。",
   "start_sec": 150.342,
   "end_sec": 152.664,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D015-S03",
   "unit_id": "C22-D015",
   "section": "D",
   "speaker": "田村",
   "text": "釣りのグループはどうですか。",
   "start_sec": 152.814,
   "end_sec": 154.664,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D016-S01",
   "unit_id": "C22-D016",
   "section": "D",
   "speaker": "ウェン",
   "text": "釣りは一度もしたことがありません。",
   "start_sec": 155.014,
   "end_sec": 157.889,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D016-S02",
   "unit_id": "C22-D016",
   "section": "D",
   "speaker": "ウェン",
   "text": "海で泳いだこともありません。",
   "start_sec": 158.039,
   "end_sec": 160.352,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D016-S03",
   "unit_id": "C22-D016",
   "section": "D",
   "speaker": "ウェン",
   "text": "初めての人も参加してもいいですか。",
   "start_sec": 160.502,
   "end_sec": 163.42,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D016-S04",
   "unit_id": "C22-D016",
   "section": "D",
   "speaker": "ウェン",
   "text": "道具もありません。",
   "start_sec": 163.57,
   "end_sec": 165.559,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D017-S01",
   "unit_id": "C22-D017",
   "section": "D",
   "speaker": "田村",
   "text": "公民館の道具を使ってもいいです。",
   "start_sec": 165.909,
   "end_sec": 168.244,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D017-S02",
   "unit_id": "C22-D017",
   "section": "D",
   "speaker": "田村",
   "text": "参加費は300円で、6日と20日の午前7時から10時までです。",
   "start_sec": 168.394,
   "end_sec": 173.612,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D018-S01",
   "unit_id": "C22-D018",
   "section": "D",
   "speaker": "ウェン",
   "text": "6日は友達が家に来ます。",
   "start_sec": 173.962,
   "end_sec": 176.752,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D018-S02",
   "unit_id": "C22-D018",
   "section": "D",
   "speaker": "ウェン",
   "text": "20日は大丈夫です。",
   "start_sec": 176.902,
   "end_sec": 178.587,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D018-S03",
   "unit_id": "C22-D018",
   "section": "D",
   "speaker": "ウェン",
   "text": "初めての釣りに挑戦したいです。",
   "start_sec": 178.737,
   "end_sec": 181.07,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D018-S04",
   "unit_id": "C22-D018",
   "section": "D",
   "speaker": "ウェン",
   "text": "田村さんも大丈夫ですか。",
   "start_sec": 181.22,
   "end_sec": 183.345,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D019-S01",
   "unit_id": "C22-D019",
   "section": "D",
   "speaker": "田村",
   "text": "はい。",
   "start_sec": 183.695,
   "end_sec": 184.434,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D019-S02",
   "unit_id": "C22-D019",
   "section": "D",
   "speaker": "田村",
   "text": "一緒に行きましょう。",
   "start_sec": 184.584,
   "end_sec": 185.819,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D019-S03",
   "unit_id": "C22-D019",
   "section": "D",
   "speaker": "田村",
   "text": "前の日は釣りの準備をして寝ます。",
   "start_sec": 185.969,
   "end_sec": 188.263,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D019-S04",
   "unit_id": "C22-D019",
   "section": "D",
   "speaker": "田村",
   "text": "写真も撮りましょう。",
   "start_sec": 188.413,
   "end_sec": 189.548,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D020-S01",
   "unit_id": "C22-D020",
   "section": "D",
   "speaker": "ウェン",
   "text": "今週の金曜日、仕事の後で一緒に申し込みに行きませんか。",
   "start_sec": 189.898,
   "end_sec": 195.139,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D020-S02",
   "unit_id": "C22-D020",
   "section": "D",
   "speaker": "ウェン",
   "text": "受付は5時まででしたね。",
   "start_sec": 195.289,
   "end_sec": 197.283,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D021-S01",
   "unit_id": "C22-D021",
   "section": "D",
   "speaker": "田村",
   "text": "はい。",
   "start_sec": 197.633,
   "end_sec": 198.23,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D021-S02",
   "unit_id": "C22-D021",
   "section": "D",
   "speaker": "田村",
   "text": "仕事は4時に終わります。",
   "start_sec": 198.38,
   "end_sec": 200.034,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D021-S03",
   "unit_id": "C22-D021",
   "section": "D",
   "speaker": "田村",
   "text": "会社の前で待ちます。",
   "start_sec": 200.184,
   "end_sec": 201.475,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D021-S04",
   "unit_id": "C22-D021",
   "section": "D",
   "speaker": "田村",
   "text": "申し込みは参加する前の日までですが、早く行きましょう。",
   "start_sec": 201.625,
   "end_sec": 205.129,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D022-S01",
   "unit_id": "C22-D022",
   "section": "D",
   "speaker": "ウェン",
   "text": "雨の日も釣りをしますか。",
   "start_sec": 205.479,
   "end_sec": 207.818,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D022-S02",
   "unit_id": "C22-D022",
   "section": "D",
   "speaker": "ウェン",
   "text": "公民館に確認したいです。",
   "start_sec": 207.968,
   "end_sec": 210.048,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D023-S01",
   "unit_id": "C22-D023",
   "section": "D",
   "speaker": "田村",
   "text": "私も知りません。",
   "start_sec": 210.398,
   "end_sec": 211.591,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D023-S02",
   "unit_id": "C22-D023",
   "section": "D",
   "speaker": "田村",
   "text": "金曜日に受付で確認しましょう。",
   "start_sec": 211.741,
   "end_sec": 214.062,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D023-S03",
   "unit_id": "C22-D023",
   "section": "D",
   "speaker": "田村",
   "text": "帰りにコーヒーでも飲みませんか。",
   "start_sec": 214.212,
   "end_sec": 216.002,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D024-S01",
   "unit_id": "C22-D024",
   "section": "D",
   "speaker": "ウェン",
   "text": "いいですね。",
   "start_sec": 216.352,
   "end_sec": 217.579,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C22-D024-S02",
   "unit_id": "C22-D024",
   "section": "D",
   "speaker": "ウェン",
   "text": "二人の休みの日に、外で活動したり、喫茶店で話したりしましょう。",
   "start_sec": 217.729,
   "end_sec": 222.484,
   "review_flags": [],
   "replacement": null
  }
 ]
}
