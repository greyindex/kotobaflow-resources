   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C21-D022-S03",
   "unit_id": "C21-D022",
   "section": "D",
   "speaker": "アミナ",
   "text": "私は17日の5時半から7時半まで準備を手伝います。",
