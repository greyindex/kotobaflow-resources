 "source_chapter": 74,
 "turns": [
  {
   "turn_id": "C74-D001",
   "turn_index": 0,
   "speaker": "佐藤",
   "source_text": "今日は交換会の会場と展示を相談しましょう。私は司会ですが、正式な議長を選ぶ会議ではありません。議事の記録には決定と提案を分けます。",
   "sentence_ids": [
    "C74-D001-01",
    "C74-D001-02",
    "C74-D001-03"
   ],
   "voice_id": "ja-jp-advisor-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 0.0,
   "end_sec": 10.337,
   "duration_sec": 10.337
  },
  {
   "turn_id": "C74-D002",
   "turn_index": 1,
   "speaker": "林梅",
   "source_text": "私は案Ａに賛成です。毎回同じ場所なら案内しやすいと思います。",
   "sentence_ids": [
    "C74-D002-01",
    "C74-D002-02"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 10.687,
   "end_sec": 16.1,
   "duration_sec": 5.413
  },
  {
   "turn_id": "C74-D003",
   "turn_index": 2,
   "speaker": "ハサン",
   "source_text": "なるほど。ただ、家賃だけで六万円です。設備の追加料金は分かりません。",
   "sentence_ids": [
    "C74-D003-01",
    "C74-D003-02",
    "C74-D003-03"
   ],
   "voice_id": "ja-jp-techagent-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 16.45,
   "end_sec": 22.267,
   "duration_sec": 5.817
  },
  {
   "turn_id": "C74-D004",
   "turn_index": 3,
   "speaker": "林梅",
   "source_text": "総費用ではないんですね。そこを読み間違えていました。",
   "sentence_ids": [
    "C74-D004-01",
    "C74-D004-02"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 22.617,
   "end_sec": 27.138,
   "duration_sec": 4.521
  },
  {
   "turn_id": "C74-D005",
   "turn_index": 4,
   "speaker": "佐藤",
   "source_text": "今の「なるほど」は賛成ですか。理由は分かったという意味ですか。",
   "sentence_ids": [
    "C74-D005-01",
    "C74-D005-02"
   ],
   "voice_id": "ja-jp-advisor-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 27.488,
   "end_sec": 31.727,
   "duration_sec": 4.239
  },
  {
   "turn_id": "C74-D006",
   "turn_index": 5,
   "speaker": "ハサン",
   "source_text": "理由は分かったという意味です。費用から考えて案Ｂを提案します。",
   "sentence_ids": [
    "C74-D006-01",
    "C74-D006-02"
   ],
   "voice_id": "ja-jp-techagent-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 32.077,
   "end_sec": 36.298,
   "duration_sec": 4.221
  },
  {
   "turn_id": "C74-D007",
   "turn_index": 6,
   "speaker": "林梅",
   "source_text": "安い一方で、場所が変わると来られない人もいるかもしれません。",
   "sentence_ids": [
    "C74-D007-01"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 36.648,
   "end_sec": 41.499,
   "duration_sec": 4.851
  },
  {
   "turn_id": "C74-D008",
   "turn_index": 7,
   "speaker": "ハサン",
   "source_text": "安ければ参加しやすいとは限りませんね。経路も調べましょう。",
   "sentence_ids": [
    "C74-D008-01",
    "C74-D008-02"
   ],
   "voice_id": "ja-jp-techagent-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 41.849,
   "end_sec": 45.688,
   "duration_sec": 3.839
  },
  {
   "turn_id": "C74-D009",
   "turn_index": 8,
   "speaker": "佐藤",
   "source_text": "十四人が場所の固定を優先していますが、回答者は二十四人ですね。",
   "sentence_ids": [
    "C74-D009-01"
   ],
   "voice_id": "ja-jp-advisor-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 46.038,
   "end_sec": 51.896,
   "duration_sec": 5.858
  },
  {
   "turn_id": "C74-D010",
   "turn_index": 9,
   "speaker": "林梅",
   "source_text": "残り十人は低料金を優先しています。未参加者の意見は分かりません。",
   "sentence_ids": [
    "C74-D010-01",
    "C74-D010-02"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 52.246,
   "end_sec": 57.424,
   "duration_sec": 5.178
  },
  {
   "turn_id": "C74-D011",
   "turn_index": 10,
   "speaker": "ハサン",
   "source_text": "晴れた日は屋外に物を並べ、雨の日だけ屋内を使うのはどうですか。",
   "sentence_ids": [
    "C74-D011-01"
   ],
   "voice_id": "ja-jp-techagent-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 57.774,
   "end_sec": 62.455,
   "duration_sec": 4.681
  },
  {
   "turn_id": "C74-D012",
   "turn_index": 11,
   "speaker": "林梅",
   "source_text": "屋外も使えるんですか。資料には書いてありません。",
   "sentence_ids": [
    "C74-D012-01",
    "C74-D012-02"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 62.805,
   "end_sec": 66.602,
   "duration_sec": 3.797
  },
  {
   "turn_id": "C74-D013",
   "turn_index": 12,
   "speaker": "ハサン",
   "source_text": "今の案は撤回します。天気で場所を変えると連絡も増えますね。",
   "sentence_ids": [
    "C74-D013-01",
    "C74-D013-02"
   ],
   "voice_id": "ja-jp-techagent-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 66.952,
   "end_sec": 71.322,
   "duration_sec": 4.37
  },
  {
   "turn_id": "C74-D014",
   "turn_index": 13,
   "speaker": "佐藤",
   "source_text": "では屋内を使う提案ですね。雨天の搬入はどうしますか。",
   "sentence_ids": [
    "C74-D014-01",
    "C74-D014-02"
   ],
   "voice_id": "ja-jp-advisor-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 71.672,
   "end_sec": 76.362,
   "duration_sec": 4.69
  },
  {
   "turn_id": "C74-D015",
   "turn_index": 14,
   "speaker": "林梅",
   "source_text": "入口までぬれずに運べるとは限りません。経路の確認が先です。",
   "sentence_ids": [
    "C74-D015-01",
    "C74-D015-02"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 76.712,
   "end_sec": 81.379,
   "duration_sec": 4.667
  },
  {
   "turn_id": "C74-D016",
   "turn_index": 15,
   "speaker": "ハサン",
   "source_text": "雨でも開くというより、開ける条件があるかを調べたいです。",
   "sentence_ids": [
    "C74-D016-01"
   ],
   "voice_id": "ja-jp-techagent-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 81.729,
   "end_sec": 86.477,
   "duration_sec": 4.748
  },
  {
   "turn_id": "C74-D017",
   "turn_index": 16,
   "speaker": "佐藤",
   "source_text": "確認前に雨天の開催を約束しないようにしましょう。",
   "sentence_ids": [
    "C74-D017-01"
   ],
   "voice_id": "ja-jp-advisor-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 86.827,
   "end_sec": 90.133,
   "duration_sec": 3.306
  },
  {
   "turn_id": "C74-D018",
   "turn_index": 17,
   "speaker": "林梅",
   "source_text": "私も意見を変えます。案Ａには利点があるものの、今は選べません。",
   "sentence_ids": [
    "C74-D018-01",
    "C74-D018-02"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 90.483,
   "end_sec": 96.268,
   "duration_sec": 5.785
  },
  {
   "turn_id": "C74-D019",
   "turn_index": 18,
   "speaker": "ハサン",
   "source_text": "では案Ｂに決定ですね。",
   "sentence_ids": [
    "C74-D019-01"
   ],
   "voice_id": "ja-jp-techagent-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 96.618,
   "end_sec": 99.198,
   "duration_sec": 2.58
  },
  {
   "turn_id": "C74-D020",
   "turn_index": 19,
   "speaker": "林梅",
   "source_text": "決定というより暫定案です。読んだ限りでは経路も未確認です。",
   "sentence_ids": [
    "C74-D020-01",
    "C74-D020-02"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 99.548,
   "end_sec": 104.867,
   "duration_sec": 5.319
  },
  {
   "turn_id": "C74-D021",
   "turn_index": 20,
   "speaker": "佐藤",
   "source_text": "Ｂを先に調べることで合意したわけですね。予約ではありません。",
   "sentence_ids": [
    "C74-D021-01",
    "C74-D021-02"
   ],
   "voice_id": "ja-jp-advisor-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 105.217,
   "end_sec": 110.193,
   "duration_sec": 4.976
  },
  {
   "turn_id": "C74-D022",
   "turn_index": 21,
   "speaker": "ハサン",
   "source_text": "週二回使え、二つの費用が計三万五千円ということから、候補に残せますね。",
   "sentence_ids": [
    "C74-D022-01"
   ],
   "voice_id": "ja-jp-techagent-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 110.543,
   "end_sec": 116.71,
   "duration_sec": 6.167
  },
  {
   "turn_id": "C74-D023",
   "turn_index": 22,
   "speaker": "佐藤",
   "source_text": "林さん、毎月の会場、経路、人数上限を問い合わせてもらえますか。",
   "sentence_ids": [
    "C74-D023-01"
   ],
   "voice_id": "ja-jp-advisor-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 117.06,
   "end_sec": 121.781,
   "duration_sec": 4.721
  },
  {
   "turn_id": "C74-D024",
   "turn_index": 23,
   "speaker": "林梅",
   "source_text": "はい。備品の範囲と、搬入、設営、撤去の時間も聞きます。",
   "sentence_ids": [
    "C74-D024-01",
    "C74-D024-02"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 122.131,
   "end_sec": 126.967,
   "duration_sec": 4.836
  },
  {
   "turn_id": "C74-D025",
   "turn_index": 24,
   "speaker": "ハサン",
   "source_text": "私は搬入を、あ、言い直します。力仕事の人数を考えます。",
   "sentence_ids": [
    "C74-D025-01",
    "C74-D025-02"
   ],
   "voice_id": "ja-jp-techagent-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 127.317,
   "end_sec": 132.258,
   "duration_sec": 4.941
  },
  {
   "turn_id": "C74-D026",
   "turn_index": 25,
   "speaker": "佐藤",
   "source_text": "全部運ぶのではなく、人手を考える役割ですね。",
   "sentence_ids": [
    "C74-D026-01"
   ],
   "voice_id": "ja-jp-advisor-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 132.608,
   "end_sec": 136.115,
   "duration_sec": 3.507
  },
  {
   "turn_id": "C74-D027",
   "turn_index": 26,
   "speaker": "ハサン",
   "source_text": "はい。頼む前に本人の都合と意思を確認します。",
   "sentence_ids": [
    "C74-D027-01",
    "C74-D027-02"
   ],
   "voice_id": "ja-jp-techagent-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 136.465,
   "end_sec": 140.018,
   "duration_sec": 3.553
  },
  {
   "turn_id": "C74-D028",
   "turn_index": 27,
   "speaker": "佐藤",
   "source_text": "私は変更の通知案を作ります。三か月目の末に負担も調べます。",
   "sentence_ids": [
    "C74-D028-01",
    "C74-D028-02"
   ],
   "voice_id": "ja-jp-advisor-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 140.368,
   "end_sec": 144.922,
   "duration_sec": 4.554
  },
  {
   "turn_id": "C74-D029",
   "turn_index": 28,
   "speaker": "林梅",
   "source_text": "最後が聞き取れませんでした。聞き返してもいいですか。三か月で終了ですか。",
   "sentence_ids": [
    "C74-D029-01",
    "C74-D029-02",
    "C74-D029-03"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 145.272,
   "end_sec": 151.695,
   "duration_sec": 6.423
  },
  {
   "turn_id": "C74-D030",
   "turn_index": 29,
   "speaker": "佐藤",
   "source_text": "いえ、全体は六か月で、後半を調整するための調査です。成果はまだありません。",
   "sentence_ids": [
    "C74-D030-01",
    "C74-D030-02"
   ],
   "voice_id": "ja-jp-advisor-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 152.045,
   "end_sec": 158.223,
   "duration_sec": 6.178
  },
  {
   "turn_id": "C74-D031",
   "turn_index": 30,
   "speaker": "林梅",
   "source_text": "分かりました。日程と雨天の対応は回答を見て相談するんですね。",
   "sentence_ids": [
    "C74-D031-01",
    "C74-D031-02"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 158.573,
   "end_sec": 163.985,
   "duration_sec": 5.412
  },
  {
   "turn_id": "C74-D032",
   "turn_index": 31,
   "speaker": "林梅",
   "source_text": "二十四人は会場に入れる人数ではありませんね。",
   "sentence_ids": [
    "C74-D032-01"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 164.335,
   "end_sec": 167.879,
   "duration_sec": 3.544
  },
  {
   "turn_id": "C74-D033",
   "turn_index": 32,
   "speaker": "佐藤",
   "source_text": "ええ、調査の回答者です。定員は施設に確認します。",
   "sentence_ids": [
    "C74-D033-01",
    "C74-D033-02"
   ],
   "voice_id": "ja-jp-advisor-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 168.229,
   "end_sec": 172.536,
   "duration_sec": 4.307
  },
  {
   "turn_id": "C74-D034",
   "turn_index": 33,
   "speaker": "林梅",
   "source_text": "会場も毎月変わる可能性があるので、経路は毎回確認します。",
   "sentence_ids": [
    "C74-D034-01"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 172.886,
   "end_sec": 177.203,
   "duration_sec": 4.317
  },
  {
   "turn_id": "C74-D035",
   "turn_index": 34,
   "speaker": "ハサン",
   "source_text": "設備費に何が含まれるか分かれば、運ぶ物を考えられます。",
   "sentence_ids": [
    "C74-D035-01"
   ],
   "voice_id": "ja-jp-techagent-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 177.553,
   "end_sec": 182.33,
   "duration_sec": 4.777
  },
  {
   "turn_id": "C74-D036",
   "turn_index": 35,
   "speaker": "佐藤",
   "source_text": "回答を共有してから分担を決めましょう。次の議題は展示です。",
   "sentence_ids": [
    "C74-D036-01",
    "C74-D036-02"
   ],
   "voice_id": "ja-jp-advisor-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 182.68,
   "end_sec": 187.364,
   "duration_sec": 4.684
  },
  {
   "turn_id": "C74-D037",
   "turn_index": 36,
   "speaker": "ハサン",
   "source_text": "はい。今日の最終的な合意と、まだ決めていないことを分けて記録しておきましょう。展示も、会場の条件が分かるまでは提案として扱います。",
   "sentence_ids": [
    "C74-D037-01",
    "C74-D037-02",
    "C74-D037-03"
   ],
   "voice_id": "ja-jp-techagent-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 187.714,
   "end_sec": 199.048,
   "duration_sec": 11.334
  },
  {
   "turn_id": "C74-D038",
   "turn_index": 37,
   "speaker": "ハサン",
   "source_text": "総じて写真なら準備しやすそうですが、紹介する文化をどう選びますか。",
   "sentence_ids": [
    "C74-D038-01"
   ],
   "voice_id": "ja-jp-techagent-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 199.398,
   "end_sec": 206.346,
   "duration_sec": 6.948
  },
  {
   "turn_id": "C74-D039",
   "turn_index": 38,
   "speaker": "林梅",
   "source_text": "国際フェスティバルという名前にして、民族舞踊も実演してはどうでしょう。",
   "sentence_ids": [
    "C74-D039-01"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 206.696,
   "end_sec": 211.378,
   "duration_sec": 4.682
  },
  {
   "turn_id": "C74-D040",
   "turn_index": 39,
   "speaker": "佐藤",
   "source_text": "まず展示の目的を考えませんか。何でも取り上げると、交換会の場所がなくなります。",
   "sentence_ids": [
    "C74-D040-01",
    "C74-D040-02"
   ],
   "voice_id": "ja-jp-advisor-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 211.728,
   "end_sec": 218.28,
   "duration_sec": 6.552
  },
  {
   "turn_id": "C74-D041",
   "turn_index": 40,
   "speaker": "ハサン",
   "source_text": "伝統を守る功罪について討論するより、道具を使った経験をざっくばらんに話す座談会ならできます。",
   "sentence_ids": [
    "C74-D041-01"
   ],
   "voice_id": "ja-jp-techagent-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 218.63,
   "end_sec": 225.689,
   "duration_sec": 7.059
  },
  {
   "turn_id": "C74-D042",
   "turn_index": 41,
   "speaker": "林梅",
   "source_text": "そうですね。茶道の茶わんや華道の花器なら、使い方を話せます。披露宴の写真だけでは、交換する物との関係が弱いですね。",
   "sentence_ids": [
    "C74-D042-01",
    "C74-D042-02",
    "C74-D042-03"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 226.038,
   "end_sec": 236.895,
   "duration_sec": 10.857
  },
  {
   "turn_id": "C74-D043",
   "turn_index": 42,
   "speaker": "ハサン",
   "source_text": "正月遊びの道具はどうですか。いろはガルタを持っています。カルタ取りなら室内で一緒にできます。",
   "sentence_ids": [
    "C74-D043-01",
    "C74-D043-02",
    "C74-D043-03"
   ],
   "voice_id": "ja-jp-techagent-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 237.245,
   "end_sec": 243.037,
   "duration_sec": 5.792
  },
  {
   "turn_id": "C74-D044",
   "turn_index": 43,
   "speaker": "林梅",
   "source_text": "凧揚げは屋外が必要ですね。羽根つきも広さを確認しないと。こま回しは床を傷つけませんか。",
   "sentence_ids": [
    "C74-D044-01",
    "C74-D044-02",
    "C74-D044-03"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 243.387,
   "end_sec": 251.946,
   "duration_sec": 8.559
  },
  {
   "turn_id": "C74-D045",
   "turn_index": 44,
   "speaker": "佐藤",
   "source_text": "福笑いとすごろくなら机で試せそうです。でも今は持ち物の候補だけ記録しましょう。",
   "sentence_ids": [
    "C74-D045-01",
    "C74-D045-02"
   ],
   "voice_id": "ja-jp-advisor-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 252.296,
   "end_sec": 258.677,
   "duration_sec": 6.381
  },
  {
   "turn_id": "C74-D046",
   "turn_index": 45,
   "speaker": "ハサン",
   "source_text": "民謡を歌い継ぐ人から盆踊りの写真も届いています。歌を流すより、踊りに使った物を見せる方がテーマに合いますね。",
   "sentence_ids": [
    "C74-D046-01",
    "C74-D046-02"
   ],
   "voice_id": "ja-jp-techagent-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 259.027,
   "end_sec": 267.389,
   "duration_sec": 8.362
  },
  {
   "turn_id": "C74-D047",
   "turn_index": 46,
   "speaker": "林梅",
   "source_text": "京劇と地方劇を紹介したい人もいます。衣装の写真はよさそうですが、歌舞伎も含めて舞台を作るのは無理ですね。",
   "sentence_ids": [
    "C74-D047-01",
    "C74-D047-02"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 267.739,
   "end_sec": 276.749,
   "duration_sec": 9.01
  },
  {
   "turn_id": "C74-D048",
   "turn_index": 47,
   "speaker": "ハサン",
   "source_text": "相撲の写真には力士の名前より、道具の説明が欲しいです。「国技だから」という理由だけでは選べません。",
   "sentence_ids": [
    "C74-D048-01",
    "C74-D048-02"
   ],
   "voice_id": "ja-jp-techagent-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 277.099,
   "end_sec": 285.491,
   "duration_sec": 8.392
  },
  {
   "turn_id": "C74-D049",
   "turn_index": 48,
   "speaker": "佐藤",
   "source_text": "建設的な問いかけですね。皆さんの見解が変わりました。賛成派と反対派に分けるより、共通の条件を探せました。",
   "sentence_ids": [
    "C74-D049-01",
    "C74-D049-02",
    "C74-D049-03"
   ],
   "voice_id": "ja-jp-advisor-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 285.841,
   "end_sec": 294.433,
   "duration_sec": 8.592
  },
  {
   "turn_id": "C74-D050",
   "turn_index": 49,
   "speaker": "林梅",
   "source_text": "何を残したいのかという質問を投げかける方が、すぐ切り返すより話が進みますね。",
   "sentence_ids": [
    "C74-D050-01"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 294.783,
   "end_sec": 301.142,
   "duration_sec": 6.359
  },
  {
   "turn_id": "C74-D051",
   "turn_index": 50,
   "speaker": "ハサン",
   "source_text": "話し上手でも聞き下手では困りますね。今日は林さんの質問に一本とられました。",
   "sentence_ids": [
    "C74-D051-01",
    "C74-D051-02"
   ],
   "voice_id": "ja-jp-techagent-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 301.493,
   "end_sec": 308.738,
   "duration_sec": 7.245
  },
  {
   "turn_id": "C74-D052",
   "turn_index": 51,
   "speaker": "佐藤",
   "source_text": "では道具と経験を中心にする案を記録します。展示の量や実施の可否は、施設の回答を見て判断しましょう。",
   "sentence_ids": [
    "C74-D052-01",
    "C74-D052-02"
   ],
   "voice_id": "ja-jp-advisor-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 309.088,
   "end_sec": 317.915,
   "duration_sec": 8.827
  }
 ],
 "sentence_intervals": [
  {
   "sentence_id": "C74-D001-01",
   "unit_id": "C74-D001",
   "section": "D",
   "speaker": "佐藤",
   "text": "今日は交換会の会場と展示を相談しましょう。",
   "start_sec": 0.0,
   "end_sec": 3.125,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D001-02",
   "unit_id": "C74-D001",
   "section": "D",
   "speaker": "佐藤",
   "text": "私は司会ですが、正式な議長を選ぶ会議ではありません。",
   "start_sec": 3.275,
   "end_sec": 7.193,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D001-03",
   "unit_id": "C74-D001",
   "section": "D",
   "speaker": "佐藤",
   "text": "議事の記録には決定と提案を分けます。",
   "start_sec": 7.343,
   "end_sec": 10.337,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D002-01",
   "unit_id": "C74-D002",
   "section": "D",
   "speaker": "林梅",
   "text": "私は案Ａに賛成です。",
   "start_sec": 10.687,
   "end_sec": 13.102,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D002-02",
   "unit_id": "C74-D002",
   "section": "D",
   "speaker": "林梅",
   "text": "毎回同じ場所なら案内しやすいと思います。",
   "start_sec": 13.252,
   "end_sec": 16.1,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D003-01",
   "unit_id": "C74-D003",
   "section": "D",
   "speaker": "ハサン",
   "text": "なるほど。",
   "start_sec": 16.45,
   "end_sec": 17.478,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D003-02",
   "unit_id": "C74-D003",
   "section": "D",
   "speaker": "ハサン",
   "text": "ただ、家賃だけで六万円です。",
   "start_sec": 17.628,
   "end_sec": 20.017,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D003-03",
   "unit_id": "C74-D003",
   "section": "D",
   "speaker": "ハサン",
   "text": "設備の追加料金は分かりません。",
   "start_sec": 20.167,
   "end_sec": 22.267,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D004-01",
   "unit_id": "C74-D004",
   "section": "D",
   "speaker": "林梅",
   "text": "総費用ではないんですね。",
   "start_sec": 22.617,
   "end_sec": 25.082,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D004-02",
   "unit_id": "C74-D004",
   "section": "D",
   "speaker": "林梅",
   "text": "そこを読み間違えていました。",
   "start_sec": 25.232,
   "end_sec": 27.138,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D005-01",
   "unit_id": "C74-D005",
   "section": "D",
   "speaker": "佐藤",
   "text": "今の「なるほど」は賛成ですか。",
   "start_sec": 27.488,
   "end_sec": 29.719,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D005-02",
   "unit_id": "C74-D005",
   "section": "D",
   "speaker": "佐藤",
   "text": "理由は分かったという意味ですか。",
   "start_sec": 29.869,
   "end_sec": 31.727,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D006-01",
   "unit_id": "C74-D006",
   "section": "D",
   "speaker": "ハサン",
   "text": "理由は分かったという意味です。",
   "start_sec": 32.077,
   "end_sec": 33.573,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D006-02",
   "unit_id": "C74-D006",
   "section": "D",
   "speaker": "ハサン",
   "text": "費用から考えて案Ｂを提案します。",
   "start_sec": 33.723,
   "end_sec": 36.298,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D007-01",
   "unit_id": "C74-D007",
   "section": "D",
   "speaker": "林梅",
   "text": "安い一方で、場所が変わると来られない人もいるかもしれません。",
   "start_sec": 36.648,
   "end_sec": 41.499,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D008-01",
   "unit_id": "C74-D008",
   "section": "D",
   "speaker": "ハサン",
   "text": "安ければ参加しやすいとは限りませんね。",
   "start_sec": 41.849,
   "end_sec": 44.167,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D008-02",
   "unit_id": "C74-D008",
   "section": "D",
   "speaker": "ハサン",
   "text": "経路も調べましょう。",
   "start_sec": 44.317,
   "end_sec": 45.688,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D009-01",
   "unit_id": "C74-D009",
   "section": "D",
   "speaker": "佐藤",
   "text": "十四人が場所の固定を優先していますが、回答者は二十四人ですね。",
   "start_sec": 46.038,
   "end_sec": 51.896,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D010-01",
   "unit_id": "C74-D010",
   "section": "D",
   "speaker": "林梅",
   "text": "残り十人は低料金を優先しています。",
   "start_sec": 52.246,
   "end_sec": 55.252,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D010-02",
   "unit_id": "C74-D010",
   "section": "D",
   "speaker": "林梅",
   "text": "未参加者の意見は分かりません。",
   "start_sec": 55.401,
   "end_sec": 57.424,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D011-01",
   "unit_id": "C74-D011",
   "section": "D",
   "speaker": "ハサン",
   "text": "晴れた日は屋外に物を並べ、雨の日だけ屋内を使うのはどうですか。",
   "start_sec": 57.774,
   "end_sec": 62.455,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D012-01",
   "unit_id": "C74-D012",
   "section": "D",
   "speaker": "林梅",
   "text": "屋外も使えるんですか。",
   "start_sec": 62.805,
   "end_sec": 64.739,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D012-02",
   "unit_id": "C74-D012",
   "section": "D",
   "speaker": "林梅",
   "text": "資料には書いてありません。",
   "start_sec": 64.889,
   "end_sec": 66.602,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D013-01",
   "unit_id": "C74-D013",
   "section": "D",
   "speaker": "ハサン",
   "text": "今の案は撤回します。",
   "start_sec": 66.952,
   "end_sec": 68.538,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D013-02",
   "unit_id": "C74-D013",
   "section": "D",
   "speaker": "ハサン",
   "text": "天気で場所を変えると連絡も増えますね。",
   "start_sec": 68.688,
   "end_sec": 71.322,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D014-01",
   "unit_id": "C74-D014",
   "section": "D",
   "speaker": "佐藤",
   "text": "では屋内を使う提案ですね。",
   "start_sec": 71.672,
   "end_sec": 74.294,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D014-02",
   "unit_id": "C74-D014",
   "section": "D",
   "speaker": "佐藤",
   "text": "雨天の搬入はどうしますか。",
   "start_sec": 74.444,
   "end_sec": 76.362,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D015-01",
   "unit_id": "C74-D015",
   "section": "D",
   "speaker": "林梅",
   "text": "入口までぬれずに運べるとは限りません。",
   "start_sec": 76.712,
   "end_sec": 79.62,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D015-02",
   "unit_id": "C74-D015",
   "section": "D",
   "speaker": "林梅",
   "text": "経路の確認が先です。",
   "start_sec": 79.77,
   "end_sec": 81.379,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D016-01",
   "unit_id": "C74-D016",
   "section": "D",
   "speaker": "ハサン",
   "text": "雨でも開くというより、開ける条件があるかを調べたいです。",
   "start_sec": 81.729,
   "end_sec": 86.477,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D017-01",
   "unit_id": "C74-D017",
   "section": "D",
   "speaker": "佐藤",
   "text": "確認前に雨天の開催を約束しないようにしましょう。",
   "start_sec": 86.827,
   "end_sec": 90.133,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D018-01",
   "unit_id": "C74-D018",
   "section": "D",
   "speaker": "林梅",
   "text": "私も意見を変えます。",
   "start_sec": 90.483,
   "end_sec": 92.341,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D018-02",
   "unit_id": "C74-D018",
   "section": "D",
   "speaker": "林梅",
   "text": "案Ａには利点があるものの、今は選べません。",
   "start_sec": 92.491,
   "end_sec": 96.268,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D019-01",
   "unit_id": "C74-D019",
   "section": "D",
   "speaker": "ハサン",
   "text": "では案Ｂに決定ですね。",
   "start_sec": 96.618,
   "end_sec": 99.198,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D020-01",
   "unit_id": "C74-D020",
   "section": "D",
   "speaker": "林梅",
   "text": "決定というより暫定案です。",
   "start_sec": 99.548,
   "end_sec": 102.238,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D020-02",
   "unit_id": "C74-D020",
   "section": "D",
   "speaker": "林梅",
   "text": "読んだ限りでは経路も未確認です。",
   "start_sec": 102.388,
   "end_sec": 104.867,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D021-01",
   "unit_id": "C74-D021",
   "section": "D",
   "speaker": "佐藤",
   "text": "Ｂを先に調べることで合意したわけですね。",
   "start_sec": 105.217,
   "end_sec": 108.298,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D021-02",
   "unit_id": "C74-D021",
   "section": "D",
   "speaker": "佐藤",
   "text": "予約ではありません。",
   "start_sec": 108.448,
   "end_sec": 110.193,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D022-01",
   "unit_id": "C74-D022",
   "section": "D",
   "speaker": "ハサン",
   "text": "週二回使え、二つの費用が計三万五千円ということから、候補に残せますね。",
   "start_sec": 110.543,
   "end_sec": 116.71,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D023-01",
   "unit_id": "C74-D023",
   "section": "D",
   "speaker": "佐藤",
   "text": "林さん、毎月の会場、経路、人数上限を問い合わせてもらえますか。",
   "start_sec": 117.06,
   "end_sec": 121.781,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D024-01",
   "unit_id": "C74-D024",
   "section": "D",
   "speaker": "林梅",
   "text": "はい。",
   "start_sec": 122.131,
   "end_sec": 122.849,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D024-02",
   "unit_id": "C74-D024",
   "section": "D",
   "speaker": "林梅",
   "text": "備品の範囲と、搬入、設営、撤去の時間も聞きます。",
   "start_sec": 122.999,
   "end_sec": 126.967,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D025-01",
   "unit_id": "C74-D025",
   "section": "D",
   "speaker": "ハサン",
   "text": "私は搬入を、あ、言い直します。",
   "start_sec": 127.317,
   "end_sec": 129.977,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D025-02",
   "unit_id": "C74-D025",
   "section": "D",
   "speaker": "ハサン",
   "text": "力仕事の人数を考えます。",
   "start_sec": 130.127,
   "end_sec": 132.258,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D026-01",
   "unit_id": "C74-D026",
   "section": "D",
   "speaker": "佐藤",
   "text": "全部運ぶのではなく、人手を考える役割ですね。",
   "start_sec": 132.608,
   "end_sec": 136.115,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D027-01",
   "unit_id": "C74-D027",
   "section": "D",
   "speaker": "ハサン",
   "text": "はい。",
   "start_sec": 136.465,
   "end_sec": 137.151,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D027-02",
   "unit_id": "C74-D027",
   "section": "D",
   "speaker": "ハサン",
   "text": "頼む前に本人の都合と意思を確認します。",
   "start_sec": 137.301,
   "end_sec": 140.018,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D028-01",
   "unit_id": "C74-D028",
   "section": "D",
   "speaker": "佐藤",
   "text": "私は変更の通知案を作ります。",
   "start_sec": 140.368,
   "end_sec": 142.447,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D028-02",
   "unit_id": "C74-D028",
   "section": "D",
   "speaker": "佐藤",
   "text": "三か月目の末に負担も調べます。",
   "start_sec": 142.597,
   "end_sec": 144.922,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D029-01",
   "unit_id": "C74-D029",
   "section": "D",
   "speaker": "林梅",
   "text": "最後が聞き取れませんでした。",
   "start_sec": 145.272,
   "end_sec": 147.576,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D029-02",
   "unit_id": "C74-D029",
   "section": "D",
   "speaker": "林梅",
   "text": "聞き返してもいいですか。",
   "start_sec": 147.726,
   "end_sec": 149.491,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D029-03",
   "unit_id": "C74-D029",
   "section": "D",
   "speaker": "林梅",
   "text": "三か月で終了ですか。",
   "start_sec": 149.641,
   "end_sec": 151.695,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D030-01",
   "unit_id": "C74-D030",
   "section": "D",
   "speaker": "佐藤",
   "text": "いえ、全体は六か月で、後半を調整するための調査です。",
   "start_sec": 152.045,
   "end_sec": 156.52,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D030-02",
   "unit_id": "C74-D030",
   "section": "D",
   "speaker": "佐藤",
   "text": "成果はまだありません。",
   "start_sec": 156.67,
   "end_sec": 158.223,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D031-01",
   "unit_id": "C74-D031",
   "section": "D",
   "speaker": "林梅",
   "text": "分かりました。",
   "start_sec": 158.573,
   "end_sec": 159.745,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D031-02",
   "unit_id": "C74-D031",
   "section": "D",
   "speaker": "林梅",
   "text": "日程と雨天の対応は回答を見て相談するんですね。",
   "start_sec": 159.895,
   "end_sec": 163.985,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D032-01",
   "unit_id": "C74-D032",
   "section": "D",
   "speaker": "林梅",
   "text": "二十四人は会場に入れる人数ではありませんね。",
   "start_sec": 164.335,
   "end_sec": 167.879,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D033-01",
   "unit_id": "C74-D033",
   "section": "D",
   "speaker": "佐藤",
   "text": "ええ、調査の回答者です。",
   "start_sec": 168.229,
   "end_sec": 170.272,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D033-02",
   "unit_id": "C74-D033",
   "section": "D",
   "speaker": "佐藤",
   "text": "定員は施設に確認します。",
   "start_sec": 170.422,
   "end_sec": 172.536,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D034-01",
   "unit_id": "C74-D034",
   "section": "D",
   "speaker": "林梅",
   "text": "会場も毎月変わる可能性があるので、経路は毎回確認します。",
   "start_sec": 172.886,
   "end_sec": 177.203,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D035-01",
   "unit_id": "C74-D035",
   "section": "D",
   "speaker": "ハサン",
   "text": "設備費に何が含まれるか分かれば、運ぶ物を考えられます。",
   "start_sec": 177.553,
   "end_sec": 182.33,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D036-01",
   "unit_id": "C74-D036",
   "section": "D",
   "speaker": "佐藤",
   "text": "回答を共有してから分担を決めましょう。",
   "start_sec": 182.68,
   "end_sec": 185.337,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D036-02",
   "unit_id": "C74-D036",
   "section": "D",
   "speaker": "佐藤",
   "text": "次の議題は展示です。",
   "start_sec": 185.487,
   "end_sec": 187.364,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D037-01",
   "unit_id": "C74-D037",
   "section": "D",
   "speaker": "ハサン",
   "text": "はい。",
   "start_sec": 187.714,
   "end_sec": 188.67,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D037-02",
   "unit_id": "C74-D037",
   "section": "D",
   "speaker": "ハサン",
   "text": "今日の最終的な合意と、まだ決めていないことを分けて記録しておきましょう。",
   "start_sec": 188.82,
   "end_sec": 194.383,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D037-03",
   "unit_id": "C74-D037",
   "section": "D",
   "speaker": "ハサン",
   "text": "展示も、会場の条件が分かるまでは提案として扱います。",
   "start_sec": 194.533,
   "end_sec": 199.048,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D038-01",
   "unit_id": "C74-D038",
   "section": "D",
   "speaker": "ハサン",
   "text": "総じて写真なら準備しやすそうですが、紹介する文化をどう選びますか。",
   "start_sec": 199.398,
   "end_sec": 206.346,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D039-01",
   "unit_id": "C74-D039",
   "section": "D",
   "speaker": "林梅",
   "text": "国際フェスティバルという名前にして、民族舞踊も実演してはどうでしょう。",
   "start_sec": 206.696,
   "end_sec": 211.378,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D040-01",
   "unit_id": "C74-D040",
   "section": "D",
   "speaker": "佐藤",
   "text": "まず展示の目的を考えませんか。",
   "start_sec": 211.728,
   "end_sec": 214.562,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D040-02",
   "unit_id": "C74-D040",
   "section": "D",
   "speaker": "佐藤",
   "text": "何でも取り上げると、交換会の場所がなくなります。",
   "start_sec": 214.712,
   "end_sec": 218.28,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D041-01",
   "unit_id": "C74-D041",
   "section": "D",
   "speaker": "ハサン",
   "text": "伝統を守る功罪について討論するより、道具を使った経験をざっくばらんに話す座談会ならできます。",
   "start_sec": 218.63,
   "end_sec": 225.689,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D042-01",
   "unit_id": "C74-D042",
   "section": "D",
   "speaker": "林梅",
   "text": "そうですね。",
   "start_sec": 226.038,
   "end_sec": 227.347,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D042-02",
   "unit_id": "C74-D042",
   "section": "D",
   "speaker": "林梅",
   "text": "茶道の茶わんや華道の花器なら、使い方を話せます。",
   "start_sec": 227.497,
   "end_sec": 231.754,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D042-03",
   "unit_id": "C74-D042",
   "section": "D",
   "speaker": "林梅",
   "text": "披露宴の写真だけでは、交換する物との関係が弱いですね。",
   "start_sec": 231.904,
   "end_sec": 236.895,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D043-01",
   "unit_id": "C74-D043",
   "section": "D",
   "speaker": "ハサン",
   "text": "正月遊びの道具はどうですか。",
   "start_sec": 237.245,
   "end_sec": 238.941,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D043-02",
   "unit_id": "C74-D043",
   "section": "D",
   "speaker": "ハサン",
   "text": "いろはガルタを持っています。",
   "start_sec": 239.091,
   "end_sec": 240.814,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D043-03",
   "unit_id": "C74-D043",
   "section": "D",
   "speaker": "ハサン",
   "text": "カルタ取りなら室内で一緒にできます。",
   "start_sec": 240.964,
   "end_sec": 243.037,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D044-01",
   "unit_id": "C74-D044",
   "section": "D",
   "speaker": "林梅",
   "text": "凧揚げは屋外が必要ですね。",
   "start_sec": 243.387,
   "end_sec": 246.116,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D044-02",
   "unit_id": "C74-D044",
   "section": "D",
   "speaker": "林梅",
   "text": "羽根つきも広さを確認しないと。",
   "start_sec": 246.266,
   "end_sec": 248.853,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D044-03",
   "unit_id": "C74-D044",
   "section": "D",
   "speaker": "林梅",
   "text": "こま回しは床を傷つけませんか。",
   "start_sec": 249.003,
   "end_sec": 251.946,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D045-01",
   "unit_id": "C74-D045",
   "section": "D",
   "speaker": "佐藤",
   "text": "福笑いとすごろくなら机で試せそうです。",
   "start_sec": 252.296,
   "end_sec": 255.595,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D045-02",
   "unit_id": "C74-D045",
   "section": "D",
   "speaker": "佐藤",
   "text": "でも今は持ち物の候補だけ記録しましょう。",
   "start_sec": 255.745,
   "end_sec": 258.677,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D046-01",
   "unit_id": "C74-D046",
   "section": "D",
   "speaker": "ハサン",
   "text": "民謡を歌い継ぐ人から盆踊りの写真も届いています。",
   "start_sec": 259.027,
   "end_sec": 262.931,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D046-02",
   "unit_id": "C74-D046",
   "section": "D",
   "speaker": "ハサン",
   "text": "歌を流すより、踊りに使った物を見せる方がテーマに合いますね。",
   "start_sec": 263.081,
   "end_sec": 267.389,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D047-01",
   "unit_id": "C74-D047",
   "section": "D",
   "speaker": "林梅",
   "text": "京劇と地方劇を紹介したい人もいます。",
   "start_sec": 267.739,
   "end_sec": 270.999,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D047-02",
   "unit_id": "C74-D047",
   "section": "D",
   "speaker": "林梅",
   "text": "衣装の写真はよさそうですが、歌舞伎も含めて舞台を作るのは無理ですね。",
   "start_sec": 271.149,
   "end_sec": 276.749,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D048-01",
   "unit_id": "C74-D048",
   "section": "D",
   "speaker": "ハサン",
   "text": "相撲の写真には力士の名前より、道具の説明が欲しいです。",
   "start_sec": 277.099,
   "end_sec": 282.489,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D048-02",
   "unit_id": "C74-D048",
   "section": "D",
   "speaker": "ハサン",
   "text": "「国技だから」という理由だけでは選べません。",
   "start_sec": 282.639,
   "end_sec": 285.491,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D049-01",
   "unit_id": "C74-D049",
   "section": "D",
   "speaker": "佐藤",
   "text": "建設的な問いかけですね。",
   "start_sec": 285.841,
   "end_sec": 287.791,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D049-02",
   "unit_id": "C74-D049",
   "section": "D",
   "speaker": "佐藤",
   "text": "皆さんの見解が変わりました。",
   "start_sec": 287.941,
   "end_sec": 290.212,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D049-03",
   "unit_id": "C74-D049",
   "section": "D",
   "speaker": "佐藤",
   "text": "賛成派と反対派に分けるより、共通の条件を探せました。",
   "start_sec": 290.362,
   "end_sec": 294.433,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D050-01",
   "unit_id": "C74-D050",
   "section": "D",
   "speaker": "林梅",
   "text": "何を残したいのかという質問を投げかける方が、すぐ切り返すより話が進みますね。",
   "start_sec": 294.783,
   "end_sec": 301.142,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D051-01",
   "unit_id": "C74-D051",
   "section": "D",
   "speaker": "ハサン",
   "text": "話し上手でも聞き下手では困りますね。",
   "start_sec": 301.493,
   "end_sec": 305.333,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D051-02",
   "unit_id": "C74-D051",
   "section": "D",
   "speaker": "ハサン",
   "text": "今日は林さんの質問に一本とられました。",
   "start_sec": 305.483,
   "end_sec": 308.738,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D052-01",
   "unit_id": "C74-D052",
   "section": "D",
   "speaker": "佐藤",
   "text": "では道具と経験を中心にする案を記録します。",
   "start_sec": 309.088,
   "end_sec": 313.334,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C74-D052-02",
   "unit_id": "C74-D052",
   "section": "D",
   "speaker": "佐藤",
   "text": "展示の量や実施の可否は、施設の回答を見て判断しましょう。",
   "start_sec": 313.484,
   "end_sec": 317.915,
   "review_flags": [],
   "replacement": null
  }
 ]
}
