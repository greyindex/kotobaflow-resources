   "end_sec": 100.345,
   "duration_sec": 7.046
  },
  {
   "turn_id": "C09-D023",
   "turn_index": 22,
   "speaker": "林梅",
   "source_text": "さっき、新しい学生と会いました。名前はアリさんです。今、教室にいます。",
   "sentence_ids": [
    "C09-D023-S01",
    "C09-D023-S02",
    "C09-D023-S03"
   ],
   "voice_id": "ja-jp-concierge-7",
