   "end_sec": 92.949,
   "duration_sec": 1.734
  },
  {
   "turn_id": "C09-D022",
   "turn_index": 21,
   "speaker": "中村",
   "source_text": "はい、過去の旅行の記録です。昨年は山へ行きました。今まで、毎年写真も撮りました。",
   "sentence_ids": [
    "C09-D022-S01",
    "C09-D022-S02",
    "C09-D022-S03"
   ],
   "voice_id": "ja-jp-tutor-1",
