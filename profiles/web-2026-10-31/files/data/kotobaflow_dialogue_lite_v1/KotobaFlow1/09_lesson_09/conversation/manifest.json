   "start_sec": 85.246,
   "end_sec": 90.865,
   "duration_sec": 5.619
  },
  {
   "turn_id": "C09-D021",
   "turn_index": 20,
   "speaker": "パク",
   "source_text": "中村さんの日記ですか。",
   "sentence_ids": [
    "C09-D021-S01"
   ],
   "voice_id": "ja-jp-assistant-7",
   "status": "candidate",
   "review_needed": false,
