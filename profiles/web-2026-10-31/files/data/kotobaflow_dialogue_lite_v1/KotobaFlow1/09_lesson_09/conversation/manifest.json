   "duration_sec": 3.485
  },
  {
   "turn_id": "C09-D012",
   "turn_index": 11,
   "speaker": "パク",
   "source_text": "こんばんは。中村さん、先月の旅行はどうでしたか。",
   "sentence_ids": [
    "C09-D012-S01",
    "C09-D012-S02"
   ],
   "voice_id": "ja-jp-assistant-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 40.33,
   "end_sec": 44.083,
   "duration_sec": 3.753
  },
  {
   "turn_id": "C09-D013",
   "turn_index": 12,
   "speaker": "中村",
   "source_text": "天気はよかったです。空港からホテルへは電車でした。前日は時刻表をよく見ました。",
   "sentence_ids": [
    "C09-D013-S01",
    "C09-D013-S02",
    "C09-D013-S03"
   ],
   "voice_id": "ja-jp-tutor-1",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 44.433,
   "end_sec": 51.481,
   "duration_sec": 7.048
  },
  {
   "turn_id": "C09-D014",
   "turn_index": 13,
   "speaker": "パク",
   "source_text": "行き先は港駅でしたか。",
   "sentence_ids": [
    "C09-D014-S01"
   ],
   "voice_id": "ja-jp-assistant-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 51.831,
   "end_sec": 53.681,
   "duration_sec": 1.85
  },
  {
   "turn_id": "C09-D015",
   "turn_index": 14,
   "speaker": "中村",
   "source_text": "いいえ、川駅でした。駅員さんと話しました。「川駅はここからいくつ目ですか。」「終点ですよ。」",
   "sentence_ids": [
    "C09-D015-S01",
    "C09-D015-S02",
    "C09-D015-S03",
    "C09-D015-S04"
   ],
   "voice_id": "ja-jp-tutor-1",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 54.031,
   "end_sec": 62.044,
   "duration_sec": 8.013
  },
  {
   "turn_id": "C09-D016",
   "turn_index": 15,
   "speaker": "林梅",
   "source_text": "プラットホームはどこでしたか。",
   "sentence_ids": [
    "C09-D016-S01"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 62.394,
   "end_sec": 64.281,
   "duration_sec": 1.887
  },
  {
   "turn_id": "C09-D017",
   "turn_index": 16,
   "speaker": "中村",
   "source_text": "改札口のすぐ前でした。川駅行きの電車の発車は二時でした。各駅に止まりました。",
   "sentence_ids": [
    "C09-D017-S01",
    "C09-D017-S02",
    "C09-D017-S03"
   ],
   "voice_id": "ja-jp-tutor-1",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 64.631,
   "end_sec": 71.616,
   "duration_sec": 6.985
  },
  {
   "turn_id": "C09-D018",
   "turn_index": 17,
   "speaker": "中村",
   "source_text": "ホテルでは一晩休みました。翌日は早々とタクシーで空港へ行きました。運賃は高くありませんでした。",
   "sentence_ids": [
    "C09-D018-S01",
    "C09-D018-S02",
    "C09-D018-S03"
   ],
   "voice_id": "ja-jp-tutor-1",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 71.966,
   "end_sec": 79.66,
   "duration_sec": 7.694
  },
  {
   "turn_id": "C09-D019",
   "turn_index": 18,
   "speaker": "マテオ",
   "source_text": "その頃は暖かかったですか。去年の一月は雪でしたね。",
   "sentence_ids": [
    "C09-D019-S01",
    "C09-D019-S02"
   ],
   "voice_id": "ja-jp-commercial-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 80.01,
   "end_sec": 84.896,
   "duration_sec": 4.886
  },
  {
   "turn_id": "C09-D020",
   "turn_index": 19,
   "speaker": "中村",
   "source_text": "はい。次の日、空港でも暖かかったです。ホテルは静かじゃありませんでした。",
   "sentence_ids": [
    "C09-D020-S01",
    "C09-D020-S02",
    "C09-D020-S03"
   ],
   "voice_id": "ja-jp-tutor-1",
