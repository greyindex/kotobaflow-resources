   "review_needed": false,
   "review_flags": [],
   "start_sec": 100.695,
   "end_sec": 107.2,
   "duration_sec": 6.505
  },
  {
   "turn_id": "C09-D024",
   "turn_index": 23,
   "speaker": "アリ",
   "source_text": "アリです。学生で、パクさんの友達です。よろしくおねがいします。",
   "sentence_ids": [
    "C09-D024-S01",
    "C09-D024-S02",
    "C09-D024-S03"
   ],
   "voice_id": "ja-jp-storyteller-12",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
