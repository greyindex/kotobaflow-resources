  },
  {
   "sentence_id": "C09-D014-S01",
   "unit_id": "C09-D014",
   "section": "D",
   "speaker": "パク",
   "text": "行き先は港駅でしたか。",
   "start_sec": 51.831,
   "end_sec": 53.681,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D015-S01",
   "unit_id": "C09-D015",
   "section": "D",
   "speaker": "中村",
   "text": "いいえ、川駅でした。",
   "start_sec": 54.031,
   "end_sec": 55.866,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D015-S02",
   "unit_id": "C09-D015",
   "section": "D",
   "speaker": "中村",
   "text": "駅員さんと話しました。",
   "start_sec": 56.016,
   "end_sec": 57.981,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D015-S03",
   "unit_id": "C09-D015",
   "section": "D",
   "speaker": "中村",
   "text": "「川駅はここからいくつ目ですか。」",
   "start_sec": 58.131,
   "end_sec": 60.736,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D015-S04",
   "unit_id": "C09-D015",
   "section": "D",
   "speaker": "中村",
   "text": "「終点ですよ。」",
   "start_sec": 60.886,
   "end_sec": 62.044,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D016-S01",
   "unit_id": "C09-D016",
   "section": "D",
   "speaker": "リン",
   "text": "プラットホームはどこでしたか。",
   "start_sec": 62.394,
   "end_sec": 64.281,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D017-S01",
   "unit_id": "C09-D017",
   "section": "D",
   "speaker": "中村",
   "text": "改札口のすぐ前でした。",
   "start_sec": 64.631,
   "end_sec": 66.843,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D017-S02",
   "unit_id": "C09-D017",
   "section": "D",
   "speaker": "中村",
   "text": "川駅行きの電車の発車は二時でした。",
   "start_sec": 66.993,
   "end_sec": 69.895,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D017-S03",
   "unit_id": "C09-D017",
   "section": "D",
   "speaker": "中村",
   "text": "各駅に止まりました。",
   "start_sec": 70.045,
   "end_sec": 71.616,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D018-S01",
   "unit_id": "C09-D018",
   "section": "D",
   "speaker": "中村",
   "text": "ホテルでは一晩休みました。",
   "start_sec": 71.966,
   "end_sec": 74.153,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D018-S02",
   "unit_id": "C09-D018",
   "section": "D",
   "speaker": "中村",
   "text": "翌日は早々とタクシーで空港へ行きました。",
   "start_sec": 74.303,
   "end_sec": 77.613,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D018-S03",
   "unit_id": "C09-D018",
   "section": "D",
   "speaker": "中村",
   "text": "運賃は高くありませんでした。",
   "start_sec": 77.763,
   "end_sec": 79.66,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D019-S01",
   "unit_id": "C09-D019",
   "section": "D",
   "speaker": "マテオ",
   "text": "その頃は暖かかったですか。",
   "start_sec": 80.01,
   "end_sec": 82.576,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D019-S02",
   "unit_id": "C09-D019",
   "section": "D",
   "speaker": "マテオ",
   "text": "去年の一月は雪でしたね。",
   "start_sec": 82.726,
   "end_sec": 84.896,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D020-S01",
   "unit_id": "C09-D020",
   "section": "D",
   "speaker": "中村",
   "text": "はい。",
   "start_sec": 85.246,
   "end_sec": 85.937,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D020-S02",
   "unit_id": "C09-D020",
   "section": "D",
   "speaker": "中村",
   "text": "次の日、空港でも暖かかったです。",
   "start_sec": 86.087,
   "end_sec": 88.538,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D020-S03",
   "unit_id": "C09-D020",
   "section": "D",
   "speaker": "中村",
   "text": "ホテルは静かじゃありませんでした。",
   "start_sec": 88.688,
   "end_sec": 90.865,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D021-S01",
   "unit_id": "C09-D021",
   "section": "D",
   "speaker": "パク",
   "text": "中村さんの日記ですか。",
   "start_sec": 91.215,
   "end_sec": 92.949,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D022-S01",
   "unit_id": "C09-D022",
   "section": "D",
   "speaker": "中村",
   "text": "はい、過去の旅行の記録です。",
   "start_sec": 93.299,
   "end_sec": 95.835,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D022-S02",
   "unit_id": "C09-D022",
   "section": "D",
   "speaker": "中村",
   "text": "昨年は山へ行きました。",
   "start_sec": 95.985,
   "end_sec": 98.019,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D022-S03",
   "unit_id": "C09-D022",
   "section": "D",
   "speaker": "中村",
   "text": "今まで、毎年写真も撮りました。",
   "start_sec": 98.169,
   "end_sec": 100.345,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D023-S01",
   "unit_id": "C09-D023",
   "section": "D",
   "speaker": "リン",
   "text": "さっき、新しい学生と会いました。",
   "start_sec": 100.695,
   "end_sec": 103.674,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D023-S02",
   "unit_id": "C09-D023",
   "section": "D",
   "speaker": "リン",
   "text": "名前はアリさんです。",
   "start_sec": 103.824,
   "end_sec": 105.457,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D023-S03",
   "unit_id": "C09-D023",
   "section": "D",
   "speaker": "リン",
   "text": "今、教室にいます。",
   "start_sec": 105.607,
   "end_sec": 107.2,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D024-S01",
   "unit_id": "C09-D024",
   "section": "D",
   "speaker": "アリ",
   "text": "アリです。",
   "start_sec": 107.55,
   "end_sec": 108.443,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D024-S02",
   "unit_id": "C09-D024",
   "section": "D",
   "speaker": "アリ",
   "text": "学生で、パクさんの友達です。",
   "start_sec": 108.593,
   "end_sec": 111.152,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D024-S03",
   "unit_id": "C09-D024",
   "section": "D",
   "speaker": "アリ",
   "text": "よろしくおねがいします。",
   "start_sec": 111.302,
   "end_sec": 112.426,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D025-S01",
   "unit_id": "C09-D025",
   "section": "D",
   "speaker": "中村",
   "text": "中村です。",
   "start_sec": 112.776,
   "end_sec": 113.756,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D025-S02",
   "unit_id": "C09-D025",
   "section": "D",
   "speaker": "中村",
   "text": "よろしくお願いします。",
   "start_sec": 113.906,
   "end_sec": 115.505,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D025-S03",
   "unit_id": "C09-D025",
   "section": "D",
   "speaker": "中村",
   "text": "さあ、七時です。",
   "start_sec": 115.655,
   "end_sec": 117.048,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C09-D025-S04",
   "unit_id": "C09-D025",
   "section": "D",
   "speaker": "中村",
   "text": "静かに教室へ行きます。",
   "start_sec": 117.198,
   "end_sec": 119.072,
   "review_flags": [],
   "replacement": null
  }
 ]
}
