   "duration_sec": 5.059
  },
  {
   "turn_id": "C08-D011",
   "turn_index": 10,
   "speaker": "マテオ",
   "source_text": "リンさん、今、教室に行きますか。",
   "sentence_ids": [
    "C08-D011-S01"
   ],
   "voice_id": "ja-jp-commercial-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
