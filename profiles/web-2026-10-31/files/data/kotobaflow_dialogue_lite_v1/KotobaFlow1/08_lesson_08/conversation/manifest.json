   "review_needed": false,
   "review_flags": [],
   "start_sec": 52.215,
   "end_sec": 57.237,
   "duration_sec": 5.022
  },
  {
   "turn_id": "C08-D014",
   "turn_index": 13,
   "speaker": "マテオ",
   "source_text": "こんな静かな村が好きです。リンさんの家の周りはどうですか。",
   "sentence_ids": [
    "C08-D014-S01",
    "C08-D014-S02"
   ],
   "voice_id": "ja-jp-commercial-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 57.587,
   "end_sec": 61.933,
   "duration_sec": 4.346
  },
  {
   "turn_id": "C08-D015",
   "turn_index": 14,
   "speaker": "林梅",
   "source_text": "高層ビルがあります。昼は騒がしいです。夜はそんなにうるさくないです。",
   "sentence_ids": [
    "C08-D015-S01",
    "C08-D015-S02",
    "C08-D015-S03"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
