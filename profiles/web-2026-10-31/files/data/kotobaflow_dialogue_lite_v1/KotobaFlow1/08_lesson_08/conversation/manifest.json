   "start_sec": 62.283,
   "end_sec": 68.035,
   "duration_sec": 5.752
  },
  {
   "turn_id": "C08-D016",
   "turn_index": 15,
   "speaker": "マテオ",
   "source_text": "わたしの家の周りは静かです。いい環境ですよ。",
   "sentence_ids": [
    "C08-D016-S01",
    "C08-D016-S02"
   ],
   "voice_id": "ja-jp-commercial-4",
   "status": "candidate",
   "review_needed": false,
