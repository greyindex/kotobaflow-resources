   "start_sec": 47.222,
   "end_sec": 51.865,
   "duration_sec": 4.643
  },
  {
   "turn_id": "C08-D013",
   "turn_index": 12,
   "speaker": "中村",
   "source_text": "素敵な写真ですね。真ん中に小さい家がありますね。",
   "sentence_ids": [
    "C08-D013-S01",
    "C08-D013-S02"
   ],
