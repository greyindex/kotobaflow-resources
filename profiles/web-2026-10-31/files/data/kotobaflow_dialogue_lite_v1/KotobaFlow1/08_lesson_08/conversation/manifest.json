   "end_sec": 46.872,
   "duration_sec": 1.991
  },
  {
   "turn_id": "C08-D012",
   "turn_index": 11,
   "speaker": "林梅",
   "source_text": "はい。教室でこの本を読みます。村の写真の本です。",
   "sentence_ids": [
    "C08-D012-S01",
    "C08-D012-S02",
    "C08-D012-S03"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
