   "end_sec": 14.714,
   "duration_sec": 3.929
  },
  {
   "turn_id": "C17-D004",
   "turn_index": 3,
   "speaker": "林梅",
   "source_text": "では、準備を手伝いましょうか。一時半に行きます。",
   "sentence_ids": [
    "C17-D004-S01",
    "C17-D004-S02"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
