   "duration_sec": 4.98
  },
  {
   "turn_id": "C17-D003",
   "turn_index": 2,
   "speaker": "マテオ",
   "source_text": "いいえ、まだ終わっていません。中村さんにはもう連絡しました。",
   "sentence_ids": [
    "C17-D003-S01",
    "C17-D003-S02"
   ],
   "voice_id": "ja-jp-commercial-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
