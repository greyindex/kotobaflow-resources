   "end_sec": 18.924,
   "duration_sec": 3.86
  },
  {
   "turn_id": "C17-D005",
   "turn_index": 4,
   "speaker": "マテオ",
   "source_text": "お願いします。一時半に受付の前で待ちます。",
   "sentence_ids": [
    "C17-D005-S01",
    "C17-D005-S02"
   ],
   "voice_id": "ja-jp-commercial-4",
   "status": "candidate",
   "review_needed": false,
