   "duration_sec": 4.209
  },
  {
   "turn_id": "C17-D010",
   "turn_index": 9,
   "speaker": "マテオ",
   "source_text": "はい。また来週。今日はリンと勉強する。",
   "sentence_ids": [
    "C17-D010-S01",
    "C17-D010-S02",
    "C17-D010-S03"
   ],
   "voice_id": "ja-jp-commercial-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
