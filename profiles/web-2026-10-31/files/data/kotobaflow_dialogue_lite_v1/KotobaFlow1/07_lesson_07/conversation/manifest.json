  {
   "turn_id": "C07-D032",
   "turn_index": 38,
   "speaker": "林梅",
   "source_text": "マテオさんと一緒に行きます。十二時に公園で昼ご飯を食べます。",
   "sentence_ids": [
    "C07-D032-S01",
    "C07-D032-S02"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 201.379,
   "end_sec": 206.333,
   "duration_sec": 4.954
  },
  {
   "turn_id": "C07-D033",
   "turn_index": 39,
   "speaker": "パク",
   "source_text": "わたしは駅へ行きます。先生、さようなら。",
   "sentence_ids": [
    "C07-D033-S01",
    "C07-D033-S02"
   ],
   "voice_id": "ja-jp-assistant-7",
