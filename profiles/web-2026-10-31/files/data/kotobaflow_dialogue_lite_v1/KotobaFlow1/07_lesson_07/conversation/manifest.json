   "duration_sec": 3.042
  },
  {
   "turn_id": "C07-D034",
   "turn_index": 40,
   "speaker": "ユーリ",
   "source_text": "さようなら。",
   "sentence_ids": [
    "C07-D034-S01"
   ],
   "voice_id": "ja-jp-techagent-10",
   "status": "candidate",
   "review_needed": false,
