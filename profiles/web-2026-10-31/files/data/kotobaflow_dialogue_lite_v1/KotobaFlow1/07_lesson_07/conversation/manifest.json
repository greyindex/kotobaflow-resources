 "turns": [
  {
   "turn_id": "C07-D001",
   "turn_index": 0,
   "speaker": "ユーリ",
   "source_text": "マテオさんは何でセンターに来ますか。家はどこですか。",
   "sentence_ids": [
    "C07-D001-S01",
    "C07-D001-S02"
   ],
   "voice_id": "ja-jp-techagent-10",
   "status": "candidate",
