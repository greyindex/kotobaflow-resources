   "replacement": null
  },
  {
   "sentence_id": "C12-D009-S01",
   "unit_id": "C12-D009",
   "section": "D",
   "speaker": "マテオ",
   "text": "二時間です。",
   "start_sec": 36.497,
   "end_sec": 37.463,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D009-S02",
   "unit_id": "C12-D009",
   "section": "D",
   "speaker": "マテオ",
   "text": "何か飲みたいですか。",
   "start_sec": 37.613,
   "end_sec": 38.866,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D010-S01",
   "unit_id": "C12-D010",
   "section": "D",
   "speaker": "リン",
   "text": "お茶がいいです。",
   "start_sec": 39.216,
   "end_sec": 40.535,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D010-S02",
   "unit_id": "C12-D010",
   "section": "D",
   "speaker": "リン",
   "text": "私は一時から準備をします。",
   "start_sec": 40.685,
   "end_sec": 42.898,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D010-S03",
   "unit_id": "C12-D010",
   "section": "D",
   "speaker": "リン",
   "text": "マテオさんは？",
   "start_sec": 43.048,
   "end_sec": 44.079,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D011-S01",
   "unit_id": "C12-D011",
   "section": "D",
   "speaker": "マテオ",
   "text": "一時に来ます。",
   "start_sec": 44.429,
   "end_sec": 45.497,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D011-S02",
   "unit_id": "C12-D011",
   "section": "D",
   "speaker": "マテオ",
   "text": "私も準備を手伝いましょうか。",
   "start_sec": 45.647,
   "end_sec": 47.439,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D012-S01",
   "unit_id": "C12-D012",
   "section": "D",
   "speaker": "リン",
   "text": "ありがとうございます。",
   "start_sec": 47.789,
   "end_sec": 49.122,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D012-S02",
   "unit_id": "C12-D012",
   "section": "D",
   "speaker": "リン",
   "text": "お願いします。",
   "start_sec": 49.272,
   "end_sec": 50.535,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D012-S03",
   "unit_id": "C12-D012",
   "section": "D",
   "speaker": "リン",
   "text": "キッチンで会いましょう。",
   "start_sec": 50.685,
   "end_sec": 52.001,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D013-S01",
   "unit_id": "C12-D013",
   "section": "D",
   "speaker": "マテオ",
   "text": "はい。",
   "start_sec": 52.351,
   "end_sec": 52.913,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D013-S02",
   "unit_id": "C12-D013",
   "section": "D",
   "speaker": "マテオ",
   "text": "キッチンで待ちましょうか。",
   "start_sec": 53.063,
   "end_sec": 54.345,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D013-S03",
   "unit_id": "C12-D013",
   "section": "D",
   "speaker": "マテオ",
   "text": "ケーキは私が買いましょう。",
   "start_sec": 54.495,
   "end_sec": 56.046,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D014-S01",
   "unit_id": "C12-D014",
   "section": "D",
   "speaker": "リン",
   "text": "お願いします。",
   "start_sec": 56.396,
   "end_sec": 57.484,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D014-S02",
   "unit_id": "C12-D014",
   "section": "D",
   "speaker": "リン",
   "text": "私も何か買いましょうか。",
   "start_sec": 57.634,
   "end_sec": 59.447,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D015-S01",
   "unit_id": "C12-D015",
   "section": "D",
   "speaker": "パク",
   "text": "こんにちは。",
   "start_sec": 59.797,
   "end_sec": 60.713,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D015-S02",
   "unit_id": "C12-D015",
   "section": "D",
   "speaker": "パク",
   "text": "週末の予定ですか。",
   "start_sec": 60.863,
   "end_sec": 62.5,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D015-S03",
   "unit_id": "C12-D015",
   "section": "D",
   "speaker": "パク",
   "text": "私はジュースを買いましょう。",
   "start_sec": 62.65,
   "end_sec": 64.45,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D016-S01",
   "unit_id": "C12-D016",
   "section": "D",
   "speaker": "マテオ",
   "text": "はい。",
   "start_sec": 64.8,
   "end_sec": 65.449,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D016-S02",
   "unit_id": "C12-D016",
   "section": "D",
   "speaker": "マテオ",
   "text": "パクさんも八日に一緒に料理をしませんか。",
   "start_sec": 65.599,
   "end_sec": 68.751,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D016-S03",
   "unit_id": "C12-D016",
   "section": "D",
   "speaker": "マテオ",
   "text": "午後の都合は？",
   "start_sec": 68.901,
   "end_sec": 70.031,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D017-S01",
   "unit_id": "C12-D017",
   "section": "D",
   "speaker": "パク",
   "text": "午後は大丈夫です。",
   "start_sec": 70.381,
   "end_sec": 71.678,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D017-S02",
   "unit_id": "C12-D017",
   "section": "D",
   "speaker": "パク",
   "text": "何時からですか。",
   "start_sec": 71.828,
   "end_sec": 73.055,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D018-S01",
   "unit_id": "C12-D018",
   "section": "D",
   "speaker": "リン",
   "text": "二時から四時までです。",
   "start_sec": 73.405,
   "end_sec": 74.854,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D018-S02",
   "unit_id": "C12-D018",
   "section": "D",
   "speaker": "リン",
   "text": "私とマテオさんは一時から準備をします。",
   "start_sec": 75.004,
   "end_sec": 77.527,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D019-S01",
   "unit_id": "C12-D019",
   "section": "D",
   "speaker": "パク",
   "text": "一時はちょっと……。",
   "start_sec": 77.877,
   "end_sec": 79.267,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D019-S02",
   "unit_id": "C12-D019",
   "section": "D",
   "speaker": "パク",
   "text": "家で昼ご飯を食べます。",
   "start_sec": 79.417,
   "end_sec": 81.099,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D019-S03",
   "unit_id": "C12-D019",
   "section": "D",
   "speaker": "パク",
   "text": "二時に来ます。",
   "start_sec": 81.249,
   "end_sec": 82.278,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D020-S01",
   "unit_id": "C12-D020",
   "section": "D",
   "speaker": "マテオ",
   "text": "大丈夫です。",
   "start_sec": 82.628,
   "end_sec": 83.551,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D020-S02",
   "unit_id": "C12-D020",
   "section": "D",
   "speaker": "マテオ",
   "text": "リンさんと私はキッチンにいます。",
   "start_sec": 83.701,
   "end_sec": 85.53,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D020-S03",
   "unit_id": "C12-D020",
   "section": "D",
   "speaker": "マテオ",
   "text": "だれかに声をかけましょうか。",
   "start_sec": 85.68,
   "end_sec": 87.347,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D021-S01",
   "unit_id": "C12-D021",
   "section": "D",
   "speaker": "パク",
   "text": "お願いします。",
   "start_sec": 87.697,
   "end_sec": 88.651,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D021-S02",
   "unit_id": "C12-D021",
   "section": "D",
   "speaker": "パク",
   "text": "マテオさん、七日の午前に一緒に公園で走りませんか。",
   "start_sec": 88.801,
   "end_sec": 92.745,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D022-S01",
   "unit_id": "C12-D022",
   "section": "D",
   "speaker": "マテオ",
   "text": "すみません。",
   "start_sec": 93.095,
   "end_sec": 94.188,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D022-S02",
   "unit_id": "C12-D022",
   "section": "D",
   "speaker": "マテオ",
   "text": "七日は走りたくないです。",
   "start_sec": 94.338,
   "end_sec": 96.343,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D022-S03",
   "unit_id": "C12-D022",
   "section": "D",
   "speaker": "マテオ",
   "text": "午前は家で休みます。",
   "start_sec": 96.493,
   "end_sec": 98.027,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D022-S04",
   "unit_id": "C12-D022",
   "section": "D",
   "speaker": "マテオ",
   "text": "午後は音楽を聞きたいです。",
   "start_sec": 98.177,
   "end_sec": 99.879,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D023-S01",
   "unit_id": "C12-D023",
   "section": "D",
   "speaker": "パク",
   "text": "分かりました。",
   "start_sec": 100.779,
   "end_sec": 101.885,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D023-S02",
   "unit_id": "C12-D023",
   "section": "D",
   "speaker": "パク",
   "text": "私は夏休みに泳ぎたいです。",
   "start_sec": 102.035,
   "end_sec": 104.178,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D023-S03",
   "unit_id": "C12-D023",
   "section": "D",
   "speaker": "パク",
   "text": "休みは何日ですか。",
   "start_sec": 104.328,
   "end_sec": 105.949,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D024-S01",
   "unit_id": "C12-D024",
   "section": "D",
   "speaker": "リン",
   "text": "私の夏休みは七日です。",
   "start_sec": 106.299,
   "end_sec": 108.385,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D024-S02",
   "unit_id": "C12-D024",
   "section": "D",
   "speaker": "リン",
   "text": "いつか一緒に泳ぎに行きましょう。",
   "start_sec": 108.535,
   "end_sec": 110.279,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D025-S01",
   "unit_id": "C12-D025",
   "section": "D",
   "speaker": "マテオ",
   "text": "いいですね。",
   "start_sec": 110.629,
   "end_sec": 111.404,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D025-S02",
   "unit_id": "C12-D025",
   "section": "D",
   "speaker": "マテオ",
   "text": "今度、歌も歌いませんか。",
   "start_sec": 111.554,
   "end_sec": 113.26,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D025-S03",
   "unit_id": "C12-D025",
   "section": "D",
   "speaker": "マテオ",
   "text": "私は今日はあまり歌いたくないです。",
   "start_sec": 113.41,
   "end_sec": 116.168,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D026-S01",
   "unit_id": "C12-D026",
   "section": "D",
   "speaker": "パク",
   "text": "では、日曜日に歌いましょう。",
   "start_sec": 116.518,
   "end_sec": 118.524,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D026-S02",
   "unit_id": "C12-D026",
   "section": "D",
   "speaker": "パク",
   "text": "料理の準備はどのぐらいですか。",
   "start_sec": 118.674,
   "end_sec": 120.816,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D027-S01",
   "unit_id": "C12-D027",
   "section": "D",
   "speaker": "リン",
   "text": "一時間です。",
   "start_sec": 121.166,
   "end_sec": 122.485,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D027-S02",
   "unit_id": "C12-D027",
   "section": "D",
   "speaker": "リン",
   "text": "さあ、これから買い物に行きませんか。",
   "start_sec": 122.635,
   "end_sec": 125.2,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D028-S01",
   "unit_id": "C12-D028",
   "section": "D",
   "speaker": "パク",
   "text": "今日はちょっと……。",
   "start_sec": 125.55,
   "end_sec": 127.058,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D028-S02",
   "unit_id": "C12-D028",
   "section": "D",
   "speaker": "パク",
   "text": "これから家に昼ご飯を食べに帰ります。",
   "start_sec": 127.209,
   "end_sec": 129.487,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C12-D028-S03",
   "unit_id": "C12-D028",
   "section": "D",
   "speaker": "パク",
   "text": "次回、一緒に行きましょう。",
   "start_sec": 129.637,
   "end_sec": 130.963,
   "review_flags": [],
   "replacement": null
  }
 ]
