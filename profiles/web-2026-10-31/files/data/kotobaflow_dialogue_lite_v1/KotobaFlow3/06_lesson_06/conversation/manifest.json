 "turns": [
  {
   "turn_id": "C42-D001",
   "turn_index": 0,
   "speaker": "原",
   "source_text": "こんにちは。カメラについて確認したいことがあると聞きました。何か問題がありましたか。",
   "sentence_ids": [
    "C42-D001-S01",
    "C42-D001-S02",
    "C42-D001-S03"
   ],
   "voice_id": "ja-jp-advisor-12",
   "status": "candidate",
