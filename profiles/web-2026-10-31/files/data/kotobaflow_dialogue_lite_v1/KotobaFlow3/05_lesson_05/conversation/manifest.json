   "start_sec": 3.118,
   "end_sec": 5.131,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D002-S01",
   "unit_id": "C41-D002",
   "section": "D",
   "speaker": "西田",
