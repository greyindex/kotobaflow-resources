   "start_sec": 5.481,
   "end_sec": 8.046,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D002-S02",
   "unit_id": "C41-D002",
   "section": "D",
   "speaker": "西田",
   "text": "心当たりはありますか。",
   "start_sec": 8.196,
   "end_sec": 9.796,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D003-S01",
   "unit_id": "C41-D003",
   "section": "D",
   "speaker": "アナ",
   "text": "いいえ。",
   "start_sec": 10.146,
   "end_sec": 10.821,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D003-S02",
   "unit_id": "C41-D003",
   "section": "D",
   "speaker": "アナ",
   "text": "中はパン二つと牛乳一本。",
   "start_sec": 10.971,
   "end_sec": 13.402,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D003-S03",
   "unit_id": "C41-D003",
   "section": "D",
   "speaker": "アナ",
   "text": "レシートは今日の五時五十二分です。",
   "start_sec": 13.552,
   "end_sec": 16.202,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D004-S01",
   "unit_id": "C41-D004",
   "section": "D",
   "speaker": "西田",
   "text": "今日のレシートが昨日入っていたはずがありません。",
   "start_sec": 16.552,
   "end_sec": 20.179,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D004-S02",
   "unit_id": "C41-D004",
   "section": "D",
   "speaker": "西田",
   "text": "六時二十分の足音は恐らく書道教室の人でしょう。",
   "start_sec": 20.329,
   "end_sec": 24.793,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D005-S01",
   "unit_id": "C41-D005",
   "section": "D",
   "speaker": "アナ",
   "text": "入口で急ぐ人をちらりと見ました。",
   "start_sec": 25.143,
   "end_sec": 27.993,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D005-S02",
   "unit_id": "C41-D005",
   "section": "D",
   "speaker": "アナ",
   "text": "知っているような、知らないような…。",
   "start_sec": 28.143,
   "end_sec": 30.372,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D005-S03",
   "unit_id": "C41-D005",
   "section": "D",
   "speaker": "アナ",
   "text": "でも、袋は見ていません。",
   "start_sec": 30.522,
   "end_sec": 32.386,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D006-S01",
   "unit_id": "C41-D006",
   "section": "D",
   "speaker": "西田",
   "text": "見ただけでは、やはりわかりませんね。",
   "start_sec": 32.736,
   "end_sec": 35.68,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D006-S02",
   "unit_id": "C41-D006",
   "section": "D",
   "speaker": "西田",
   "text": "予定を確認します。",
   "start_sec": 35.83,
   "end_sec": 37.175,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D007-S01",
   "unit_id": "C41-D007",
   "section": "D",
   "speaker": "西田",
   "text": "勘違いでした。",
   "start_sec": 38.075,
   "end_sec": 39.573,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D007-S02",
   "unit_id": "C41-D007",
   "section": "D",
   "speaker": "西田",
   "text": "教室は木曜日です。",
   "start_sec": 39.723,
   "end_sec": 41.61,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D007-S03",
   "unit_id": "C41-D007",
   "section": "D",
   "speaker": "西田",
   "text": "今日はだれもいないようです。",
   "start_sec": 41.76,
   "end_sec": 43.918,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D007-S04",
   "unit_id": "C41-D007",
   "section": "D",
   "speaker": "西田",
   "text": "原さんの話では小川さんが来たそうです。",
   "start_sec": 44.068,
   "end_sec": 46.934,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D008-S01",
   "unit_id": "C41-D008",
   "section": "D",
   "speaker": "アナ",
   "text": "どうやらその足音ですね。",
   "start_sec": 47.284,
   "end_sec": 49.424,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D008-S02",
   "unit_id": "C41-D008",
   "section": "D",
   "speaker": "アナ",
   "text": "写真を見せたら？",
   "start_sec": 49.574,
   "end_sec": 50.94,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D009-S01",
   "unit_id": "C41-D009",
   "section": "D",
   "speaker": "西田",
   "text": "見せました。",
   "start_sec": 51.29,
   "end_sec": 52.396,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D009-S02",
   "unit_id": "C41-D009",
   "section": "D",
   "speaker": "西田",
   "text": "首を傾げて、「私の物ではない」と。",
   "start_sec": 52.546,
   "end_sec": 56.071,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D009-S03",
   "unit_id": "C41-D009",
   "section": "D",
   "speaker": "西田",
   "text": "どことなく悲しげに見えましたが、事情はまるでわかりません。",
   "start_sec": 56.221,
   "end_sec": 60.194,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D010-S01",
   "unit_id": "C41-D010",
   "section": "D",
   "speaker": "アナ",
   "text": "わかったふりはできませんね。",
   "start_sec": 60.544,
   "end_sec": 62.895,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D010-S02",
   "unit_id": "C41-D010",
   "section": "D",
   "speaker": "アナ",
   "text": "まず証拠が必要なように思います。",
   "start_sec": 63.045,
   "end_sec": 65.858,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D010-S03",
   "unit_id": "C41-D010",
   "section": "D",
   "speaker": "アナ",
   "text": "あ、電話です。",
   "start_sec": 66.008,
   "end_sec": 67.152,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D011-S01",
   "unit_id": "C41-D011",
   "section": "D",
   "speaker": "松井",
   "text": "松井です。",
   "start_sec": 68.052,
   "end_sec": 68.964,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D011-S02",
   "unit_id": "C41-D011",
   "section": "D",
   "speaker": "松井",
   "text": "六時過ぎ、留守の事務室前で待っていて紙袋を忘れました。",
   "start_sec": 69.114,
   "end_sec": 73.488,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D011-S03",
   "unit_id": "C41-D011",
   "section": "D",
   "speaker": "松井",
   "text": "「こむぎ」のクリームパン二つと牛乳一本です。",
   "start_sec": 73.638,
   "end_sec": 76.771,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D012-S01",
   "unit_id": "C41-D012",
   "section": "D",
   "speaker": "西田",
   "text": "数も店名も一致します。",
   "start_sec": 77.121,
   "end_sec": 79.166,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D012-S02",
   "unit_id": "C41-D012",
   "section": "D",
   "speaker": "西田",
   "text": "七時四十分に来られますか。",
   "start_sec": 79.316,
   "end_sec": 81.335,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D013-S01",
   "unit_id": "C41-D013",
   "section": "D",
   "speaker": "松井",
   "text": "はい。",
   "start_sec": 81.685,
   "end_sec": 82.47,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D013-S02",
   "unit_id": "C41-D013",
   "section": "D",
   "speaker": "松井",
   "text": "八時まで開いているそうですね。",
   "start_sec": 82.62,
   "end_sec": 84.744,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D014-S01",
   "unit_id": "C41-D014",
   "section": "D",
   "speaker": "西田",
   "text": "ええ。",
   "start_sec": 85.094,
   "end_sec": 85.704,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D014-S02",
   "unit_id": "C41-D014",
   "section": "D",
   "speaker": "西田",
   "text": "来たら名前と中身をもう一度確認します。",
   "start_sec": 85.854,
   "end_sec": 88.93,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D015-S01",
   "unit_id": "C41-D015",
   "section": "D",
   "speaker": "アナ",
   "text": "展示の物音には、はっとしました。",
   "start_sec": 89.83,
   "end_sec": 92.471,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D015-S02",
   "unit_id": "C41-D015",
   "section": "D",
   "speaker": "アナ",
   "text": "犬が吠える声も、けたたましい音も、録音だったんですね。",
   "start_sec": 92.621,
   "end_sec": 97.123,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D016-S01",
   "unit_id": "C41-D016",
   "section": "D",
   "speaker": "西田",
   "text": "ええ。",
   "start_sec": 97.473,
   "end_sec": 98.192,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D016-S02",
   "unit_id": "C41-D016",
   "section": "D",
   "speaker": "西田",
   "text": "扉をトントンとたたく音も。",
   "start_sec": 98.342,
   "end_sec": 100.49,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D017-S01",
   "unit_id": "C41-D017",
   "section": "D",
   "speaker": "アナ",
   "text": "ははあ、だから扉の向こうを覗いてもだれもいなかったんですね。",
   "start_sec": 100.84,
   "end_sec": 105.838,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D017-S02",
   "unit_id": "C41-D017",
   "section": "D",
   "speaker": "アナ",
   "text": "じっと立って聞くと、同じ音でした。",
   "start_sec": 105.988,
   "end_sec": 109.167,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D018-S01",
   "unit_id": "C41-D018",
   "section": "D",
   "speaker": "西田",
   "text": "ずいぶん本物らしい音でしたね。",
   "start_sec": 109.517,
   "end_sec": 112.176,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D018-S02",
   "unit_id": "C41-D018",
   "section": "D",
   "speaker": "西田",
   "text": "どうも機械の音とは思えませんでした。",
   "start_sec": 112.326,
   "end_sec": 115.413,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D019-S01",
   "unit_id": "C41-D019",
   "section": "D",
   "speaker": "アナ",
   "text": "本物の犬の録音だそうです。",
   "start_sec": 115.763,
   "end_sec": 118.2,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D019-S02",
   "unit_id": "C41-D019",
   "section": "D",
   "speaker": "アナ",
   "text": "よく似ているはずですね。",
   "start_sec": 118.35,
   "end_sec": 120.235,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D019-S03",
   "unit_id": "C41-D019",
   "section": "D",
   "speaker": "アナ",
   "text": "犬がそこにいるような気がしました。",
   "start_sec": 120.385,
   "end_sec": 122.731,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D020-S01",
   "unit_id": "C41-D020",
   "section": "D",
   "speaker": "西田",
   "text": "私はさっき説明を読んだはずですが、驚きました。",
   "start_sec": 123.081,
   "end_sec": 127.275,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D020-S02",
   "unit_id": "C41-D020",
   "section": "D",
   "speaker": "西田",
   "text": "七時には帰れるはずだったのに、今日は予想が外れてばかりです。",
   "start_sec": 127.425,
   "end_sec": 131.949,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D021-S01",
   "unit_id": "C41-D021",
   "section": "D",
   "speaker": "アナ",
   "text": "待つ時間も、こうして話せば発見がありますね。",
   "start_sec": 132.299,
   "end_sec": 135.753,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D021-S02",
   "unit_id": "C41-D021",
   "section": "D",
   "speaker": "アナ",
   "text": "雨の音はもう小さいように思います。",
   "start_sec": 135.903,
   "end_sec": 138.783,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C41-D021-S03",
   "unit_id": "C41-D021",
   "section": "D",
   "speaker": "アナ",
   "text": "窓の外の様子を見ましょうか。",
   "start_sec": 138.933,
   "end_sec": 140.947,
   "review_flags": [],
   "replacement": null
  }
 ]
}
