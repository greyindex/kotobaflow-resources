  {
   "sentence_id": "C39-D011-S03",
   "unit_id": "C39-D011",
   "section": "D",
   "speaker": "西田",
   "text": "一度逃げたら、同じ写真は撮れませんね。",
   "start_sec": 85.094,
   "end_sec": 88.231,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C39-D011-S04",
   "unit_id": "C39-D011",
   "section": "D",
   "speaker": "西田",
   "text": "くねくねした道で立ち止まると、後ろの人が通れません。",
   "start_sec": 88.381,
   "end_sec": 92.004,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C39-D012-S01",
   "unit_id": "C39-D012",
   "section": "D",
   "speaker": "アナ・ロペス",
   "text": "ええ。",
   "start_sec": 92.354,
   "end_sec": 92.833,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C39-D012-S02",
   "unit_id": "C39-D012",
   "section": "D",
   "speaker": "アナ・ロペス",
   "text": "七時から七時半までは話し合いで、接続をやめます。",
   "start_sec": 92.983,
   "end_sec": 96.892,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C39-D012-S03",
   "unit_id": "C39-D012",
   "section": "D",
   "speaker": "アナ・ロペス",
   "text": "途中で止まったら、どうしたらいいですか。",
   "start_sec": 97.042,
   "end_sec": 99.607,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C39-D013-S01",
   "unit_id": "C39-D013",
   "section": "D",
   "speaker": "西田",
   "text": "接続がないと十五分で止まります。",
   "start_sec": 99.957,
   "end_sec": 102.797,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C39-D013-S02",
   "unit_id": "C39-D013",
   "section": "D",
   "speaker": "西田",
   "text": "話し合いの後で電源を入れればいいですよ。",
   "start_sec": 102.947,
   "end_sec": 105.747,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C39-D013-S03",
   "unit_id": "C39-D013",
   "section": "D",
   "speaker": "西田",
   "text": "三十秒ほどすると使えます。",
   "start_sec": 105.897,
   "end_sec": 107.83,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C39-D014-S01",
   "unit_id": "C39-D014",
   "section": "D",
   "speaker": "アナ・ロペス",
   "text": "それなら設定は変えません。",
   "start_sec": 108.18,
   "end_sec": 110.268,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C39-D014-S02",
   "unit_id": "C39-D014",
   "section": "D",
   "speaker": "アナ・ロペス",
   "text": "来月の準備は別の人ですが、ケーブルがなければ借りられますか。",
   "start_sec": 110.418,
   "end_sec": 114.901,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C39-D015-S01",
   "unit_id": "C39-D015",
   "section": "D",
   "speaker": "西田",
   "text": "予備は一本です。",
   "start_sec": 115.251,
   "end_sec": 116.635,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C39-D015-S02",
   "unit_id": "C39-D015",
   "section": "D",
   "speaker": "西田",
   "text": "予約時に確かめてください。",
   "start_sec": 116.785,
   "end_sec": 118.862,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C39-D015-S03",
   "unit_id": "C39-D015",
   "section": "D",
   "speaker": "西田",
   "text": "皆さんに写真を楽しんでもらえるといいですね。",
   "start_sec": 119.012,
   "end_sec": 121.923,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C39-D016-S01",
   "unit_id": "C39-D016",
   "section": "D",
   "speaker": "アナ・ロペス",
   "text": "ありがとうございます。",
   "start_sec": 122.273,
   "end_sec": 123.586,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C39-D016-S02",
   "unit_id": "C39-D016",
   "section": "D",
   "speaker": "アナ・ロペス",
   "text": "今日は八時半に終わります。",
   "start_sec": 123.736,
   "end_sec": 125.92,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C39-D016-S03",
   "unit_id": "C39-D016",
   "section": "D",
   "speaker": "アナ・ロペス",
   "text": "借りた物はありませんから、電源を切って九時までに帰ります。",
   "start_sec": 126.07,
   "end_sec": 130.181,
   "review_flags": [],
   "replacement": null
  }
 ]
}
