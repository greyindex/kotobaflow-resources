":"lesson_17","lesson_title":"二つの案を比べる","source_type":"lesson_vocab","source_kind":"curriculum_vocab"}],"curriculum_extension":{"id":"C35-V12","word":"締切","reading":"しめきり","meaning_zh":"截止期限","role":"production","status":"recycle","examples":[{"id":"C35-V12-E01","ja":"予約の締切は五月二十三日十七時で、今日はまだ予約していません。","zh":"预约截止时间是五月二十三日十七点，今天还未预约。"}],"notes_zh":"締切亦写締め切り；指受理申请的最后界限。"},"learning_enrichment":{"textbook_uid":"cfv-4b007a428274d42a","index":2296,"word":"締切","reading_hiragana":"しめきり","context_meaning_zh":"截止期限","pos_ja":"名詞","pos_zh":"名词","register_zh":"中性","senses":[{"meaning_zh":"截止期限","meaning_ja":"申し込みや提出などを受け付ける最後の日時。","example_ja":"申込書の締切は金曜日です。","example_zh":"申请表的截止日期是星期五。"}],"collocations":[{"ja":"締切を守る","zh":"遵守截止期限"},{"ja":"締切に間に合う","zh":"赶上截止期限"}],"usage_note_zh":"表示受理或提交的最后界限；可写作「締め切り」。常说「締切はN日」「締切に間に合う」，与表示可持续时长的「期間」不同。","pos":{"primary":"noun","classes":["noun"],"subtypes":[],"conjugation":"not_applicable"},"transitivity":{"value":"not_applicable","scope":"not_applicable"},"register":{"formality":"neutral","politeness":[],"usage":[]},"style":{"medium":"general","genres":[]},"lexical_review":{"schemaVersion":2,"status":"reviewed","confidence":"high","basis":["dictionary","context"],"note_zh":"预约最晚可办到五月二十三日下午五点，属于期限名词义。","dictionary_sequences":[1594590],"identity":{"word":"締切","reading_hiragana":"しめきり","meaning":"截止期限"}}},"transitivity":{"value":"not_applicable","scope":"not_applicable"},"register":{"formality":"neutral","politeness":[],"usage":[]},"style":{"medium":"general","genres":[]},"lexical_review":{"schemaVersion":2,"status":"reviewed","confidence":"high","basis":["dictionary","context"],"note_zh":"预约最晚可办到五月二十三日下午五点，属于期限名词义。","dictionary_sequences":[1594590],"identity":{"word":"締切","reading_hiragana":"しめきり","meaning":"截止期限"}},"v4_enrichment":null,"jitendex_overlay":null,"audio_available":false},{"source_index":2297,"source_label":"体調","source_word":"体調","split_part":1,"split_total":1,"label":"体調","word":"体調","reading_hiragana":"たいちょう","meaning":"身体状况",