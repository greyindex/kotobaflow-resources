{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 88.692,
 "source_chapter": 46,
 "sentence_intervals": [
  {
   "sentence_id": "C46-A001-S01",
   "section": "A",
   "text": "12月21日月曜日、わたしはみなと市国際センターへ行きました。",
   "start_sec": 0.0,
   "end_sec": 5.819
  },
  {
   "sentence_id": "C46-A001-S02",
   "section": "A",
   "text": "3階の窓口で15番の札を取り、センターだより12月号に目を通しました。",
   "start_sec": 6.019,
   "end_sec": 12.531
  },
  {
   "sentence_id": "C46-A001-S03",
   "section": "A",
   "text": "職員の小松さんは「お待たせしました」とパンフレットをくださいました。",
   "start_sec": 12.731,
   "end_sec": 17.969
  },
  {
   "sentence_id": "C46-A001-S04",
   "section": "A",
   "text": "わたしは申込書もいただき、去年の写真を見せていただきました。",
   "start_sec": 18.169,
   "end_sec": 23.32
  },
  {
   "sentence_id": "C46-A002-S01",
   "section": "A",
   "text": "冬の合宿は1月29日から31日まで、北山の「山の家」で2泊3日です。",
   "start_sec": 23.77,
   "end_sec": 32.76
  },
  {
   "sentence_id": "C46-A002-S02",
   "section": "A",
   "text": "食事付きで8,000円、締め切りは1月8日です。",
   "start_sec": 32.96,
   "end_sec": 38.114
  },
  {
   "sentence_id": "C46-A002-S03",
   "section": "A",
   "text": "隣では住まいの相談会も開かれていました。",
   "start_sec": 38.314,
   "end_sec": 42.447
  },
  {
   "sentence_id": "C46-A002-S04",
   "section": "A",
   "text": "土地を買ってマイホームを建てる人が相談できます。",
   "start_sec": 42.647,
   "end_sec": 46.541
  },
  {
   "sentence_id": "C46-A002-S05",
   "section": "A",
   "text": "住宅を借りる人も相談できます。",
   "start_sec": 46.741,
   "end_sec": 49.314
  },
  {
   "sentence_id": "C46-A002-S06",
   "section": "A",
   "text": "持ち家と借家では必要な手続きが違います。",
   "start_sec": 49.514,
   "end_sec": 53.527
  },
  {
   "sentence_id": "C46-A003-S01",
   "section": "A",
   "text": "わたしは分譲マンションではなく、家賃の安い部屋を探しています。",
   "start_sec": 53.977,
   "end_sec": 59.185
  },
  {
   "sentence_id": "C46-A003-S02",
   "section": "A",
   "text": "一戸建ての広告には敷地30坪、延床面積80平方メートルとありました。",
   "start_sec": 59.385,
   "end_sec": 66.758
  },
  {
   "sentence_id": "C46-A003-S03",
   "section": "A",
   "text": "職員は、土地の面積と各階の床を合わせた面積は違うと説明しました。",
   "start_sec": 66.958,
   "end_sec": 73.752
  },
  {
   "sentence_id": "C46-A003-S04",
   "section": "A",
   "text": "お茶を1杯飲んで帰り、夜、アナさんに合宿の案内を見せました。",
   "start_sec": 73.952,
   "end_sec": 80.121
  },
  {
   "sentence_id": "C46-A003-S05",
   "section": "A",
   "text": "佐藤さんは金曜日に仕事があるそうです。",
   "start_sec": 80.321,
   "end_sec": 83.314
  },
  {
   "sentence_id": "C46-A003-S06",
   "section": "A",
   "text": "アナさんが翌日、1泊で参加できるか問い合わせてくれることになりました。",
   "start_sec": 83.514,
   "end_sec": 88.686
  }
 ]
}
