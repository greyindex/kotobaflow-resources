{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 78.348,
 "source_chapter": 54,
 "sentence_intervals": [
  {
   "sentence_id": "C54-A001-S01",
   "section": "A",
   "text": "次の土曜日、会議室Ａで午後二時から四時まで本の交換会を開く。",
   "start_sec": 0.0,
   "end_sec": 6.788
  },
  {
   "sentence_id": "C54-A001-S02",
   "section": "A",
   "text": "四時半までに後始末を終える約束がある。",
   "start_sec": 6.988,
   "end_sec": 10.538
  },
  {
   "sentence_id": "C54-A001-S03",
   "section": "A",
   "text": "担当者のアナは全員に三十分の手伝いを頼む案を考えた。",
   "start_sec": 10.738,
   "end_sec": 16.323
  },
  {
   "sentence_id": "C54-A001-S04",
   "section": "A",
   "text": "しかし、ミンは四時から本の店で働くので、三時半に出る必要がある。",
   "start_sec": 16.523,
   "end_sec": 23.086
  },
  {
   "sentence_id": "C54-A002-S01",
   "section": "A",
   "text": "アナ、ミン、佐藤は月曜日に相談した。",
   "start_sec": 23.536,
   "end_sec": 27.577
  },
  {
   "sentence_id": "C54-A002-S02",
   "section": "A",
   "text": "参加する人の立場への配慮も、後始末の必要性も考えるべきだ。",
   "start_sec": 27.777,
   "end_sec": 33.462
  },
  {
   "sentence_id": "C54-A002-S03",
   "section": "A",
   "text": "会議室を借りたので後始末は必要だが、全員に手伝う義務があるわけではない。",
   "start_sec": 33.663,
   "end_sec": 40.256
  },
  {
   "sentence_id": "C54-A002-S04",
   "section": "A",
   "text": "会では学習用の本も紹介する。",
   "start_sec": 40.456,
   "end_sec": 43.629
  },
  {
   "sentence_id": "C54-A002-S05",
   "section": "A",
   "text": "試験を控えた人に対する助言にも、同じ配慮が必要だ。",
   "start_sec": 43.829,
   "end_sec": 48.816
  },
  {
   "sentence_id": "C54-A003-S01",
   "section": "A",
   "text": "三人は準備も選べる案に合意した。",
   "start_sec": 49.266,
   "end_sec": 52.901
  },
  {
   "sentence_id": "C54-A003-S02",
   "section": "A",
   "text": "佐藤は後始末を引き受けたが、ミンの返事はまだだ。",
   "start_sec": 53.101,
   "end_sec": 58.085
  },
  {
   "sentence_id": "C54-A003-S03",
   "section": "A",
   "text": "無理に引き受けることはない。",
   "start_sec": 58.285,
   "end_sec": 60.199
  },
  {
   "sentence_id": "C54-A003-S04",
   "section": "A",
   "text": "しかし、人と本を守るために重い箱は二人で運ぶ。",
   "start_sec": 60.399,
   "end_sec": 66.005
  },
  {
   "sentence_id": "C54-A003-S05",
   "section": "A",
   "text": "この原則は優先する。",
   "start_sec": 66.205,
   "end_sec": 68.118
  },
  {
   "sentence_id": "C54-A003-S06",
   "section": "A",
   "text": "人が少なければ、本を少なくする選択肢もある。",
   "start_sec": 68.318,
   "end_sec": 72.691
  },
  {
   "sentence_id": "C54-A003-S07",
   "section": "A",
   "text": "解決のためには、譲歩できることとできないことを考える必要がある。",
   "start_sec": 72.891,
   "end_sec": 78.342
  }
 ]
}
