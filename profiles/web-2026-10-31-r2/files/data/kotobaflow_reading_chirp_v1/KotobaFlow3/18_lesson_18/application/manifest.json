{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 237.38,
 "source_chapter": 54,
 "sentence_intervals": [
  {
   "sentence_id": "C54-B001-S01",
   "section": "B",
   "text": "次の土曜日、会議室Ａで午後二時から四時まで本の交換会を開きます。",
   "start_sec": 0.0,
   "end_sec": 6.992
  },
  {
   "sentence_id": "C54-B001-S02",
   "section": "B",
   "text": "準備は一時半から二時、後始末は四時から四時半です。",
   "start_sec": 7.192,
   "end_sec": 13.099
  },
  {
   "sentence_id": "C54-B001-S03",
   "section": "B",
   "text": "重い箱は二人で運び、出口の前には置きません。",
   "start_sec": 13.299,
   "end_sec": 17.48
  },
  {
   "sentence_id": "C54-B001-S04",
   "section": "B",
   "text": "人と本を守るため、安全を優先します。",
   "start_sec": 17.68,
   "end_sec": 21.37
  },
  {
   "sentence_id": "C54-B001-S05",
   "section": "B",
   "text": "管理者との約束に従い、四時半までに後始末を終えねばなりません。",
   "start_sec": 21.57,
   "end_sec": 27.143
  },
  {
   "sentence_id": "C54-B001-S06",
   "section": "B",
   "text": "手伝いは参加の条件ではなく、準備と後始末から選べます。",
   "start_sec": 27.343,
   "end_sec": 33.094
  },
  {
   "sentence_id": "C54-B001-S07",
   "section": "B",
   "text": "佐藤さんは後始末を引き受けました。",
   "start_sec": 33.294,
   "end_sec": 36.527
  },
  {
   "sentence_id": "C54-B001-S08",
   "section": "B",
   "text": "ミンさんは三時半に出ますが、準備への参加は確認中です。",
   "start_sec": 36.727,
   "end_sec": 42.214
  },
  {
   "sentence_id": "C54-B002-S01",
   "section": "B",
   "text": "学習用の本を選ぶ机では、短い練習を自由に試せます。",
   "start_sec": 42.664,
   "end_sec": 48.05
  },
  {
   "sentence_id": "C54-B002-S02",
   "section": "B",
   "text": "これは学力を測るテストではありません。",
   "start_sec": 48.25,
   "end_sec": 51.335
  },
  {
   "sentence_id": "C54-B002-S03",
   "section": "B",
   "text": "難問が解けないことを恥ずかしがる必要もありません。",
   "start_sec": 51.535,
   "end_sec": 55.128
  },
  {
   "sentence_id": "C54-B002-S04",
   "section": "B",
   "text": "穴埋めの問題では、例文を読んで空白に合う言葉を考えます。",
   "start_sec": 55.328,
   "end_sec": 60.481
  },
  {
   "sentence_id": "C54-B002-S05",
   "section": "B",
   "text": "正しい答えを確認し、解説が分かりやすいかも確かめてください。",
   "start_sec": 60.681,
   "end_sec": 65.475
  },
  {
   "sentence_id": "C54-B002-S06",
   "section": "B",
   "text": "答えの暗記より、説明の方法を重視して本を選ぶことを勧めます。",
   "start_sec": 65.675,
   "end_sec": 71.465
  },
  {
   "sentence_id": "C54-B002-S07",
   "section": "B",
   "text": "覚えた知識の応用にも役立つ本を探しましょう。",
   "start_sec": 71.665,
   "end_sec": 75.878
  },
  {
   "sentence_id": "C54-B003-S01",
   "section": "B",
   "text": "筆記試験の練習帳には、問題用紙と解答用紙の見本があります。",
   "start_sec": 76.328,
   "end_sec": 82.846
  },
  {
   "sentence_id": "C54-B003-S02",
   "section": "B",
   "text": "問題を読む前に書き始めると、解答欄を間違えるかもしれません。",
   "start_sec": 83.046,
   "end_sec": 88.02
  },
  {
   "sentence_id": "C54-B003-S03",
   "section": "B",
   "text": "名前を書き間違ったら、書き直してください。",
   "start_sec": 88.22,
   "end_sec": 91.502
  },
  {
   "sentence_id": "C54-B003-S04",
   "section": "B",
   "text": "自分で採点した後も答案を残すと、間違いを確認できます。",
   "start_sec": 91.702,
   "end_sec": 97.146
  },
  {
   "sentence_id": "C54-B003-S05",
   "section": "B",
   "text": "満点を取ることだけが目的ではありません。",
   "start_sec": 97.346,
   "end_sec": 100.52
  },
  {
   "sentence_id": "C54-B003-S06",
   "section": "B",
   "text": "口頭試験の本には音声もあります。",
   "start_sec": 100.72,
   "end_sec": 103.893
  },
  {
   "sentence_id": "C54-B003-S07",
   "section": "B",
   "text": "文章を読み上げる機器のテストは、係の人に頼んでください。",
   "start_sec": 104.093,
   "end_sec": 109.01
  },
  {
   "sentence_id": "C54-B004-S01",
   "section": "B",
   "text": "漢和辞典を紹介する人は、「学力」のような漢字の熟語を一つ選び、引き方を見せます。",
   "start_sec": 109.46,
   "end_sec": 116.683
  },
  {
   "sentence_id": "C54-B004-S02",
   "section": "B",
   "text": "感想文の本を紹介する人は、内容の善し悪しを一方的に判断せず、書いた人が何を伝えたいか聞いてください。",
   "start_sec": 116.883,
   "end_sec": 125.756
  },
  {
   "sentence_id": "C54-B004-S03",
   "section": "B",
   "text": "スピーチ・コンテストの本では、話の例と講評を一緒に読めます。",
   "start_sec": 125.956,
   "end_sec": 131.353
  },
  {
   "sentence_id": "C54-B004-S04",
   "section": "B",
   "text": "紹介する人の価値観や利害が違っても、ほかの人の選択を尊重するという方針は共通です。",
   "start_sec": 131.553,
   "end_sec": 138.987
  },
  {
   "sentence_id": "C54-B005-S01",
   "section": "B",
   "text": "手伝えない人は断ってもかまいません。",
   "start_sec": 139.437,
   "end_sec": 142.294
  },
  {
   "sentence_id": "C54-B005-S02",
   "section": "B",
   "text": "義理で引き受けることはありません。",
   "start_sec": 142.494,
   "end_sec": 144.828
  },
  {
   "sentence_id": "C54-B005-S03",
   "section": "B",
   "text": "理由が正当かどうかを担当者が決めるのは妥当ではないと考えます。",
   "start_sec": 145.028,
   "end_sec": 151.096
  },
  {
   "sentence_id": "C54-B005-S04",
   "section": "B",
   "text": "無理な頼み方は、相手に負担を与える行為です。",
   "start_sec": 151.296,
   "end_sec": 155.375
  },
  {
   "sentence_id": "C54-B005-S05",
   "section": "B",
   "text": "困っている人に機会を与えることの重要性も考慮してください。",
   "start_sec": 155.575,
   "end_sec": 160.798
  },
  {
   "sentence_id": "C54-B005-S06",
   "section": "B",
   "text": "全員に同じ仕事をさせれば公平になるわけではありません。",
   "start_sec": 160.998,
   "end_sec": 165.851
  },
  {
   "sentence_id": "C54-B005-S07",
   "section": "B",
   "text": "参加者の声に耳を傾け、分担の変更を認めます。",
   "start_sec": 166.051,
   "end_sec": 170.998
  },
  {
   "sentence_id": "C54-B006-S01",
   "section": "B",
   "text": "人が少なければ、紹介する本を少なくするほかありません。",
   "start_sec": 171.448,
   "end_sec": 176.256
  },
  {
   "sentence_id": "C54-B006-S02",
   "section": "B",
   "text": "危険な作業を続けるよりましです。",
   "start_sec": 176.456,
   "end_sec": 178.909
  },
  {
   "sentence_id": "C54-B006-S03",
   "section": "B",
   "text": "ただし、引き受けた後で来られなくなった場合は、アナに連絡してください。",
   "start_sec": 179.109,
   "end_sec": 184.44
  },
  {
   "sentence_id": "C54-B006-S04",
   "section": "B",
   "text": "変更を見過ごして、連絡しないわけにはいきません。",
   "start_sec": 184.64,
   "end_sec": 188.756
  },
  {
   "sentence_id": "C54-B006-S05",
   "section": "B",
   "text": "アナが分担を調整します。",
   "start_sec": 188.956,
   "end_sec": 191.83
  },
  {
   "sentence_id": "C54-B006-S06",
   "section": "B",
   "text": "担当者は問題の解決に責任を持ちますが、一人で全部決めるべきではありません。",
   "start_sec": 192.03,
   "end_sec": 198.56
  },
  {
   "sentence_id": "C54-B006-S07",
   "section": "B",
   "text": "相談できる時間を作ることが望ましいと考えます。",
   "start_sec": 198.76,
   "end_sec": 203.314
  },
  {
   "sentence_id": "C54-B007-S01",
   "section": "B",
   "text": "木曜日までに意見をアナへ寄せてください。",
   "start_sec": 203.764,
   "end_sec": 207.357
  },
  {
   "sentence_id": "C54-B007-S02",
   "section": "B",
   "text": "分担には変更の余地があります。",
   "start_sec": 207.557,
   "end_sec": 210.53
  },
  {
   "sentence_id": "C54-B007-S03",
   "section": "B",
   "text": "月曜日の合意は三人の合意で、全員の同意ではありません。",
   "start_sec": 210.73,
   "end_sec": 216.167
  },
  {
   "sentence_id": "C54-B007-S04",
   "section": "B",
   "text": "金曜日に案を決めて知らせます。",
   "start_sec": 216.367,
   "end_sec": 219.361
  },
  {
   "sentence_id": "C54-B007-S05",
   "section": "B",
   "text": "「人を手伝うべきだ」という道徳を理由に、強引な押し付けをするのは控えましょう。",
   "start_sec": 219.561,
   "end_sec": 225.37
  },
  {
   "sentence_id": "C54-B007-S06",
   "section": "B",
   "text": "良識に期待するだけでは負担は変わりません。",
   "start_sec": 225.57,
   "end_sec": 228.96
  },
  {
   "sentence_id": "C54-B007-S07",
   "section": "B",
   "text": "安全の原則は変えず、時間の分担では譲歩し、本の数では妥協するという選択肢を考えます。",
   "start_sec": 229.16,
   "end_sec": 237.373
  }
 ]
}
