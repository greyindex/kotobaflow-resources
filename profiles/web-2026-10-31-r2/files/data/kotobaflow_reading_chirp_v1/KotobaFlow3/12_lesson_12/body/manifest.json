{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 100.243,
 "source_chapter": 48,
 "sentence_intervals": [
  {
   "sentence_id": "C48-A001-S01",
   "section": "A",
   "text": "一月十二日、ミンは国際交流会の案内三十枚をみどり印刷店で受け取った。",
   "start_sec": 0.0,
   "end_sec": 7.673
  },
  {
   "sentence_id": "C48-A001-S02",
   "section": "A",
   "text": "注文番号は二十五番だった。",
   "start_sec": 7.873,
   "end_sec": 10.509
  },
  {
   "sentence_id": "C48-A001-S03",
   "section": "A",
   "text": "店を出る前に読んだら、メールアドレスに間違いがあった。",
   "start_sec": 10.709,
   "end_sec": 15.075
  },
  {
   "sentence_id": "C48-A001-S04",
   "section": "A",
   "text": "印刷を申し込む前に送った原稿には、正しいアドレスが書いてあった。",
   "start_sec": 15.275,
   "end_sec": 20.879
  },
  {
   "sentence_id": "C48-A002-S01",
   "section": "A",
   "text": "ミンは店員に原稿を見せたが、その日は印刷の担当者がいなかった。",
   "start_sec": 21.329,
   "end_sec": 26.979
  },
  {
   "sentence_id": "C48-A002-S02",
   "section": "A",
   "text": "次の日、アナが電話で相談した。",
   "start_sec": 27.179,
   "end_sec": 30.199
  },
  {
   "sentence_id": "C48-A002-S03",
   "section": "A",
   "text": "三十枚はまだ配っていない。",
   "start_sec": 30.399,
   "end_sec": 32.85
  },
  {
   "sentence_id": "C48-A002-S04",
   "section": "A",
   "text": "ほかの被害はまだ確認できていない。",
   "start_sec": 33.05,
   "end_sec": 36.213
  },
  {
   "sentence_id": "C48-A002-S05",
   "section": "A",
   "text": "店では苦情の記録を残すが、原因も責任も、これから確かめる。",
   "start_sec": 36.413,
   "end_sec": 42.142
  },
  {
   "sentence_id": "C48-A003-S01",
   "section": "A",
   "text": "電話の途中で、担当の田中は「原稿と案内を持って、今日、店にいらっしゃることはできますか」と言った。",
   "start_sec": 42.592,
   "end_sec": 50.545
  },
  {
   "sentence_id": "C48-A003-S02",
   "section": "A",
   "text": "アナは授業があって行けないので、断った。",
   "start_sec": 50.745,
   "end_sec": 54.648
  },
  {
   "sentence_id": "C48-A003-S03",
   "section": "A",
   "text": "それから、代わりに原稿と写真をメールで送ってもいいか聞いた。",
   "start_sec": 54.848,
   "end_sec": 60.402
  },
  {
   "sentence_id": "C48-A003-S04",
   "section": "A",
   "text": "田中は「それで大丈夫です」と答えた。",
   "start_sec": 60.602,
   "end_sec": 63.988
  },
  {
   "sentence_id": "C48-A003-S05",
   "section": "A",
   "text": "アナは送る前に写真を大きくして、文字が読めるか確かめた。",
   "start_sec": 64.188,
   "end_sec": 70.266
  },
  {
   "sentence_id": "C48-A003-S06",
   "section": "A",
   "text": "もう一度印刷するかどうかは、まだ決まっていない。",
   "start_sec": 70.466,
   "end_sec": 74.277
  },
  {
   "sentence_id": "C48-A004-S01",
   "section": "A",
   "text": "電話の後、アナはメールを書いた。",
   "start_sec": 74.727,
   "end_sec": 77.703
  },
  {
   "sentence_id": "C48-A004-S02",
   "section": "A",
   "text": "目的は次にだれが何をするか確認することだ。",
   "start_sec": 77.903,
   "end_sec": 82.134
  },
  {
   "sentence_id": "C48-A004-S03",
   "section": "A",
   "text": "礼儀を守って相手の立場を考える。",
   "start_sec": 82.334,
   "end_sec": 85.991
  },
  {
   "sentence_id": "C48-A004-S04",
   "section": "A",
   "text": "でも、自分の意思や希望もはっきり伝える。",
   "start_sec": 86.191,
   "end_sec": 90.511
  },
  {
   "sentence_id": "C48-A004-S05",
   "section": "A",
   "text": "アナは授業で勉強した敬語を使い、できないことと代わりにできることを書いた。",
   "start_sec": 90.711,
   "end_sec": 96.863
  },
  {
   "sentence_id": "C48-A004-S06",
   "section": "A",
   "text": "今後も同じ記録を見ながら連絡していく。",
   "start_sec": 97.063,
   "end_sec": 100.236
  }
 ]
}
