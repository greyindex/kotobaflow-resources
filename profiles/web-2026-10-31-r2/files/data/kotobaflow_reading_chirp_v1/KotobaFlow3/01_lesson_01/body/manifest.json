{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 57.313,
 "source_chapter": 37,
 "sentence_intervals": [
  {
   "sentence_id": "C37-A001-S01",
   "section": "A",
   "text": "土曜日の八時五十分、アナさんはさくら市民センターの教室Ｂに着きました。",
   "start_sec": 0.0,
   "end_sec": 6.293
  },
  {
   "sentence_id": "C37-A001-S02",
   "section": "A",
   "text": "九時から日本語の会があります。",
   "start_sec": 6.493,
   "end_sec": 8.947
  },
  {
   "sentence_id": "C37-A001-S03",
   "section": "A",
   "text": "昨日の写真の会の道具が残っています。",
   "start_sec": 9.147,
   "end_sec": 12.364
  },
  {
   "sentence_id": "C37-A001-S04",
   "section": "A",
   "text": "右の窓が開きっぱなしで、写真が床に落ちています。",
   "start_sec": 12.564,
   "end_sec": 17.015
  },
  {
   "sentence_id": "C37-A001-S05",
   "section": "A",
   "text": "壊れたフレームの裏に、インクが付いています。",
   "start_sec": 17.215,
   "end_sec": 20.509
  },
  {
   "sentence_id": "C37-A002-S01",
   "section": "A",
   "text": "机の真ん中には、横倒しの瓶があります。",
   "start_sec": 20.959,
   "end_sec": 24.732
  },
  {
   "sentence_id": "C37-A002-S02",
   "section": "A",
   "text": "零れた水で布が濡れ、表面が青く染まっています。",
   "start_sec": 24.932,
   "end_sec": 29.605
  },
  {
   "sentence_id": "C37-A002-S03",
   "section": "A",
   "text": "壁の写真には色あせもありますが、それは昨日の写真でも確認できます。",
   "start_sec": 29.805,
   "end_sec": 35.739
  },
  {
   "sentence_id": "C37-A002-S04",
   "section": "A",
   "text": "アナさんは掃除の前に三枚撮り、見える状態を書き込みました。",
   "start_sec": 35.939,
   "end_sec": 40.938
  },
  {
   "sentence_id": "C37-A003-S01",
   "section": "A",
   "text": "だれかがわざと物を壊したかどうかは、まだわかりません。",
   "start_sec": 41.388,
   "end_sec": 46.285
  },
  {
   "sentence_id": "C37-A003-S02",
   "section": "A",
   "text": "アナさんは冷静でいようと思いました。",
   "start_sec": 46.485,
   "end_sec": 49.434
  },
  {
   "sentence_id": "C37-A003-S03",
   "section": "A",
   "text": "九時十分、管理担当の西田さんに連絡し、破損と前からの変化を分けて確認することにしました。",
   "start_sec": 49.634,
   "end_sec": 57.307
  }
 ]
}
