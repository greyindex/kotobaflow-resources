{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 170.894,
 "source_chapter": 44,
 "sentence_intervals": [
  {
   "sentence_id": "C44-B001-S01",
   "section": "B",
   "text": "みなさんへ。",
   "start_sec": 0.0,
   "end_sec": 1.168
  },
  {
   "sentence_id": "C44-B001-S02",
   "section": "B",
   "text": "代表のアナです。",
   "start_sec": 1.368,
   "end_sec": 3.162
  },
  {
   "sentence_id": "C44-B001-S03",
   "section": "B",
   "text": "十一月二十七日の相談の報告です。",
   "start_sec": 3.362,
   "end_sec": 6.787
  },
  {
   "sentence_id": "C44-B001-S04",
   "section": "B",
   "text": "十二月十一日のパーティーは十八時から二十時三十分まで、センターの会議室Ａで開きます。",
   "start_sec": 6.987,
   "end_sec": 15.774
  },
  {
   "sentence_id": "C44-B001-S05",
   "section": "B",
   "text": "管理者の西田さんから、十七時からの使用の承認をもらいました。",
   "start_sec": 15.974,
   "end_sec": 20.972
  },
  {
   "sentence_id": "C44-B001-S06",
   "section": "B",
   "text": "準備は十七時から十八時までです。",
   "start_sec": 21.172,
   "end_sec": 24.466
  },
  {
   "sentence_id": "C44-B002-S01",
   "section": "B",
   "text": "安全についての指示に従い、机といすは元に戻し、ごみは持ち帰ります。",
   "start_sec": 24.916,
   "end_sec": 31.562
  },
  {
   "sentence_id": "C44-B002-S02",
   "section": "B",
   "text": "鍵は二十一時までに事務室前の返却箱へ入れてください。",
   "start_sec": 31.762,
   "end_sec": 37.15
  },
  {
   "sentence_id": "C44-B002-S03",
   "section": "B",
   "text": "代表の私が責任を担いますが、仕事を一方的に命じる権限はありません。",
   "start_sec": 37.35,
   "end_sec": 43.943
  },
  {
   "sentence_id": "C44-B002-S04",
   "section": "B",
   "text": "委員も本人に確認してから事に当たります。",
   "start_sec": 44.143,
   "end_sec": 47.753
  },
  {
   "sentence_id": "C44-B003-S01",
   "section": "B",
   "text": "ミンさんは十六時まで試験なので準備を休み、十八時から十八時三十分まで受付を担当します。",
   "start_sec": 48.203,
   "end_sec": 56.764
  },
  {
   "sentence_id": "C44-B003-S02",
   "section": "B",
   "text": "佐藤さんは十八時まで仕事で、十八時四十分ごろ到着します。",
   "start_sec": 56.964,
   "end_sec": 62.799
  },
  {
   "sentence_id": "C44-B003-S03",
   "section": "B",
   "text": "片付けは二十時三十分から二十一時まで、私と佐藤さんともう一人で行い、担当は毎回交代します。",
   "start_sec": 62.999,
   "end_sec": 72.892
  },
  {
   "sentence_id": "C44-B003-S04",
   "section": "B",
   "text": "佐藤さんが鍵を返します。",
   "start_sec": 73.092,
   "end_sec": 75.425
  },
  {
   "sentence_id": "C44-B003-S05",
   "section": "B",
   "text": "準備の手伝いと片付けの三人目は募集中です。",
   "start_sec": 75.625,
   "end_sec": 80.178
  },
  {
   "sentence_id": "C44-B003-S06",
   "section": "B",
   "text": "十二月四日までにメールで返事をください。",
   "start_sec": 80.379,
   "end_sec": 83.996
  },
  {
   "sentence_id": "C44-B003-S07",
   "section": "B",
   "text": "希望者がいなければ再相談します。",
   "start_sec": 84.196,
   "end_sec": 87.01
  },
  {
   "sentence_id": "C44-B004-S01",
   "section": "B",
   "text": "今回は短い演劇もあります。",
   "start_sec": 87.46,
   "end_sec": 89.939
  },
  {
   "sentence_id": "C44-B004-S02",
   "section": "B",
   "text": "作品は、科学者になりたい子どもと、医科大学の研究所で働く大人の物語です。",
   "start_sec": 90.139,
   "end_sec": 97.392
  },
  {
   "sentence_id": "C44-B004-S03",
   "section": "B",
   "text": "監督役は俳優の経験がある会員です。",
   "start_sec": 97.592,
   "end_sec": 101.365
  },
  {
   "sentence_id": "C44-B004-S04",
   "section": "B",
   "text": "女優と男優の二人が出演し、ヒロインとその相手役を演じます。",
   "start_sec": 101.565,
   "end_sec": 107.416
  },
  {
   "sentence_id": "C44-B004-S05",
   "section": "B",
   "text": "稽古ではベテランがリード役を務めますが、指示を命令と感じたら相談できます。",
   "start_sec": 107.616,
   "end_sec": 114.33
  },
  {
   "sentence_id": "C44-B004-S06",
   "section": "B",
   "text": "観客にも意見を聞く予定です。",
   "start_sec": 114.53,
   "end_sec": 117.223
  },
  {
   "sentence_id": "C44-B005-S01",
   "section": "B",
   "text": "大道具は運びやすい紙の家です。",
   "start_sec": 117.673,
   "end_sec": 120.846
  },
  {
   "sentence_id": "C44-B005-S02",
   "section": "B",
   "text": "手仕事が好きな人が作ります。",
   "start_sec": 121.046,
   "end_sec": 123.56
  },
  {
   "sentence_id": "C44-B005-S03",
   "section": "B",
   "text": "コスチュームはデザイナーに相談しました。",
   "start_sec": 123.76,
   "end_sec": 126.965
  },
  {
   "sentence_id": "C44-B005-S04",
   "section": "B",
   "text": "縫い物が得意な会員が直します。",
   "start_sec": 127.165,
   "end_sec": 130.57
  },
  {
   "sentence_id": "C44-B005-S05",
   "section": "B",
   "text": "美容師の会員も髪を整えてくれます。",
   "start_sec": 130.77,
   "end_sec": 134.123
  },
  {
   "sentence_id": "C44-B005-S06",
   "section": "B",
   "text": "アーティストに全部任せるのではなく、できる仕事を選んでください。",
   "start_sec": 134.323,
   "end_sec": 139.239
  },
  {
   "sentence_id": "C44-B005-S07",
   "section": "B",
   "text": "子どもは紙芝居を見るだけでも楽しめます。",
   "start_sec": 139.439,
   "end_sec": 142.733
  },
  {
   "sentence_id": "C44-B005-S08",
   "section": "B",
   "text": "保護者の名前も知らせ、一緒に帰ってください。",
   "start_sec": 142.933,
   "end_sec": 146.683
  },
  {
   "sentence_id": "C44-B005-S09",
   "section": "B",
   "text": "子どもに片付けをさせる予定はありません。",
   "start_sec": 146.883,
   "end_sec": 149.757
  },
  {
   "sentence_id": "C44-B006-S01",
   "section": "B",
   "text": "十二月十九日十時から十二時のセンターの掃除は、パーティーの片付けとは別です。",
   "start_sec": 150.207,
   "end_sec": 156.911
  },
  {
   "sentence_id": "C44-B006-S02",
   "section": "B",
   "text": "参加は自由で、強制ではありません。",
   "start_sec": 157.111,
   "end_sec": 160.346
  },
  {
   "sentence_id": "C44-B006-S03",
   "section": "B",
   "text": "私とミンさんは参加希望、佐藤さんは会社の予定で辞退しました。",
   "start_sec": 160.546,
   "end_sec": 166.899
  },
  {
   "sentence_id": "C44-B006-S04",
   "section": "B",
   "text": "ほかの人も十二月四日までに返事をください。",
   "start_sec": 167.099,
   "end_sec": 170.887
  }
 ]
}
