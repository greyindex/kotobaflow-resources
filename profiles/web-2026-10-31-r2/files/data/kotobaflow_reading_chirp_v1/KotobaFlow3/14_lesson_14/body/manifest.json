{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 114.025,
 "source_chapter": 50,
 "sentence_intervals": [
  {
   "sentence_id": "C50-A001-S01",
   "section": "A",
   "text": "二月六日の午後、会議室Ａで好きな日本語を紙に書いて紹介します。",
   "start_sec": 0.0,
   "end_sec": 6.181
  },
  {
   "sentence_id": "C50-A001-S02",
   "section": "A",
   "text": "私は紙とペンさえあれば十分だと思っていました。",
   "start_sec": 6.381,
   "end_sec": 10.514
  },
  {
   "sentence_id": "C50-A001-S03",
   "section": "A",
   "text": "しかし、準備を疎かにすると、人の安全を守れません。",
   "start_sec": 10.714,
   "end_sec": 15.683
  },
  {
   "sentence_id": "C50-A001-S04",
   "section": "A",
   "text": "アナさんは「転ばぬ先の杖ですね」と言い、道具の扱い方も確認しようと提案しました。",
   "start_sec": 15.883,
   "end_sec": 22.716
  },
  {
   "sentence_id": "C50-A001-S05",
   "section": "A",
   "text": "いくら急いでも、確認だけは省けません。",
   "start_sec": 22.916,
   "end_sec": 26.329
  },
  {
   "sentence_id": "C50-A001-S06",
   "section": "A",
   "text": "予定の変更に備えるには、連絡方法も決めておく必要があります。",
   "start_sec": 26.529,
   "end_sec": 32.474
  },
  {
   "sentence_id": "C50-A002-S01",
   "section": "A",
   "text": "私たちは借りた材料でカードの見本を作りました。",
   "start_sec": 32.924,
   "end_sec": 37.56
  },
  {
   "sentence_id": "C50-A002-S02",
   "section": "A",
   "text": "まず鋏の持ち方を確かめ、紙をチョッキンと切って二つに折ります。",
   "start_sec": 37.76,
   "end_sec": 43.521
  },
  {
   "sentence_id": "C50-A002-S03",
   "section": "A",
   "text": "形は不揃いでも、厚さはほぼ均一です。",
   "start_sec": 43.721,
   "end_sec": 47.314
  },
  {
   "sentence_id": "C50-A002-S04",
   "section": "A",
   "text": "チューブ入りののりを少し出し、紙を板にくっつけます。",
   "start_sec": 47.514,
   "end_sec": 51.457
  },
  {
   "sentence_id": "C50-A002-S05",
   "section": "A",
   "text": "分量を増やすだけでは、丈夫になりません。",
   "start_sec": 51.657,
   "end_sec": 55.074
  },
  {
   "sentence_id": "C50-A002-S06",
   "section": "A",
   "text": "地球の絵のステッカーをあしらうと、紹介の話題も広がりました。",
   "start_sec": 55.274,
   "end_sec": 60.398
  },
  {
   "sentence_id": "C50-A003-S01",
   "section": "A",
   "text": "見本を立てるには、短い棒に糸をぐるぐる巻き付けて結びます。",
   "start_sec": 60.848,
   "end_sec": 66.436
  },
  {
   "sentence_id": "C50-A003-S02",
   "section": "A",
   "text": "幾重にも巻くと結び目が大きくなり、穴に差し込めません。",
   "start_sec": 66.636,
   "end_sec": 71.377
  },
  {
   "sentence_id": "C50-A003-S03",
   "section": "A",
   "text": "強く引っぱる代わりに、一度解いて巻き直しました。",
   "start_sec": 71.577,
   "end_sec": 75.695
  },
  {
   "sentence_id": "C50-A003-S04",
   "section": "A",
   "text": "片付ける時は結び目を解き、板から棒を外します。",
   "start_sec": 75.895,
   "end_sec": 80.629
  },
  {
   "sentence_id": "C50-A003-S05",
   "section": "A",
   "text": "道具を転がすと落ちるので、箱に戻します。",
   "start_sec": 80.829,
   "end_sec": 84.302
  },
  {
   "sentence_id": "C50-A003-S06",
   "section": "A",
   "text": "失敗に応じて手順を変えることも必要でした。",
   "start_sec": 84.502,
   "end_sec": 88.275
  },
  {
   "sentence_id": "C50-A004-S01",
   "section": "A",
   "text": "注意深いアナさんは、高い棚の荷物を下ろすために踏み台を用意しました。",
   "start_sec": 88.725,
   "end_sec": 95.019
  },
  {
   "sentence_id": "C50-A004-S02",
   "section": "A",
   "text": "縄で結んだ箱は一緒に運び、床の汚れはバケツの水で拭きました。",
   "start_sec": 95.219,
   "end_sec": 101.332
  },
  {
   "sentence_id": "C50-A004-S03",
   "section": "A",
   "text": "「急がば回れ」という言葉の意味が分かりました。",
   "start_sec": 101.532,
   "end_sec": 105.125
  },
  {
   "sentence_id": "C50-A004-S04",
   "section": "A",
   "text": "危険を避けるには用心が必要です。",
   "start_sec": 105.325,
   "end_sec": 108.486
  },
  {
   "sentence_id": "C50-A004-S05",
   "section": "A",
   "text": "今のうちに手を打つことが、当日の間違いを防ぐ対策になるのです。",
   "start_sec": 108.686,
   "end_sec": 114.019
  }
 ]
}
