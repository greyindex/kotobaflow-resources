{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 159.326,
 "source_chapter": 41,
 "sentence_intervals": [
  {
   "sentence_id": "C41-B005-S01",
   "section": "B",
   "text": "観察メモ・アナ。",
   "start_sec": 0.0,
   "end_sec": 1.313
  },
  {
   "sentence_id": "C41-B005-S02",
   "section": "B",
   "text": "夕方、一階の「見たことと聞いたこと」展は人出が多く、活気にあふれていた。",
   "start_sec": 1.513,
   "end_sec": 7.627
  },
  {
   "sentence_id": "C41-B005-S03",
   "section": "B",
   "text": "音の正体を当てる展示で、私は自分の観察を記録した。",
   "start_sec": 7.827,
   "end_sec": 13.1
  },
  {
   "sentence_id": "C41-B005-S04",
   "section": "B",
   "text": "窓から山を望む席に座ると、柱の陰で何かが動くのが目に入った。",
   "start_sec": 13.3,
   "end_sec": 19.529
  },
  {
   "sentence_id": "C41-B005-S05",
   "section": "B",
   "text": "周囲を見回すと、風が薄い布を煽っていた。",
   "start_sec": 19.729,
   "end_sec": 23.882
  },
  {
   "sentence_id": "C41-B005-S06",
   "section": "B",
   "text": "ひらひら揺れる布が壁をパタパタとたたき、窓の隙間からちょろちょろと水が流れていた。",
   "start_sec": 24.082,
   "end_sec": 31.608
  },
  {
   "sentence_id": "C41-B005-S07",
   "section": "B",
   "text": "パラパラ降り始めた雨は、やがてザーザー降った。",
   "start_sec": 31.808,
   "end_sec": 35.733
  },
  {
   "sentence_id": "C41-B005-S08",
   "section": "B",
   "text": "高温多湿の日で、窓にも湿気が多かった。",
   "start_sec": 35.933,
   "end_sec": 39.466
  },
  {
   "sentence_id": "C41-B005-S09",
   "section": "B",
   "text": "係の人に知らせると、すぐ窓を閉めて水を拭いてくれた。",
   "start_sec": 39.666,
   "end_sec": 44.719
  },
  {
   "sentence_id": "C41-B005-S10",
   "section": "B",
   "text": "視線を戻すと、映像の中で煙が立ち昇っていた。",
   "start_sec": 44.919,
   "end_sec": 49.459
  },
  {
   "sentence_id": "C41-B005-S11",
   "section": "B",
   "text": "まるで本物の火事のようで、不思議な気がした。",
   "start_sec": 49.659,
   "end_sec": 53.595
  },
  {
   "sentence_id": "C41-B005-S12",
   "section": "B",
   "text": "出口の注意書きが目に付いた。",
   "start_sec": 53.795,
   "end_sec": 56.128
  },
  {
   "sentence_id": "C41-B005-S13",
   "section": "B",
   "text": "「一目で安全と判定しない。",
   "start_sec": 56.328,
   "end_sec": 58.766
  },
  {
   "sentence_id": "C41-B005-S14",
   "section": "B",
   "text": "実際に確かめる。」と書いてあった。",
   "start_sec": 58.966,
   "end_sec": 61.959
  },
  {
   "sentence_id": "C41-B001-S01",
   "section": "B",
   "text": "忘れ物記録・西田。",
   "start_sec": 62.409,
   "end_sec": 64.502
  },
  {
   "sentence_id": "C41-B001-S02",
   "section": "B",
   "text": "十月二十日火曜日、二十時。",
   "start_sec": 64.702,
   "end_sec": 67.336
  },
  {
   "sentence_id": "C41-B001-S03",
   "section": "B",
   "text": "十八時四十分、アナさんが一階のベンチで紙袋を発見した。",
   "start_sec": 67.536,
   "end_sec": 73.564
  },
  {
   "sentence_id": "C41-B001-S04",
   "section": "B",
   "text": "中には「こむぎ」のクリームパン二つ、牛乳一本、当日十七時五十二分のレシート。",
   "start_sec": 73.764,
   "end_sec": 81.677
  },
  {
   "sentence_id": "C41-B001-S05",
   "section": "B",
   "text": "私は十八時から十五分間、別の教室にいて事務室は留守だった。",
   "start_sec": 81.877,
   "end_sec": 87.27
  },
  {
   "sentence_id": "C41-B001-S06",
   "section": "B",
   "text": "十八時には袋がなかったはずだが、記憶違いの可能性はある。",
   "start_sec": 87.47,
   "end_sec": 92.831
  },
  {
   "sentence_id": "C41-B002-S01",
   "section": "B",
   "text": "十八時二十分、二階へ行く足音がした。",
   "start_sec": 93.281,
   "end_sec": 97.058
  },
  {
   "sentence_id": "C41-B002-S02",
   "section": "B",
   "text": "書道教室の人だと推測し、十九時半の終了後に戻ると予測した。",
   "start_sec": 97.258,
   "end_sec": 103.186
  },
  {
   "sentence_id": "C41-B002-S03",
   "section": "B",
   "text": "予定表を見ると教室は木曜日で、私の勘違いだった。",
   "start_sec": 103.386,
   "end_sec": 108.605
  },
  {
   "sentence_id": "C41-B002-S04",
   "section": "B",
   "text": "十八時五十五分、人の気配はなかった。",
   "start_sec": 108.805,
   "end_sec": 112.502
  },
  {
   "sentence_id": "C41-B002-S05",
   "section": "B",
   "text": "原さんによると小川さんが十八時二十分ごろ来たそうだ。",
   "start_sec": 112.702,
   "end_sec": 117.437
  },
  {
   "sentence_id": "C41-B002-S06",
   "section": "B",
   "text": "足音は小川さんのものらしいが、直接見ていない。",
   "start_sec": 117.637,
   "end_sec": 121.819
  },
  {
   "sentence_id": "C41-B003-S01",
   "section": "B",
   "text": "アナさんは十八時二十八分ごろ、入口で電話しながら急ぐ人を見た。",
   "start_sec": 122.269,
   "end_sec": 128.616
  },
  {
   "sentence_id": "C41-B003-S02",
   "section": "B",
   "text": "袋は見ていない。",
   "start_sec": 128.816,
   "end_sec": 130.365
  },
  {
   "sentence_id": "C41-B003-S03",
   "section": "B",
   "text": "言動や外見を怪しいと思っても、疑う根拠にはならない。",
   "start_sec": 130.565,
   "end_sec": 135.319
  },
  {
   "sentence_id": "C41-B003-S04",
   "section": "B",
   "text": "偶然そこにいたのかもしれない。",
   "start_sec": 135.519,
   "end_sec": 137.672
  },
  {
   "sentence_id": "C41-B004-S01",
   "section": "B",
   "text": "十九時五分、松井さんから電話。",
   "start_sec": 138.122,
   "end_sec": 141.409
  },
  {
   "sentence_id": "C41-B004-S02",
   "section": "B",
   "text": "留守の事務室前で待ったそうだ。",
   "start_sec": 141.608,
   "end_sec": 143.989
  },
  {
   "sentence_id": "C41-B004-S03",
   "section": "B",
   "text": "店名と数がレシートと一致した。",
   "start_sec": 144.189,
   "end_sec": 146.938
  },
  {
   "sentence_id": "C41-B004-S04",
   "section": "B",
   "text": "十九時四十分、松井さんが現れた。",
   "start_sec": 147.138,
   "end_sec": 150.312
  },
  {
   "sentence_id": "C41-B004-S05",
   "section": "B",
   "text": "名前と中身を再確認し、相違がないので返した。",
   "start_sec": 150.512,
   "end_sec": 155.035
  },
  {
   "sentence_id": "C41-B004-S06",
   "section": "B",
   "text": "正確な紛失時刻と入口の人の身元は不明だ。",
   "start_sec": 155.235,
   "end_sec": 159.32
  }
 ]
}
