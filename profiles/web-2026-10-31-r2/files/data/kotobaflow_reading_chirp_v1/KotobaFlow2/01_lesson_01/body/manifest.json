 "duration_sec": 47.718,
 "source_chapter": 19,
 "sentence_intervals": [
  {
   "sentence_id": "C19-A001-S01",
   "section": "A",
   "text": "私は毎月、センターの読書会に行きます。",
   "start_sec": 0.0,
   "end_sec": 3.533
  },
  {
   "sentence_id": "C19-A001-S02",
   "section": "A",
   "text": "仲間は森さん、木村さん、上田さん、トムさんです。",
   "start_sec": 3.733,
   "end_sec": 8.347
  },
  {
   "sentence_id": "C19-A001-S03",
   "section": "A",
   "text": "全員で五人です。",
   "start_sec": 8.547,
   "end_sec": 10.277
  },
  {
   "sentence_id": "C19-A001-S04",
   "section": "A",
   "text": "私たちは読書会を交流の場と考えています。",
   "start_sec": 10.477,
   "end_sec": 14.574
  },
  {
   "sentence_id": "C19-A002-S01",
   "section": "A",
   "text": "6月7日の夜、森さんはチャットで「14日は公園で読書会をしませんか」と言いました。",
   "start_sec": 15.024,
   "end_sec": 23.111
  },
  {
   "sentence_id": "C19-A002-S02",
   "section": "A",
   "text": "先月も同じ提案をしました。",
   "start_sec": 23.311,
   "end_sec": 25.704
  },
  {
   "sentence_id": "C19-A002-S03",
   "section": "A",
   "text": "森さんはずっと、外の読書会はいいと思っています。",
   "start_sec": 25.904,
   "end_sec": 29.857
  },
  {
   "sentence_id": "C19-A003-S01",
   "section": "A",
   "text": "木村さんは賛成しました。",
   "start_sec": 30.307,
   "end_sec": 32.221
  },
  {
   "sentence_id": "C19-A003-S02",
   "section": "A",
   "text": "上田さんは場所を考えています。",
   "start_sec": 32.421,
   "end_sec": 35.102
  },
  {
   "sentence_id": "C19-A003-S03",
   "section": "A",
   "text": "トムさんの返事はまだです。",
   "start_sec": 35.302,
   "end_sec": 37.231
  },
  {
   "sentence_id": "C19-A003-S04",
   "section": "A",
   "text": "私は反対の理由を述べました。",
   "start_sec": 37.431,
   "end_sec": 40.065
  },
  {
   "sentence_id": "C19-A003-S05",
   "section": "A",
   "text": "机がありませんから、センターがいいと思います。",
   "start_sec": 40.265,
   "end_sec": 43.738
  },
  {
   "sentence_id": "C19-A003-S06",
   "section": "A",
   "text": "短い言葉で自分の考えを言い表します。",
   "start_sec": 43.938,
   "end_sec": 47.712
  }
 ]
}
