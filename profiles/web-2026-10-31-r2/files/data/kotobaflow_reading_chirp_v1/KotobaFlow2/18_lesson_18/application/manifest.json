{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 113.041,
 "source_chapter": 36,
 "sentence_intervals": [
  {
   "sentence_id": "C36-B001-S01",
   "section": "B",
   "text": "一月十六日は東町公民館で写真の会をします。",
   "start_sec": 0.0,
   "end_sec": 5.553
  },
  {
   "sentence_id": "C36-B001-S02",
   "section": "B",
   "text": "十四日に青木さんから「十六日は休みます」と連絡がありました。",
   "start_sec": 5.753,
   "end_sec": 11.28
  },
  {
   "sentence_id": "C36-B001-S03",
   "section": "B",
   "text": "参加予定は五人です。",
   "start_sec": 11.48,
   "end_sec": 13.646
  },
  {
   "sentence_id": "C36-B001-S04",
   "section": "B",
   "text": "会は午後二時から三時半までです。",
   "start_sec": 13.846,
   "end_sec": 16.644
  },
  {
   "sentence_id": "C36-B001-S05",
   "section": "B",
   "text": "青木さんは写真を届けなくてもいいです。",
   "start_sec": 16.844,
   "end_sec": 20.137
  },
  {
   "sentence_id": "C36-B002-S01",
   "section": "B",
   "text": "準備は午後一時四十分からです。",
   "start_sec": 20.587,
   "end_sec": 24.06
  },
  {
   "sentence_id": "C36-B002-S02",
   "section": "B",
   "text": "小野さんは鍵と部屋を確認します。",
   "start_sec": 24.26,
   "end_sec": 27.228
  },
  {
   "sentence_id": "C36-B002-S03",
   "section": "B",
   "text": "リーさんは小野さんに手伝ってもらって、机二つと椅子五つを準備します。",
   "start_sec": 27.428,
   "end_sec": 33.994
  },
  {
   "sentence_id": "C36-B002-S04",
   "section": "B",
   "text": "二時に始めて、一人三分で名前や趣味を話します。",
   "start_sec": 34.194,
   "end_sec": 38.915
  },
  {
   "sentence_id": "C36-B002-S05",
   "section": "B",
   "text": "それから写真を見ながら話します。",
   "start_sec": 39.115,
   "end_sec": 42.587
  },
  {
   "sentence_id": "C36-B002-S06",
   "section": "B",
   "text": "二時四十五分から十分間休憩します。",
   "start_sec": 42.787,
   "end_sec": 46.261
  },
  {
   "sentence_id": "C36-B002-S07",
   "section": "B",
   "text": "三時二十分に記録を書き始めて、三時半までに書き終わります。",
   "start_sec": 46.461,
   "end_sec": 51.872
  },
  {
   "sentence_id": "C36-B002-S08",
   "section": "B",
   "text": "会の後は二人で片づけて、小野さんが四時までに鍵を返します。",
   "start_sec": 52.072,
   "end_sec": 57.729
  },
  {
   "sentence_id": "C36-B003-S01",
   "section": "B",
   "text": "写真はリーさんが八枚持っていきます。",
   "start_sec": 58.179,
   "end_sec": 61.455
  },
  {
   "sentence_id": "C36-B003-S02",
   "section": "B",
   "text": "町と料理の写真を二枚ずつ選びます。",
   "start_sec": 61.655,
   "end_sec": 65.409
  },
  {
   "sentence_id": "C36-B003-S03",
   "section": "B",
   "text": "四枚は予備です。",
   "start_sec": 65.609,
   "end_sec": 67.693
  },
  {
   "sentence_id": "C36-B003-S04",
   "section": "B",
   "text": "小野さんは千二百円までのお茶を買います。",
   "start_sec": 67.893,
   "end_sec": 70.946
  },
  {
   "sentence_id": "C36-B003-S05",
   "section": "B",
   "text": "部屋、紙、ペンは無料です。",
   "start_sec": 71.146,
   "end_sec": 74.421
  },
  {
   "sentence_id": "C36-B003-S06",
   "section": "B",
   "text": "六百円は使わない予定です。",
   "start_sec": 74.621,
   "end_sec": 77.125
  },
  {
   "sentence_id": "C36-B003-S07",
   "section": "B",
   "text": "変更の連絡は小野さんの担当です。",
   "start_sec": 77.325,
   "end_sec": 80.614
  },
  {
   "sentence_id": "C36-B003-S08",
   "section": "B",
   "text": "リーさんが休むときは公民館にある町の地図を使います。",
   "start_sec": 80.814,
   "end_sec": 85.457
  },
  {
   "sentence_id": "C36-B003-S09",
   "section": "B",
   "text": "机は一つにして、参加する人に準備を手伝ってもらいます。",
   "start_sec": 85.657,
   "end_sec": 90.443
  },
  {
   "sentence_id": "C36-B004-S01",
   "section": "B",
   "text": "お願い：人の写真を撮る前に、その人に「写真を撮ってもいいですか」と聞いてください。",
   "start_sec": 90.893,
   "end_sec": 97.663
  },
  {
   "sentence_id": "C36-B004-S02",
   "section": "B",
   "text": "話したくないときは、話さなくてもいいです。",
   "start_sec": 97.863,
   "end_sec": 101.234
  },
  {
   "sentence_id": "C36-B004-S03",
   "section": "B",
   "text": "遅れたり休んだりするときは小野さんに連絡してください。",
   "start_sec": 101.434,
   "end_sec": 105.748
  },
  {
   "sentence_id": "C36-B004-S04",
   "section": "B",
   "text": "十五日午後六時が確認の返事の締切でした。",
   "start_sec": 105.948,
   "end_sec": 110.261
  },
  {
   "sentence_id": "C36-B004-S05",
   "section": "B",
   "text": "五人全員から返事がありました。",
   "start_sec": 110.461,
   "end_sec": 113.034
  }
 ]
}
