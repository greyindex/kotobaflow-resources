{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 64.154,
 "source_chapter": 34,
 "sentence_intervals": [
  {
   "sentence_id": "C34-A001-S01",
   "section": "A",
   "text": "土曜日、サミと森さんは南町センターの読書会を手伝いました。",
   "start_sec": 0.0,
   "end_sec": 5.453
  },
  {
   "sentence_id": "C34-A001-S02",
   "section": "A",
   "text": "九時に準備を始めて、名前とページを確認してから資料を印刷しました。",
   "start_sec": 5.653,
   "end_sec": 11.515
  },
  {
   "sentence_id": "C34-A001-S03",
   "section": "A",
   "text": "同じ部屋では来月のイベントの相談も進んでいました。",
   "start_sec": 11.715,
   "end_sec": 15.908
  },
  {
   "sentence_id": "C34-A001-S04",
   "section": "A",
   "text": "読書会と音楽会を組み合わせる計画です。",
   "start_sec": 16.108,
   "end_sec": 19.92
  },
  {
   "sentence_id": "C34-A002-S01",
   "section": "A",
   "text": "サミは音楽を聞きながら机を片づけました。",
   "start_sec": 20.37,
   "end_sec": 24.487
  },
  {
   "sentence_id": "C34-A002-S02",
   "section": "A",
   "text": "しかし、曲目の相談と資料の確認を同時に始めたら、気が散ります。",
   "start_sec": 24.687,
   "end_sec": 30.953
  },
  {
   "sentence_id": "C34-A002-S03",
   "section": "A",
   "text": "効率も悪いし、確認もおろそかになるし、先に今日の作業を終えることにしました。",
   "start_sec": 31.153,
   "end_sec": 37.94
  },
  {
   "sentence_id": "C34-A002-S04",
   "section": "A",
   "text": "森さんと話す前に音楽を止めて、資料に集中しました。",
   "start_sec": 38.14,
   "end_sec": 43.293
  },
  {
   "sentence_id": "C34-A003-S01",
   "section": "A",
   "text": "途中で森さんが早く来た人を迎えに行ったので、印刷を中断しました。",
   "start_sec": 43.743,
   "end_sec": 49.617
  },
  {
   "sentence_id": "C34-A003-S02",
   "section": "A",
   "text": "それでも九時四十八分には十部そろって、期限に間に合いました。",
   "start_sec": 49.817,
   "end_sec": 55.51
  },
  {
   "sentence_id": "C34-A003-S03",
   "section": "A",
   "text": "二人は入口で参加する人を待ちました。",
   "start_sec": 55.71,
   "end_sec": 59.25
  },
  {
   "sentence_id": "C34-A003-S04",
   "section": "A",
   "text": "サミは店で働くときも、この順序を使おうと思いました。",
   "start_sec": 59.45,
   "end_sec": 64.147
  }
 ]
}
