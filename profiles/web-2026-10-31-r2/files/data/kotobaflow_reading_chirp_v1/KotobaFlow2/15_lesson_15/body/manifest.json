 "source_chapter": 33,
 "sentence_intervals": [
  {
   "sentence_id": "C33-A001-S01",
   "section": "A",
   "text": "ソラは二月に朝の散歩を始めました。",
   "start_sec": 0.0,
   "end_sec": 3.922
  },
  {
   "sentence_id": "C33-A001-S02",
   "section": "A",
   "text": "最初は毎朝六時に起きて三十分歩くつもりでした。",
   "start_sec": 4.122,
   "end_sec": 9.695
  },
  {
   "sentence_id": "C33-A001-S03",
   "section": "A",
   "text": "早起きに慣れていなかったので、散歩は三日しか続きませんでした。",
   "start_sec": 9.895,
   "end_sec": 14.84
  },
  {
   "sentence_id": "C33-A001-S04",
   "section": "A",
   "text": "次の週は仕事が忙しくて中断しました。",
   "start_sec": 15.04,
   "end_sec": 19.208
  },
  {
   "sentence_id": "C33-A002-S01",
   "section": "A",
   "text": "十五日から別の方法を試してみました。",
   "start_sec": 19.658,
   "end_sec": 23.071
  },
  {
   "sentence_id": "C33-A002-S02",
   "section": "A",
   "text": "毎週三回、昼休みに十分歩くことにしました。",
   "start_sec": 23.271,
   "end_sec": 27.524
  },
  {
   "sentence_id": "C33-A002-S03",
   "section": "A",
   "text": "手帳に時間と感想を書くようにしています。",
   "start_sec": 27.724,
   "end_sec": 30.898
  },
  {
   "sentence_id": "C33-A002-S04",
   "section": "A",
   "text": "二週間、毎週三回の目標を達成しました。",
   "start_sec": 31.098,
   "end_sec": 35.473
  },
  {
   "sentence_id": "C33-A003-S01",
   "section": "A",
   "text": "外に出る回数が増えました。",
   "start_sec": 35.923,
   "end_sec": 38.386
  },
  {
   "sentence_id": "C33-A003-S02",
   "section": "A",
   "text": "朝の負担は減りました。",
   "start_sec": 38.586,
   "end_sec": 40.508
  },
  {
   "sentence_id": "C33-A003-S03",
   "section": "A",
   "text": "昼休みの散歩はだんだん習慣になっています。",
   "start_sec": 40.708,
   "end_sec": 44.421
  },
  {
   "sentence_id": "C33-A003-S04",
   "section": "A",
   "text": "でも、体力が変わったかどうか、まだ確認が必要です。",
   "start_sec": 44.621,
   "end_sec": 49.394
  },
  {
   "sentence_id": "C33-A003-S05",
   "section": "A",
   "text": "三月もこの計画を続けるつもりです。",
   "start_sec": 49.594,
   "end_sec": 52.528
  }
 ]
}
