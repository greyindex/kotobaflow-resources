 "sentence_intervals": [
  {
   "sentence_id": "C33-B001-S01",
   "section": "B",
   "text": "二月一日～七日：早起きに挑戦した。",
   "start_sec": 0.0,
   "end_sec": 4.013
  },
  {
   "sentence_id": "C33-B001-S02",
   "section": "B",
   "text": "朝三十分歩いた日は三日。",
   "start_sec": 4.213,
   "end_sec": 6.989
  },
  {
   "sentence_id": "C33-B001-S03",
   "section": "B",
   "text": "毎日の目標は達成できなかった。",
   "start_sec": 7.189,
   "end_sec": 10.062
  },
  {
   "sentence_id": "C33-B001-S04",
   "section": "B",
   "text": "八日～十四日：仕事が忙しくて散歩を中断した。",
   "start_sec": 10.262,
   "end_sec": 15.1
  },
  {
   "sentence_id": "C33-B001-S05",
   "section": "B",
   "text": "睡眠の時間も短くなった。",
   "start_sec": 15.3,
   "end_sec": 17.855
  },
  {
   "sentence_id": "C33-B002-S01",
   "section": "B",
   "text": "十五日～二十八日：散歩を再開した。",
   "start_sec": 18.305,
   "end_sec": 22.429
  },
  {
   "sentence_id": "C33-B002-S02",
   "section": "B",
   "text": "毎週三回、一回十分。",
   "start_sec": 22.629,
   "end_sec": 25.502
  },
  {
   "sentence_id": "C33-B002-S03",
   "section": "B",
   "text": "十五日は五分歩いて休憩してまた五分歩いた。",
   "start_sec": 25.702,
   "end_sec": 30.173
  },
  {
   "sentence_id": "C33-B002-S04",
   "section": "B",
   "text": "二十八日は十分歩き続けられた。",
   "start_sec": 30.373,
   "end_sec": 33.886
  },
  {
   "sentence_id": "C33-B002-S05",
   "section": "B",
   "text": "今日の成果を記録する。",
   "start_sec": 34.087,
   "end_sec": 35.94
  },
  {
   "sentence_id": "C33-B003-S01",
   "section": "B",
   "text": "振り返り：時間帯の変更が工夫の一つだった。",
   "start_sec": 36.39,
   "end_sec": 40.879
  },
  {
   "sentence_id": "C33-B003-S02",
   "section": "B",
   "text": "朝の負担が減った。",
   "start_sec": 41.079,
   "end_sec": 42.835
  },
  {
   "sentence_id": "C33-B003-S03",
   "section": "B",
   "text": "三月の改善：金曜日に記録を読んで、次の週の予定を確認する。",
   "start_sec": 43.035,
   "end_sec": 49.367
  },
  {
   "sentence_id": "C33-B003-S04",
   "section": "B",
   "text": "忙しい週は目標を直す。",
   "start_sec": 49.567,
   "end_sec": 52.441
  },
  {
   "sentence_id": "C33-B003-S05",
   "section": "B",
   "text": "金曜日の確認を続けたい。",
   "start_sec": 52.641,
   "end_sec": 54.794
  }
 ]
}
