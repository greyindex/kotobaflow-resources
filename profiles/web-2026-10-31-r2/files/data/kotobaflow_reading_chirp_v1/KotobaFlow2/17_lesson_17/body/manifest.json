{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 73.685,
 "source_chapter": 35,
 "sentence_intervals": [
  {
   "sentence_id": "C35-A001-S01",
   "section": "A",
   "text": "東町の日本語の仲間は、来月の練習会の計画を考えています。",
   "start_sec": 0.0,
   "end_sec": 6.05
  },
  {
   "sentence_id": "C35-A001-S02",
   "section": "A",
   "text": "話す時間の目標は三分です。",
   "start_sec": 6.25,
   "end_sec": 9.302
  },
  {
   "sentence_id": "C35-A001-S03",
   "section": "A",
   "text": "写真や時計を見せながら話すつもりです。",
   "start_sec": 9.502,
   "end_sec": 12.582
  },
  {
   "sentence_id": "C35-A001-S04",
   "section": "A",
   "text": "田中さんとラナさんは、二つの案を比べる前に、先月の記録を読みました。",
   "start_sec": 12.782,
   "end_sec": 19.069
  },
  {
   "sentence_id": "C35-A001-S05",
   "section": "A",
   "text": "先月は写真を見ながら話す練習を三回しました。",
   "start_sec": 19.269,
   "end_sec": 24.543
  },
  {
   "sentence_id": "C35-A002-S01",
   "section": "A",
   "text": "始めは、一分しか話せない人もいました。",
   "start_sec": 24.993,
   "end_sec": 28.53
  },
  {
   "sentence_id": "C35-A002-S02",
   "section": "A",
   "text": "三回とも短いメモを書いてから話してみました。",
   "start_sec": 28.73,
   "end_sec": 32.503
  },
  {
   "sentence_id": "C35-A002-S03",
   "section": "A",
   "text": "三回目には、六人とも二分間話せるようになりました。",
   "start_sec": 32.703,
   "end_sec": 37.712
  },
  {
   "sentence_id": "C35-A002-S04",
   "section": "A",
   "text": "しかし、四十分続けて練習した日は、三人が「疲れました」と言いました。",
   "start_sec": 37.912,
   "end_sec": 44.085
  },
  {
   "sentence_id": "C35-A002-S05",
   "section": "A",
   "text": "長く続けすぎないほうがいいと思います。",
   "start_sec": 44.285,
   "end_sec": 47.207
  },
  {
   "sentence_id": "C35-A003-S01",
   "section": "A",
   "text": "次は、公園で写真を撮る案と、教室で時計や写真を見せて話す案があります。",
   "start_sec": 47.657,
   "end_sec": 53.954
  },
  {
   "sentence_id": "C35-A003-S02",
   "section": "A",
   "text": "どちらも予算と時間の条件は大丈夫です。",
   "start_sec": 54.154,
   "end_sec": 58.403
  },
  {
   "sentence_id": "C35-A003-S03",
   "section": "A",
   "text": "ラナさんは公園で試すつもりでしたが、天気が心配です。",
   "start_sec": 58.603,
   "end_sec": 63.265
  },
  {
   "sentence_id": "C35-A003-S04",
   "section": "A",
   "text": "田中さんは、教室で途中に休憩をして、練習を続けようと思っています。",
   "start_sec": 63.465,
   "end_sec": 69.896
  },
  {
   "sentence_id": "C35-A003-S05",
   "section": "A",
   "text": "二人は今日、記録を使って相談します。",
   "start_sec": 70.096,
   "end_sec": 73.679
  }
 ]
}
