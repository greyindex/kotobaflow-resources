{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 101.684,
 "source_chapter": 35,
 "sentence_intervals": [
  {
   "sentence_id": "C35-B001-S01",
   "section": "B",
   "text": "参加する人は六人です。",
   "start_sec": 0.0,
   "end_sec": 1.973
  },
  {
   "sentence_id": "C35-B001-S02",
   "section": "B",
   "text": "六月六日、十時から十二時まで練習します。",
   "start_sec": 2.173,
   "end_sec": 6.351
  },
  {
   "sentence_id": "C35-B001-S03",
   "section": "B",
   "text": "集合は十時、東町市民センターの教室の予定です。",
   "start_sec": 6.551,
   "end_sec": 11.382
  },
  {
   "sentence_id": "C35-B001-S04",
   "section": "B",
   "text": "一人の予算は三百円で、交通費もこの予算から払います。",
   "start_sec": 11.582,
   "end_sec": 16.822
  },
  {
   "sentence_id": "C35-B001-S05",
   "section": "B",
   "text": "話す時間の目標は一人三分です。",
   "start_sec": 17.022,
   "end_sec": 20.495
  },
  {
   "sentence_id": "C35-B001-S06",
   "section": "B",
   "text": "教室の料金は六人で六百円です。",
   "start_sec": 20.695,
   "end_sec": 24.502
  },
  {
   "sentence_id": "C35-B001-S07",
   "section": "B",
   "text": "予約の締切は五月二十三日十七時で、今日はまだ予約していません。",
   "start_sec": 24.701,
   "end_sec": 31.173
  },
  {
   "sentence_id": "C35-B002-S01",
   "section": "B",
   "text": "案Ａでは教室から公園まで歩きます。",
   "start_sec": 31.623,
   "end_sec": 35.189
  },
  {
   "sentence_id": "C35-B002-S02",
   "section": "B",
   "text": "片道の所要時間は十分です。",
   "start_sec": 35.389,
   "end_sec": 37.902
  },
  {
   "sentence_id": "C35-B002-S03",
   "section": "B",
   "text": "公園で三十分写真を撮ります。",
   "start_sec": 38.102,
   "end_sec": 41.095
  },
  {
   "sentence_id": "C35-B002-S04",
   "section": "B",
   "text": "教室に戻ってから十分休憩します。",
   "start_sec": 41.295,
   "end_sec": 44.649
  },
  {
   "sentence_id": "C35-B002-S05",
   "section": "B",
   "text": "その後、写真を見せながら話します。",
   "start_sec": 44.849,
   "end_sec": 47.782
  },
  {
   "sentence_id": "C35-B002-S06",
   "section": "B",
   "text": "公園は無料なので、一人の料金は合計百円です。",
   "start_sec": 47.982,
   "end_sec": 52.626
  },
  {
   "sentence_id": "C35-B002-S07",
   "section": "B",
   "text": "雨の日は公園に行きません。",
   "start_sec": 52.826,
   "end_sec": 54.859
  },
  {
   "sentence_id": "C35-B003-S01",
   "section": "B",
   "text": "案Ｂでは教室で時計や写真を見せて話します。",
   "start_sec": 55.309,
   "end_sec": 60.136
  },
  {
   "sentence_id": "C35-B003-S02",
   "section": "B",
   "text": "準備とメモに三十分、休憩に十分使います。",
   "start_sec": 60.336,
   "end_sec": 64.867
  },
  {
   "sentence_id": "C35-B003-S03",
   "section": "B",
   "text": "その後、二人で練習して、最後にみんなの前で話します。",
   "start_sec": 65.067,
   "end_sec": 70.494
  },
  {
   "sentence_id": "C35-B003-S04",
   "section": "B",
   "text": "一人の料金は百円です。",
   "start_sec": 70.694,
   "end_sec": 73.441
  },
  {
   "sentence_id": "C35-B003-S05",
   "section": "B",
   "text": "教室では水やお茶を飲めますが、パンなどを食べてはいけません。",
   "start_sec": 73.641,
   "end_sec": 78.637
  },
  {
   "sentence_id": "C35-B003-S06",
   "section": "B",
   "text": "音量にも注意してください。",
   "start_sec": 78.837,
   "end_sec": 80.811
  },
  {
   "sentence_id": "C35-B004-S01",
   "section": "B",
   "text": "予約の担当は田中さんです。",
   "start_sec": 81.261,
   "end_sec": 83.654
  },
  {
   "sentence_id": "C35-B004-S02",
   "section": "B",
   "text": "ラナさんは五月二十四日までに参加する人へ計画を送ります。",
   "start_sec": 83.854,
   "end_sec": 89.517
  },
  {
   "sentence_id": "C35-B004-S03",
   "section": "B",
   "text": "六月六日は、話した時間と体調を記録します。",
   "start_sec": 89.717,
   "end_sec": 94.418
  },
  {
   "sentence_id": "C35-B004-S04",
   "section": "B",
   "text": "次の練習会の日はまだ決めていません。",
   "start_sec": 94.618,
   "end_sec": 98.151
  },
  {
   "sentence_id": "C35-B004-S05",
   "section": "B",
   "text": "予約を確認してからメールを送ります。",
   "start_sec": 98.351,
   "end_sec": 101.678
  }
 ]
}
