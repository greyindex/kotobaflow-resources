{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 74.285,
 "source_chapter": 26,
 "sentence_intervals": [
  {
   "sentence_id": "C26-B001-S01",
   "section": "B",
   "text": "11月21日（土）、植物園に出かけます。",
   "start_sec": 0.0,
   "end_sec": 5.211
  },
  {
   "sentence_id": "C26-B001-S02",
   "section": "B",
   "text": "集合は10時、植物園前駅の東口です。",
   "start_sec": 5.411,
   "end_sec": 9.725
  },
  {
   "sentence_id": "C26-B001-S03",
   "section": "B",
   "text": "早めに来てください。",
   "start_sec": 9.925,
   "end_sec": 11.538
  },
  {
   "sentence_id": "C26-B001-S04",
   "section": "B",
   "text": "昼ご飯と水、念のため傘も持っていってください。",
   "start_sec": 11.738,
   "end_sec": 15.872
  },
  {
   "sentence_id": "C26-B002-S01",
   "section": "B",
   "text": "晴れだったら、午前は屋外で花を見ます。",
   "start_sec": 16.322,
   "end_sec": 19.855
  },
  {
   "sentence_id": "C26-B002-S02",
   "section": "B",
   "text": "小雨でも行きます。",
   "start_sec": 20.055,
   "end_sec": 21.428
  },
  {
   "sentence_id": "C26-B002-S03",
   "section": "B",
   "text": "雨のときは温室に入ります。",
   "start_sec": 21.628,
   "end_sec": 24.007
  },
  {
   "sentence_id": "C26-B002-S04",
   "section": "B",
   "text": "昼ご飯は温室の隣の部屋で食べます。",
   "start_sec": 24.207,
   "end_sec": 27.926
  },
  {
   "sentence_id": "C26-B002-S05",
   "section": "B",
   "text": "午後、雨が止んだら屋外に出ます。",
   "start_sec": 28.126,
   "end_sec": 31.644
  },
  {
   "sentence_id": "C26-B002-S06",
   "section": "B",
   "text": "止まなかったら温室で写真を撮ります。",
   "start_sec": 31.844,
   "end_sec": 35.228
  },
  {
   "sentence_id": "C26-B002-S07",
   "section": "B",
   "text": "15時に帰ります。",
   "start_sec": 35.428,
   "end_sec": 37.226
  },
  {
   "sentence_id": "C26-B003-S01",
   "section": "B",
   "text": "朝7時の予報が大雨や雪や強風だったら、中止します。",
   "start_sec": 37.676,
   "end_sec": 43.41
  },
  {
   "sentence_id": "C26-B003-S02",
   "section": "B",
   "text": "西川が全員にメッセージを送ります。",
   "start_sec": 43.61,
   "end_sec": 46.706
  },
  {
   "sentence_id": "C26-B003-S03",
   "section": "B",
   "text": "予備の日は28日です。",
   "start_sec": 46.906,
   "end_sec": 49.264
  },
  {
   "sentence_id": "C26-B003-S04",
   "section": "B",
   "text": "電車が運休だったら、家にいてください。",
   "start_sec": 49.464,
   "end_sec": 52.337
  },
  {
   "sentence_id": "C26-B003-S05",
   "section": "B",
   "text": "雷の音が聞こえたら屋内に入ってください。",
   "start_sec": 52.537,
   "end_sec": 56.43
  },
  {
   "sentence_id": "C26-B003-S06",
   "section": "B",
   "text": "風にも注意してください。",
   "start_sec": 56.63,
   "end_sec": 58.367
  },
  {
   "sentence_id": "C26-B004-S01",
   "section": "B",
   "text": "電車に遅延があっても、10時30分まで東口で待ちます。",
   "start_sec": 58.817,
   "end_sec": 64.573
  },
  {
   "sentence_id": "C26-B004-S02",
   "section": "B",
   "text": "遅れたら連絡してください。",
   "start_sec": 64.773,
   "end_sec": 66.566
  },
  {
   "sentence_id": "C26-B004-S03",
   "section": "B",
   "text": "駅で迷ったら地図を見てください。",
   "start_sec": 66.766,
   "end_sec": 69.612
  },
  {
   "sentence_id": "C26-B004-S04",
   "section": "B",
   "text": "それでも出口を探せなかったら、西川に電話してください。",
   "start_sec": 69.812,
   "end_sec": 74.278
  }
 ]
}
