{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 57.459,
 "source_chapter": 30,
 "sentence_intervals": [
  {
   "sentence_id": "C30-A001-S01",
   "section": "A",
   "text": "七月十九日、私は林さん、アキさんと中央公園へ行きました。",
   "start_sec": 0.0,
   "end_sec": 5.555
  },
  {
   "sentence_id": "C30-A001-S02",
   "section": "A",
   "text": "九時四十分、入口で佐藤さんに会いました。",
   "start_sec": 5.755,
   "end_sec": 9.564
  },
  {
   "sentence_id": "C30-A001-S03",
   "section": "A",
   "text": "空は曇っていました。",
   "start_sec": 9.764,
   "end_sec": 11.798
  },
  {
   "sentence_id": "C30-A001-S04",
   "section": "A",
   "text": "雨が降りそうでした。",
   "start_sec": 11.998,
   "end_sec": 13.762
  },
  {
   "sentence_id": "C30-A001-S05",
   "section": "A",
   "text": "風は弱くて、木の枝が少し揺れていました。",
   "start_sec": 13.962,
   "end_sec": 17.868
  },
  {
   "sentence_id": "C30-A001-S06",
   "section": "A",
   "text": "朝から蒸し暑かったです。",
   "start_sec": 18.068,
   "end_sec": 20.022
  },
  {
   "sentence_id": "C30-A002-S01",
   "section": "A",
   "text": "佐藤さんは天気予報を見て、「午後は夕立があるかもしれません」と言いました。",
   "start_sec": 20.472,
   "end_sec": 26.069
  },
  {
   "sentence_id": "C30-A002-S02",
   "section": "A",
   "text": "十時から十一時まで、公園の教室で写真を見ます。",
   "start_sec": 26.269,
   "end_sec": 30.702
  },
  {
   "sentence_id": "C30-A002-S03",
   "section": "A",
   "text": "散歩は十一時に天気を見た後で決めます。",
   "start_sec": 30.902,
   "end_sec": 34.852
  },
  {
   "sentence_id": "C30-A003-S01",
   "section": "A",
   "text": "アキさんは「この雲を撮りたいです」と何度も言って、写真を撮りたがっていました。",
   "start_sec": 35.302,
   "end_sec": 41.432
  },
  {
   "sentence_id": "C30-A003-S02",
   "section": "A",
   "text": "雨で道も土もぬれました。",
   "start_sec": 41.632,
   "end_sec": 44.468
  },
  {
   "sentence_id": "C30-A003-S03",
   "section": "A",
   "text": "滑りそうだったので、ゆっくり歩きました。",
   "start_sec": 44.668,
   "end_sec": 47.962
  },
  {
   "sentence_id": "C30-A003-S04",
   "section": "A",
   "text": "十時に教室に入りました。",
   "start_sec": 48.162,
   "end_sec": 50.555
  },
  {
   "sentence_id": "C30-A003-S05",
   "section": "A",
   "text": "春から冬までの写真には季節感がありました。",
   "start_sec": 50.755,
   "end_sec": 54.68
  },
  {
   "sentence_id": "C30-A003-S06",
   "section": "A",
   "text": "間近で撮った鷺の写真もありました。",
   "start_sec": 54.88,
   "end_sec": 57.453
  }
 ]
}
