 "sentence_intervals": [
  {
   "sentence_id": "C20-B001-S01",
   "section": "B",
   "text": "昨日の会議の後で、教室の席の下に次の落とし物がありました。",
   "start_sec": 0.0,
   "end_sec": 5.607
  },
  {
   "sentence_id": "C20-B001-S02",
   "section": "B",
   "text": "今は受付にあります。",
   "start_sec": 5.807,
   "end_sec": 7.858
  },
  {
   "sentence_id": "C20-B001-S03",
   "section": "B",
   "text": "①紺色のかばん：しまの模様があります。",
   "start_sec": 8.058,
   "end_sec": 11.541
  },
  {
   "sentence_id": "C20-B001-S04",
   "section": "B",
   "text": "形は四角いです。",
   "start_sec": 11.741,
   "end_sec": 13.437
  },
  {
   "sentence_id": "C20-B001-S05",
   "section": "B",
   "text": "②紺色のかばん：水玉の模様があります。",
   "start_sec": 13.637,
   "end_sec": 17.222
  },
  {
   "sentence_id": "C20-B001-S06",
   "section": "B",
   "text": "形は四角いです。",
   "start_sec": 17.422,
   "end_sec": 19.216
  },
  {
   "sentence_id": "C20-B001-S07",
   "section": "B",
   "text": "③透明な袋：中にノートが一つあります。",
   "start_sec": 19.416,
   "end_sec": 23.697
  },
  {
   "sentence_id": "C20-B001-S08",
   "section": "B",
   "text": "④長いペン：太いです。",
   "start_sec": 23.897,
   "end_sec": 26.13
  },
  {
   "sentence_id": "C20-B001-S09",
   "section": "B",
   "text": "⑤短いペン：細いです。",
   "start_sec": 26.33,
   "end_sec": 28.648
  },
  {
   "sentence_id": "C20-B002-S01",
   "section": "B",
   "text": "落とし物を探している人は、受付に来てください。",
   "start_sec": 29.098,
   "end_sec": 32.915
  },
  {
   "sentence_id": "C20-B002-S02",
   "section": "B",
   "text": "受付は午前九時から午後六時までです。",
   "start_sec": 33.115,
   "end_sec": 36.871
  },
  {
   "sentence_id": "C20-B002-S03",
   "section": "B",
   "text": "持ち主の名前と昨日の席の番号を言ってください。",
   "start_sec": 37.071,
   "end_sec": 41.59
  },
  {
   "sentence_id": "C20-B002-S04",
   "section": "B",
   "text": "それから、目印を伝えてください。",
   "start_sec": 41.79,
   "end_sec": 44.543
  },
  {
   "sentence_id": "C20-B002-S05",
   "section": "B",
   "text": "目印はこのメッセージには書きません。",
   "start_sec": 44.743,
   "end_sec": 48.11
  },
  {
   "sentence_id": "C20-B002-S06",
   "section": "B",
   "text": "友達の物かどうかは、その友達と確認します。",
   "start_sec": 48.31,
   "end_sec": 52.479
  },
  {
   "sentence_id": "C20-B002-S07",
   "section": "B",
   "text": "学校に来ない人は、受付に電話してください。",
   "start_sec": 52.679,
   "end_sec": 56.745
  },
  {
   "sentence_id": "C20-B002-S08",
   "section": "B",
   "text": "電話番号は〇三、一二三四、五六七八です。",
   "start_sec": 56.945,
   "end_sec": 62.123
  }
 ]
}
