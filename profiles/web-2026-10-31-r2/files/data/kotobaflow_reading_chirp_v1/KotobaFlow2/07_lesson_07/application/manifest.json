{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 82.177,
 "source_chapter": 25,
 "sentence_intervals": [
  {
   "sentence_id": "C25-B001-S01",
   "section": "B",
   "text": "十一月七日、十時から十五時まで東町公民館でバザーを開きます。",
   "start_sec": 0.0,
   "end_sec": 7.044
  },
  {
   "sentence_id": "C25-B001-S02",
   "section": "B",
   "text": "本や服を売って、図書館の本を買います。",
   "start_sec": 7.244,
   "end_sec": 10.537
  },
  {
   "sentence_id": "C25-B001-S03",
   "section": "B",
   "text": "二日から五日の十時から十七時まで、係が品物を受け取ります。",
   "start_sec": 10.737,
   "end_sec": 16.332
  },
  {
   "sentence_id": "C25-B001-S04",
   "section": "B",
   "text": "きれいなおもちゃや人形も歓迎します。",
   "start_sec": 16.532,
   "end_sec": 19.633
  },
  {
   "sentence_id": "C25-B002-S01",
   "section": "B",
   "text": "長い机を五台使います。",
   "start_sec": 20.083,
   "end_sec": 22.819
  },
  {
   "sentence_id": "C25-B002-S02",
   "section": "B",
   "text": "机を貸していただけませんか。",
   "start_sec": 23.019,
   "end_sec": 25.217
  },
  {
   "sentence_id": "C25-B002-S03",
   "section": "B",
   "text": "六日に運んで、八日に家に届けます。",
   "start_sec": 25.417,
   "end_sec": 29.033
  },
  {
   "sentence_id": "C25-B002-S04",
   "section": "B",
   "text": "六日の十八時から二十時まで準備をします。",
   "start_sec": 29.233,
   "end_sec": 32.977
  },
  {
   "sentence_id": "C25-B002-S05",
   "section": "B",
   "text": "役割は荷物の運搬です。",
   "start_sec": 33.177,
   "end_sec": 35.737
  },
  {
   "sentence_id": "C25-B002-S06",
   "section": "B",
   "text": "七日の当番は受付と会計で、午前は十時から十二時半、午後は十二時半から十五時です。",
   "start_sec": 35.937,
   "end_sec": 45.279
  },
  {
   "sentence_id": "C25-B003-S01",
   "section": "B",
   "text": "当番の順番は受付の紙で確認してください。",
   "start_sec": 45.729,
   "end_sec": 49.816
  },
  {
   "sentence_id": "C25-B003-S02",
   "section": "B",
   "text": "ひとりひとりに無理のない役割をお願いします。",
   "start_sec": 50.016,
   "end_sec": 53.79
  },
  {
   "sentence_id": "C25-B003-S03",
   "section": "B",
   "text": "負担が大きい仕事は断っても大丈夫です。",
   "start_sec": 53.99,
   "end_sec": 57.583
  },
  {
   "sentence_id": "C25-B003-S04",
   "section": "B",
   "text": "できるだけ早く係に相談してください。",
   "start_sec": 57.783,
   "end_sec": 61.126
  },
  {
   "sentence_id": "C25-B003-S05",
   "section": "B",
   "text": "お互いの都合を話して、互いに助け合いましょう。",
   "start_sec": 61.326,
   "end_sec": 65.365
  },
  {
   "sentence_id": "C25-B004-S01",
   "section": "B",
   "text": "お客さんとのコミュニケーションが大切です。",
   "start_sec": 65.815,
   "end_sec": 69.083
  },
  {
   "sentence_id": "C25-B004-S02",
   "section": "B",
   "text": "スタッフ同士で情報を交換して、質問には丁寧に答えてください。",
   "start_sec": 69.283,
   "end_sec": 74.57
  },
  {
   "sentence_id": "C25-B004-S03",
   "section": "B",
   "text": "入口で案内を配ります。",
   "start_sec": 74.77,
   "end_sec": 77.044
  },
  {
   "sentence_id": "C25-B004-S04",
   "section": "B",
   "text": "会場での飲酒はご遠慮ください。",
   "start_sec": 77.244,
   "end_sec": 79.637
  },
  {
   "sentence_id": "C25-B004-S05",
   "section": "B",
   "text": "活動の後の飲み会はありません。",
   "start_sec": 79.837,
   "end_sec": 82.17
  }
 ]
}
