 "source_chapter": 25,
 "sentence_intervals": [
  {
   "sentence_id": "C25-A001-S01",
   "section": "A",
   "text": "四月、東町に来ました。",
   "start_sec": 0.0,
   "end_sec": 2.573
  },
  {
   "sentence_id": "C25-A001-S02",
   "section": "A",
   "text": "青木さんが台車を貸してくれました。",
   "start_sec": 2.773,
   "end_sec": 5.527
  },
  {
   "sentence_id": "C25-A001-S03",
   "section": "A",
   "text": "町の地図もくれました。",
   "start_sec": 5.727,
   "end_sec": 7.356
  },
  {
   "sentence_id": "C25-A001-S04",
   "section": "A",
   "text": "わたしは台車を借りて、荷物を運びました。",
   "start_sec": 7.556,
   "end_sec": 11.449
  },
  {
   "sentence_id": "C25-A001-S05",
   "section": "A",
   "text": "やさしい知人ができて、助かりました。",
   "start_sec": 11.649,
   "end_sec": 14.774
  },
  {
   "sentence_id": "C25-A001-S06",
   "section": "A",
   "text": "今は仲よくなって、お互いに助け合っています。",
   "start_sec": 14.974,
   "end_sec": 18.687
  },
  {
   "sentence_id": "C25-A002-S01",
   "section": "A",
   "text": "八月、青木さんに駅の地図を見せてあげました。",
   "start_sec": 19.137,
   "end_sec": 23.443
  },
  {
   "sentence_id": "C25-A002-S02",
   "section": "A",
   "text": "旅行の後で、お土産のお茶をもらいました。",
   "start_sec": 23.643,
   "end_sec": 27.009
  },
  {
   "sentence_id": "C25-A002-S03",
   "section": "A",
   "text": "わたしはお返しに絵葉書を送りました。",
   "start_sec": 27.209,
   "end_sec": 30.367
  },
  {
   "sentence_id": "C25-A002-S04",
   "section": "A",
   "text": "青木さんの好意はありがたいです。",
   "start_sec": 30.567,
   "end_sec": 32.9
  },
  {
   "sentence_id": "C25-A003-S01",
   "section": "A",
   "text": "十月、青木さんがバザーの予定を教えてくれました。",
   "start_sec": 33.35,
   "end_sec": 37.544
  },
  {
   "sentence_id": "C25-A003-S02",
   "section": "A",
   "text": "世話役は小野さんです。",
   "start_sec": 37.744,
   "end_sec": 39.357
  },
  {
   "sentence_id": "C25-A003-S03",
   "section": "A",
   "text": "わたしもスタッフの一員です。",
   "start_sec": 39.557,
   "end_sec": 41.799
  },
  {
   "sentence_id": "C25-A003-S04",
   "section": "A",
   "text": "進んで手伝いたいです。",
   "start_sec": 41.999,
   "end_sec": 43.901
  },
  {
   "sentence_id": "C25-A003-S05",
   "section": "A",
   "text": "親切な人たちと付き合って、自分自身も変わりました。",
   "start_sec": 44.101,
   "end_sec": 48.414
  },
  {
   "sentence_id": "C25-A003-S06",
   "section": "A",
   "text": "今度は皆にお礼をしたいです。",
   "start_sec": 48.614,
   "end_sec": 51.487
  }
 ]
}
