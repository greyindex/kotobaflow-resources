{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 61.286,
 "source_chapter": 23,
 "sentence_intervals": [
  {
   "sentence_id": "C23-A001-S01",
   "section": "A",
   "text": "わたしの趣味は写真を撮ることだ。",
   "start_sec": 0.0,
   "end_sec": 3.161
  },
  {
   "sentence_id": "C23-A001-S02",
   "section": "A",
   "text": "旅行で山に登ったことがある。",
   "start_sec": 3.361,
   "end_sec": 6.35
  },
  {
   "sentence_id": "C23-A001-S03",
   "section": "A",
   "text": "でも、海で釣りをした経験はなかった。",
   "start_sec": 6.55,
   "end_sec": 9.863
  },
  {
   "sentence_id": "C23-A001-S04",
   "section": "A",
   "text": "9月20日、同僚の田村さんと港公民館の釣りの会に参加した。",
   "start_sec": 10.063,
   "end_sec": 16.113
  },
  {
   "sentence_id": "C23-A001-S05",
   "section": "A",
   "text": "田村さんは何度も釣りをしたことがある。",
   "start_sec": 16.313,
   "end_sec": 19.366
  },
  {
   "sentence_id": "C23-A001-S06",
   "section": "A",
   "text": "「釣りは楽しいですよ」と言っていた。",
   "start_sec": 19.566,
   "end_sec": 22.544
  },
  {
   "sentence_id": "C23-A002-S01",
   "section": "A",
   "text": "その日は雨ではなかった。",
   "start_sec": 22.994,
   "end_sec": 24.907
  },
  {
   "sentence_id": "C23-A002-S02",
   "section": "A",
   "text": "初めての釣りは難しかった。",
   "start_sec": 25.107,
   "end_sec": 27.681
  },
  {
   "sentence_id": "C23-A002-S03",
   "section": "A",
   "text": "でも、楽しかった。",
   "start_sec": 27.881,
   "end_sec": 29.954
  },
  {
   "sentence_id": "C23-A002-S04",
   "section": "A",
   "text": "釣りの後で、散歩をしたり、写真を撮ったりした。",
   "start_sec": 30.154,
   "end_sec": 34.047
  },
  {
   "sentence_id": "C23-A002-S05",
   "section": "A",
   "text": "いい思い出だ。",
   "start_sec": 34.247,
   "end_sec": 35.44
  },
  {
   "sentence_id": "C23-A002-S06",
   "section": "A",
   "text": "田村さんと26日の写真散歩に行く約束もした。",
   "start_sec": 35.64,
   "end_sec": 40.253
  },
  {
   "sentence_id": "C23-A003-S01",
   "section": "A",
   "text": "家に帰った後で、紺色の帽子を探した。",
   "start_sec": 40.703,
   "end_sec": 44.657
  },
  {
   "sentence_id": "C23-A003-S02",
   "section": "A",
   "text": "でも、なかった。",
   "start_sec": 44.857,
   "end_sec": 46.631
  },
  {
   "sentence_id": "C23-A003-S03",
   "section": "A",
   "text": "公民館に忘れたと思う。",
   "start_sec": 46.831,
   "end_sec": 48.744
  },
  {
   "sentence_id": "C23-A003-S04",
   "section": "A",
   "text": "帽子の中には名前がある。",
   "start_sec": 48.944,
   "end_sec": 51.542
  },
  {
   "sentence_id": "C23-A003-S05",
   "section": "A",
   "text": "受付に電話をして、確認する。",
   "start_sec": 51.742,
   "end_sec": 54.593
  },
  {
   "sentence_id": "C23-A003-S06",
   "section": "A",
   "text": "帽子がどこにあるか、まだ分からない。",
   "start_sec": 54.793,
   "end_sec": 57.906
  },
  {
   "sentence_id": "C23-A003-S07",
   "section": "A",
   "text": "10月も釣りに行きたいと思っている。",
   "start_sec": 58.106,
   "end_sec": 61.279
  }
 ]
}
