 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 48.071,
 "source_chapter": 7,
 "sentence_intervals": [
  {
   "sentence_id": "C07-A001-S01",
   "section": "A",
   "text": "わたしはマテオです。",
   "start_sec": 0.0,
   "end_sec": 1.476
  },
  {
   "sentence_id": "C07-A001-S02",
   "section": "A",
   "text": "毎朝六時半に起きます。",
   "start_sec": 1.675,
   "end_sec": 4.009
  },
  {
   "sentence_id": "C07-A001-S03",
   "section": "A",
   "text": "家で朝ご飯を食べます。",
   "start_sec": 4.209,
   "end_sec": 6.482
  },
  {
   "sentence_id": "C07-A001-S04",
   "section": "A",
   "text": "朝食はパンです。",
   "start_sec": 6.682,
   "end_sec": 8.176
  },
  {
   "sentence_id": "C07-A001-S05",
   "section": "A",
   "text": "お茶を飲みます。",
   "start_sec": 8.376,
   "end_sec": 9.567
  },
  {
   "sentence_id": "C07-A001-S06",
   "section": "A",
   "text": "新聞を読みます。",
   "start_sec": 9.767,
   "end_sec": 11.14
  },
  {
   "sentence_id": "C07-A002-S01",
   "section": "A",
   "text": "木曜日、八時に出掛けます。",
   "start_sec": 11.59,
   "end_sec": 14.146
  },
  {
   "sentence_id": "C07-A002-S02",
   "section": "A",
   "text": "家から大学まで五百メートルです。",
   "start_sec": 14.346,
   "end_sec": 17.219
  },
  {
   "sentence_id": "C07-A002-S03",
   "section": "A",
   "text": "徒歩で大学へ行きます。",
   "start_sec": 17.419,
   "end_sec": 19.153
  },
  {
   "sentence_id": "C07-A002-S04",
   "section": "A",
   "text": "午前、大学で勉強します。",
   "start_sec": 19.353,
   "end_sec": 21.686
  },
  {
   "sentence_id": "C07-A002-S05",
   "section": "A",
   "text": "十二時に昼ご飯を食べます。",
   "start_sec": 21.886,
   "end_sec": 24.304
  },
  {
   "sentence_id": "C07-A002-S06",
   "section": "A",
   "text": "午後、図書館で宿題をします。",
   "start_sec": 24.504,
   "end_sec": 27.257
  },
  {
   "sentence_id": "C07-A002-S07",
   "section": "A",
   "text": "五時に家へ帰ります。",
   "start_sec": 27.457,
   "end_sec": 29.594
  },
  {
   "sentence_id": "C07-A003-S01",
   "section": "A",
   "text": "六時に家で晩ご飯を食べます。",
   "start_sec": 30.044,
   "end_sec": 33.133
  },
  {
   "sentence_id": "C07-A003-S02",
   "section": "A",
   "text": "六時半にバスでセンターへ行きます。",
   "start_sec": 33.333,
   "end_sec": 36.431
  },
  {
   "sentence_id": "C07-A003-S03",
   "section": "A",
   "text": "七時から八時半まで、リンさんと一緒に日本語を勉強します。",
   "start_sec": 36.631,
   "end_sec": 41.916
  },
  {
   "sentence_id": "C07-A003-S04",
   "section": "A",
   "text": "九時に家に帰ります。",
   "start_sec": 42.116,
   "end_sec": 44.041
  },
  {
   "sentence_id": "C07-A003-S05",
   "section": "A",
   "text": "毎晩、本を読みます。",
   "start_sec": 44.241,
   "end_sec": 46.275
  },
  {
   "sentence_id": "C07-A003-S06",
   "section": "A",
   "text": "十一時に寝ます。",
   "start_sec": 46.475,
   "end_sec": 48.065
  }
 ]
}
