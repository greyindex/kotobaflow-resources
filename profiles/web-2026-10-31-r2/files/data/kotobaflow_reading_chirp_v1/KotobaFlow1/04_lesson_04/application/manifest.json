 "sentence_intervals": [
  {
   "sentence_id": "C04-B001-S01",
   "section": "B",
   "text": "これは、みなと駅の近くの地図です。",
   "start_sec": 0.0,
   "end_sec": 2.9
  },
  {
   "sentence_id": "C04-B001-S02",
   "section": "B",
   "text": "地図の★は、センターの入口です。",
   "start_sec": 3.1,
   "end_sec": 5.853
  },
  {
   "sentence_id": "C04-B003-S01",
   "section": "B",
   "text": "駅の出口の前に、バス停があります。",
   "start_sec": 6.303,
   "end_sec": 9.478
  },
  {
   "sentence_id": "C04-B003-S02",
   "section": "B",
   "text": "バス停の前に、公園があります。",
   "start_sec": 9.678,
   "end_sec": 12.252
  },
  {
   "sentence_id": "C04-B003-S03",
   "section": "B",
   "text": "みどりセンターは、公園の右にあります。",
   "start_sec": 12.452,
   "end_sec": 15.801
  },
  {
   "sentence_id": "C04-B004-S01",
   "section": "B",
   "text": "駅の右に、銀行と郵便局があります。",
   "start_sec": 16.251,
   "end_sec": 19.926
  },
  {
   "sentence_id": "C04-B004-S02",
   "section": "B",
   "text": "郵便局は、銀行の隣です。",
   "start_sec": 20.126,
   "end_sec": 22.996
  },
  {
   "sentence_id": "C04-B005-S01",
   "section": "B",
   "text": "駅の左に、スーパーがあります。",
   "start_sec": 23.446,
   "end_sec": 26.079
  },
  {
   "sentence_id": "C04-B005-S02",
   "section": "B",
   "text": "スーパーの入口は、駅の出口の近くにあります。",
   "start_sec": 26.279,
   "end_sec": 30.377
  },
  {
   "sentence_id": "C04-B005-S03",
   "section": "B",
   "text": "病院は、スーパーの後ろにあります。",
   "start_sec": 30.577,
   "end_sec": 33.471
  },
  {
   "sentence_id": "C04-B006-S01",
   "section": "B",
   "text": "駅の中には、店やトイレがあります。",
   "start_sec": 33.921,
   "end_sec": 36.982
  },
  {
   "sentence_id": "C04-B006-S02",
   "section": "B",
   "text": "センターの後ろには、学校があります。",
   "start_sec": 37.182,
   "end_sec": 40.297
  },
  {
   "sentence_id": "C04-B007-S01",
   "section": "B",
   "text": "センターの中に、教室や図書館があります。",
   "start_sec": 40.747,
   "end_sec": 44.362
  },
  {
   "sentence_id": "C04-B007-S02",
   "section": "B",
   "text": "図書館は、教室の隣にあります。",
   "start_sec": 44.562,
   "end_sec": 47.795
  },
  {
   "sentence_id": "C04-B007-S03",
   "section": "B",
   "text": "センターの入口の近くに、トイレがあります。",
   "start_sec": 47.995,
   "end_sec": 52.291
  }
 ]
}
