 "sentence_intervals": [
  {
   "sentence_id": "C04-A001-S01",
   "section": "A",
   "text": "教室は、みどりセンターの中にあります。",
   "start_sec": 0.0,
   "end_sec": 3.209
  },
  {
   "sentence_id": "C04-A001-S02",
   "section": "A",
   "text": "図書館の隣です。",
   "start_sec": 3.409,
   "end_sec": 5.133
  },
  {
   "sentence_id": "C04-A001-S03",
   "section": "A",
   "text": "教室の中には、机や椅子などがあります。",
   "start_sec": 5.333,
   "end_sec": 9.08
  },
  {
   "sentence_id": "C04-A002-S01",
   "section": "A",
   "text": "入口の近くに、森先生の机があります。",
   "start_sec": 9.53,
   "end_sec": 13.423
  },
  {
   "sentence_id": "C04-A002-S02",
   "section": "A",
   "text": "机の上に、パソコンと時計があります。",
   "start_sec": 13.623,
   "end_sec": 16.89
  },
  {
   "sentence_id": "C04-A002-S03",
   "section": "A",
   "text": "森先生は、机の後ろにいます。",
   "start_sec": 17.09,
   "end_sec": 20.008
  },
  {
   "sentence_id": "C04-A003-S01",
   "section": "A",
   "text": "森先生の机の前に、わたしの机があります。",
   "start_sec": 20.458,
   "end_sec": 24.513
  },
  {
   "sentence_id": "C04-A003-S02",
   "section": "A",
   "text": "わたしの右に、パクさんがいます。",
   "start_sec": 24.713,
   "end_sec": 27.259
  },
  {
   "sentence_id": "C04-A003-S03",
   "section": "A",
   "text": "アナンドさんは、パクさんの隣にいます。",
   "start_sec": 27.459,
   "end_sec": 30.56
  },
  {
   "sentence_id": "C04-A004-S01",
   "section": "A",
   "text": "わたしのかばんは、椅子の下にあります。",
   "start_sec": 31.01,
   "end_sec": 33.936
  },
  {
   "sentence_id": "C04-A004-S02",
   "section": "A",
   "text": "かばんの中には、本やノートなどがあります。",
   "start_sec": 34.136,
   "end_sec": 37.621
  },
  {
   "sentence_id": "C04-A004-S03",
   "section": "A",
   "text": "ペンもあります。",
   "start_sec": 37.821,
   "end_sec": 38.942
  },
  {
   "sentence_id": "C04-A004-S04",
   "section": "A",
   "text": "鍵は、机の上です。",
   "start_sec": 39.142,
   "end_sec": 41.176
  }
 ]
}
