{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 57.067,
 "source_chapter": 10,
 "sentence_intervals": [
  {
   "sentence_id": "C10-A001-S01",
   "section": "A",
   "text": "今日は土曜日です。",
   "start_sec": 0.0,
   "end_sec": 1.433
  },
  {
   "sentence_id": "C10-A001-S02",
   "section": "A",
   "text": "私はマテオです。",
   "start_sec": 1.633,
   "end_sec": 3.222
  },
  {
   "sentence_id": "C10-A001-S03",
   "section": "A",
   "text": "午前中はみどりセンターで日本語を勉強します。",
   "start_sec": 3.422,
   "end_sec": 7.015
  },
  {
   "sentence_id": "C10-A001-S04",
   "section": "A",
   "text": "十一時半に終わります。",
   "start_sec": 7.215,
   "end_sec": 9.187
  },
  {
   "sentence_id": "C10-A001-S05",
   "section": "A",
   "text": "センターの食堂は人が多いです。",
   "start_sec": 9.387,
   "end_sec": 12.533
  },
  {
   "sentence_id": "C10-A001-S06",
   "section": "A",
   "text": "駅前のレストランは少し高いです。",
   "start_sec": 12.733,
   "end_sec": 15.584
  },
  {
   "sentence_id": "C10-A001-S07",
   "section": "A",
   "text": "今日はリンさんと二人でカフェでご飯を食べます。",
   "start_sec": 15.784,
   "end_sec": 20.037
  },
  {
   "sentence_id": "C10-A002-S01",
   "section": "A",
   "text": "午後はスーパーで食品を買います。",
   "start_sec": 20.487,
   "end_sec": 23.061
  },
  {
   "sentence_id": "C10-A002-S02",
   "section": "A",
   "text": "昨日、肉と牛乳を買いました。",
   "start_sec": 23.261,
   "end_sec": 26.201
  },
  {
   "sentence_id": "C10-A002-S03",
   "section": "A",
   "text": "家に食べ物はたくさんあります。",
   "start_sec": 26.401,
   "end_sec": 28.674
  },
  {
   "sentence_id": "C10-A002-S04",
   "section": "A",
   "text": "卵は少ないです。",
   "start_sec": 28.874,
   "end_sec": 30.368
  },
  {
   "sentence_id": "C10-A002-S05",
   "section": "A",
   "text": "今日は卵と野菜が欲しいです。",
   "start_sec": 30.568,
   "end_sec": 33.441
  },
  {
   "sentence_id": "C10-A002-S06",
   "section": "A",
   "text": "この店の野菜は新鮮です。",
   "start_sec": 33.641,
   "end_sec": 36.214
  },
  {
   "sentence_id": "C10-A002-S07",
   "section": "A",
   "text": "生の野菜も好きです。",
   "start_sec": 36.414,
   "end_sec": 38.07
  },
  {
   "sentence_id": "C10-A003-S01",
   "section": "A",
   "text": "卵は十個四百円です。",
   "start_sec": 38.52,
   "end_sec": 41.153
  },
  {
   "sentence_id": "C10-A003-S02",
   "section": "A",
   "text": "小さいキャベツは一つ百円です。",
   "start_sec": 41.353,
   "end_sec": 44.451
  },
  {
   "sentence_id": "C10-A003-S03",
   "section": "A",
   "text": "キャベツを一つ買います。",
   "start_sec": 44.651,
   "end_sec": 46.588
  },
  {
   "sentence_id": "C10-A003-S04",
   "section": "A",
   "text": "飲み物はジュースを二本買います。",
   "start_sec": 46.788,
   "end_sec": 49.829
  },
  {
   "sentence_id": "C10-A003-S05",
   "section": "A",
   "text": "洋ナシも買います。",
   "start_sec": 50.029,
   "end_sec": 51.453
  },
  {
   "sentence_id": "C10-A003-S06",
   "section": "A",
   "text": "袋はいっぱいです。",
   "start_sec": 51.653,
   "end_sec": 53.687
  },
  {
   "sentence_id": "C10-A003-S07",
   "section": "A",
   "text": "夜は家で魚とご飯を食べます。",
   "start_sec": 53.887,
   "end_sec": 57.06
  }
 ]
}
