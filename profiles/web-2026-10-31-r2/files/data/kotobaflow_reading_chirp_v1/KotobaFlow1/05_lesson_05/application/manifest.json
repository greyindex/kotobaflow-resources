 "source_chapter": 5,
 "sentence_intervals": [
  {
   "sentence_id": "C05-B001-S01",
   "section": "B",
   "text": "みどりセンター：月曜日から金曜日まで、午前九時から午後九時まで。",
   "start_sec": 0.0,
   "end_sec": 5.996
  },
  {
   "sentence_id": "C05-B001-S02",
   "section": "B",
   "text": "土曜日と日曜日は午前九時から午後五時まで。",
   "start_sec": 6.196,
   "end_sec": 10.689
  },
  {
   "sentence_id": "C05-B002-S01",
   "section": "B",
   "text": "図書館：毎日、午前十時から午後四時まで。",
   "start_sec": 11.139,
   "end_sec": 15.88
  },
  {
   "sentence_id": "C05-B002-S02",
   "section": "B",
   "text": "中村さんは入口の隣にいます。",
   "start_sec": 16.08,
   "end_sec": 18.714
  },
  {
   "sentence_id": "C05-B003-S01",
   "section": "B",
   "text": "日本語クラス：火曜日は午後二時から三時半まで。",
   "start_sec": 19.164,
   "end_sec": 23.872
  },
  {
   "sentence_id": "C05-B003-S02",
   "section": "B",
   "text": "木曜日は午後七時から八時半まで。",
   "start_sec": 24.072,
   "end_sec": 27.605
  },
  {
   "sentence_id": "C05-B003-S03",
   "section": "B",
   "text": "木曜日の先生は森先生とユーリ先生です。",
   "start_sec": 27.805,
   "end_sec": 32.238
  },
  {
   "sentence_id": "C05-B003-S04",
   "section": "B",
   "text": "来週も火曜日と木曜日にクラスがあります。",
   "start_sec": 32.438,
   "end_sec": 35.972
  },
  {
   "sentence_id": "C05-B004-S01",
   "section": "B",
   "text": "今週の週末のクラス：十月三日、土曜日。",
   "start_sec": 36.422,
   "end_sec": 40.435
  },
  {
   "sentence_id": "C05-B004-S02",
   "section": "B",
   "text": "午前十時から十一時半まで。",
   "start_sec": 40.635,
   "end_sec": 42.968
  },
  {
   "sentence_id": "C05-B004-S03",
   "section": "B",
   "text": "先生はユーリ先生です。",
   "start_sec": 43.168,
   "end_sec": 45.322
  },
  {
   "sentence_id": "C05-B004-S04",
   "section": "B",
   "text": "教室は図書館の隣にあります。",
   "start_sec": 45.522,
   "end_sec": 48.335
  },
  {
   "sentence_id": "C05-B005-S01",
   "section": "B",
   "text": "十月（じゅうがつ）：一日（ついたち）は木曜日。",
   "start_sec": 48.785,
   "end_sec": 51.447
  },
  {
   "sentence_id": "C05-B005-S02",
   "section": "B",
   "text": "二日（ふつか）は金曜日。",
   "start_sec": 51.647,
   "end_sec": 53.021
  },
  {
   "sentence_id": "C05-B005-S03",
   "section": "B",
   "text": "三日（みっか）は土曜日。",
   "start_sec": 53.221,
   "end_sec": 54.654
  }
 ]
}
