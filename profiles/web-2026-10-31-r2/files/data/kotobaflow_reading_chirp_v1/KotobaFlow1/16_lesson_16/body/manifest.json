{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 78.855,
 "source_chapter": 16,
 "sentence_intervals": [
  {
   "sentence_id": "C16-A001-S01",
   "section": "A",
   "text": "毎月、みなとセンターで日本語を練習しています。",
   "start_sec": 0.0,
   "end_sec": 4.133
  },
  {
   "sentence_id": "C16-A001-S02",
   "section": "A",
   "text": "日曜日の朝です。",
   "start_sec": 4.333,
   "end_sec": 6.007
  },
  {
   "sentence_id": "C16-A001-S03",
   "section": "A",
   "text": "私は朝ご飯を作る前に顔を洗いました。",
   "start_sec": 6.207,
   "end_sec": 10.34
  },
  {
   "sentence_id": "C16-A001-S04",
   "section": "A",
   "text": "初めに湯を沸かしました。",
   "start_sec": 10.54,
   "end_sec": 12.453
  },
  {
   "sentence_id": "C16-A001-S05",
   "section": "A",
   "text": "パンは固いから、ナイフで切りました。",
   "start_sec": 12.653,
   "end_sec": 15.421
  },
  {
   "sentence_id": "C16-A001-S06",
   "section": "A",
   "text": "食べた後で皿を洗って、外出の支度をしました。",
   "start_sec": 15.621,
   "end_sec": 19.934
  },
  {
   "sentence_id": "C16-A001-S07",
   "section": "A",
   "text": "先週はノートを忘れました。",
   "start_sec": 20.134,
   "end_sec": 23.007
  },
  {
   "sentence_id": "C16-A001-S08",
   "section": "A",
   "text": "そこで、今日は出かける前に、かばんの中を見ました。",
   "start_sec": 23.207,
   "end_sec": 27.521
  },
  {
   "sentence_id": "C16-A001-S09",
   "section": "A",
   "text": "宿題もノートパソコンもあります。",
   "start_sec": 27.721,
   "end_sec": 30.471
  },
  {
   "sentence_id": "C16-A002-S01",
   "section": "A",
   "text": "駅で道を尋ねました。",
   "start_sec": 30.921,
   "end_sec": 32.714
  },
  {
   "sentence_id": "C16-A002-S02",
   "section": "A",
   "text": "センターは駅のすぐ前ではありません。",
   "start_sec": 32.914,
   "end_sec": 36.507
  },
  {
   "sentence_id": "C16-A002-S03",
   "section": "A",
   "text": "橋の先です。",
   "start_sec": 36.707,
   "end_sec": 38.021
  },
  {
   "sentence_id": "C16-A002-S04",
   "section": "A",
   "text": "大きい通りの両側に歩道があります。",
   "start_sec": 38.221,
   "end_sec": 41.034
  },
  {
   "sentence_id": "C16-A002-S05",
   "section": "A",
   "text": "私は左側の歩道をまっすぐ歩いて、次の角を左に曲がりました。",
   "start_sec": 41.234,
   "end_sec": 47.093
  },
  {
   "sentence_id": "C16-A002-S06",
   "section": "A",
   "text": "門のそばに案内がありました。",
   "start_sec": 47.293,
   "end_sec": 49.85
  },
  {
   "sentence_id": "C16-A002-S07",
   "section": "A",
   "text": "建物の正面は駅と反対の方向です。",
   "start_sec": 50.05,
   "end_sec": 53.644
  },
  {
   "sentence_id": "C16-A002-S08",
   "section": "A",
   "text": "最初は迷いました。",
   "start_sec": 53.844,
   "end_sec": 55.457
  },
  {
   "sentence_id": "C16-A002-S09",
   "section": "A",
   "text": "今日は早い時間に着きました。",
   "start_sec": 55.657,
   "end_sec": 58.804
  },
  {
   "sentence_id": "C16-A003-S01",
   "section": "A",
   "text": "準備は九時四十五分からです。",
   "start_sec": 59.254,
   "end_sec": 62.108
  },
  {
   "sentence_id": "C16-A003-S02",
   "section": "A",
   "text": "練習は十時に始まります。",
   "start_sec": 62.308,
   "end_sec": 64.663
  },
  {
   "sentence_id": "C16-A003-S03",
   "section": "A",
   "text": "私は昼に用事があるから、十一時に帰ります。",
   "start_sec": 64.863,
   "end_sec": 68.735
  },
  {
   "sentence_id": "C16-A003-S04",
   "section": "A",
   "text": "帰る前に、リンさんと話したいです。",
   "start_sec": 68.935,
   "end_sec": 71.928
  },
  {
   "sentence_id": "C16-A003-S05",
   "section": "A",
   "text": "理由は二人の練習が好きだからです。",
   "start_sec": 72.128,
   "end_sec": 75.469
  },
  {
   "sentence_id": "C16-A003-S06",
   "section": "A",
   "text": "リンさんは十二時まで時間があります。",
   "start_sec": 75.669,
   "end_sec": 78.848
  }
 ]
}
