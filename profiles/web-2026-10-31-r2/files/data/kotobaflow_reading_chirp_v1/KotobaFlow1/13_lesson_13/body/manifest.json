{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 58.469,
 "source_chapter": 13,
 "sentence_intervals": [
  {
   "sentence_id": "C13-A001-S01",
   "section": "A",
   "text": "今日はセンターで写真の会があります。",
   "start_sec": 0.0,
   "end_sec": 3.893
  },
  {
   "sentence_id": "C13-A001-S02",
   "section": "A",
   "text": "二時から三時までで、食事も無料です。",
   "start_sec": 4.093,
   "end_sec": 7.479
  },
  {
   "sentence_id": "C13-A001-S03",
   "section": "A",
   "text": "センターには毎月、市からお金が入ります。",
   "start_sec": 7.679,
   "end_sec": 11.14
  },
  {
   "sentence_id": "C13-A001-S04",
   "section": "A",
   "text": "今日の食事の費用もセンターから出ます。",
   "start_sec": 11.34,
   "end_sec": 14.093
  },
  {
   "sentence_id": "C13-A001-S05",
   "section": "A",
   "text": "入口には係を一人置きます。",
   "start_sec": 14.293,
   "end_sec": 17.587
  },
  {
   "sentence_id": "C13-A001-S06",
   "section": "A",
   "text": "中村さんが今日の係です。",
   "start_sec": 17.787,
   "end_sec": 20.24
  },
  {
   "sentence_id": "C13-A002-S01",
   "section": "A",
   "text": "マテオとリンは一時五十分に来ます。",
   "start_sec": 20.69,
   "end_sec": 24.113
  },
  {
   "sentence_id": "C13-A002-S02",
   "section": "A",
   "text": "二人は教室に入って、紙に名前と住所を書きます。",
   "start_sec": 24.313,
   "end_sec": 29.038
  },
  {
   "sentence_id": "C13-A002-S03",
   "section": "A",
   "text": "マテオは紙を中村さんに渡します。",
   "start_sec": 29.238,
   "end_sec": 32.597
  },
  {
   "sentence_id": "C13-A002-S04",
   "section": "A",
   "text": "リンは窓を開けて、机を拭きます。",
   "start_sec": 32.797,
   "end_sec": 35.776
  },
  {
   "sentence_id": "C13-A002-S05",
   "section": "A",
   "text": "それから、写真を縦に並べて、写真の下に名前の紙を貼ります。",
   "start_sec": 35.976,
   "end_sec": 42.062
  },
  {
   "sentence_id": "C13-A003-S01",
   "section": "A",
   "text": "会では写真を見て、食事を取ります。",
   "start_sec": 42.512,
   "end_sec": 45.652
  },
  {
   "sentence_id": "C13-A003-S02",
   "section": "A",
   "text": "二人は公園の写真が好きです。",
   "start_sec": 45.852,
   "end_sec": 48.546
  },
  {
   "sentence_id": "C13-A003-S03",
   "section": "A",
   "text": "日曜日の十時に公園の入口で会います。",
   "start_sec": 48.746,
   "end_sec": 52.339
  },
  {
   "sentence_id": "C13-A003-S04",
   "section": "A",
   "text": "三時に会が終わります。",
   "start_sec": 52.539,
   "end_sec": 54.842
  },
  {
   "sentence_id": "C13-A003-S05",
   "section": "A",
   "text": "二人は窓を閉めて、教室を出ます。",
   "start_sec": 55.042,
   "end_sec": 58.462
  }
 ]
}
