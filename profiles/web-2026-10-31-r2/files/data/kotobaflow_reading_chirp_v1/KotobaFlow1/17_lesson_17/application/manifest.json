{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 71.455,
 "source_chapter": 17,
 "sentence_intervals": [
  {
   "sentence_id": "C17-B001-S01",
   "section": "B",
   "text": "部屋は午後二時から四時まで使ってもいいです。",
   "start_sec": 0.0,
   "end_sec": 3.699
  },
  {
   "sentence_id": "C17-B001-S02",
   "section": "B",
   "text": "準備は一時半からです。",
   "start_sec": 3.899,
   "end_sec": 6.018
  },
  {
   "sentence_id": "C17-B001-S03",
   "section": "B",
   "text": "今、入口で机を運んでいます。",
   "start_sec": 6.218,
   "end_sec": 9.621
  },
  {
   "sentence_id": "C17-B001-S04",
   "section": "B",
   "text": "危険ですから、一時半の前に部屋に入ってはいけません。",
   "start_sec": 9.821,
   "end_sec": 14.135
  },
  {
   "sentence_id": "C17-B001-S05",
   "section": "B",
   "text": "受付の前で待ってください。",
   "start_sec": 14.335,
   "end_sec": 16.463
  },
  {
   "sentence_id": "C17-B001-S06",
   "section": "B",
   "text": "準備の順番は、まず机、次に椅子です。",
   "start_sec": 16.663,
   "end_sec": 20.957
  },
  {
   "sentence_id": "C17-B001-S07",
   "section": "B",
   "text": "部屋で水やお茶を飲んではいけません。",
   "start_sec": 21.157,
   "end_sec": 24.142
  },
  {
   "sentence_id": "C17-B001-S08",
   "section": "B",
   "text": "廊下で飲んでください。",
   "start_sec": 24.342,
   "end_sec": 26.096
  },
  {
   "sentence_id": "C17-B001-S09",
   "section": "B",
   "text": "部屋の机は使ってもいいです。",
   "start_sec": 26.296,
   "end_sec": 28.45
  },
  {
   "sentence_id": "C17-B001-S10",
   "section": "B",
   "text": "机は二人で運んでください。",
   "start_sec": 28.65,
   "end_sec": 30.884
  },
  {
   "sentence_id": "C17-B001-S11",
   "section": "B",
   "text": "机を運んだ後で、椅子を運んでください。",
   "start_sec": 31.084,
   "end_sec": 34.477
  },
  {
   "sentence_id": "C17-B001-S12",
   "section": "B",
   "text": "入る前に、この注意を読んでください。",
   "start_sec": 34.677,
   "end_sec": 37.971
  },
  {
   "sentence_id": "C17-B002-S01",
   "section": "B",
   "text": "日曜日は一時半に受付の前で待つ。",
   "start_sec": 38.421,
   "end_sec": 42.379
  },
  {
   "sentence_id": "C17-B002-S02",
   "section": "B",
   "text": "部屋は二時から使う。",
   "start_sec": 42.579,
   "end_sec": 44.413
  },
  {
   "sentence_id": "C17-B002-S03",
   "section": "B",
   "text": "先に準備をする。",
   "start_sec": 44.613,
   "end_sec": 46.106
  },
  {
   "sentence_id": "C17-B002-S04",
   "section": "B",
   "text": "その後で、日本語を勉強する。",
   "start_sec": 46.306,
   "end_sec": 49.095
  },
  {
   "sentence_id": "C17-B002-S05",
   "section": "B",
   "text": "パクは今日は来ない。",
   "start_sec": 49.295,
   "end_sec": 50.968
  },
  {
   "sentence_id": "C17-B002-S06",
   "section": "B",
   "text": "午後は用事がある。",
   "start_sec": 51.168,
   "end_sec": 52.901
  },
  {
   "sentence_id": "C17-B002-S07",
   "section": "B",
   "text": "四時に終わる。",
   "start_sec": 53.101,
   "end_sec": 54.209
  },
  {
   "sentence_id": "C17-B003-S01",
   "section": "B",
   "text": "日曜日は一時半に受付の前で待ちます。",
   "start_sec": 54.659,
   "end_sec": 58.757
  },
  {
   "sentence_id": "C17-B003-S02",
   "section": "B",
   "text": "部屋は二時から使います。",
   "start_sec": 58.957,
   "end_sec": 60.859
  },
  {
   "sentence_id": "C17-B003-S03",
   "section": "B",
   "text": "先に準備をします。",
   "start_sec": 61.059,
   "end_sec": 62.553
  },
  {
   "sentence_id": "C17-B003-S04",
   "section": "B",
   "text": "その後で、日本語を勉強します。",
   "start_sec": 62.753,
   "end_sec": 65.558
  },
  {
   "sentence_id": "C17-B003-S05",
   "section": "B",
   "text": "パクさんは今日は来ません。",
   "start_sec": 65.758,
   "end_sec": 67.671
  },
  {
   "sentence_id": "C17-B003-S06",
   "section": "B",
   "text": "午後は用事があります。",
   "start_sec": 67.871,
   "end_sec": 69.785
  },
  {
   "sentence_id": "C17-B003-S07",
   "section": "B",
   "text": "四時に終わります。",
   "start_sec": 69.985,
   "end_sec": 71.448
  }
 ]
}
