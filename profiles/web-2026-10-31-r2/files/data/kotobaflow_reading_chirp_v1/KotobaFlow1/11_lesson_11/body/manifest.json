 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 56.103,
 "source_chapter": 11,
 "sentence_intervals": [
  {
   "sentence_id": "C11-A001-S01",
   "section": "A",
   "text": "昨日は土曜日でした。",
   "start_sec": 0.0,
   "end_sec": 1.613
  },
  {
   "sentence_id": "C11-A001-S02",
   "section": "A",
   "text": "十時から十一時半までみどりセンターで日本語を勉強しました。",
   "start_sec": 1.813,
   "end_sec": 6.525
  },
  {
   "sentence_id": "C11-A001-S03",
   "section": "A",
   "text": "それから、リンさんと港駅の前の店へ行きました。",
   "start_sec": 6.725,
   "end_sec": 11.731
  },
  {
   "sentence_id": "C11-A001-S04",
   "section": "A",
   "text": "魚とご飯を食べました。",
   "start_sec": 11.931,
   "end_sec": 14.084
  },
  {
   "sentence_id": "C11-A001-S05",
   "section": "A",
   "text": "ジュースを一杯飲みました。",
   "start_sec": 14.284,
   "end_sec": 16.554
  },
  {
   "sentence_id": "C11-A002-S01",
   "section": "A",
   "text": "午後は家の近くのスーパーへ行きました。",
   "start_sec": 17.004,
   "end_sec": 20.255
  },
  {
   "sentence_id": "C11-A002-S02",
   "section": "A",
   "text": "あのスーパーはとても便利です。",
   "start_sec": 20.455,
   "end_sec": 22.756
  },
  {
   "sentence_id": "C11-A002-S03",
   "section": "A",
   "text": "昨日の天気は雨ではありませんでした。",
   "start_sec": 22.956,
   "end_sec": 25.829
  },
  {
   "sentence_id": "C11-A002-S04",
   "section": "A",
   "text": "朝のメモは「卵、キャベツ、ジュース二本、魚」でした。",
   "start_sec": 26.029,
   "end_sec": 31.706
  },
  {
   "sentence_id": "C11-A003-S01",
   "section": "A",
   "text": "まず、卵を十個買いました。",
   "start_sec": 32.156,
   "end_sec": 34.487
  },
  {
   "sentence_id": "C11-A003-S02",
   "section": "A",
   "text": "それから、小さいキャベツを一つ買いました。",
   "start_sec": 34.687,
   "end_sec": 38.172
  },
  {
   "sentence_id": "C11-A003-S03",
   "section": "A",
   "text": "ジュースは一本、水は二本買いました。",
   "start_sec": 38.372,
   "end_sec": 41.979
  },
  {
   "sentence_id": "C11-A003-S04",
   "section": "A",
   "text": "魚は買いませんでした。",
   "start_sec": 42.179,
   "end_sec": 43.912
  },
  {
   "sentence_id": "C11-A003-S05",
   "section": "A",
   "text": "とても高かったです。",
   "start_sec": 44.112,
   "end_sec": 45.746
  },
  {
   "sentence_id": "C11-A003-S06",
   "section": "A",
   "text": "レシート：九百円。",
   "start_sec": 45.946,
   "end_sec": 48.144
  },
  {
   "sentence_id": "C11-A004-S01",
   "section": "A",
   "text": "夜は家で卵とご飯を食べました。",
   "start_sec": 48.594,
   "end_sec": 51.887
  },
  {
   "sentence_id": "C11-A004-S02",
   "section": "A",
   "text": "今朝はパンを一つ食べました。",
   "start_sec": 52.087,
   "end_sec": 54.523
  },
  {
   "sentence_id": "C11-A004-S03",
   "section": "A",
   "text": "牛乳も飲みました。",
   "start_sec": 54.723,
   "end_sec": 56.096
  }
 ]
}
