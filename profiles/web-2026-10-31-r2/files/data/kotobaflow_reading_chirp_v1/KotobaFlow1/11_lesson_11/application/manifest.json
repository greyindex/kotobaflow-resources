 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 60.569,
 "source_chapter": 11,
 "sentence_intervals": [
  {
   "sentence_id": "C11-B001-S01",
   "section": "B",
   "text": "七時に家で朝ご飯を食べます。",
   "start_sec": 0.0,
   "end_sec": 2.973
  },
  {
   "sentence_id": "C11-B001-S02",
   "section": "B",
   "text": "パンを食べます。",
   "start_sec": 3.173,
   "end_sec": 4.448
  },
  {
   "sentence_id": "C11-B001-S03",
   "section": "B",
   "text": "牛乳も飲みます。",
   "start_sec": 4.648,
   "end_sec": 6.321
  },
  {
   "sentence_id": "C11-B001-S04",
   "section": "B",
   "text": "九時半にバスでみどりセンターへ行きます。",
   "start_sec": 6.521,
   "end_sec": 9.395
  },
  {
   "sentence_id": "C11-B001-S05",
   "section": "B",
   "text": "十時から十一時半まで日本語を勉強します。",
   "start_sec": 9.595,
   "end_sec": 13.269
  },
  {
   "sentence_id": "C11-B002-S01",
   "section": "B",
   "text": "十一時に港駅でリンさんと会います。",
   "start_sec": 13.719,
   "end_sec": 17.191
  },
  {
   "sentence_id": "C11-B002-S02",
   "section": "B",
   "text": "電車でさくら駅へ行きます。",
   "start_sec": 17.391,
   "end_sec": 19.304
  },
  {
   "sentence_id": "C11-B002-S03",
   "section": "B",
   "text": "電車は便利です。",
   "start_sec": 19.504,
   "end_sec": 21.1
  },
  {
   "sentence_id": "C11-B002-S04",
   "section": "B",
   "text": "十二時に駅の近くの店で昼ご飯を食べます。",
   "start_sec": 21.3,
   "end_sec": 25.794
  },
  {
   "sentence_id": "C11-B003-S01",
   "section": "B",
   "text": "一時に駅の前のスーパーで買い物をします。",
   "start_sec": 26.244,
   "end_sec": 30.498
  },
  {
   "sentence_id": "C11-B003-S02",
   "section": "B",
   "text": "大きいスーパーです。",
   "start_sec": 30.698,
   "end_sec": 32.191
  },
  {
   "sentence_id": "C11-B003-S03",
   "section": "B",
   "text": "値段も安いです。",
   "start_sec": 32.391,
   "end_sec": 34.0
  },
  {
   "sentence_id": "C11-B003-S04",
   "section": "B",
   "text": "予算は千円です。",
   "start_sec": 34.2,
   "end_sec": 35.948
  },
  {
   "sentence_id": "C11-B003-S05",
   "section": "B",
   "text": "卵を十個、キャベツを一つ、水を二本、パンを二つ買います。",
   "start_sec": 36.148,
   "end_sec": 41.901
  },
  {
   "sentence_id": "C11-B003-S06",
   "section": "B",
   "text": "リンさんも野菜を買います。",
   "start_sec": 42.101,
   "end_sec": 44.533
  },
  {
   "sentence_id": "C11-B004-S01",
   "section": "B",
   "text": "三時に電車で港駅へ行きます。",
   "start_sec": 44.983,
   "end_sec": 48.457
  },
  {
   "sentence_id": "C11-B004-S02",
   "section": "B",
   "text": "それから、バスで家へ帰ります。",
   "start_sec": 48.657,
   "end_sec": 51.301
  },
  {
   "sentence_id": "C11-B004-S03",
   "section": "B",
   "text": "夜は家で宿題をします。",
   "start_sec": 51.501,
   "end_sec": 53.834
  },
  {
   "sentence_id": "C11-B004-S04",
   "section": "B",
   "text": "宿題は二つです。",
   "start_sec": 54.034,
   "end_sec": 56.095
  },
  {
   "sentence_id": "C11-B004-S05",
   "section": "B",
   "text": "十一時に寝ます。",
   "start_sec": 56.295,
   "end_sec": 57.789
  },
  {
   "sentence_id": "C11-B004-S06",
   "section": "B",
   "text": "日曜日は家で休みます。",
   "start_sec": 57.989,
   "end_sec": 60.563
  }
 ]
}
