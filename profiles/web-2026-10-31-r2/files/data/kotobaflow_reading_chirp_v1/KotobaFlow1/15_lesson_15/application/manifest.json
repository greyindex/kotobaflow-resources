{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 68.725,
 "source_chapter": 15,
 "sentence_intervals": [
  {
   "sentence_id": "C15-B001-S01",
   "section": "B",
   "text": "明日は一時にセンターに行く。",
   "start_sec": 0.0,
   "end_sec": 2.393
  },
  {
   "sentence_id": "C15-B001-S02",
   "section": "B",
   "text": "入口の右の部屋で二時まで練習する。",
   "start_sec": 2.593,
   "end_sec": 6.101
  },
  {
   "sentence_id": "C15-B001-S03",
   "section": "B",
   "text": "中村先生も来る。",
   "start_sec": 6.301,
   "end_sec": 7.914
  },
  {
   "sentence_id": "C15-B001-S04",
   "section": "B",
   "text": "ところで、今日は駅前の店でセールがある。",
   "start_sec": 8.114,
   "end_sec": 12.145
  },
  {
   "sentence_id": "C15-B001-S05",
   "section": "B",
   "text": "パンの売り場で店員さんが安いパンを売っている。",
   "start_sec": 12.345,
   "end_sec": 16.328
  },
  {
   "sentence_id": "C15-B002-S01",
   "section": "B",
   "text": "時間は大丈夫だ。",
   "start_sec": 16.778,
   "end_sec": 18.457
  },
  {
   "sentence_id": "C15-B002-S02",
   "section": "B",
   "text": "地図も見た。",
   "start_sec": 18.657,
   "end_sec": 19.79
  },
  {
   "sentence_id": "C15-B002-S03",
   "section": "B",
   "text": "ぼくは今、家で勉強している。",
   "start_sec": 19.99,
   "end_sec": 22.623
  },
  {
   "sentence_id": "C15-B002-S04",
   "section": "B",
   "text": "買い物はそのうちに行く。",
   "start_sec": 22.823,
   "end_sec": 25.217
  },
  {
   "sentence_id": "C15-B002-S05",
   "section": "B",
   "text": "今日の小遣いは千円だ。",
   "start_sec": 25.417,
   "end_sec": 27.754
  },
  {
   "sentence_id": "C15-B002-S06",
   "section": "B",
   "text": "いくら支払った？",
   "start_sec": 27.954,
   "end_sec": 29.358
  },
  {
   "sentence_id": "C15-B003-S01",
   "section": "B",
   "text": "六百円だ。",
   "start_sec": 29.808,
   "end_sec": 31.153
  },
  {
   "sentence_id": "C15-B003-S02",
   "section": "B",
   "text": "値札も見た。",
   "start_sec": 31.353,
   "end_sec": 32.426
  },
  {
   "sentence_id": "C15-B003-S03",
   "section": "B",
   "text": "細かいお金はなかった。",
   "start_sec": 32.626,
   "end_sec": 34.419
  },
  {
   "sentence_id": "C15-B003-S04",
   "section": "B",
   "text": "千円の札で支払った。",
   "start_sec": 34.619,
   "end_sec": 36.653
  },
  {
   "sentence_id": "C15-B003-S05",
   "section": "B",
   "text": "おつりは四百円だった。",
   "start_sec": 36.853,
   "end_sec": 38.815
  },
  {
   "sentence_id": "C15-B003-S06",
   "section": "B",
   "text": "パンはもう売り切れた。",
   "start_sec": 39.015,
   "end_sec": 40.737
  },
  {
   "sentence_id": "C15-B003-S07",
   "section": "B",
   "text": "コンビニエンスストアにもパンがあるよ。",
   "start_sec": 40.937,
   "end_sec": 43.694
  },
  {
   "sentence_id": "C15-B004-S01",
   "section": "B",
   "text": "うん、分かった。",
   "start_sec": 44.144,
   "end_sec": 45.637
  },
  {
   "sentence_id": "C15-B004-S02",
   "section": "B",
   "text": "じゃ、駅の前でまた会いましょう。",
   "start_sec": 45.837,
   "end_sec": 48.147
  },
  {
   "sentence_id": "C15-B004-S03",
   "section": "B",
   "text": "いや、今日は行かない。",
   "start_sec": 48.347,
   "end_sec": 49.888
  },
  {
   "sentence_id": "C15-B004-S04",
   "section": "B",
   "text": "やっぱり家で勉強する。",
   "start_sec": 50.088,
   "end_sec": 51.991
  },
  {
   "sentence_id": "C15-B004-S05",
   "section": "B",
   "text": "明日は一時に行く。",
   "start_sec": 52.191,
   "end_sec": 53.564
  },
  {
   "sentence_id": "C15-B005-S01",
   "section": "B",
   "text": "こんにちは。",
   "start_sec": 54.014,
   "end_sec": 54.878
  },
  {
   "sentence_id": "C15-B005-S02",
   "section": "B",
   "text": "今日は一時にセンターに行きます。",
   "start_sec": 55.078,
   "end_sec": 57.771
  },
  {
   "sentence_id": "C15-B005-S03",
   "section": "B",
   "text": "地図はもう見ました。",
   "start_sec": 57.971,
   "end_sec": 59.465
  },
  {
   "sentence_id": "C15-B005-S04",
   "section": "B",
   "text": "昼ご飯は家で食べました。",
   "start_sec": 59.665,
   "end_sec": 62.178
  },
  {
   "sentence_id": "C15-B005-S05",
   "section": "B",
   "text": "先生のアドレスはアドレス帳にあります。",
   "start_sec": 62.378,
   "end_sec": 65.491
  },
  {
   "sentence_id": "C15-B005-S06",
   "section": "B",
   "text": "リンさんのメールを転送してもいいですか。",
   "start_sec": 65.691,
   "end_sec": 68.718
  }
 ]
}
