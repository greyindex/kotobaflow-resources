{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 59.78,
 "source_chapter": 15,
 "sentence_intervals": [
  {
   "sentence_id": "C15-A001-S01",
   "section": "A",
   "text": "今日は十一月十四日、土曜日です。",
   "start_sec": 0.0,
   "end_sec": 3.365
  },
  {
   "sentence_id": "C15-A001-S02",
   "section": "A",
   "text": "マテオは家にいます。",
   "start_sec": 3.565,
   "end_sec": 5.358
  },
  {
   "sentence_id": "C15-A001-S03",
   "section": "A",
   "text": "机の上に電話があります。",
   "start_sec": 5.558,
   "end_sec": 7.766
  },
  {
   "sentence_id": "C15-A001-S04",
   "section": "A",
   "text": "リンから短いメッセージが来ました。",
   "start_sec": 7.966,
   "end_sec": 11.071
  },
  {
   "sentence_id": "C15-A001-S05",
   "section": "A",
   "text": "「今日、何時に行く？」",
   "start_sec": 11.271,
   "end_sec": 13.304
  },
  {
   "sentence_id": "C15-A001-S06",
   "section": "A",
   "text": "マテオは返事を送ります。",
   "start_sec": 13.504,
   "end_sec": 15.87
  },
  {
   "sentence_id": "C15-A001-S07",
   "section": "A",
   "text": "「一時に行く。」",
   "start_sec": 16.07,
   "end_sec": 17.338
  },
  {
   "sentence_id": "C15-A001-S08",
   "section": "A",
   "text": "二人は勉強の仲間です。",
   "start_sec": 17.538,
   "end_sec": 19.706
  },
  {
   "sentence_id": "C15-A001-S09",
   "section": "A",
   "text": "今日もセンターで会話を練習します。",
   "start_sec": 19.905,
   "end_sec": 23.079
  },
  {
   "sentence_id": "C15-A002-S01",
   "section": "A",
   "text": "昨日はメールで連絡しました。",
   "start_sec": 23.529,
   "end_sec": 26.102
  },
  {
   "sentence_id": "C15-A002-S02",
   "section": "A",
   "text": "電子メールの件名は「土曜日の練習」です。",
   "start_sec": 26.302,
   "end_sec": 30.128
  },
  {
   "sentence_id": "C15-A002-S03",
   "section": "A",
   "text": "リンの文章は長かったです。",
   "start_sec": 30.328,
   "end_sec": 32.977
  },
  {
   "sentence_id": "C15-A002-S04",
   "section": "A",
   "text": "二人のメッセージは普通体です。",
   "start_sec": 33.177,
   "end_sec": 35.65
  },
  {
   "sentence_id": "C15-A002-S05",
   "section": "A",
   "text": "でも、先生には丁寧体でメールを書きます。",
   "start_sec": 35.85,
   "end_sec": 40.184
  },
  {
   "sentence_id": "C15-A002-S06",
   "section": "A",
   "text": "相手をよく考えます。",
   "start_sec": 40.384,
   "end_sec": 42.209
  },
  {
   "sentence_id": "C15-A003-S01",
   "section": "A",
   "text": "今日は買い物のメッセージも読みます。",
   "start_sec": 42.659,
   "end_sec": 45.592
  },
  {
   "sentence_id": "C15-A003-S02",
   "section": "A",
   "text": "雑談ではいろんな言葉を使います。",
   "start_sec": 45.792,
   "end_sec": 48.776
  },
  {
   "sentence_id": "C15-A003-S03",
   "section": "A",
   "text": "言葉の意味と声の調子を一緒に考えます。",
   "start_sec": 48.976,
   "end_sec": 53.169
  },
  {
   "sentence_id": "C15-A003-S04",
   "section": "A",
   "text": "短い返事も良い練習です。",
   "start_sec": 53.369,
   "end_sec": 55.882
  },
  {
   "sentence_id": "C15-A003-S05",
   "section": "A",
   "text": "マテオはノートに丁寧な挨拶も書きました。",
   "start_sec": 56.082,
   "end_sec": 59.774
  }
 ]
}
