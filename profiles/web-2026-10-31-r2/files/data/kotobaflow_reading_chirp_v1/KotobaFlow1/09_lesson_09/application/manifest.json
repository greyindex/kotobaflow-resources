{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 53.536,
 "source_chapter": 9,
 "sentence_intervals": [
  {
   "sentence_id": "C09-B001-S01",
   "section": "B",
   "text": "ユーリ先生、こんばんは。",
   "start_sec": 0.0,
   "end_sec": 2.01
  },
  {
   "sentence_id": "C09-B001-S02",
   "section": "B",
   "text": "パクです。",
   "start_sec": 2.21,
   "end_sec": 3.165
  },
  {
   "sentence_id": "C09-B001-S03",
   "section": "B",
   "text": "昨日は仕事で、センターへ行きませんでした。",
   "start_sec": 3.365,
   "end_sec": 7.257
  },
  {
   "sentence_id": "C09-B001-S04",
   "section": "B",
   "text": "まず、八時に電車で会社へ行きました。",
   "start_sec": 7.457,
   "end_sec": 11.252
  },
  {
   "sentence_id": "C09-B001-S05",
   "section": "B",
   "text": "港駅で一号線に乗り換えました。",
   "start_sec": 11.452,
   "end_sec": 14.925
  },
  {
   "sentence_id": "C09-B001-S06",
   "section": "B",
   "text": "車内は静かで、乗客は少なかったです。",
   "start_sec": 15.125,
   "end_sec": 18.831
  },
  {
   "sentence_id": "C09-B001-S07",
   "section": "B",
   "text": "十時に会社の人と会いました。",
   "start_sec": 19.031,
   "end_sec": 21.784
  },
  {
   "sentence_id": "C09-B002-S01",
   "section": "B",
   "text": "帰りは市バスでした。",
   "start_sec": 22.234,
   "end_sec": 24.173
  },
  {
   "sentence_id": "C09-B002-S02",
   "section": "B",
   "text": "運賃は二百円で、降車は後ろのドアからでした。",
   "start_sec": 24.373,
   "end_sec": 28.661
  },
  {
   "sentence_id": "C09-B002-S03",
   "section": "B",
   "text": "午後七時に家へ帰りました。",
   "start_sec": 28.861,
   "end_sec": 31.537
  },
  {
   "sentence_id": "C09-B002-S04",
   "section": "B",
   "text": "今日は休みでした。",
   "start_sec": 31.737,
   "end_sec": 33.531
  },
  {
   "sentence_id": "C09-B002-S05",
   "section": "B",
   "text": "いつも六時に起きます。",
   "start_sec": 33.731,
   "end_sec": 35.505
  },
  {
   "sentence_id": "C09-B002-S06",
   "section": "B",
   "text": "今朝は九時に起きました。",
   "start_sec": 35.705,
   "end_sec": 37.499
  },
  {
   "sentence_id": "C09-B002-S07",
   "section": "B",
   "text": "午前中は家で休みました。",
   "start_sec": 37.699,
   "end_sec": 40.152
  },
  {
   "sentence_id": "C09-B002-S08",
   "section": "B",
   "text": "午後は買い物をしました。",
   "start_sec": 40.352,
   "end_sec": 42.504
  },
  {
   "sentence_id": "C09-B003-S01",
   "section": "B",
   "text": "それから、日本語を勉強しました。",
   "start_sec": 42.954,
   "end_sec": 46.063
  },
  {
   "sentence_id": "C09-B003-S02",
   "section": "B",
   "text": "先週のクラスは難しかったです。",
   "start_sec": 46.263,
   "end_sec": 48.716
  },
  {
   "sentence_id": "C09-B003-S03",
   "section": "B",
   "text": "昨日も難しかったですか。",
   "start_sec": 48.916,
   "end_sec": 50.997
  },
  {
   "sentence_id": "C09-B003-S04",
   "section": "B",
   "text": "木曜日はセンターへ行きます。",
   "start_sec": 51.197,
   "end_sec": 53.53
  }
 ]
}
