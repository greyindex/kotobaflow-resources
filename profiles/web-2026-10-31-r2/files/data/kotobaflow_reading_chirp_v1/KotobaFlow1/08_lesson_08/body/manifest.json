 "source_chapter": 8,
 "sentence_intervals": [
  {
   "sentence_id": "C08-A001-S01",
   "section": "A",
   "text": "わたしの家は大学の近くです。",
   "start_sec": 0.0,
   "end_sec": 3.073
  },
  {
   "sentence_id": "C08-A001-S02",
   "section": "A",
   "text": "古いアパートです。",
   "start_sec": 3.273,
   "end_sec": 4.586
  },
  {
   "sentence_id": "C08-A001-S03",
   "section": "A",
   "text": "部屋は狭いです。",
   "start_sec": 4.786,
   "end_sec": 6.159
  },
  {
   "sentence_id": "C08-A001-S04",
   "section": "A",
   "text": "スーパーは近いです。",
   "start_sec": 6.359,
   "end_sec": 7.946
  },
  {
   "sentence_id": "C08-A001-S05",
   "section": "A",
   "text": "便利です。",
   "start_sec": 8.146,
   "end_sec": 9.132
  },
  {
   "sentence_id": "C08-A001-S06",
   "section": "A",
   "text": "駅は遠いです。",
   "start_sec": 9.332,
   "end_sec": 10.787
  },
  {
   "sentence_id": "C08-A001-S07",
   "section": "A",
   "text": "電車は不便です。",
   "start_sec": 10.987,
   "end_sec": 12.487
  },
  {
   "sentence_id": "C08-A002-S01",
   "section": "A",
   "text": "大学は大きいです。",
   "start_sec": 12.937,
   "end_sec": 14.796
  },
  {
   "sentence_id": "C08-A002-S02",
   "section": "A",
   "text": "図書館は新しい建物です。",
   "start_sec": 14.996,
   "end_sec": 17.149
  },
  {
   "sentence_id": "C08-A002-S03",
   "section": "A",
   "text": "きれいです。",
   "start_sec": 17.349,
   "end_sec": 18.293
  },
  {
   "sentence_id": "C08-A002-S04",
   "section": "A",
   "text": "周りに木や花壇があります。",
   "start_sec": 18.493,
   "end_sec": 21.156
  },
  {
   "sentence_id": "C08-A002-S05",
   "section": "A",
   "text": "池のそばにベンチがあります。",
   "start_sec": 21.356,
   "end_sec": 23.788
  },
  {
   "sentence_id": "C08-A002-S06",
   "section": "A",
   "text": "緑が綺麗です。",
   "start_sec": 23.988,
   "end_sec": 25.481
  },
  {
   "sentence_id": "C08-A002-S07",
   "section": "A",
   "text": "この辺りは静かです。",
   "start_sec": 25.681,
   "end_sec": 27.714
  },
  {
   "sentence_id": "C08-A003-S01",
   "section": "A",
   "text": "駅前は賑やかです。",
   "start_sec": 28.164,
   "end_sec": 30.052
  },
  {
   "sentence_id": "C08-A003-S02",
   "section": "A",
   "text": "高いビルがあります。",
   "start_sec": 30.252,
   "end_sec": 31.625
  },
  {
   "sentence_id": "C08-A003-S03",
   "section": "A",
   "text": "大学の前にはポストがあります。",
   "start_sec": 31.825,
   "end_sec": 33.979
  },
  {
   "sentence_id": "C08-A003-S04",
   "section": "A",
   "text": "わたしはこの町が大好きです。",
   "start_sec": 34.179,
   "end_sec": 36.523
  },
  {
   "sentence_id": "C08-A003-S05",
   "section": "A",
   "text": "木曜日は忙しいです。",
   "start_sec": 36.723,
   "end_sec": 38.874
  },
  {
   "sentence_id": "C08-A003-S06",
   "section": "A",
   "text": "夜の日本語クラスは楽しいです。",
   "start_sec": 39.074,
   "end_sec": 41.887
  }
 ]
}
