{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 229.588,
 "source_chapter": 61,
 "sentence_intervals": [
  {
   "sentence_id": "C61-B001-S01",
   "section": "B",
   "text": "1月9日開始の表計算講座は、利用方法の確認が不可欠です。",
   "start_sec": 0.0,
   "end_sec": 6.35
  },
  {
   "sentence_id": "C61-B001-S02",
   "section": "B",
   "text": "やむを得ない変更もありますので、ご了承ください。",
   "start_sec": 6.55,
   "end_sec": 10.446
  },
  {
   "sentence_id": "C61-B002-S01",
   "section": "B",
   "text": "12月15日まで窓口か電話で申し込めます。",
   "start_sec": 10.896,
   "end_sec": 15.206
  },
  {
   "sentence_id": "C61-B002-S02",
   "section": "B",
   "text": "定員20人、先着順で、満員後はお断りします。",
   "start_sec": 15.406,
   "end_sec": 20.54
  },
  {
   "sentence_id": "C61-B002-S03",
   "section": "B",
   "text": "席の仮予約はお受けしかねます。",
   "start_sec": 20.74,
   "end_sec": 23.753
  },
  {
   "sentence_id": "C61-B002-S04",
   "section": "B",
   "text": "団体は全員の氏名が必要です。",
   "start_sec": 23.953,
   "end_sec": 27.189
  },
  {
   "sentence_id": "C61-B002-S05",
   "section": "B",
   "text": "15日までの電話取消は無料。",
   "start_sec": 27.389,
   "end_sec": 30.364
  },
  {
   "sentence_id": "C61-B002-S06",
   "section": "B",
   "text": "費用は一人1,500円で教材込みです。",
   "start_sec": 30.564,
   "end_sec": 35.417
  },
  {
   "sentence_id": "C61-B002-S07",
   "section": "B",
   "text": "1月9日の受付で払います。",
   "start_sec": 35.617,
   "end_sec": 38.337
  },
  {
   "sentence_id": "C61-B003-S01",
   "section": "B",
   "text": "大雪による交通の遅延や設備故障で安全を確かめられない場合は、中止か延期を決めます。",
   "start_sec": 38.787,
   "end_sec": 46.461
  },
  {
   "sentence_id": "C61-B003-S02",
   "section": "B",
   "text": "大雪のおそれがある日は前日夕方にもホームページをご確認ください。",
   "start_sec": 46.661,
   "end_sec": 51.952
  },
  {
   "sentence_id": "C61-B003-S03",
   "section": "B",
   "text": "11月の暖房の不具合は修理済みで、再発の可能性は低いですが、ゼロではありません。",
   "start_sec": 52.152,
   "end_sec": 60.028
  },
  {
   "sentence_id": "C61-B003-S04",
   "section": "B",
   "text": "中止は当日8時までに掲載し、団体代表へ電話します。",
   "start_sec": 60.228,
   "end_sec": 65.824
  },
  {
   "sentence_id": "C61-B003-S05",
   "section": "B",
   "text": "補講は2月6日10―12時。",
   "start_sec": 66.024,
   "end_sec": 69.137
  },
  {
   "sentence_id": "C61-B003-S06",
   "section": "B",
   "text": "補講参加も元の回の参加記録に入ります。",
   "start_sec": 69.337,
   "end_sec": 73.29
  },
  {
   "sentence_id": "C61-B003-S07",
   "section": "B",
   "text": "交通費等の損害の補償と受講料の返金はいたしかねます。",
   "start_sec": 73.49,
   "end_sec": 78.044
  },
  {
   "sentence_id": "C61-B004-S01",
   "section": "B",
   "text": "貸出パソコン15台は申込時に予約してください。",
   "start_sec": 78.494,
   "end_sec": 82.806
  },
  {
   "sentence_id": "C61-B004-S02",
   "section": "B",
   "text": "故障は起こり得るので、ファイルは何度も保存しましょう。",
   "start_sec": 83.007,
   "end_sec": 87.32
  },
  {
   "sentence_id": "C61-B004-S03",
   "section": "B",
   "text": "欠陥があれば使用を中止し、先生へ。",
   "start_sec": 87.52,
   "end_sec": 90.813
  },
  {
   "sentence_id": "C61-B004-S04",
   "section": "B",
   "text": "自分のパソコンは館内ネットワークに接続できませんが、講座は接続なしで受けられます。",
   "start_sec": 91.013,
   "end_sec": 98.527
  },
  {
   "sentence_id": "C61-B004-S05",
   "section": "B",
   "text": "自分の機器の故障やデータ消失の被害には責任を負いかねます。",
   "start_sec": 98.727,
   "end_sec": 104.039
  },
  {
   "sentence_id": "C61-B005-S01",
   "section": "B",
   "text": "去年は通路のかばんにつまずく事故がありました。",
   "start_sec": 104.489,
   "end_sec": 108.143
  },
  {
   "sentence_id": "C61-B005-S02",
   "section": "B",
   "text": "再発を防ぐため荷物は机の下へ。",
   "start_sec": 108.343,
   "end_sec": 112.268
  },
  {
   "sentence_id": "C61-B005-S03",
   "section": "B",
   "text": "短時間でも油断は禁物です。",
   "start_sec": 112.468,
   "end_sec": 115.401
  },
  {
   "sentence_id": "C61-B005-S04",
   "section": "B",
   "text": "事故の防止にご協力ください。",
   "start_sec": 115.601,
   "end_sec": 117.874
  },
  {
   "sentence_id": "C61-B006-S01",
   "section": "B",
   "text": "不明点は窓口か電話でお問い合わせください。",
   "start_sec": 118.324,
   "end_sec": 122.098
  },
  {
   "sentence_id": "C61-B006-S02",
   "section": "B",
   "text": "以下は表計算の練習用資料です。",
   "start_sec": 122.298,
   "end_sec": 125.621
  },
  {
   "sentence_id": "C61-B006-S03",
   "section": "B",
   "text": "リスクの原因と対策を別の欄に記入します。",
   "start_sec": 125.821,
   "end_sec": 129.56
  },
  {
   "sentence_id": "C61-B007-S01",
   "section": "B",
   "text": "海洋に囲まれた日本の国土には、多くの島があります。",
   "start_sec": 130.01,
   "end_sec": 134.548
  },
  {
   "sentence_id": "C61-B007-S02",
   "section": "B",
   "text": "日本列島や南西諸島の地図で、活火山の位置や低地を確かめます。",
   "start_sec": 134.748,
   "end_sec": 140.608
  },
  {
   "sentence_id": "C61-B007-S03",
   "section": "B",
   "text": "同じ災害でも土地によって危険は違います。",
   "start_sec": 140.808,
   "end_sec": 145.033
  },
  {
   "sentence_id": "C61-B007-S04",
   "section": "B",
   "text": "地中の水道管が破壊されれば、水が足りなくなるおそれがあります。",
   "start_sec": 145.233,
   "end_sec": 150.386
  },
  {
   "sentence_id": "C61-B007-S05",
   "section": "B",
   "text": "命を危険に晒す行動を避け、厳しい日々を生き抜く備えが必要です。",
   "start_sec": 150.586,
   "end_sec": 156.372
  },
  {
   "sentence_id": "C61-B008-S01",
   "section": "B",
   "text": "温暖化と二酸化炭素の関係を調べる班は、二酸化炭素の量と海の温度のデータを集めます。",
   "start_sec": 156.822,
   "end_sec": 164.937
  },
  {
   "sentence_id": "C61-B008-S02",
   "section": "B",
   "text": "別の班は、酸性雨による自然林への影響や、土地の砂漠化を調べます。",
   "start_sec": 165.137,
   "end_sec": 171.38
  },
  {
   "sentence_id": "C61-B008-S03",
   "section": "B",
   "text": "砂漠が広がり、水不足に苦しむ地域の記録も読みます。",
   "start_sec": 171.58,
   "end_sec": 176.578
  },
  {
   "sentence_id": "C61-B008-S04",
   "section": "B",
   "text": "原因が違えば対策も違うので、一つの説明で済ませないでください。",
   "start_sec": 176.778,
   "end_sec": 182.625
  },
  {
   "sentence_id": "C61-B009-S01",
   "section": "B",
   "text": "非常食の比較では、固形の食品と飲料を分け、量と期限を記録します。",
   "start_sec": 183.075,
   "end_sec": 189.909
  },
  {
   "sentence_id": "C61-B009-S02",
   "section": "B",
   "text": "保存料は食品添加物の一種です。",
   "start_sec": 190.109,
   "end_sec": 193.402
  },
  {
   "sentence_id": "C61-B009-S03",
   "section": "B",
   "text": "「添加物は全部危険だ」という説明は受け入れがたいので、名前だけで判断せず、使い方も確かめます。",
   "start_sec": 193.602,
   "end_sec": 201.428
  },
  {
   "sentence_id": "C61-B010-S01",
   "section": "B",
   "text": "災難の記録を読むときは、助かった理由にも注目します。",
   "start_sec": 201.878,
   "end_sec": 206.703
  },
  {
   "sentence_id": "C61-B010-S02",
   "section": "B",
   "text": "水の備えが尽きると生活は厳しくなります。",
   "start_sec": 206.903,
   "end_sec": 211.187
  },
  {
   "sentence_id": "C61-B010-S03",
   "section": "B",
   "text": "避難を余儀なくされた人の話から、差し迫る危険と、長く人を苦しめる問題を分けて考えましょう。",
   "start_sec": 211.387,
   "end_sec": 219.457
  },
  {
   "sentence_id": "C61-B010-S04",
   "section": "B",
   "text": "「一寸先はやみ」だから何もできないのではありません。",
   "start_sec": 219.657,
   "end_sec": 223.577
  },
  {
   "sentence_id": "C61-B010-S05",
   "section": "B",
   "text": "危機の瀬戸際に立つ前に、連絡先と持ち出す物を確かめておくのです。",
   "start_sec": 223.777,
   "end_sec": 229.582
  }
 ]
}
