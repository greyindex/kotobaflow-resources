{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 164.0,
 "source_chapter": 59,
 "sentence_intervals": [
  {
   "sentence_id": "C59-A001-S01",
   "section": "A",
   "text": "緑町の職場では、この三年で仕事の方法が変化しました。",
   "start_sec": 0.0,
   "end_sec": 5.393
  },
  {
   "sentence_id": "C59-A001-S02",
   "section": "A",
   "text": "11月27日の勉強会の準備のため、林梅は11月10日に大野さんを取材しました。",
   "start_sec": 5.593,
   "end_sec": 14.287
  },
  {
   "sentence_id": "C59-A001-S03",
   "section": "A",
   "text": "新しい技術の習得は、今の仕事を始める前から続いていたそうです。",
   "start_sec": 14.487,
   "end_sec": 20.0
  },
  {
   "sentence_id": "C59-A002-S01",
   "section": "A",
   "text": "大野さんは書店で八年間働いた後、二年間、家で父の世話をしました。",
   "start_sec": 20.45,
   "end_sec": 27.161
  },
  {
   "sentence_id": "C59-A002-S02",
   "section": "A",
   "text": "「父と病院に行く予定や薬が増えたことがきっかけとなって、表の作り方を独学で学び始めました。",
   "start_sec": 27.361,
   "end_sec": 35.854
  },
  {
   "sentence_id": "C59-A002-S03",
   "section": "A",
   "text": "病院に行くついでに図書館で本を借りたんです。」",
   "start_sec": 36.054,
   "end_sec": 39.527
  },
  {
   "sentence_id": "C59-A003-S01",
   "section": "A",
   "text": "「初めは一つの表に一時間かかりました。",
   "start_sec": 39.977,
   "end_sec": 43.823
  },
  {
   "sentence_id": "C59-A003-S02",
   "section": "A",
   "text": "基礎を身につけるため、本の例を写す練習を繰り返しました。",
   "start_sec": 44.023,
   "end_sec": 48.721
  },
  {
   "sentence_id": "C59-A003-S03",
   "section": "A",
   "text": "でも、真似をするだけでは、別の表は作れません。",
   "start_sec": 48.921,
   "end_sec": 52.906
  },
  {
   "sentence_id": "C59-A003-S04",
   "section": "A",
   "text": "使い慣れるに従って操作への理解が深まり、必要な機能を選べるようになりました。",
   "start_sec": 53.106,
   "end_sec": 59.938
  },
  {
   "sentence_id": "C59-A003-S05",
   "section": "A",
   "text": "実生活で役立つかどうかを確かめながら、経験を積み重ねたんです。」",
   "start_sec": 60.138,
   "end_sec": 65.396
  },
  {
   "sentence_id": "C59-A004-S01",
   "section": "A",
   "text": "四年前、大野さんは今の会社に転職しました。",
   "start_sec": 65.846,
   "end_sec": 69.979
  },
  {
   "sentence_id": "C59-A004-S02",
   "section": "A",
   "text": "2024年4月には、新しいシステムへと移行し、伝票を作る作業が自動化されました。",
   "start_sec": 70.179,
   "end_sec": 78.086
  },
  {
   "sentence_id": "C59-A004-S03",
   "section": "A",
   "text": "「初めは画面に慣れず、効率が下がりました。",
   "start_sec": 78.286,
   "end_sec": 81.933
  },
  {
   "sentence_id": "C59-A004-S04",
   "section": "A",
   "text": "慣れるにつれて入力が速くなり、速さも安定しました。",
   "start_sec": 82.133,
   "end_sec": 86.566
  },
  {
   "sentence_id": "C59-A004-S05",
   "section": "A",
   "text": "ただ、仕事全体の成果は、入力時間だけでは判断できません。」",
   "start_sec": 86.766,
   "end_sec": 92.799
  },
  {
   "sentence_id": "C59-A005-S01",
   "section": "A",
   "text": "同じ年、全員が研修を受けました。",
   "start_sec": 93.249,
   "end_sec": 96.362
  },
  {
   "sentence_id": "C59-A005-S02",
   "section": "A",
   "text": "講師の指導のもとで確認の方法を教わり、説明の資料を見直すことになりました。",
   "start_sec": 96.562,
   "end_sec": 103.636
  },
  {
   "sentence_id": "C59-A005-S03",
   "section": "A",
   "text": "「熟練した人がいなくてもできるように、資料の改善に力を入れています。",
   "start_sec": 103.836,
   "end_sec": 109.229
  },
  {
   "sentence_id": "C59-A005-S04",
   "section": "A",
   "text": "今は二、三人で確認します。",
   "start_sec": 109.429,
   "end_sec": 111.805
  },
  {
   "sentence_id": "C59-A005-S05",
   "section": "A",
   "text": "分担は変わりつつあり、新しい方法も定着しつつあります。」",
   "start_sec": 112.005,
   "end_sec": 117.278
  },
  {
   "sentence_id": "C59-A005-S06",
   "section": "A",
   "text": "今は大野さんも同僚に操作を教えています。",
   "start_sec": 117.478,
   "end_sec": 121.012
  },
  {
   "sentence_id": "C59-A005-S07",
   "section": "A",
   "text": "大野さんは「確認の時間は増えましたが、間違いは減ったと思います」と話しました。",
   "start_sec": 121.212,
   "end_sec": 128.237
  },
  {
   "sentence_id": "C59-A006-S01",
   "section": "A",
   "text": "「学ぶ意欲はありますが、疲れきった日は休みます。",
   "start_sec": 128.687,
   "end_sec": 132.598
  },
  {
   "sentence_id": "C59-A006-S02",
   "section": "A",
   "text": "黙々と長く練習するより、短い練習を続けるほうが私には合っています。",
   "start_sec": 132.798,
   "end_sec": 139.331
  },
  {
   "sentence_id": "C59-A006-S03",
   "section": "A",
   "text": "能力を伸ばすには、自分の失敗も活かすことが大切です。」",
   "start_sec": 139.531,
   "end_sec": 144.182
  },
  {
   "sentence_id": "C59-A006-S04",
   "section": "A",
   "text": "「私も最初は素人でした。",
   "start_sec": 144.382,
   "end_sec": 146.835
  },
  {
   "sentence_id": "C59-A006-S05",
   "section": "A",
   "text": "できる人のやり方を賢く活用したいですね。」",
   "start_sec": 147.035,
   "end_sec": 150.988
  },
  {
   "sentence_id": "C59-A006-S06",
   "section": "A",
   "text": "技術の進歩と個人の上達は同じではありません。",
   "start_sec": 151.188,
   "end_sec": 155.597
  },
  {
   "sentence_id": "C59-A006-S07",
   "section": "A",
   "text": "必要が生まれた契機と能力が向上する過程を分けて考えると、次に取り組む課題も見えてきます。",
   "start_sec": 155.797,
   "end_sec": 163.994
  }
 ]
}
