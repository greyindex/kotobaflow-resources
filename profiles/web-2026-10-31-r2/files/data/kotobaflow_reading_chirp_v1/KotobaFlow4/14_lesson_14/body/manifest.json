{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 56.159,
 "source_chapter": 70,
 "sentence_intervals": [
  {
   "sentence_id": "C70-A001-S01",
   "section": "A",
   "text": "緑町地区センターでは、二月に案内図を新しくした。",
   "start_sec": 0.0,
   "end_sec": 4.613
  },
  {
   "sentence_id": "C70-A001-S02",
   "section": "A",
   "text": "二十八人に感想を聞き、二十人が回答した。",
   "start_sec": 4.813,
   "end_sec": 9.219
  },
  {
   "sentence_id": "C70-A001-S03",
   "section": "A",
   "text": "十六人が「分かりやすい」と答えたため、林梅は初めて来る人にも役立つに違いないと思った。",
   "start_sec": 9.419,
   "end_sec": 17.216
  },
  {
   "sentence_id": "C70-A001-S04",
   "section": "A",
   "text": "しかし、初めてかどうかは聞いていなかった。",
   "start_sec": 17.416,
   "end_sec": 20.839
  },
  {
   "sentence_id": "C70-A001-S05",
   "section": "A",
   "text": "その確信の根拠になる資料は不十分だった。",
   "start_sec": 21.039,
   "end_sec": 25.892
  },
  {
   "sentence_id": "C70-A002-S01",
   "section": "A",
   "text": "野口は、回答の数字を疑うことと、判断の範囲を見直すことは違うと言った。",
   "start_sec": 26.342,
   "end_sec": 33.043
  },
  {
   "sentence_id": "C70-A002-S02",
   "section": "A",
   "text": "四人は分かりにくいと答えている。",
   "start_sec": 33.243,
   "end_sec": 36.364
  },
  {
   "sentence_id": "C70-A002-S03",
   "section": "A",
   "text": "「誰でも必ず分かる」という断定は成り立たない。",
   "start_sec": 36.564,
   "end_sec": 39.917
  },
  {
   "sentence_id": "C70-A002-S04",
   "section": "A",
   "text": "林梅はこの反例を残して報告を直した。",
   "start_sec": 40.117,
   "end_sec": 44.912
  },
  {
   "sentence_id": "C70-A002-S05",
   "section": "A",
   "text": "全ての人への効果については判断を保留し、今回確認できたことを伝えることにした。",
   "start_sec": 45.112,
   "end_sec": 52.245
  },
  {
   "sentence_id": "C70-A002-S06",
   "section": "A",
   "text": "この経験は、読書会の紹介文にも生きた。",
   "start_sec": 52.445,
   "end_sec": 56.153
  }
 ]
}
