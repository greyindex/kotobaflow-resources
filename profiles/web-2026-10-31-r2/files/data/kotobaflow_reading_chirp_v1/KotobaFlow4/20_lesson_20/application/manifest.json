{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 213.181,
 "source_chapter": 76,
 "sentence_intervals": [
  {
   "sentence_id": "C76-B001-01",
   "section": "B",
   "text": "聞き取りの要点を要約します。",
   "start_sec": 0.0,
   "end_sec": 2.47
  },
  {
   "sentence_id": "C76-B001-02",
   "section": "B",
   "text": "参加したのは、今この会場を利用している二十四人です。",
   "start_sec": 2.67,
   "end_sec": 7.799
  },
  {
   "sentence_id": "C76-B001-03",
   "section": "B",
   "text": "全員が自分の意思で参加しました。",
   "start_sec": 7.999,
   "end_sec": 10.692
  },
  {
   "sentence_id": "C76-B001-04",
   "section": "B",
   "text": "十四人は会場が変わらないことを、残る十人は費用が少ないことを優先すると回答しました。",
   "start_sec": 10.892,
   "end_sec": 18.315
  },
  {
   "sentence_id": "C76-B001-05",
   "section": "B",
   "text": "この結果は、どちらの案を支持するかを直接示していません。",
   "start_sec": 18.515,
   "end_sec": 23.676
  },
  {
   "sentence_id": "C76-B001-06",
   "section": "B",
   "text": "優先する点と、具体的な案への賛成や反対は分けて考える必要があります。",
   "start_sec": 23.876,
   "end_sec": 30.714
  },
  {
   "sentence_id": "C76-B002-01",
   "section": "B",
   "text": "二十四人の回答を読む限りでは、同じ会場を優先する人のほうが多いです。",
   "start_sec": 31.164,
   "end_sec": 37.89
  },
  {
   "sentence_id": "C76-B002-02",
   "section": "B",
   "text": "一方で、少ない費用を優先する人も十人います。",
   "start_sec": 38.09,
   "end_sec": 42.379
  },
  {
   "sentence_id": "C76-B002-03",
   "section": "B",
   "text": "多数の希望だけで結論を出すと、別の立場の人への配慮が不十分になるおそれがあります。",
   "start_sec": 42.579,
   "end_sec": 49.652
  },
  {
   "sentence_id": "C76-B002-04",
   "section": "B",
   "text": "また、利用していない人の意見は含まれていません。",
   "start_sec": 49.852,
   "end_sec": 53.806
  },
  {
   "sentence_id": "C76-B002-05",
   "section": "B",
   "text": "従って、この結果を地域の住民全体の希望として紹介することはできません。",
   "start_sec": 54.006,
   "end_sec": 60.24
  },
  {
   "sentence_id": "C76-B002-06",
   "section": "B",
   "text": "参加していない理由も、資料には示されていません。",
   "start_sec": 60.44,
   "end_sec": 64.393
  },
  {
   "sentence_id": "C76-B003-01",
   "section": "B",
   "text": "私は、資料Aの条件と費用に基づいて、B案を暫定的に選ぶことを提案します。",
   "start_sec": 64.843,
   "end_sec": 71.976
  },
  {
   "sentence_id": "C76-B003-02",
   "section": "B",
   "text": "論拠は、週二回開くことと、月三万五千円という費用です。",
   "start_sec": 72.176,
   "end_sec": 77.959
  },
  {
   "sentence_id": "C76-B003-03",
   "section": "B",
   "text": "ただし、費用が少なければ不便が全てなくなるとは限りません。",
   "start_sec": 78.159,
   "end_sec": 83.05
  },
  {
   "sentence_id": "C76-B003-04",
   "section": "B",
   "text": "条件付きの支持というのは、必要な確認が終わる前に実施を認めることではありません。",
   "start_sec": 83.25,
   "end_sec": 89.516
  },
  {
   "sentence_id": "C76-B003-05",
   "section": "B",
   "text": "提案の前提は、始める前に経路と毎月の会場を確認することです。",
   "start_sec": 89.716,
   "end_sec": 96.326
  },
  {
   "sentence_id": "C76-B003-06",
   "section": "B",
   "text": "経路が未確認の会場で始めることには同意できません。",
   "start_sec": 96.526,
   "end_sec": 100.842
  },
  {
   "sentence_id": "C76-B004-01",
   "section": "B",
   "text": "会場の変更への対策も必要です。",
   "start_sec": 101.292,
   "end_sec": 104.226
  },
  {
   "sentence_id": "C76-B004-02",
   "section": "B",
   "text": "会場の案内を用意し、変更があれば利用者に知らせる方法を、始める前に説明することを提案します。",
   "start_sec": 104.426,
   "end_sec": 112.879
  },
  {
   "sentence_id": "C76-B004-03",
   "section": "B",
   "text": "通知を出すだけでなく、利用者が確認しやすい方法かどうかも相談したいと思います。",
   "start_sec": 113.079,
   "end_sec": 119.728
  },
  {
   "sentence_id": "C76-B004-04",
   "section": "B",
   "text": "これらは今後の対応案で、実施が決定した方法ではありません。",
   "start_sec": 119.928,
   "end_sec": 125.374
  },
  {
   "sentence_id": "C76-B004-05",
   "section": "B",
   "text": "会場が変わらないA案にも利点がありますが、今は総費用と経路が未確認です。",
   "start_sec": 125.574,
   "end_sec": 131.928
  },
  {
   "sentence_id": "C76-B004-06",
   "section": "B",
   "text": "A案が必ず予算より高くなると決まったわけでもありません。",
   "start_sec": 132.128,
   "end_sec": 137.393
  },
  {
   "sentence_id": "C76-B005-01",
   "section": "B",
   "text": "三か月目の末には出席状況と利用者の負担を調べ、その結果に基づいて、その後の三か月の調整を相談します。",
   "start_sec": 137.843,
   "end_sec": 147.497
  },
  {
   "sentence_id": "C76-B005-02",
   "section": "B",
   "text": "今「B案によって参加しやすくなった」と書く根拠はありません。",
   "start_sec": 147.697,
   "end_sec": 153.03
  },
  {
   "sentence_id": "C76-B005-03",
   "section": "B",
   "text": "数字を引用する場合は、出典を「資料A」か「資料B」として示してください。",
   "start_sec": 153.23,
   "end_sec": 160.124
  },
  {
   "sentence_id": "C76-B005-04",
   "section": "B",
   "text": "「住民の十四人」ではなく、「聞き取りに参加した利用者二十四人のうち十四人」と書けば、回答の範囲が伝わります。",
   "start_sec": 160.324,
   "end_sec": 170.112
  },
  {
   "sentence_id": "C76-B005-05",
   "section": "B",
   "text": "合意した内容と留保した点を残し、判断を変えた場合には、議論の経緯も補足しましょう。",
   "start_sec": 170.312,
   "end_sec": 178.38
  },
  {
   "sentence_id": "C76-B006-01",
   "section": "B",
   "text": "利用の対象と条件を問い合わせられた場合の対応も必要です。",
   "start_sec": 178.83,
   "end_sec": 184.278
  },
  {
   "sentence_id": "C76-B006-02",
   "section": "B",
   "text": "この聞き取りは利用制度の説明ではありません。",
   "start_sec": 184.478,
   "end_sec": 188.343
  },
  {
   "sentence_id": "C76-B006-03",
   "section": "B",
   "text": "誰が制度の対象なのか、利用者になるためにどんな条件があるのかは、別に確認してから伝えましょう。",
   "start_sec": 188.543,
   "end_sec": 196.576
  },
  {
   "sentence_id": "C76-B006-04",
   "section": "B",
   "text": "回答者の範囲から、参加できる人の範囲を決めてはいけません。",
   "start_sec": 196.776,
   "end_sec": 201.689
  },
  {
   "sentence_id": "C76-B006-05",
   "section": "B",
   "text": "人数や利用時間に制限があるかどうかも、この二つの資料だけでは分かりません。",
   "start_sec": 201.889,
   "end_sec": 208.243
  },
  {
   "sentence_id": "C76-B006-06",
   "section": "B",
   "text": "分からないことを、制限がないことと混同しないでください。",
   "start_sec": 208.443,
   "end_sec": 213.175
  }
 ]
}
