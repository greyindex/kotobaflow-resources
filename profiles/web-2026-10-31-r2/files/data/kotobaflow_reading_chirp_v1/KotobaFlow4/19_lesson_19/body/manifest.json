 "duration_sec": 64.067,
 "source_chapter": 75,
 "sentence_intervals": [
  {
   "sentence_id": "C75-A001-S01",
   "section": "A",
   "text": "六月二十日、林梅とハサンは日本語の学習会で、初めて見る道具室の資料を読んだ。",
   "start_sec": 0.0,
   "end_sec": 7.656
  },
  {
   "sentence_id": "C75-A001-S02",
   "section": "A",
   "text": "二人は以前の練習資料を見ずに要約を書き、別の説明を聞いて要点を話した。",
   "start_sec": 7.856,
   "end_sec": 14.952
  },
  {
   "sentence_id": "C75-A001-S03",
   "section": "A",
   "text": "林梅は無料という言葉に気を取られ、市内に住んでいれば誰でも借りられると考えた。",
   "start_sec": 15.152,
   "end_sec": 22.691
  },
  {
   "sentence_id": "C75-A001-S04",
   "section": "A",
   "text": "そのため、年齢の条件を書かなかった。",
   "start_sec": 22.891,
   "end_sec": 26.183
  },
  {
   "sentence_id": "C75-A002-S01",
   "section": "A",
   "text": "ハサンは条件を理解したものの、最後の訂正を記録しなかった。",
   "start_sec": 26.633,
   "end_sec": 31.92
  },
  {
   "sentence_id": "C75-A002-S02",
   "section": "A",
   "text": "担当者は七月と言ったかと思うと、九月と言い直した。",
   "start_sec": 32.12,
   "end_sec": 36.621
  },
  {
   "sentence_id": "C75-A002-S03",
   "section": "A",
   "text": "二人は佐野さんと資料を比べた。",
   "start_sec": 36.821,
   "end_sec": 39.668
  },
  {
   "sentence_id": "C75-A002-S04",
   "section": "A",
   "text": "一度の結果だけで、読む力や聞く力の全部が分かるというものではない。",
   "start_sec": 39.868,
   "end_sec": 45.923
  },
  {
   "sentence_id": "C75-A003-S01",
   "section": "A",
   "text": "今回の記録を根拠に、林梅は条件と例外を確認する練習を、ハサンは訂正後の情報を記録する練習をすることにした。",
   "start_sec": 46.373,
   "end_sec": 57.286
  },
  {
   "sentence_id": "C75-A003-S02",
   "section": "A",
   "text": "次の章では別の資料を使い、結論を急がずに理解できるか検証する。",
   "start_sec": 57.486,
   "end_sec": 64.061
  }
 ]
}
