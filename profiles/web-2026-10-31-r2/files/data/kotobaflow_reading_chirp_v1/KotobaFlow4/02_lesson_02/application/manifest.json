{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 191.438,
 "source_chapter": 58,
 "sentence_intervals": [
  {
   "sentence_id": "C58-B001-S01",
   "section": "B",
   "text": "この案内は緑町図書館のものです。",
   "start_sec": 0.0,
   "end_sec": 3.473
  },
  {
   "sentence_id": "C58-B001-S02",
   "section": "B",
   "text": "十月二十五日公開、十一月一日更新。",
   "start_sec": 3.673,
   "end_sec": 8.373
  },
  {
   "sentence_id": "C58-B001-S03",
   "section": "B",
   "text": "電子書籍サービスも十一月一日開始です。",
   "start_sec": 8.573,
   "end_sec": 12.624
  },
  {
   "sentence_id": "C58-B001-S04",
   "section": "B",
   "text": "対象は登録した利用者で、住所は問いません。",
   "start_sec": 12.824,
   "end_sec": 17.557
  },
  {
   "sentence_id": "C58-B001-S05",
   "section": "B",
   "text": "他町のカードの利用は未定です。",
   "start_sec": 17.757,
   "end_sec": 20.891
  },
  {
   "sentence_id": "C58-B001-S06",
   "section": "B",
   "text": "一度に二冊まで、二週間後に自動返却します。",
   "start_sec": 21.091,
   "end_sec": 24.979
  },
  {
   "sentence_id": "C58-B001-S07",
   "section": "B",
   "text": "早い返却も可能です。",
   "start_sec": 25.179,
   "end_sec": 27.093
  },
  {
   "sentence_id": "C58-B001-S08",
   "section": "B",
   "text": "貸出中の本は予約できます。",
   "start_sec": 27.293,
   "end_sec": 29.757
  },
  {
   "sentence_id": "C58-B002-S01",
   "section": "B",
   "text": "カード番号とパスワードで認証します。",
   "start_sec": 30.207,
   "end_sec": 33.381
  },
  {
   "sentence_id": "C58-B002-S02",
   "section": "B",
   "text": "初回にパスワードを決め、五回続けて間違えると三十分ログインできません。",
   "start_sec": 33.581,
   "end_sec": 40.602
  },
  {
   "sentence_id": "C58-B002-S03",
   "section": "B",
   "text": "個人情報の漏えいを防ぐため、通信内容を暗号に変えます。",
   "start_sec": 40.802,
   "end_sec": 46.118
  },
  {
   "sentence_id": "C58-B002-S04",
   "section": "B",
   "text": "履歴は返却当日に削除しますが、保存に同意した場合は残します。",
   "start_sec": 46.318,
   "end_sec": 53.087
  },
  {
   "sentence_id": "C58-B002-S05",
   "section": "B",
   "text": "設定は変更でき、画面で履歴を見られるのは本人だけです。",
   "start_sec": 53.287,
   "end_sec": 58.763
  },
  {
   "sentence_id": "C58-B002-S06",
   "section": "B",
   "text": "許可なく他人に見せません。",
   "start_sec": 58.963,
   "end_sec": 61.116
  },
  {
   "sentence_id": "C58-B002-S07",
   "section": "B",
   "text": "秘話性を保つため、パスワードは他人に教えないでください。",
   "start_sec": 61.316,
   "end_sec": 65.925
  },
  {
   "sentence_id": "C58-B003-S01",
   "section": "B",
   "text": "音声の体験室は職員の指導のもとで利用します。",
   "start_sec": 66.375,
   "end_sec": 71.648
  },
  {
   "sentence_id": "C58-B003-S02",
   "section": "B",
   "text": "ラジカセとテープレコーダーでは、磁気で記録したテープを再生できます。",
   "start_sec": 71.848,
   "end_sec": 77.16
  },
  {
   "sentence_id": "C58-B003-S03",
   "section": "B",
   "text": "「巻き戻し」で戻り、「早送り」で先へ進みます。",
   "start_sec": 77.36,
   "end_sec": 81.396
  },
  {
   "sentence_id": "C58-B003-S04",
   "section": "B",
   "text": "テープを巻き戻す前に停止してください。",
   "start_sec": 81.596,
   "end_sec": 84.843
  },
  {
   "sentence_id": "C58-B003-S05",
   "section": "B",
   "text": "マイクで発音を録音し、イヤホンで聞いて音量を調節できます。",
   "start_sec": 85.043,
   "end_sec": 90.436
  },
  {
   "sentence_id": "C58-B003-S06",
   "section": "B",
   "text": "ステレオの音は左右から聞こえます。",
   "start_sec": 90.636,
   "end_sec": 93.988
  },
  {
   "sentence_id": "C58-B004-S01",
   "section": "B",
   "text": "デジタルの機種では、メモリーカードに保存します。",
   "start_sec": 94.438,
   "end_sec": 98.03
  },
  {
   "sentence_id": "C58-B004-S02",
   "section": "B",
   "text": "別売りのカードが必要かは説明書で確認してください。",
   "start_sec": 98.23,
   "end_sec": 102.493
  },
  {
   "sentence_id": "C58-B004-S03",
   "section": "B",
   "text": "電源キーを押し、画面にタッチすると、音声をインプットするアプリケーションが開きます。",
   "start_sec": 102.693,
   "end_sec": 109.381
  },
  {
   "sentence_id": "C58-B004-S04",
   "section": "B",
   "text": "このソフトは波の形を映し出すので、無音の部分を識別できます。",
   "start_sec": 109.581,
   "end_sec": 115.35
  },
  {
   "sentence_id": "C58-B004-S05",
   "section": "B",
   "text": "プロセッサーを交換しても、古い録音の雑音は消えません。",
   "start_sec": 115.55,
   "end_sec": 120.163
  },
  {
   "sentence_id": "C58-B005-S01",
   "section": "B",
   "text": "インターネットに繋がる端末で、図書館のマークをクリックすると試聴できます。",
   "start_sec": 120.613,
   "end_sec": 126.521
  },
  {
   "sentence_id": "C58-B005-S02",
   "section": "B",
   "text": "回線の速度は大容量のファイルの送受信に関係します。",
   "start_sec": 126.721,
   "end_sec": 131.431
  },
  {
   "sentence_id": "C58-B005-S03",
   "section": "B",
   "text": "高速化しても、音の良さを保証するわけではありません。",
   "start_sec": 131.631,
   "end_sec": 135.945
  },
  {
   "sentence_id": "C58-B005-S04",
   "section": "B",
   "text": "通信会社のサービスエリア外では接続できません。",
   "start_sec": 136.145,
   "end_sec": 140.199
  },
  {
   "sentence_id": "C58-B005-S05",
   "section": "B",
   "text": "ダウンロードの前に容量を確認し、着信音を切ってから聞いてください。",
   "start_sec": 140.399,
   "end_sec": 146.251
  },
  {
   "sentence_id": "C58-B006-S01",
   "section": "B",
   "text": "解説の画像は倍率を変えて読めます。",
   "start_sec": 146.701,
   "end_sec": 149.994
  },
  {
   "sentence_id": "C58-B006-S02",
   "section": "B",
   "text": "印刷が許可された案内はプリンターでプリントアウトできます。",
   "start_sec": 150.194,
   "end_sec": 154.845
  },
  {
   "sentence_id": "C58-B006-S03",
   "section": "B",
   "text": "ただし、本のページの転載や、画像を他人に送ることは禁止です。",
   "start_sec": 155.045,
   "end_sec": 160.794
  },
  {
   "sentence_id": "C58-B006-S04",
   "section": "B",
   "text": "引用の条件は窓口で確認してください。",
   "start_sec": 160.994,
   "end_sec": 164.613
  },
  {
   "sentence_id": "C58-B006-S05",
   "section": "B",
   "text": "著作権の保護にかかわる問題です。",
   "start_sec": 164.813,
   "end_sec": 167.597
  },
  {
   "sentence_id": "C58-B006-S06",
   "section": "B",
   "text": "出典を書くだけで自由に使えるわけではありません。",
   "start_sec": 167.797,
   "end_sec": 172.77
  },
  {
   "sentence_id": "C58-B007-S01",
   "section": "B",
   "text": "体験室では、自分の声と見本をリアルタイムで比較できます。",
   "start_sec": 173.22,
   "end_sec": 178.636
  },
  {
   "sentence_id": "C58-B007-S02",
   "section": "B",
   "text": "この分析を基礎に練習計画を作りましょう。",
   "start_sec": 178.836,
   "end_sec": 182.64
  },
  {
   "sentence_id": "C58-B007-S03",
   "section": "B",
   "text": "誤情報を見つけたら、掲載日とページを職員に伝えてください。",
   "start_sec": 182.84,
   "end_sec": 187.927
  },
  {
   "sentence_id": "C58-B007-S04",
   "section": "B",
   "text": "規約の変更はこのページで知らせます。",
   "start_sec": 188.127,
   "end_sec": 191.432
  }
 ]
}
