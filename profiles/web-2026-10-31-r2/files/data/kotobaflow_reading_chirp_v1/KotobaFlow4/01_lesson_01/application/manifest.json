{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 218.877,
 "source_chapter": 57,
 "sentence_intervals": [
  {
   "sentence_id": "C57-B001-S01",
   "section": "B",
   "text": "緑町図書館は午前九時から午後七時まで開いています。",
   "start_sec": 0.0,
   "end_sec": 5.512
  },
  {
   "sentence_id": "C57-B001-S02",
   "section": "B",
   "text": "二階に学習室とグループ室があります。",
   "start_sec": 5.712,
   "end_sec": 9.703
  },
  {
   "sentence_id": "C57-B001-S03",
   "section": "B",
   "text": "以下は本館の設備に関する案内です。",
   "start_sec": 9.903,
   "end_sec": 13.619
  },
  {
   "sentence_id": "C57-B001-S04",
   "section": "B",
   "text": "他館には適用しません。",
   "start_sec": 13.819,
   "end_sec": 15.492
  },
  {
   "sentence_id": "C57-B002-S01",
   "section": "B",
   "text": "登録の対象は、緑町に住む、町で働く、町の学校で学ぶという三条件の一つに該当する人です。",
   "start_sec": 15.942,
   "end_sec": 25.687
  },
  {
   "sentence_id": "C57-B002-S02",
   "section": "B",
   "text": "所定の申込書の全項目を記入し、住所の分かる書類を窓口へ出してください。",
   "start_sec": 25.887,
   "end_sec": 32.568
  },
  {
   "sentence_id": "C57-B002-S03",
   "section": "B",
   "text": "町外の人は町内で働く、または学ぶことの証明も必要です。",
   "start_sec": 32.768,
   "end_sec": 38.973
  },
  {
   "sentence_id": "C57-B002-S04",
   "section": "B",
   "text": "登録後に利用者番号をお知らせします。",
   "start_sec": 39.173,
   "end_sec": 42.467
  },
  {
   "sentence_id": "C57-B003-S01",
   "section": "B",
   "text": "本と雑誌は合計十冊まで、二週間借りられます。",
   "start_sec": 42.917,
   "end_sec": 47.584
  },
  {
   "sentence_id": "C57-B003-S02",
   "section": "B",
   "text": "最新号、辞書、地図、新聞は対象外です。",
   "start_sec": 47.784,
   "end_sec": 52.209
  },
  {
   "sentence_id": "C57-B003-S03",
   "section": "B",
   "text": "返却は窓口、閉館中は入口右の返却ポストをご利用ください。",
   "start_sec": 52.409,
   "end_sec": 58.751
  },
  {
   "sentence_id": "C57-B003-S04",
   "section": "B",
   "text": "期限を過ぎることを延滞と言います。",
   "start_sec": 58.951,
   "end_sec": 62.304
  },
  {
   "sentence_id": "C57-B003-S05",
   "section": "B",
   "text": "期限を過ぎた場合は、借りた物を全部返すまで、新しい貸出と予約はできません。",
   "start_sec": 62.504,
   "end_sec": 69.508
  },
  {
   "sentence_id": "C57-B003-S06",
   "section": "B",
   "text": "貸出中の本は五冊まで予約できます。",
   "start_sec": 69.708,
   "end_sec": 72.701
  },
  {
   "sentence_id": "C57-B003-S07",
   "section": "B",
   "text": "用意できたらメールで知らせます。",
   "start_sec": 72.901,
   "end_sec": 75.054
  },
  {
   "sentence_id": "C57-B003-S08",
   "section": "B",
   "text": "通知日から七日以内に受け取ってください。",
   "start_sec": 75.254,
   "end_sec": 78.248
  },
  {
   "sentence_id": "C57-B004-S01",
   "section": "B",
   "text": "学習室の特徴は静かに学べることです。",
   "start_sec": 78.698,
   "end_sec": 82.291
  },
  {
   "sentence_id": "C57-B004-S02",
   "section": "B",
   "text": "登録前でも使えますが、席は予約できません。",
   "start_sec": 82.491,
   "end_sec": 86.454
  },
  {
   "sentence_id": "C57-B004-S03",
   "section": "B",
   "text": "グループ室は予約者の登録が原則です。",
   "start_sec": 86.654,
   "end_sec": 90.247
  },
  {
   "sentence_id": "C57-B004-S04",
   "section": "B",
   "text": "同伴者の登録は不要です。",
   "start_sec": 90.447,
   "end_sec": 92.761
  },
  {
   "sentence_id": "C57-B004-S05",
   "section": "B",
   "text": "一回二時間、一人週二回まで、窓口で予約を受け付けます。",
   "start_sec": 92.961,
   "end_sec": 98.986
  },
  {
   "sentence_id": "C57-B004-S06",
   "section": "B",
   "text": "備品のパソコンは館内専用で、十冊には含みません。",
   "start_sec": 99.186,
   "end_sec": 103.919
  },
  {
   "sentence_id": "C57-B004-S07",
   "section": "B",
   "text": "検索機能は使えますが、個人情報は入力せず、使用後に窓口へ返してください。",
   "start_sec": 104.119,
   "end_sec": 111.092
  },
  {
   "sentence_id": "C57-B005-S01",
   "section": "B",
   "text": "体の事情で来館が難しい人への別の貸出方法は、窓口にご相談ください。",
   "start_sec": 111.542,
   "end_sec": 118.309
  },
  {
   "sentence_id": "C57-B005-S02",
   "section": "B",
   "text": "例外の基準や登録に関連する質問も受け付けます。",
   "start_sec": 118.509,
   "end_sec": 123.051
  },
  {
   "sentence_id": "C57-B005-S03",
   "section": "B",
   "text": "川西市での番号の利用は未定です。",
   "start_sec": 123.251,
   "end_sec": 126.424
  },
  {
   "sentence_id": "C57-B005-S04",
   "section": "B",
   "text": "決定後に入口に掲示します。",
   "start_sec": 126.624,
   "end_sec": 129.524
  },
  {
   "sentence_id": "C57-B006-S01",
   "section": "B",
   "text": "展示の地図コーナーは、地域を分類する練習です。",
   "start_sec": 129.974,
   "end_sec": 133.987
  },
  {
   "sentence_id": "C57-B006-S02",
   "section": "B",
   "text": "架空の地方「青葉地方」は、東方の学園都市と西の港町からなります。",
   "start_sec": 134.187,
   "end_sec": 140.541
  },
  {
   "sentence_id": "C57-B006-S03",
   "section": "B",
   "text": "両地域の内部を細かく分けた図もあります。",
   "start_sec": 140.741,
   "end_sec": 144.505
  },
  {
   "sentence_id": "C57-B006-S04",
   "section": "B",
   "text": "地図上の英語名と国名は創作です。",
   "start_sec": 144.705,
   "end_sec": 147.998
  },
  {
   "sentence_id": "C57-B006-S05",
   "section": "B",
   "text": "都市のシンボルである石造りの門は名園の入口に立ち、その先に山城があります。",
   "start_sec": 148.198,
   "end_sec": 156.025
  },
  {
   "sentence_id": "C57-B006-S06",
   "section": "B",
   "text": "歴史のある地を新しい副都心と混同しないでください。",
   "start_sec": 156.225,
   "end_sec": 160.973
  },
  {
   "sentence_id": "C57-B007-S01",
   "section": "B",
   "text": "模型を見ると、道路は網の目のように広がり、至る所に小さな公園があります。",
   "start_sec": 161.423,
   "end_sec": 168.457
  },
  {
   "sentence_id": "C57-B007-S02",
   "section": "B",
   "text": "超高層ビル群の頂上部と、ドームの内壁は外して見られます。",
   "start_sec": 168.657,
   "end_sec": 174.561
  },
  {
   "sentence_id": "C57-B007-S03",
   "section": "B",
   "text": "透明な層を通して、建物の構造や内部の空間を確かめてください。",
   "start_sec": 174.761,
   "end_sec": 180.514
  },
  {
   "sentence_id": "C57-B007-S04",
   "section": "B",
   "text": "主な施設には番号があります。",
   "start_sec": 180.714,
   "end_sec": 183.607
  },
  {
   "sentence_id": "C57-B007-S05",
   "section": "B",
   "text": "案内の頭文字だけを見ず、名称を読んで位置を探してください。",
   "start_sec": 183.807,
   "end_sec": 188.754
  },
  {
   "sentence_id": "C57-B007-S06",
   "section": "B",
   "text": "先端の細い部品には触れないでください。",
   "start_sec": 188.954,
   "end_sec": 192.338
  },
  {
   "sentence_id": "C57-B008-S01",
   "section": "B",
   "text": "関連図書は、学問の分野ごとに分かれています。",
   "start_sec": 192.788,
   "end_sec": 196.561
  },
  {
   "sentence_id": "C57-B008-S02",
   "section": "B",
   "text": "経済学の棚では貨幣を扱う本、科学の棚では宇宙船の仕組みを説明する本を紹介しています。",
   "start_sec": 196.761,
   "end_sec": 205.245
  },
  {
   "sentence_id": "C57-B008-S03",
   "section": "B",
   "text": "展示は読書活動の一環です。",
   "start_sec": 205.445,
   "end_sec": 208.524
  },
  {
   "sentence_id": "C57-B008-S04",
   "section": "B",
   "text": "参加者の年齢は問いません。",
   "start_sec": 208.724,
   "end_sec": 210.997
  },
  {
   "sentence_id": "C57-B008-S05",
   "section": "B",
   "text": "すでに学問のある人も、これから学問に励む人も、自分の関心に合う資料を探してください。",
   "start_sec": 211.197,
   "end_sec": 218.871
  }
 ]
}
