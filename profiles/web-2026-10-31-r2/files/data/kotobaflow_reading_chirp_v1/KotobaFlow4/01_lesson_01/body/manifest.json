{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 150.778,
 "source_chapter": 57,
 "sentence_intervals": [
  {
   "sentence_id": "C57-A001-S01",
   "section": "A",
   "text": "図書館の説明を読むときは、言葉の範囲を確かめることが基本です。",
   "start_sec": 0.0,
   "end_sec": 5.321
  },
  {
   "sentence_id": "C57-A001-S02",
   "section": "A",
   "text": "ここでは架空の緑町図書館を例にします。",
   "start_sec": 5.521,
   "end_sec": 9.331
  },
  {
   "sentence_id": "C57-A001-S03",
   "section": "A",
   "text": "「利用者とは、登録した人のことである」という定義は、登録を前提とします。",
   "start_sec": 9.531,
   "end_sec": 15.524
  },
  {
   "sentence_id": "C57-A001-S04",
   "section": "A",
   "text": "登録できる人と登録が済んだ人は区別します。",
   "start_sec": 15.724,
   "end_sec": 20.277
  },
  {
   "sentence_id": "C57-A001-S05",
   "section": "A",
   "text": "ただし、登録前でも館内で本を読めます。",
   "start_sec": 20.477,
   "end_sec": 24.436
  },
  {
   "sentence_id": "C57-A002-S01",
   "section": "A",
   "text": "貸出とは、本などを借りて館外で使うことです。",
   "start_sec": 24.886,
   "end_sec": 29.281
  },
  {
   "sentence_id": "C57-A002-S02",
   "section": "A",
   "text": "本の貸出期間は二週間です。",
   "start_sec": 29.481,
   "end_sec": 32.572
  },
  {
   "sentence_id": "C57-A002-S03",
   "section": "A",
   "text": "辞書や雑誌の最新号は、貸出の対象から除きます。",
   "start_sec": 32.772,
   "end_sec": 37.476
  },
  {
   "sentence_id": "C57-A002-S04",
   "section": "A",
   "text": "部屋の予約というのは、使用日時を先に決めることです。",
   "start_sec": 37.676,
   "end_sec": 41.963
  },
  {
   "sentence_id": "C57-A002-S05",
   "section": "A",
   "text": "本の予約は順番を取ることです。",
   "start_sec": 42.163,
   "end_sec": 45.037
  },
  {
   "sentence_id": "C57-A002-S06",
   "section": "A",
   "text": "先に申し込む点は共通でも、内容は異なります。",
   "start_sec": 45.237,
   "end_sec": 49.612
  },
  {
   "sentence_id": "C57-A002-S07",
   "section": "A",
   "text": "名称だけで判断せず、具体的な条件も読みましょう。",
   "start_sec": 49.812,
   "end_sec": 54.321
  },
  {
   "sentence_id": "C57-A003-S01",
   "section": "A",
   "text": "今月、館内では「言葉と世界」という展示をしています。",
   "start_sec": 54.771,
   "end_sec": 59.744
  },
  {
   "sentence_id": "C57-A003-S02",
   "section": "A",
   "text": "言葉の働きを調べるセクションでは、動詞は動作などを表す語、代名詞は名前の代わりに人や物を指す語として紹介しています。",
   "start_sec": 59.944,
   "end_sec": 71.158
  },
  {
   "sentence_id": "C57-A003-S03",
   "section": "A",
   "text": "形容詞は性質などを表し、副詞は動作や状態を詳しくします。",
   "start_sec": 71.358,
   "end_sec": 77.891
  },
  {
   "sentence_id": "C57-A003-S04",
   "section": "A",
   "text": "助動詞はほかの語に付いて意味を加えます。",
   "start_sec": 78.091,
   "end_sec": 82.071
  },
  {
   "sentence_id": "C57-A003-S05",
   "section": "A",
   "text": "動詞は語を分ける類の一つです。",
   "start_sec": 82.271,
   "end_sec": 85.308
  },
  {
   "sentence_id": "C57-A003-S06",
   "section": "A",
   "text": "それぞれの類に属する語が、文を成す要素になります。",
   "start_sec": 85.508,
   "end_sec": 89.965
  },
  {
   "sentence_id": "C57-A004-S01",
   "section": "A",
   "text": "隣には、声を写す擬声語と、様子を表す擬態語の説明があります。",
   "start_sec": 90.415,
   "end_sec": 96.442
  },
  {
   "sentence_id": "C57-A004-S02",
   "section": "A",
   "text": "「わんわん」と「きらきら」が代表的な例です。",
   "start_sec": 96.642,
   "end_sec": 100.093
  },
  {
   "sentence_id": "C57-A004-S03",
   "section": "A",
   "text": "文字の表記と発音は同じではありません。",
   "start_sec": 100.293,
   "end_sec": 103.587
  },
  {
   "sentence_id": "C57-A004-S04",
   "section": "A",
   "text": "同音の語でも意味は違います。",
   "start_sec": 103.787,
   "end_sec": 106.66
  },
  {
   "sentence_id": "C57-A004-S05",
   "section": "A",
   "text": "音数を数える表は「拍」を単位とし、音節とは区別しています。",
   "start_sec": 106.86,
   "end_sec": 112.784
  },
  {
   "sentence_id": "C57-A004-S06",
   "section": "A",
   "text": "言語の体系そのものを全部教える展示ではありません。",
   "start_sec": 112.984,
   "end_sec": 117.838
  },
  {
   "sentence_id": "C57-A005-S01",
   "section": "A",
   "text": "説明というものは、読み手の知識と切り離せません。",
   "start_sec": 118.288,
   "end_sec": 122.185
  },
  {
   "sentence_id": "C57-A005-S02",
   "section": "A",
   "text": "専門用語だけでは伝わりにくいので、書き手は一般の人向けの言葉も使います。",
   "start_sec": 122.385,
   "end_sec": 128.678
  },
  {
   "sentence_id": "C57-A005-S03",
   "section": "A",
   "text": "これは単なる言い換えではなく、物事の関係を考える課題です。",
   "start_sec": 128.878,
   "end_sec": 133.827
  },
  {
   "sentence_id": "C57-A005-S04",
   "section": "A",
   "text": "説明は、いわば知識への入口のようなものです。",
   "start_sec": 134.027,
   "end_sec": 138.403
  },
  {
   "sentence_id": "C57-A005-S05",
   "section": "A",
   "text": "抽象的な概念にも身近な例を添えると、理解を助けます。",
   "start_sec": 138.603,
   "end_sec": 144.208
  },
  {
   "sentence_id": "C57-A005-S06",
   "section": "A",
   "text": "人間は、知らない言葉を身近な経験と結び付けて理解することもあります。",
   "start_sec": 144.408,
   "end_sec": 150.772
  }
 ]
}
