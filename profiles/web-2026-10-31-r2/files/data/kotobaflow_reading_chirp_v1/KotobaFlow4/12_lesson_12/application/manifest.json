{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 181.706,
 "source_chapter": 68,
 "sentence_intervals": [
  {
   "sentence_id": "C68-B001-S01",
   "section": "B",
   "text": "申請は一月十二日から二月十日午後五時まで、窓口でできます。",
   "start_sec": 0.0,
   "end_sec": 6.353
  },
  {
   "sentence_id": "C68-B001-S02",
   "section": "B",
   "text": "書類を郵便で送ったり、オンラインで申請したりすることはできません。",
   "start_sec": 6.553,
   "end_sec": 11.8
  },
  {
   "sentence_id": "C68-B001-S03",
   "section": "B",
   "text": "初めて申請する団体は、一月二十九日までに事前相談をしてください。",
   "start_sec": 12.0,
   "end_sec": 18.38
  },
  {
   "sentence_id": "C68-B001-S04",
   "section": "B",
   "text": "相談には団体の代表である本人、または委任状を持った会員が来てください。",
   "start_sec": 18.58,
   "end_sec": 25.293
  },
  {
   "sentence_id": "C68-B001-S05",
   "section": "B",
   "text": "十四日の印刷機の停止による期限の変更はありません。",
   "start_sec": 25.493,
   "end_sec": 30.8
  },
  {
   "sentence_id": "C68-B001-S06",
   "section": "B",
   "text": "準備で困っている場合は、担当者に相談してください。",
   "start_sec": 31.0,
   "end_sec": 35.51
  },
  {
   "sentence_id": "C68-B002-S01",
   "section": "B",
   "text": "支援金は、対象の費用と参加費の収入の差の半分を基本とし、上限を超える場合は上限までとします。",
   "start_sec": 35.96,
   "end_sec": 45.013
  },
  {
   "sentence_id": "C68-B002-S02",
   "section": "B",
   "text": "平均参加人数に応じて上限が変わります。",
   "start_sec": 45.213,
   "end_sec": 49.07
  },
  {
   "sentence_id": "C68-B002-S03",
   "section": "B",
   "text": "十人より少ない場合は二万円、十人以上の場合は四万円です。",
   "start_sec": 49.27,
   "end_sec": 55.987
  },
  {
   "sentence_id": "C68-B002-S04",
   "section": "B",
   "text": "上限の金額を必ず受け取れるわけではありません。",
   "start_sec": 56.187,
   "end_sec": 60.446
  },
  {
   "sentence_id": "C68-B002-S05",
   "section": "B",
   "text": "予算は合計六十万円で、申請書類を審査します。",
   "start_sec": 60.646,
   "end_sec": 65.708
  },
  {
   "sentence_id": "C68-B002-S06",
   "section": "B",
   "text": "審査の点数が同じ場合は抽選で決めます。",
   "start_sec": 65.908,
   "end_sec": 69.793
  },
  {
   "sentence_id": "C68-B002-S07",
   "section": "B",
   "text": "結果は三月中旬までに書類で通知します。",
   "start_sec": 69.993,
   "end_sec": 73.586
  },
  {
   "sentence_id": "C68-B003-S01",
   "section": "B",
   "text": "飲食費は原則として対象外です。",
   "start_sec": 74.036,
   "end_sec": 77.087
  },
  {
   "sentence_id": "C68-B003-S02",
   "section": "B",
   "text": "例外もあります。",
   "start_sec": 77.287,
   "end_sec": 78.555
  },
  {
   "sentence_id": "C68-B003-S03",
   "section": "B",
   "text": "料理をする活動の食材費は対象になります。",
   "start_sec": 78.755,
   "end_sec": 82.601
  },
  {
   "sentence_id": "C68-B003-S04",
   "section": "B",
   "text": "休憩中のお茶やお菓子は、この例外に入りません。",
   "start_sec": 82.801,
   "end_sec": 86.934
  },
  {
   "sentence_id": "C68-B003-S05",
   "section": "B",
   "text": "申請の資格や費用の範囲は、制度の説明で確認してください。",
   "start_sec": 87.134,
   "end_sec": 92.482
  },
  {
   "sentence_id": "C68-B003-S06",
   "section": "B",
   "text": "印刷機は復旧していますが、それによって制度の条件が変わったわけではありません。",
   "start_sec": 92.682,
   "end_sec": 99.275
  },
  {
   "sentence_id": "C68-B004-S01",
   "section": "B",
   "text": "ここからは、利用者の西田明子さんの投稿です。",
   "start_sec": 99.725,
   "end_sec": 104.195
  },
  {
   "sentence_id": "C68-B004-S02",
   "section": "B",
   "text": "「十四日、私は書類を印刷するためにセンターへ行った。",
   "start_sec": 104.395,
   "end_sec": 109.309
  },
  {
   "sentence_id": "C68-B004-S03",
   "section": "B",
   "text": "申込書を受け取れたものの、その日は時間がなく、申請はしなかった。",
   "start_sec": 109.509,
   "end_sec": 115.419
  },
  {
   "sentence_id": "C68-B004-S04",
   "section": "B",
   "text": "担当者の配慮で助かったが、仕事のある日にもう一度出かけるのは、私にとって負担である。",
   "start_sec": 115.619,
   "end_sec": 122.692
  },
  {
   "sentence_id": "C68-B004-S05",
   "section": "B",
   "text": "窓口が開いていたという訂正は必要だ。",
   "start_sec": 122.892,
   "end_sec": 126.167
  },
  {
   "sentence_id": "C68-B004-S06",
   "section": "B",
   "text": "それでも、困った利用者がいなかったわけではない。",
   "start_sec": 126.367,
   "end_sec": 130.533
  },
  {
   "sentence_id": "C68-B005-S01",
   "section": "B",
   "text": "直接会って相談すると説明を聞きやすい反面、行く時間を調整する必要がある。",
   "start_sec": 130.983,
   "end_sec": 137.89
  },
  {
   "sentence_id": "C68-B005-S02",
   "section": "B",
   "text": "私は利用者として、申請方法の追加を提案したい。",
   "start_sec": 138.09,
   "end_sec": 142.58
  },
  {
   "sentence_id": "C68-B005-S03",
   "section": "B",
   "text": "公平な制度にするには、来られない人の事情も考えるべきだと思う。",
   "start_sec": 142.78,
   "end_sec": 147.933
  },
  {
   "sentence_id": "C68-B005-S04",
   "section": "B",
   "text": "オンラインなら問題が全部解決する、と主張しているわけではない。",
   "start_sec": 148.133,
   "end_sec": 153.089
  },
  {
   "sentence_id": "C68-B005-S05",
   "section": "B",
   "text": "画面での操作に不安がある人にも、相談できる窓口が必要だ。",
   "start_sec": 153.289,
   "end_sec": 159.079
  },
  {
   "sentence_id": "C68-B005-S06",
   "section": "B",
   "text": "快適に使える方法は、人によって違う。",
   "start_sec": 159.279,
   "end_sec": 162.752
  },
  {
   "sentence_id": "C68-B006-S01",
   "section": "B",
   "text": "方法が増えると担当者の仕事も増えるだろう。",
   "start_sec": 163.202,
   "end_sec": 166.976
  },
  {
   "sentence_id": "C68-B006-S02",
   "section": "B",
   "text": "その負担への対応も話し合う必要がある。",
   "start_sec": 167.176,
   "end_sec": 171.035
  },
  {
   "sentence_id": "C68-B006-S03",
   "section": "B",
   "text": "意見が対立している点も確認してから、改善を進めるべきだ。",
   "start_sec": 171.235,
   "end_sec": 176.346
  },
  {
   "sentence_id": "C68-B006-S04",
   "section": "B",
   "text": "これは私個人の考えであり、利用者全員の意見ではない。」",
   "start_sec": 176.546,
   "end_sec": 181.699
  }
 ]
}
