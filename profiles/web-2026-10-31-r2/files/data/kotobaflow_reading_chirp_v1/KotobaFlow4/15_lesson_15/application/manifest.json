{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 247.153,
 "source_chapter": 71,
 "sentence_intervals": [
  {
   "sentence_id": "C71-B001-S01",
   "section": "B",
   "text": "青木さん、先日はありがとうございました。",
   "start_sec": 0.0,
   "end_sec": 2.993
  },
  {
   "sentence_id": "C71-B001-S02",
   "section": "B",
   "text": "写真に関する数々のお話に感動しました。",
   "start_sec": 3.193,
   "end_sec": 7.207
  },
  {
   "sentence_id": "C71-B001-S03",
   "section": "B",
   "text": "店の許可が出たので、三月七日にカフェで小さい展示ができます。",
   "start_sec": 7.407,
   "end_sec": 12.56
  },
  {
   "sentence_id": "C71-B001-S04",
   "section": "B",
   "text": "候補六枚のうち、人が写っている二枚は本人の返事を待っています。",
   "start_sec": 12.76,
   "end_sec": 19.569
  },
  {
   "sentence_id": "C71-B001-S05",
   "section": "B",
   "text": "許可を確認できない写真は使いません。",
   "start_sec": 19.769,
   "end_sec": 22.763
  },
  {
   "sentence_id": "C71-B001-S06",
   "section": "B",
   "text": "お父様の店の写真には、青木さんのお話を整理した以下の文章を添える案を考えました。",
   "start_sec": 22.963,
   "end_sec": 29.736
  },
  {
   "sentence_id": "C71-B001-S07",
   "section": "B",
   "text": "本文と見出しも確認していただいてから印刷します。",
   "start_sec": 29.936,
   "end_sec": 33.756
  },
  {
   "sentence_id": "C71-B002-S01",
   "section": "B",
   "text": "「父は少年時代を故郷の港町で過ごした。",
   "start_sec": 34.206,
   "end_sec": 38.316
  },
  {
   "sentence_id": "C71-B002-S02",
   "section": "B",
   "text": "物心がついた時分には、祖父の店が遊び場だったという。",
   "start_sec": 38.516,
   "end_sec": 43.399
  },
  {
   "sentence_id": "C71-B002-S03",
   "section": "B",
   "text": "私が小さかったころは、父が肩車をして町の名物の時計を見せてくれた。",
   "start_sec": 43.599,
   "end_sec": 50.252
  },
  {
   "sentence_id": "C71-B002-S04",
   "section": "B",
   "text": "父は祖父の跡を継いだ商人だったが、家業を守ることだけが商売の目的ではなかった。",
   "start_sec": 50.452,
   "end_sec": 58.476
  },
  {
   "sentence_id": "C71-B002-S05",
   "section": "B",
   "text": "お馴染みのお客さんと語り合い、困っている人には代金を待つこともあった。",
   "start_sec": 58.676,
   "end_sec": 64.849
  },
  {
   "sentence_id": "C71-B002-S06",
   "section": "B",
   "text": "家族を養うために稼ぐ必要があるのに、なんと心が広いのだろうと、私は感心した。",
   "start_sec": 65.049,
   "end_sec": 72.377
  },
  {
   "sentence_id": "C71-B002-S07",
   "section": "B",
   "text": "父は出世よりも、人と知り合うことを喜んだ。",
   "start_sec": 72.577,
   "end_sec": 76.17
  },
  {
   "sentence_id": "C71-B003-S01",
   "section": "B",
   "text": "客が減り、店が落ち目だった時期もある。",
   "start_sec": 76.62,
   "end_sec": 80.057
  },
  {
   "sentence_id": "C71-B003-S02",
   "section": "B",
   "text": "新しい売り方を試しても空回りが続き、父は自信をなくした。",
   "start_sec": 80.257,
   "end_sec": 85.877
  },
  {
   "sentence_id": "C71-B003-S03",
   "section": "B",
   "text": "それでも、店にやってくる子どもたちに昔話を語る時は、嬉しそうだった。",
   "start_sec": 86.077,
   "end_sec": 92.31
  },
  {
   "sentence_id": "C71-B003-S04",
   "section": "B",
   "text": "故郷をこよなく愛する父にとって、店は生き甲斐だったのだ。",
   "start_sec": 92.51,
   "end_sec": 97.384
  },
  {
   "sentence_id": "C71-B003-S05",
   "section": "B",
   "text": "いつまでも続くと思っていた店は、父の病気で閉まった。",
   "start_sec": 97.584,
   "end_sec": 102.083
  },
  {
   "sentence_id": "C71-B003-S06",
   "section": "B",
   "text": "別れの日、お客さんと父は閉店を悲しみ合った。",
   "start_sec": 102.283,
   "end_sec": 106.816
  },
  {
   "sentence_id": "C71-B003-S07",
   "section": "B",
   "text": "すすり泣く声も聞こえた。",
   "start_sec": 107.016,
   "end_sec": 109.049
  },
  {
   "sentence_id": "C71-B003-S08",
   "section": "B",
   "text": "父がどんなに町の人に支えられたか、その時に分かった。",
   "start_sec": 109.249,
   "end_sec": 113.948
  },
  {
   "sentence_id": "C71-B004-S01",
   "section": "B",
   "text": "店を失った苦難を、私はすぐ美談にはできなかった。",
   "start_sec": 114.398,
   "end_sec": 119.52
  },
  {
   "sentence_id": "C71-B004-S02",
   "section": "B",
   "text": "父も『失敗は恥だ』と嘆いたことがある。",
   "start_sec": 119.72,
   "end_sec": 123.674
  },
  {
   "sentence_id": "C71-B004-S03",
   "section": "B",
   "text": "人を憎む気持ちはないと言ったが、その嘆きは一度の会話では消えなかった。",
   "start_sec": 123.874,
   "end_sec": 130.063
  },
  {
   "sentence_id": "C71-B004-S04",
   "section": "B",
   "text": "幸いなことに、今は穏やかな生活を送っている。",
   "start_sec": 130.263,
   "end_sec": 134.656
  },
  {
   "sentence_id": "C71-B004-S05",
   "section": "B",
   "text": "先日、店の写真を見せると、父は懐かしがって涙ぐんだ。",
   "start_sec": 134.856,
   "end_sec": 140.009
  },
  {
   "sentence_id": "C71-B004-S06",
   "section": "B",
   "text": "私は父を駅まで送り、ホームで別れる時に振り返った。",
   "start_sec": 140.209,
   "end_sec": 145.418
  },
  {
   "sentence_id": "C71-B004-S07",
   "section": "B",
   "text": "手を振る父の姿を一生忘れないと思う。",
   "start_sec": 145.618,
   "end_sec": 149.091
  },
  {
   "sentence_id": "C71-B004-S08",
   "section": "B",
   "text": "店はなくても、父と話せる喜びは残る。」",
   "start_sec": 149.291,
   "end_sec": 152.764
  },
  {
   "sentence_id": "C71-B005-S01",
   "section": "B",
   "text": "林さん、原稿をありがとうございます。",
   "start_sec": 153.214,
   "end_sec": 155.967
  },
  {
   "sentence_id": "C71-B005-S02",
   "section": "B",
   "text": "店の話を自分の言葉で読み直すと、万感が胸に迫ります。",
   "start_sec": 156.167,
   "end_sec": 162.093
  },
  {
   "sentence_id": "C71-B005-S03",
   "section": "B",
   "text": "友人との再会を喜び合う一方で、戻れない時間が切ないのです。",
   "start_sec": 162.293,
   "end_sec": 168.44
  },
  {
   "sentence_id": "C71-B005-S04",
   "section": "B",
   "text": "こうした感情に自分でも戸惑います。",
   "start_sec": 168.64,
   "end_sec": 172.146
  },
  {
   "sentence_id": "C71-B005-S05",
   "section": "B",
   "text": "説明を成功の教訓にまとめると、かえって空しいと感じます。",
   "start_sec": 172.346,
   "end_sec": 177.33
  },
  {
   "sentence_id": "C71-B005-S06",
   "section": "B",
   "text": "父は失敗も経験した人です。",
   "start_sec": 177.53,
   "end_sec": 180.404
  },
  {
   "sentence_id": "C71-B005-S07",
   "section": "B",
   "text": "「最高の人生だった」と私が代わりに決めることはできません。",
   "start_sec": 180.604,
   "end_sec": 185.085
  },
  {
   "sentence_id": "C71-B005-S08",
   "section": "B",
   "text": "ただ、人を待つ姿勢には感銘を受けました。",
   "start_sec": 185.285,
   "end_sec": 188.782
  },
  {
   "sentence_id": "C71-B005-S09",
   "section": "B",
   "text": "商売の規模を誇ることより、相手の話を聞く心の余裕を大事にしたいです。",
   "start_sec": 188.982,
   "end_sec": 195.156
  },
  {
   "sentence_id": "C71-B006-S01",
   "section": "B",
   "text": "暗い写真については、次の週も美咲と撮影したことを書いてください。",
   "start_sec": 195.606,
   "end_sec": 201.279
  },
  {
   "sentence_id": "C71-B006-S02",
   "section": "B",
   "text": "「もう二度と撮るものか」は、つくづく強がりでした。",
   "start_sec": 201.479,
   "end_sec": 205.063
  },
  {
   "sentence_id": "C71-B006-S03",
   "section": "B",
   "text": "美咲が待ってくれて、どれほど心強かったことか。",
   "start_sec": 205.263,
   "end_sec": 209.216
  },
  {
   "sentence_id": "C71-B006-S04",
   "section": "B",
   "text": "美咲が呆れていたのか、皮肉を言っていたのかは、覚えていません。",
   "start_sec": 209.416,
   "end_sec": 214.75
  },
  {
   "sentence_id": "C71-B006-S05",
   "section": "B",
   "text": "声の印象は書かないでください。",
   "start_sec": 214.95,
   "end_sec": 217.643
  },
  {
   "sentence_id": "C71-B006-S06",
   "section": "B",
   "text": "写真の外の経験が私の人生観の形成に関わった、という説明なら納得できます。",
   "start_sec": 217.843,
   "end_sec": 225.431
  },
  {
   "sentence_id": "C71-B006-S07",
   "section": "B",
   "text": "一緒に過ごす時間こそ学びの実りだったのかもしれません。",
   "start_sec": 225.631,
   "end_sec": 230.005
  },
  {
   "sentence_id": "C71-B006-S08",
   "section": "B",
   "text": "写真を見て、いろいろな感慨が浮かびました。",
   "start_sec": 230.205,
   "end_sec": 234.125
  },
  {
   "sentence_id": "C71-B006-S09",
   "section": "B",
   "text": "父があのころ、どんなに不安だったことだろうと思うと、軽い言葉ではまとめられません。",
   "start_sec": 234.325,
   "end_sec": 240.499
  },
  {
   "sentence_id": "C71-B006-S10",
   "section": "B",
   "text": "一人ではなく、友達と確かめながら原稿を作ってくださるのは、有難いことです。",
   "start_sec": 240.699,
   "end_sec": 247.147
  }
 ]
}
