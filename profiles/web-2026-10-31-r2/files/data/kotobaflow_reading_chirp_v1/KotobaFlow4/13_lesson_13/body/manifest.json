{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 104.19,
 "source_chapter": 69,
 "sentence_intervals": [
  {
   "sentence_id": "C69-A001-S01",
   "section": "A",
   "text": "緑町のパン店「こむぎ」は、二月一日から七日まで、箱を無料で貸す方法を試した。",
   "start_sec": 0.0,
   "end_sec": 7.376
  },
  {
   "sentence_id": "C69-A001-S02",
   "section": "A",
   "text": "佐藤と岸は、袋を減らす方法を一か月検討した末に、この方法を選んだ。",
   "start_sec": 7.576,
   "end_sec": 14.879
  },
  {
   "sentence_id": "C69-A001-S03",
   "section": "A",
   "text": "貸した五十個のうち四十個の返却を目標にしたが、戻ったのは三十八個だった。",
   "start_sec": 15.079,
   "end_sec": 21.706
  },
  {
   "sentence_id": "C69-A002-S01",
   "section": "A",
   "text": "二人は箱に説明を印刷する予定だった。",
   "start_sec": 22.156,
   "end_sec": 26.179
  },
  {
   "sentence_id": "C69-A002-S02",
   "section": "A",
   "text": "しかし、何度も相談したあげく、注文が間に合わなくなり、説明を書いた紙を入れた。",
   "start_sec": 26.379,
   "end_sec": 34.05
  },
  {
   "sentence_id": "C69-A002-S03",
   "section": "A",
   "text": "紙の期限は二月七日、最初の日のポスターは当日中だった。",
   "start_sec": 34.25,
   "end_sec": 39.359
  },
  {
   "sentence_id": "C69-A002-S04",
   "section": "A",
   "text": "ポスターは二日に直した。",
   "start_sec": 39.559,
   "end_sec": 41.544
  },
  {
   "sentence_id": "C69-A003-S01",
   "section": "A",
   "text": "岸は「急いだばかりに失敗した」と反省した。",
   "start_sec": 41.994,
   "end_sec": 45.727
  },
  {
   "sentence_id": "C69-A003-S02",
   "section": "A",
   "text": "六人が期限を質問したことから、説明が分かりにくかった可能性はある。",
   "start_sec": 45.927,
   "end_sec": 51.774
  },
  {
   "sentence_id": "C69-A003-S03",
   "section": "A",
   "text": "しかし、六人の箱が戻ったかどうかは不明で、結果を一つの原因で説明するのは早い。",
   "start_sec": 51.974,
   "end_sec": 59.228
  },
  {
   "sentence_id": "C69-A004-S01",
   "section": "A",
   "text": "店員は毎晩、箱を洗う努力を続けた。",
   "start_sec": 59.678,
   "end_sec": 63.151
  },
  {
   "sentence_id": "C69-A004-S02",
   "section": "A",
   "text": "苦労しても目標を達成できなかったが、作業に必要な時間が分かったので、全部無駄だったわけではない。",
   "start_sec": 63.351,
   "end_sec": 71.024
  },
  {
   "sentence_id": "C69-A004-S03",
   "section": "A",
   "text": "二人は失敗を悔やむだけでなく、記録に基づいて方法を変える決心をした。",
   "start_sec": 71.224,
   "end_sec": 77.758
  },
  {
   "sentence_id": "C69-A004-S04",
   "section": "A",
   "text": "試行錯誤は続く。",
   "start_sec": 77.958,
   "end_sec": 79.766
  },
  {
   "sentence_id": "C69-A004-S05",
   "section": "A",
   "text": "この経験の結末はまだ決まっていない。",
   "start_sec": 79.966,
   "end_sec": 83.14
  },
  {
   "sentence_id": "C69-A005-S01",
   "section": "A",
   "text": "岸は比較のため、知人の農園が前年に書いた記録も持ってきた。",
   "start_sec": 83.59,
   "end_sec": 89.217
  },
  {
   "sentence_id": "C69-A005-S02",
   "section": "A",
   "text": "花が咲く畑で草を抜けば収穫が増えると思ったのに、そう簡単ではなかったという。",
   "start_sec": 89.417,
   "end_sec": 96.19
  },
  {
   "sentence_id": "C69-A005-S03",
   "section": "A",
   "text": "店と農園では条件が違うが、一つの作業だけで結果を説明できない点は共通していた。",
   "start_sec": 96.39,
   "end_sec": 104.184
  }
 ]
}
