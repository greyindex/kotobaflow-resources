{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 146.223,
 "source_chapter": 66,
 "sentence_intervals": [
  {
   "sentence_id": "C66-A101-S01",
   "section": "A",
   "text": "緑町地区センターは、公的な支援と民間の相談員をつなぐ窓口を開設した。",
   "start_sec": 0.0,
   "end_sec": 6.744
  },
  {
   "sentence_id": "C66-A101-S02",
   "section": "A",
   "text": "市の直営だが、学校や農協とも連携する。",
   "start_sec": 6.944,
   "end_sec": 10.915
  },
  {
   "sentence_id": "C66-A101-S03",
   "section": "A",
   "text": "相談は成人だけでなく未成年者にも開放し、私的な悩みを勝手に家族へ伝えない。",
   "start_sec": 11.115,
   "end_sec": 18.669
  },
  {
   "sentence_id": "C66-A101-S04",
   "section": "A",
   "text": "未婚者か既婚者かで相談の順番を変えることもない。",
   "start_sec": 18.869,
   "end_sec": 23.473
  },
  {
   "sentence_id": "C66-A101-S05",
   "section": "A",
   "text": "制度的な条件を確かめ、適切な担当へつなぐのが役目だ。",
   "start_sec": 23.673,
   "end_sec": 28.932
  },
  {
   "sentence_id": "C66-A102-S01",
   "section": "A",
   "text": "最初の相談は進学だった。",
   "start_sec": 29.382,
   "end_sec": 31.836
  },
  {
   "sentence_id": "C66-A102-S02",
   "section": "A",
   "text": "「しりつ」と聞いたが、市立か私立かわからず、費用の違いを尋ねた。",
   "start_sec": 32.036,
   "end_sec": 37.909
  },
  {
   "sentence_id": "C66-A102-S03",
   "section": "A",
   "text": "担当者は二校の案内を開き、授業料と入学時の費用を別々に比べた。",
   "start_sec": 38.109,
   "end_sec": 44.522
  },
  {
   "sentence_id": "C66-A102-S04",
   "section": "A",
   "text": "市立だから何でも安いとは言えない。",
   "start_sec": 44.722,
   "end_sec": 47.895
  },
  {
   "sentence_id": "C66-A102-S05",
   "section": "A",
   "text": "短大の別科と予備校では目的も違う。",
   "start_sec": 48.096,
   "end_sec": 51.569
  },
  {
   "sentence_id": "C66-A102-S06",
   "section": "A",
   "text": "浪人中の人には、進学率だけで学校を選ばず、何を学んでどんな仕事に就くか考えるよう勧めた。",
   "start_sec": 51.769,
   "end_sec": 60.752
  },
  {
   "sentence_id": "C66-A102-S07",
   "section": "A",
   "text": "高学歴なら安心とは限らない。",
   "start_sec": 60.952,
   "end_sec": 64.005
  },
  {
   "sentence_id": "C66-A102-S08",
   "section": "A",
   "text": "登校拒否で悩む家庭には、まだ退学を決めていない子の希望を先に聞こうと話した。",
   "start_sec": 64.205,
   "end_sec": 71.159
  },
  {
   "sentence_id": "C66-A103-S01",
   "section": "A",
   "text": "次は初月給を受け取った若者だった。",
   "start_sec": 71.609,
   "end_sec": 75.424
  },
  {
   "sentence_id": "C66-A103-S02",
   "section": "A",
   "text": "初めての月給日で、手取りが契約の給与より少ないことに気づいた。",
   "start_sec": 75.624,
   "end_sec": 80.869
  },
  {
   "sentence_id": "C66-A103-S03",
   "section": "A",
   "text": "明細には税金と保険料の天引きがあった。",
   "start_sec": 81.069,
   "end_sec": 84.982
  },
  {
   "sentence_id": "C66-A103-S04",
   "section": "A",
   "text": "ボーナスを含む年収と、毎月使える金額も別だ。",
   "start_sec": 85.182,
   "end_sec": 89.756
  },
  {
   "sentence_id": "C66-A103-S05",
   "section": "A",
   "text": "簿記を習った相談員は、会社への問い合わせ用に数字を整理した。",
   "start_sec": 89.956,
   "end_sec": 95.179
  },
  {
   "sentence_id": "C66-A103-S06",
   "section": "A",
   "text": "伝票だけでは引かれた理由がわからず、確認が必要な項目も残った。",
   "start_sec": 95.379,
   "end_sec": 101.195
  },
  {
   "sentence_id": "C66-A104-S01",
   "section": "A",
   "text": "午後は仕事と住まいの相談が続いた。",
   "start_sec": 101.645,
   "end_sec": 104.818
  },
  {
   "sentence_id": "C66-A104-S02",
   "section": "A",
   "text": "定年退職と、会社の人減らしによる失業では、次の仕事の探し方も違う。",
   "start_sec": 105.018,
   "end_sec": 111.405
  },
  {
   "sentence_id": "C66-A104-S03",
   "section": "A",
   "text": "配置転換で社宅を出る平社員には、配偶者の収入を含む世帯の予算を確認した。",
   "start_sec": 111.605,
   "end_sec": 119.34
  },
  {
   "sentence_id": "C66-A104-S04",
   "section": "A",
   "text": "保証人を頼む前に、負担の範囲を説明する必要がある。",
   "start_sec": 119.54,
   "end_sec": 124.394
  },
  {
   "sentence_id": "C66-A105-S01",
   "section": "A",
   "text": "店を始めたい人には、加盟店になる契約の加盟料を調べてもらった。",
   "start_sec": 124.844,
   "end_sec": 130.694
  },
  {
   "sentence_id": "C66-A105-S02",
   "section": "A",
   "text": "金融機関から借りるなら、金利も確認しなければならない。",
   "start_sec": 130.894,
   "end_sec": 135.627
  },
  {
   "sentence_id": "C66-A105-S03",
   "section": "A",
   "text": "契約するからには、収入の予想だけでなく費用も読む。",
   "start_sec": 135.827,
   "end_sec": 140.322
  },
  {
   "sentence_id": "C66-A105-S04",
   "section": "A",
   "text": "窓口は本人に代わって決定せず、事情に応じた選択を支える。",
   "start_sec": 140.522,
   "end_sec": 146.216
  }
 ]
}
