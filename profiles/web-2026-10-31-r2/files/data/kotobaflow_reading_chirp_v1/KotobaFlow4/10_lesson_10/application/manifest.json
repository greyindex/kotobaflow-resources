{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 171.132,
 "source_chapter": 66,
 "sentence_intervals": [
  {
   "sentence_id": "C66-B001-S01",
   "section": "B",
   "text": "これは授業用の架空の制度です。",
   "start_sec": 0.0,
   "end_sec": 3.329
  },
  {
   "sentence_id": "C66-B001-S02",
   "section": "B",
   "text": "申請資格があるのは会員五人以上で、申請時に三か月以上活動している団体。",
   "start_sec": 3.529,
   "end_sec": 10.8
  },
  {
   "sentence_id": "C66-B001-S03",
   "section": "B",
   "text": "半数以上が緑町に居住、勤務、または通学し、代表者は十八歳以上であることが必要です。",
   "start_sec": 11.0,
   "end_sec": 20.64
  },
  {
   "sentence_id": "C66-B001-S04",
   "section": "B",
   "text": "年齢や国籍を問わず参加できる活動に限り、利益目的は対象外です。",
   "start_sec": 20.84,
   "end_sec": 26.713
  },
  {
   "sentence_id": "C66-B001-S05",
   "section": "B",
   "text": "2026年度の先着順・一律三万円から審査制に変わり、過去の受給団体の優遇はありません。",
   "start_sec": 26.913,
   "end_sec": 35.627
  },
  {
   "sentence_id": "C66-B002-S01",
   "section": "B",
   "text": "申請額は、対象費用から参加費収入を除いた額の半分。",
   "start_sec": 36.077,
   "end_sec": 42.262
  },
  {
   "sentence_id": "C66-B002-S02",
   "section": "B",
   "text": "平均参加人数に応じて、十人未満は上限二万円、十人以上は四万円となっています。",
   "start_sec": 42.462,
   "end_sec": 50.948
  },
  {
   "sentence_id": "C66-B002-S03",
   "section": "B",
   "text": "材料、部屋、講師、活動の保険料が対象です。",
   "start_sec": 51.148,
   "end_sec": 56.422
  },
  {
   "sentence_id": "C66-B002-S04",
   "section": "B",
   "text": "飲食費は除きますが、料理活動の材料は含みます。",
   "start_sec": 56.622,
   "end_sec": 61.347
  },
  {
   "sentence_id": "C66-B002-S05",
   "section": "B",
   "text": "休憩のお茶は含みません。",
   "start_sec": 61.547,
   "end_sec": 63.52
  },
  {
   "sentence_id": "C66-B002-S06",
   "section": "B",
   "text": "支出を証明するレシートを残してください。",
   "start_sec": 63.72,
   "end_sec": 67.304
  },
  {
   "sentence_id": "C66-B002-S07",
   "section": "B",
   "text": "費用六万円、収入二万円なら申請額は二万円です。",
   "start_sec": 67.504,
   "end_sec": 73.213
  },
  {
   "sentence_id": "C66-B003-S01",
   "section": "B",
   "text": "手続きは2027年1月12日から2月10日17時まで、窓口のみ。",
   "start_sec": 73.663,
   "end_sec": 81.675
  },
  {
   "sentence_id": "C66-B003-S02",
   "section": "B",
   "text": "締め切りの延長はなく、期限後の申請は無効です。",
   "start_sec": 81.875,
   "end_sec": 86.39
  },
  {
   "sentence_id": "C66-B003-S03",
   "section": "B",
   "text": "申込書と計画書を提出してください。",
   "start_sec": 86.59,
   "end_sec": 89.691
  },
  {
   "sentence_id": "C66-B003-S04",
   "section": "B",
   "text": "初回は1月29日までの事前相談が必要です。",
   "start_sec": 89.891,
   "end_sec": 95.229
  },
  {
   "sentence_id": "C66-B003-S05",
   "section": "B",
   "text": "代表者本人か委任状を持つ会員が来てください。",
   "start_sec": 95.429,
   "end_sec": 99.563
  },
  {
   "sentence_id": "C66-B003-S06",
   "section": "B",
   "text": "委任状抜きの代理相談では、この条件を満たせません。",
   "start_sec": 99.763,
   "end_sec": 104.205
  },
  {
   "sentence_id": "C66-B004-S01",
   "section": "B",
   "text": "予算は六十万円。",
   "start_sec": 104.655,
   "end_sec": 106.739
  },
  {
   "sentence_id": "C66-B004-S02",
   "section": "B",
   "text": "申請総額が予算を超える場合、支援金は審査の結果次第で減ることがあります。",
   "start_sec": 106.939,
   "end_sec": 113.773
  },
  {
   "sentence_id": "C66-B004-S03",
   "section": "B",
   "text": "同評価なら抽選です。",
   "start_sec": 113.973,
   "end_sec": 116.293
  },
  {
   "sentence_id": "C66-B004-S04",
   "section": "B",
   "text": "審査が終わり次第、3月中旬までに書面で通知します。",
   "start_sec": 116.493,
   "end_sec": 121.378
  },
  {
   "sentence_id": "C66-B004-S05",
   "section": "B",
   "text": "決定通知を受けた団体には、その額を受け取る権利があります。",
   "start_sec": 121.578,
   "end_sec": 126.354
  },
  {
   "sentence_id": "C66-B004-S06",
   "section": "B",
   "text": "ただし、納税の義務を免除する制度ではありません。",
   "start_sec": 126.554,
   "end_sec": 130.439
  },
  {
   "sentence_id": "C66-B005-S01",
   "section": "B",
   "text": "支援金を受けた上は、規則にのっとって活動してください。",
   "start_sec": 130.889,
   "end_sec": 135.5
  },
  {
   "sentence_id": "C66-B005-S02",
   "section": "B",
   "text": "活動と登録の有効期間は2027年4月1日～2028年3月31日。",
   "start_sec": 135.7,
   "end_sec": 145.156
  },
  {
   "sentence_id": "C66-B005-S03",
   "section": "B",
   "text": "2028年4月30日までに費用報告書及びレシートを提出してください。",
   "start_sec": 145.356,
   "end_sec": 153.017
  },
  {
   "sentence_id": "C66-B005-S04",
   "section": "B",
   "text": "受け取る以上は報告の義務があります。",
   "start_sec": 153.217,
   "end_sec": 156.211
  },
  {
   "sentence_id": "C66-B005-S05",
   "section": "B",
   "text": "次年度の申請には報告書の提出と登録の更新が必要です。",
   "start_sec": 156.411,
   "end_sec": 162.138
  },
  {
   "sentence_id": "C66-B005-S06",
   "section": "B",
   "text": "回数や計画の変更は事前に申請し、場所や日時は状況に応じて担当の野口に相談してください。",
   "start_sec": 162.338,
   "end_sec": 171.125
  }
 ]
}
