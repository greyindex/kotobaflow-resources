   "replacement": null
  },
  {
   "sentence_id": "C16-D003-S01",
   "unit_id": "C16-D003",
   "section": "D",
   "speaker": "リン",
   "text": "こっちが教室です。",
   "start_sec": 11.164,
   "end_sec": 12.697,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C16-D003-S02",
   "unit_id": "C16-D003",
   "section": "D",
   "speaker": "リン",
   "text": "まず、窓を開けましょう。",
   "start_sec": 12.847,
   "end_sec": 14.762,
   "review_flags": [],
   "replacement": null
  },
  {
