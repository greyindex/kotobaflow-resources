   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C04-D019-S01",
   "unit_id": "C04-D019",
   "section": "D",
   "speaker": "パク",
   "text": "あれは犬ではありません。",
   "start_sec": 49.573,
   "end_sec": 51.437,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C04-D019-S02",
   "unit_id": "C04-D019",
   "section": "D",
   "speaker": "パク",
   "text": "猫です。",
   "start_sec": 51.587,
   "end_sec": 52.442,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C04-D020-S01",
   "unit_id": "C04-D020",
   "section": "D",
   "speaker": "アナンド",
