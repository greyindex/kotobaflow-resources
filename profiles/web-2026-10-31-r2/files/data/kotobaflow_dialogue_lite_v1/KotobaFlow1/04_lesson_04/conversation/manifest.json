   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C04-D015-S01",
   "unit_id": "C04-D015",
   "section": "D",
   "speaker": "パク",
   "text": "駅の中と、センターの入口の近くにあります。",
   "start_sec": 39.157,
   "end_sec": 42.645,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C04-D016-S01",
   "unit_id": "C04-D016",
   "section": "D",
   "speaker": "アナンド",
   "text": "あそこに犬がいます。",
   "start_sec": 43.545,
