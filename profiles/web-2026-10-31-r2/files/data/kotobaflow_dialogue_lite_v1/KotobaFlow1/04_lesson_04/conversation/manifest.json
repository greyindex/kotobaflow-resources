   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C04-D018-S01",
   "unit_id": "C04-D018",
   "section": "D",
   "speaker": "アナンド",
   "text": "はい、あの椅子の下にいます。",
