   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C04-D017-S01",
   "unit_id": "C04-D017",
   "section": "D",
   "speaker": "パク",
   "text": "犬ですか。",
   "start_sec": 45.311,
