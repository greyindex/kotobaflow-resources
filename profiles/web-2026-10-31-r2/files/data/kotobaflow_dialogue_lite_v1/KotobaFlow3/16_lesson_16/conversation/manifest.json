  },
  {
   "turn_id": "C52-D016",
   "turn_index": 14,
   "speaker": "ミン",
   "source_text": "資料を読めば読むほど、確かめたいことが増えますね。",
   "sentence_ids": [
    "C52-D016-1"
   ],
   "voice_id": "ja-jp-podcaster-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 112.376,
   "end_sec": 116.076,
