  },
  {
   "turn_id": "C55-D003",
   "turn_index": 2,
   "speaker": "アナ",
   "source_text": "分かりました。二〇ポイントに訂正します。一週間の試行にしては変化が大きいと思いますが、原因はまだ分かりませんね。",
   "sentence_ids": [
    "C55-D003-1",
    "C55-D003-2",
    "C55-D003-3"
   ],
   "voice_id": "ja-jp-advisor-5",
   "status": "candidate",
   "review_needed": false,
