   "duration_sec": 6.299
  },
  {
   "turn_id": "C49-D002",
   "turn_index": 1,
   "speaker": "アナ",
   "source_text": "はい、十五センチもちょうどなら使えます。数字が読みにくければ手伝います。",
   "sentence_ids": [
    "C49-D002-S01",
    "C49-D002-S02"
   ],
   "voice_id": "ja-jp-advisor-5",
