  },
  {
   "turn_id": "C49-D012",
   "turn_index": 11,
   "speaker": "ミン",
   "source_text": "私も十二を二十一と書いていました。直しましたが、「入口」はどう読みますか。",
   "sentence_ids": [
    "C49-D012-S01",
    "C49-D012-S02"
