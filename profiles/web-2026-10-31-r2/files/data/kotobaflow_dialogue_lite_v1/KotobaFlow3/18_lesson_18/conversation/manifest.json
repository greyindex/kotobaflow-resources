  },
  {
   "sentence_id": "C54-D003-S03",
   "unit_id": "C54-D003",
   "section": "D",
   "speaker": "アナ",
   "text": "案内にそう書くべきですね。",
   "start_sec": 22.367,
   "end_sec": 24.3,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C54-D004-S01",
   "unit_id": "C54-D004",
   "section": "D",
   "speaker": "佐藤",
   "text": "参加する人の立場も考えるべきですね。",
   "start_sec": 24.65,
   "end_sec": 27.563,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C54-D004-S02",
   "unit_id": "C54-D004",
   "section": "D",
   "speaker": "佐藤",
   "text": "全員に同じ仕事を頼んでも公平にはなりません。",
   "start_sec": 27.713,
   "end_sec": 31.291,
   "review_flags": [],
   "replacement": null
  },
