  },
  {
   "turn_id": "C56-D013",
   "turn_index": 12,
   "speaker": "アナ",
   "source_text": "同意した後で使わないでくださいと言われた場合は、使いません。その条件も伝えましょう。",
   "sentence_ids": [
    "C56-D013-S01",
    "C56-D013-S02"
   ],
   "voice_id": "ja-jp-advisor-5",
   "status": "candidate",
