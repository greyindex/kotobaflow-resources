  },
  {
   "turn_id": "C56-D017",
   "turn_index": 16,
   "speaker": "ミン",
   "source_text": "はい。書き直したら、読んでいただけませんか。分からない点が残っていても、分かったふりはしないで、その点も書いて発表しましょう。",
   "sentence_ids": [
    "C56-D017-S01",
