  {
   "turn_id": "C56-D001",
   "turn_index": 0,
   "speaker": "ミン",
   "source_text": "提案の目的を確かめましょう。学習室を使いやすくするために、何を変えるか考えるんですよね。",
   "sentence_ids": [
    "C56-D001-S01",
    "C56-D001-S02"
   ],
   "voice_id": "ja-jp-podcaster-11",
   "status": "candidate",
