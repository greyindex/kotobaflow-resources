  },
  {
   "turn_id": "C72-D003",
   "turn_index": 2,
   "speaker": "佐藤",
   "source_text": "番号まで入力しました。この下のボタンですね。字が小さくて、視力の弱い親友にも見づらそうです。",
   "sentence_ids": [
    "C72-D003-S01",
    "C72-D003-S02",
    "C72-D003-S03"
   ],
   "voice_id": "ja-jp-advisor-10",
   "status": "candidate",
   "review_needed": false,
