   "duration_sec": 6.535
  },
  {
   "turn_id": "C72-D015",
   "turn_index": 14,
   "speaker": "佐藤",
   "source_text": "自分でできます。そこまで気を使う必要はありません。でも、聞いてくださるのは嬉しいです。",
   "sentence_ids": [
    "C72-D015-S01",
    "C72-D015-S02",
    "C72-D015-S03"
   ],
   "voice_id": "ja-jp-advisor-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 100.863,
   "end_sec": 107.518,
   "duration_sec": 6.655
  },
  {
   "turn_id": "C72-D016",
   "turn_index": 15,
   "speaker": "坂井",
   "source_text": "では、手順を書きます。待つ間も、分からないところがあったらおっしゃってください。",
   "sentence_ids": [
    "C72-D016-S01",
    "C72-D016-S02"
   ],
   "voice_id": "ja-jp-storyteller-11",
   "status": "candidate",
   "review_needed": false,
