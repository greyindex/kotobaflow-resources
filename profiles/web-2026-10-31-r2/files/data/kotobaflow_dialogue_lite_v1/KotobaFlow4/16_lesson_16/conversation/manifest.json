  {
   "turn_id": "C72-D002",
   "turn_index": 1,
   "speaker": "坂井",
   "source_text": "はい。スマートフォンは持っていてください。どこまで進んだか教えていただけませんか。",
   "sentence_ids": [
    "C72-D002-S01",
    "C72-D002-S02",
