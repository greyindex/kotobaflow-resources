   "speaker": "坂井",
   "text": "ここに腰を下ろしてお待ちください。",
   "start_sec": 81.963,
   "end_sec": 83.96,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C72-D012-S03",
   "unit_id": "C72-D012",
   "section": "D",
   "speaker": "坂井",
   "text": "個人の番号は書かず、手順だけにしますね。",
   "start_sec": 84.11,
   "end_sec": 87.216,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C72-D013-S01",
   "unit_id": "C72-D013",
   "section": "D",
   "speaker": "佐藤",
   "text": "ありがとうございます。",
   "start_sec": 87.566,
   "end_sec": 88.891,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C72-D013-S02",
   "unit_id": "C72-D013",
   "section": "D",
   "speaker": "佐藤",
   "text": "長く立っていて少し疲れました。",
   "start_sec": 89.041,
   "end_sec": 91.173,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C72-D013-S03",
   "unit_id": "C72-D013",
   "section": "D",
   "speaker": "佐藤",
   "text": "荷物を背負ったままでしたし。",
   "start_sec": 91.323,
   "end_sec": 93.628,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C72-D014-S01",
   "unit_id": "C72-D014",
   "section": "D",
   "speaker": "坂井",
   "text": "隣の椅子に置けますよ。",
   "start_sec": 93.978,
   "end_sec": 96.128,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C72-D014-S02",
   "unit_id": "C72-D014",
   "section": "D",
   "speaker": "坂井",
   "text": "ご自分で動かしますか。",
   "start_sec": 96.278,
   "end_sec": 98.205,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C72-D014-S03",
   "unit_id": "C72-D014",
   "section": "D",
   "speaker": "坂井",
   "text": "それとも、手を貸しましょうか。",
   "start_sec": 98.355,
   "end_sec": 100.513,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C72-D015-S01",
   "unit_id": "C72-D015",
   "section": "D",
   "speaker": "佐藤",
   "text": "自分でできます。",
   "start_sec": 100.863,
   "end_sec": 101.992,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C72-D015-S02",
   "unit_id": "C72-D015",
   "section": "D",
   "speaker": "佐藤",
   "text": "そこまで気を使う必要はありません。",
   "start_sec": 102.142,
   "end_sec": 104.71,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C72-D015-S03",
   "unit_id": "C72-D015",
   "section": "D",
   "speaker": "佐藤",
   "text": "でも、聞いてくださるのは嬉しいです。",
   "start_sec": 104.86,
   "end_sec": 107.518,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C72-D016-S01",
   "unit_id": "C72-D016",
   "section": "D",
   "speaker": "坂井",
   "text": "では、手順を書きます。",
   "start_sec": 107.868,
   "end_sec": 109.684,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C72-D016-S02",
   "unit_id": "C72-D016",
   "section": "D",
   "speaker": "坂井",
   "text": "待つ間も、分からないところがあったらおっしゃってください。",
   "start_sec": 109.834,
   "end_sec": 112.978,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C72-D017-S01",
   "unit_id": "C72-D017",
   "section": "D",
   "speaker": "佐藤",
   "text": "この短い説明なら、私にも読めます。",
   "start_sec": 113.328,
   "end_sec": 116.403,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C72-D017-S02",
   "unit_id": "C72-D017",
   "section": "D",
   "speaker": "佐藤",
   "text": "難しい言葉が多いと、質問するだけで迷惑かと思ってしまうんです。",
   "start_sec": 116.553,
   "end_sec": 121.197,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C72-D018-S01",
   "unit_id": "C72-D018",
   "section": "D",
   "speaker": "坂井",
   "text": "質問は迷惑ではありません。",
   "start_sec": 121.547,
   "end_sec": 124.081,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C72-D018-S02",
   "unit_id": "C72-D018",
   "section": "D",
   "speaker": "坂井",
   "text": "手順を一つ試して、紙の説明と合っているか確認していただけますか。",
   "start_sec": 124.231,
   "end_sec": 129.067,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C72-D019-S01",
   "unit_id": "C72-D019",
   "section": "D",
   "speaker": "佐藤",
   "text": "できました。",
   "start_sec": 129.417,
   "end_sec": 130.411,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C72-D019-S02",
   "unit_id": "C72-D019",
   "section": "D",
   "speaker": "佐藤",
   "text": "番号を入力すると、この画面になりますね。",
   "start_sec": 130.561,
   "end_sec": 133.478,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C72-D019-S03",
   "unit_id": "C72-D019",
   "section": "D",
   "speaker": "佐藤",
   "text": "今度は安心して家で練習できます。",
   "start_sec": 133.628,
   "end_sec": 135.916,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C72-D020-S01",
   "unit_id": "C72-D020",
   "section": "D",
   "speaker": "坂井",
   "text": "よかったです。",
   "start_sec": 136.266,
   "end_sec": 137.518,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C72-D020-S02",
   "unit_id": "C72-D020",
   "section": "D",
   "speaker": "坂井",
   "text": "ご自分で進めたいというお気持ちを、これからも大切にします。",
   "start_sec": 137.668,
   "end_sec": 141.778,
   "review_flags": [],
   "replacement": null
  }
 ]
