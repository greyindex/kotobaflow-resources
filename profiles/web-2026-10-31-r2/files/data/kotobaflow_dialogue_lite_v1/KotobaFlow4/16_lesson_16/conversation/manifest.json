   "end_sec": 22.19,
   "duration_sec": 8.786
  },
  {
   "turn_id": "C72-D004",
   "turn_index": 3,
   "speaker": "坂井",
   "source_text": "文字を大きくする方法があります。ご友人にも説明が必要なら、ご本人に希望を聞いてから案内します。",
   "sentence_ids": [
    "C72-D004-S01",
    "C72-D004-S02"
   ],
   "voice_id": "ja-jp-storyteller-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 22.54,
   "end_sec": 30.255,
   "duration_sec": 7.715
  },
  {
   "turn_id": "C72-D005",
   "turn_index": 4,
   "speaker": "佐藤",
   "source_text": "私は家族に確認せずにはいられませんでしたが、友人は一人で試したいそうです。性質が違うんですね。",
   "sentence_ids": [
    "C72-D005-S01",
    "C72-D005-S02"
   ],
   "voice_id": "ja-jp-advisor-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 30.605,
   "end_sec": 37.39,
   "duration_sec": 6.785
  },
  {
   "turn_id": "C72-D006",
   "turn_index": 5,
   "speaker": "坂井",
   "source_text": "人によって違いますし、同じ人でもその日の気分は違います。私も先に気を配るべきでした。",
   "sentence_ids": [
    "C72-D006-S01",
    "C72-D006-S02"
   ],
   "voice_id": "ja-jp-storyteller-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 37.74,
   "end_sec": 45.137,
   "duration_sec": 7.397
  },
  {
   "turn_id": "C72-D007",
   "turn_index": 6,
   "speaker": "佐藤",
   "source_text": "ところで、資料の確認を断ると角が立つかと心配でした。遠慮して引き受けるところでした。",
   "sentence_ids": [
    "C72-D007-S01",
    "C72-D007-S02"
   ],
   "voice_id": "ja-jp-advisor-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 45.487,
   "end_sec": 51.96,
   "duration_sec": 6.473
  },
  {
   "turn_id": "C72-D008",
   "turn_index": 7,
   "speaker": "坂井",
   "source_text": "無理に引き受けなくて大丈夫です。今回は辞退したいというお気持ちを聞いて、納得しました。",
   "sentence_ids": [
    "C72-D008-S01",
    "C72-D008-S02"
   ],
   "voice_id": "ja-jp-storyteller-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 52.31,
   "end_sec": 59.081,
   "duration_sec": 6.771
  },
  {
   "turn_id": "C72-D009",
   "turn_index": 8,
   "speaker": "佐藤",
   "source_text": "ありがとうございます。助けてくれる人には頭が上がらないと思っていました。でも、希望は言っていいんですね。",
   "sentence_ids": [
    "C72-D009-S01",
    "C72-D009-S02",
    "C72-D009-S03"
   ],
   "voice_id": "ja-jp-advisor-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 59.431,
   "end_sec": 66.621,
   "duration_sec": 7.19
  },
  {
   "turn_id": "C72-D010",
   "turn_index": 9,
   "speaker": "坂井",
   "source_text": "もちろんです。ありがたいことに、今回のご意見は案内の改善に一役買いました。",
   "sentence_ids": [
    "C72-D010-S01",
    "C72-D010-S02"
   ],
   "voice_id": "ja-jp-storyteller-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 66.971,
   "end_sec": 73.393,
   "duration_sec": 6.422
  },
  {
   "turn_id": "C72-D011",
   "turn_index": 10,
   "speaker": "佐藤",
   "source_text": "では、この画面までの順番を書いてくださいませんか。家で使いたいです。",
   "sentence_ids": [
    "C72-D011-S01",
    "C72-D011-S02"
   ],
   "voice_id": "ja-jp-advisor-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 73.743,
   "end_sec": 78.481,
   "duration_sec": 4.738
  },
  {
   "turn_id": "C72-D012",
   "turn_index": 11,
   "speaker": "坂井",
   "source_text": "はい、そのお願いには応じられます。ここに腰を下ろしてお待ちください。個人の番号は書かず、手順だけにしますね。",
   "sentence_ids": [
    "C72-D012-S01",
    "C72-D012-S02",
    "C72-D012-S03"
   ],
   "voice_id": "ja-jp-storyteller-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 78.831,
   "end_sec": 87.216,
   "duration_sec": 8.385
  },
  {
   "turn_id": "C72-D013",
   "turn_index": 12,
   "speaker": "佐藤",
   "source_text": "ありがとうございます。長く立っていて少し疲れました。荷物を背負ったままでしたし。",
   "sentence_ids": [
    "C72-D013-S01",
    "C72-D013-S02",
    "C72-D013-S03"
   ],
   "voice_id": "ja-jp-advisor-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
