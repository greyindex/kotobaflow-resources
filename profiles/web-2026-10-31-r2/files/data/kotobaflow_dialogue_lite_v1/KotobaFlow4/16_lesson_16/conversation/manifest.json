   "end_sec": 93.628,
   "duration_sec": 6.062
  },
  {
   "turn_id": "C72-D014",
   "turn_index": 13,
   "speaker": "坂井",
   "source_text": "隣の椅子に置けますよ。ご自分で動かしますか。それとも、手を貸しましょうか。",
   "sentence_ids": [
    "C72-D014-S01",
    "C72-D014-S02",
    "C72-D014-S03"
   ],
   "voice_id": "ja-jp-storyteller-11",
