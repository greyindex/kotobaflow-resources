   "turn_index": 9,
   "speaker": "林梅",
   "source_text": "ええ。条件の説明を中心に、私がまとめて送ります。私は11月に2冊、待たずに借りられましたが、人気の本は待つことも書きます。",
   "sentence_ids": [
    "C64-D010-S01",
    "C64-D010-S02",
    "C64-D010-S03"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": true,
