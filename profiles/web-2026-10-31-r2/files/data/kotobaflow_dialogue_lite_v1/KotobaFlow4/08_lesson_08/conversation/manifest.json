  {
   "turn_id": "C64-D002",
   "turn_index": 1,
   "speaker": "林梅",
   "source_text": "サービスではなく説明への意見です。中村さんも同じです。図書館にしてみれば、まず知ってほしいのでしょうね。",
   "sentence_ids": [
    "C64-D002-S01",
    "C64-D002-S02",
    "C64-D002-S03"
   ],
   "voice_id": "ja-jp-concierge-7",
