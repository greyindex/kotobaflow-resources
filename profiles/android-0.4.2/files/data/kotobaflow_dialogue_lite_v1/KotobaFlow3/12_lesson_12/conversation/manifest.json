   "end_sec": 30.344,
   "duration_sec": 6.133
  },
  {
   "turn_id": "C48-D006",
   "turn_index": 5,
   "speaker": "アナ",
   "source_text": "はい。先に送った原稿もご覧になりますか。そちらには正しいアドレスを書きました。",
   "sentence_ids": [
    "C48-D006-S01",
    "C48-D006-S02",
    "C48-D006-S03"
   ],
   "voice_id": "ja-jp-advisor-5",
