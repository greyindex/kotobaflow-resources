   "end_sec": 10.682,
   "duration_sec": 6.772
  },
  {
   "turn_id": "C48-D003",
   "turn_index": 2,
   "speaker": "田中",
   "source_text": "注文番号を教えていただけますか。私が印刷の担当です。",
   "sentence_ids": [
    "C48-D003-S01",
    "C48-D003-S02"
   ],
   "voice_id": "ja-jp-storyteller-12",
