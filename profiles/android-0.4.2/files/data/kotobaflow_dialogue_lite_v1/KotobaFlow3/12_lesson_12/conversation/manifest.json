   "end_sec": 41.094,
   "duration_sec": 3.976
  },
  {
   "turn_id": "C48-D008",
   "turn_index": 7,
   "speaker": "アナ",
   "source_text": "いいえ、三十枚ともまだです。ほかに被害があるかどうかは、まだ分かりません。",
   "sentence_ids": [
    "C48-D008-S01",
    "C48-D008-S02"
   ],
   "voice_id": "ja-jp-advisor-5",
   "status": "candidate",
   "review_needed": false,
