   "review_needed": false,
   "review_flags": [],
   "start_sec": 30.694,
   "end_sec": 36.768,
   "duration_sec": 6.074
  },
  {
   "turn_id": "C48-D007",
   "turn_index": 6,
   "speaker": "田中",
   "source_text": "はい、拝見します。案内はもう配りましたか。",
   "sentence_ids": [
    "C48-D007-S01",
    "C48-D007-S02"
   ],
   "voice_id": "ja-jp-storyteller-12",
   "status": "candidate",
   "review_needed": false,
