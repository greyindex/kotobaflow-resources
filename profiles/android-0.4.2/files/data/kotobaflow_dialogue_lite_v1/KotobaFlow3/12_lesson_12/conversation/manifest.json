  {
   "turn_id": "C48-D002",
   "turn_index": 1,
   "speaker": "アナ",
   "source_text": "国際交流会のアナ・ロペスと申します。注文した案内について、ご相談したいんですが。",
   "sentence_ids": [
    "C48-D002-S01",
    "C48-D002-S02"
