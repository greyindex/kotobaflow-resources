   "end_sec": 47.206,
   "duration_sec": 5.762
  },
  {
   "turn_id": "C48-D009",
   "turn_index": 8,
   "speaker": "田中",
   "source_text": "分かりました。原稿と案内を持って、今日、店にいらっしゃることはできますか。",
   "sentence_ids": [
    "C48-D009-S01",
    "C48-D009-S02"
   ],
   "voice_id": "ja-jp-storyteller-12",
   "status": "candidate",
   "review_needed": false,
