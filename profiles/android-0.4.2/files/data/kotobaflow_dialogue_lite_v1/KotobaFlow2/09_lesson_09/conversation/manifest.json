 "source_chapter": 27,
 "turns": [
  {
   "turn_id": "C27-D001",
   "turn_index": 0,
   "speaker": "村田",
   "source_text": "ミラさん、おはようございます。私は村田です。事務室の前で待っていました。今日は初めてですね。まず、ルールを確認しましょう。",
   "sentence_ids": [
    "C27-D001-S01",
    "C27-D001-S02",
    "C27-D001-S03",
    "C27-D001-S04",
    "C27-D001-S05"
   ],
   "voice_id": "ja-jp-concierge-12",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 0.0,
   "end_sec": 9.523,
   "duration_sec": 9.523
  },
  {
   "turn_id": "C27-D002",
   "turn_index": 1,
   "speaker": "ミラ",
   "source_text": "おはようございます。13時から仕事があるので、12時20分に出なければならないんです。清掃も必要ですよね。",
   "sentence_ids": [
    "C27-D002-S01",
    "C27-D002-S02",
    "C27-D002-S03"
   ],
   "voice_id": "ja-jp-csagent-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 9.873,
   "end_sec": 18.789,
   "duration_sec": 8.916
  },
  {
   "turn_id": "C27-D003",
   "turn_index": 2,
   "speaker": "村田",
   "source_text": "清掃は12時半からですが、先に帰る人はしなくてもいいです。今は9時40分ですね。9時45分から準備を手伝ってください。",
   "sentence_ids": [
    "C27-D003-S01",
    "C27-D003-S02",
    "C27-D003-S03"
   ],
   "voice_id": "ja-jp-concierge-12",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 19.139,
   "end_sec": 29.204,
   "duration_sec": 10.065
  },
  {
   "turn_id": "C27-D004",
   "turn_index": 3,
   "speaker": "ミラ",
   "source_text": "はい。野菜を洗います。ここは学校の給食のキッチンですか。入口に子ども専用の椅子もありますね。",
   "sentence_ids": [
    "C27-D004-S01",
    "C27-D004-S02",
    "C27-D004-S03",
    "C27-D004-S04"
   ],
   "voice_id": "ja-jp-csagent-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 29.554,
   "end_sec": 37.918,
   "duration_sec": 8.364
  },
  {
   "turn_id": "C27-D005",
   "turn_index": 4,
   "speaker": "村田",
   "source_text": "いいえ、地域の料理の会で使っています。あの椅子は子どもの会で使います。では、受付で鍵を借りましょう。",
   "sentence_ids": [
    "C27-D005-S01",
    "C27-D005-S02",
    "C27-D005-S03"
   ],
   "voice_id": "ja-jp-concierge-12",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 38.268,
   "end_sec": 46.411,
   "duration_sec": 8.143
  },
  {
   "turn_id": "C27-D006",
   "turn_index": 5,
   "speaker": "石井",
   "source_text": "おはようございます。今日は10時から13時まで、600円です。準備は9時45分からで構いません。",
   "sentence_ids": [
    "C27-D006-S01",
    "C27-D006-S02",
    "C27-D006-S03"
   ],
   "voice_id": "ja-jp-techagent-6",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 46.761,
   "end_sec": 54.891,
   "duration_sec": 8.13
  },
  {
   "turn_id": "C27-D007",
   "turn_index": 6,
   "speaker": "村田",
   "source_text": "はい、600円です。今日の会費は無しですね。材料はめいめい持ってきました。",
   "sentence_ids": [
    "C27-D007-S01",
    "C27-D007-S02",
    "C27-D007-S03"
   ],
   "voice_id": "ja-jp-concierge-12",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 55.241,
   "end_sec": 61.257,
   "duration_sec": 6.016
  },
  {
   "turn_id": "C27-D008",
   "turn_index": 7,
   "speaker": "石井",
   "source_text": "はい。追加の支払いは不要です。人数は16人までです。今日は何人ですか。",
   "sentence_ids": [
    "C27-D008-S01",
    "C27-D008-S02",
    "C27-D008-S03",
    "C27-D008-S04"
   ],
   "voice_id": "ja-jp-techagent-6",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 61.607,
   "end_sec": 70.116,
   "duration_sec": 8.509
  },
  {
   "turn_id": "C27-D009",
   "turn_index": 8,
   "speaker": "村田",
   "source_text": "12人です。13時から次の教室ですね。私は最後に鍵を返します。ミラさんは戻らなくても大丈夫ですよ。",
   "sentence_ids": [
    "C27-D009-S01",
    "C27-D009-S02",
    "C27-D009-S03",
    "C27-D009-S04"
   ],
   "voice_id": "ja-jp-concierge-12",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 70.466,
   "end_sec": 78.85,
   "duration_sec": 8.384
  },
  {
   "turn_id": "C27-D010",
   "turn_index": 9,
   "speaker": "ミラ",
   "source_text": "ありがとうございます。掲示の21時は最後の期限で、今日は13時前ですね。ちゃんと覚えました。",
   "sentence_ids": [
    "C27-D010-S01",
    "C27-D010-S02",
    "C27-D010-S03"
   ],
   "voice_id": "ja-jp-csagent-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 79.2,
   "end_sec": 87.117,
   "duration_sec": 7.917
  },
  {
   "turn_id": "C27-D011",
   "turn_index": 10,
   "speaker": "石井",
   "source_text": "ええ。遅れては困ります。次の人が入れませんから。それから、入口の立札は隣の会議室の注意です。事務室への出入りは管理人に相談してください。",
   "sentence_ids": [
    "C27-D011-S01",
    "C27-D011-S02",
    "C27-D011-S03",
    "C27-D011-S04",
    "C27-D011-S05"
   ],
   "voice_id": "ja-jp-techagent-6",
   "status": "candidate",
   "review_needed": true,
   "review_flags": [
    "clip_asr_difference",
    "low_ASR_text_match"
   ],
   "start_sec": 87.467,
   "end_sec": 101.367,
   "duration_sec": 13.9
  },
  {
   "turn_id": "C27-D012",
   "turn_index": 11,
   "speaker": "ミラ",
   "source_text": "「土足で入るべからず」ですか。「靴を脱いでください」という意味ですね。キッチンでも脱ぎますか。",
   "sentence_ids": [
    "C27-D012-S01",
    "C27-D012-S02",
    "C27-D012-S03"
   ],
   "voice_id": "ja-jp-csagent-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 101.717,
   "end_sec": 109.467,
   "duration_sec": 7.75
  },
  {
   "turn_id": "C27-D013",
   "turn_index": 12,
   "speaker": "石井",
   "source_text": "キッチンでは脱がなくてもいいです。ただし、たばこはどちらでも吸ってはいけません。マッチも使わないでください。",
   "sentence_ids": [
    "C27-D013-S01",
    "C27-D013-S02",
    "C27-D013-S03"
   ],
   "voice_id": "ja-jp-techagent-6",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 109.817,
   "end_sec": 116.798,
   "duration_sec": 6.981
  },
  {
   "turn_id": "C27-D014",
   "turn_index": 13,
   "speaker": "村田",
   "source_text": "では、準備を始めましょう。机を動かす前に、下の埃を掃きます。ミラさん、この箱を見てください。新しい箱を設置しましたから、物を床に置かなくてもいいです。",
   "sentence_ids": [
    "C27-D014-S01",
    "C27-D014-S02",
    "C27-D014-S03",
    "C27-D014-S04"
   ],
   "voice_id": "ja-jp-concierge-12",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 117.148,
   "end_sec": 129.579,
   "duration_sec": 12.431
  },
  {
   "turn_id": "C27-D015",
   "turn_index": 14,
   "speaker": "ミラ",
   "source_text": "落し物の箱ですね。誰かの乾電池があります。でも、ごみですか。勝手に捨てるのはいけませんね。",
   "sentence_ids": [
    "C27-D015-S01",
    "C27-D015-S02",
    "C27-D015-S03",
    "C27-D015-S04"
   ],
   "voice_id": "ja-jp-csagent-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 129.929,
   "end_sec": 137.773,
   "duration_sec": 7.844
  },
  {
   "turn_id": "C27-D016",
   "turn_index": 15,
   "speaker": "村田",
   "source_text": "そうですね。管理人に聞きましょう。今日は大掃除ではありませんから、私たちの机の下だけでいいです。",
   "sentence_ids": [
    "C27-D016-S01",
    "C27-D016-S02",
    "C27-D016-S03"
   ],
   "voice_id": "ja-jp-concierge-12",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 138.123,
   "end_sec": 145.593,
   "duration_sec": 7.47
  },
  {
   "turn_id": "C27-D017",
   "turn_index": 16,
   "speaker": "ミラ",
   "source_text": "料理の後のごみはどうしますか。ビニールの袋に全部入れてもいいですか。紙とプラスチックは別ですか。",
   "sentence_ids": [
    "C27-D017-S01",
    "C27-D017-S02",
    "C27-D017-S03"
   ],
   "voice_id": "ja-jp-csagent-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 145.943,
   "end_sec": 153.536,
   "duration_sec": 7.593
  },
  {
   "turn_id": "C27-D018",
   "turn_index": 17,
   "speaker": "村田",
   "source_text": "別です。包み紙はこちら、生ゴミはあちらです。生ゴミは私が持ち帰ります。空き缶は洗って、受付の横の箱に入れてください。",
   "sentence_ids": [
    "C27-D018-S01",
    "C27-D018-S02",
    "C27-D018-S03",
    "C27-D018-S04"
   ],
   "voice_id": "ja-jp-concierge-12",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 153.886,
   "end_sec": 163.769,
   "duration_sec": 9.883
  },
  {
   "turn_id": "C27-D019",
   "turn_index": 18,
   "speaker": "ミラ",
   "source_text": "承知しました。外のプラカードにも「ごみを散らかさないで」とありますね。人が手に持って、歩行者に見せています。",
   "sentence_ids": [
    "C27-D019-S01",
    "C27-D019-S02",
    "C27-D019-S03"
   ],
   "voice_id": "ja-jp-csagent-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 164.119,
   "end_sec": 172.775,
   "duration_sec": 8.656
  },
  {
   "turn_id": "C27-D020",
   "turn_index": 19,
   "speaker": "村田",
   "source_text": "広場でも今日は清掃の日なんです。前に子どもがごみでいたずらをして、大人が「こらっ、ふざけるな」と言いました。",
   "sentence_ids": [
    "C27-D020-S01",
    "C27-D020-S02"
   ],
   "voice_id": "ja-jp-concierge-12",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 173.125,
   "end_sec": 181.895,
   "duration_sec": 8.77
  },
  {
   "turn_id": "C27-D021",
   "turn_index": 20,
   "speaker": "ミラ",
   "source_text": "強い言い方ですね。友達には「騒がないでください」でいいですか。大声で注意するのも困りますね。",
   "sentence_ids": [
    "C27-D021-S01",
    "C27-D021-S02",
    "C27-D021-S03"
   ],
   "voice_id": "ja-jp-csagent-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 182.245,
   "end_sec": 190.132,
   "duration_sec": 7.887
  },
  {
   "turn_id": "C27-D022",
   "turn_index": 21,
   "speaker": "村田",
   "source_text": "ええ。規律は大切ですが、理由も説明しましょう。秩序を守るのは、一人の仕事ではありません。私も絶対に時間を守ります。",
   "sentence_ids": [
    "C27-D022-S01",
    "C27-D022-S02",
    "C27-D022-S03",
    "C27-D022-S04"
   ],
   "voice_id": "ja-jp-concierge-12",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 190.482,
   "end_sec": 200.068,
   "duration_sec": 9.586
  },
  {
   "turn_id": "C27-D023",
   "turn_index": 22,
   "speaker": "ミラ",
   "source_text": "私は12時20分に電気を消しますか。それとも、まだ料理をしていますか。",
   "sentence_ids": [
    "C27-D023-S01",
    "C27-D023-S02"
   ],
   "voice_id": "ja-jp-csagent-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 200.418,
   "end_sec": 207.071,
   "duration_sec": 6.653
  },
  {
   "turn_id": "C27-D024",
   "turn_index": 23,
   "speaker": "村田",
   "source_text": "まだ料理をしていますから、消さないでください。最後に出る私の責任です。窓を閉めて、鍵もかけます。",
   "sentence_ids": [
    "C27-D024-S01",
    "C27-D024-S02",
    "C27-D024-S03"
   ],
   "voice_id": "ja-jp-concierge-12",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 207.421,
   "end_sec": 215.24,
   "duration_sec": 7.819
  },
  {
   "turn_id": "C27-D025",
   "turn_index": 24,
   "speaker": "ミラ",
   "source_text": "分かりました。午前の準備をちゃんと手伝います。次は仕事を片づけて、最後まで参加したいです。",
   "sentence_ids": [
    "C27-D025-S01",
    "C27-D025-S02",
    "C27-D025-S03"
   ],
   "voice_id": "ja-jp-csagent-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 215.59,
   "end_sec": 223.155,
   "duration_sec": 7.565
  },
  {
   "turn_id": "C27-D026",
   "turn_index": 25,
   "speaker": "村田",
   "source_text": "次は1月9日です。仕事の日程を確認したら、連絡してください。まだ参加を決めなくてもかまいませんよ。",
   "sentence_ids": [
    "C27-D026-S01",
    "C27-D026-S02",
    "C27-D026-S03"
   ],
   "voice_id": "ja-jp-concierge-12",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 223.505,
   "end_sec": 231.882,
   "duration_sec": 8.377
  }
 ],
 "sentence_intervals": [
