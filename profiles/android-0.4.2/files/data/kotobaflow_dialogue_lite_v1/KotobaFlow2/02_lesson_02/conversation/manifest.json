   "end_sec": 9.392,
   "duration_sec": 4.816
  },
  {
   "turn_id": "C20-D003",
   "turn_index": 2,
   "speaker": "ルカ",
   "source_text": "ルカです。この近くに住んでいます。紺色のかばんです。",
   "sentence_ids": [
    "C20-D003-S01",
    "C20-D003-S02",
    "C20-D003-S03"
   ],
   "voice_id": "ja-jp-concierge-6",
   "status": "candidate",
   "review_needed": false,
