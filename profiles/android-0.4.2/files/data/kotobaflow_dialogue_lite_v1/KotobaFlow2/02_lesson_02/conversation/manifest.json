  {
   "turn_id": "C20-D002",
   "turn_index": 1,
   "speaker": "小林",
   "source_text": "かばんは二つあります。どんなかばんですか。名前もお願いします。",
   "sentence_ids": [
    "C20-D002-S01",
    "C20-D002-S02",
    "C20-D002-S03"
