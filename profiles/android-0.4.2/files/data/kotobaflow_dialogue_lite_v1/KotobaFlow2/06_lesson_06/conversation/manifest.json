 "source_chapter": 24,
 "turns": [
  {
   "turn_id": "C24-D001",
   "turn_index": 0,
   "speaker": "木下",
   "source_text": "こんにちは。ピアノの授業に参加しますか。教室と家のパソコンから選べます。今日は見学もできます。",
   "sentence_ids": [
    "C24-D001-S01",
    "C24-D001-S02",
    "C24-D001-S03",
    "C24-D001-S04"
   ],
   "voice_id": "ja-jp-techagent-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 0.0,
   "end_sec": 7.31,
   "duration_sec": 7.31
  },
  {
   "turn_id": "C24-D002",
   "turn_index": 1,
   "speaker": "サラ",
   "source_text": "ピアノを弾いたことがありますが、今は右の手でしか弾けません。レベルは初級です。このコースに参加してもいいですか。",
   "sentence_ids": [
    "C24-D002-S01",
    "C24-D002-S02",
    "C24-D002-S03"
   ],
   "voice_id": "ja-jp-storyteller-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 7.66,
   "end_sec": 16.565,
   "duration_sec": 8.905
  },
  {
   "turn_id": "C24-D003",
   "turn_index": 2,
   "speaker": "木下",
   "source_text": "はい。ゆっくり練習します。教材の説明は短いです。紙もペンもここにあります。",
   "sentence_ids": [
    "C24-D003-S01",
    "C24-D003-S02",
    "C24-D003-S03",
    "C24-D003-S04"
   ],
   "voice_id": "ja-jp-techagent-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 16.915,
   "end_sec": 23.005,
   "duration_sec": 6.09
  },
  {
   "turn_id": "C24-D004",
   "turn_index": 3,
   "speaker": "サラ",
   "source_text": "左の耳では声がはっきり聞こえないんです。先生が右に見える席はありますか。目で手の動きも確認したいです。",
   "sentence_ids": [
    "C24-D004-S01",
    "C24-D004-S02",
    "C24-D004-S03"
   ],
   "voice_id": "ja-jp-storyteller-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 23.355,
   "end_sec": 32.507,
   "duration_sec": 9.152
  },
  {
   "turn_id": "C24-D005",
   "turn_index": 4,
   "speaker": "木下",
   "source_text": "先生のピアノの左にあります。教室まで案内します。今日は先生もいますから、声を確認できます。",
   "sentence_ids": [
    "C24-D005-S01",
    "C24-D005-S02",
    "C24-D005-S03"
   ],
   "voice_id": "ja-jp-techagent-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 32.857,
   "end_sec": 39.779,
   "duration_sec": 6.922
  },
  {
   "turn_id": "C24-D006",
   "turn_index": 5,
   "speaker": "サラ",
   "source_text": "お願いします。案内の文字は理解できますが、手の動きは文章ではよく分かりません。実際に見たいです。",
   "sentence_ids": [
    "C24-D006-S01",
    "C24-D006-S02",
    "C24-D006-S03"
   ],
   "voice_id": "ja-jp-storyteller-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 40.129,
   "end_sec": 49.859,
   "duration_sec": 9.73
  },
  {
   "turn_id": "C24-D007",
   "turn_index": 6,
   "speaker": "木下",
   "source_text": "この席です。黒板の文字と先生の手が見えますか。先生はチョークで音の名前を書きました。今、ピアノを弾いています。",
   "sentence_ids": [
    "C24-D007-S01",
    "C24-D007-S02",
    "C24-D007-S03",
    "C24-D007-S04"
   ],
   "voice_id": "ja-jp-techagent-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 50.209,
   "end_sec": 59.005,
   "duration_sec": 8.796
  },
  {
   "turn_id": "C24-D008",
   "turn_index": 7,
   "speaker": "サラ",
   "source_text": "はい、どれもはっきり見えます。声も聞こえます。先生はピアノが上手ですね。わたしにはとてもできません。",
   "sentence_ids": [
    "C24-D008-S01",
    "C24-D008-S02",
    "C24-D008-S03",
    "C24-D008-S04"
   ],
   "voice_id": "ja-jp-storyteller-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 59.355,
   "end_sec": 68.813,
   "duration_sec": 9.458
  },
  {
   "turn_id": "C24-D009",
   "turn_index": 8,
   "speaker": "木下",
   "source_text": "初めは一つずつ練習します。今はこの教室には三人しかいませんが、授業には八人参加します。土曜日にも声を確認してください。",
   "sentence_ids": [
    "C24-D009-S01",
    "C24-D009-S02",
    "C24-D009-S03"
   ],
   "voice_id": "ja-jp-techagent-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 69.163,
   "end_sec": 78.409,
   "duration_sec": 9.246
  },
  {
   "turn_id": "C24-D010",
   "turn_index": 9,
   "speaker": "サラ",
   "source_text": "はい。新しい歌も少しずつしか覚えられません。家では動画を見たいです。パソコンは苦手ですが、スマートフォンは使えます。",
   "sentence_ids": [
    "C24-D010-S01",
    "C24-D010-S02",
    "C24-D010-S03",
    "C24-D010-S04"
   ],
   "voice_id": "ja-jp-storyteller-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 78.759,
   "end_sec": 89.468,
   "duration_sec": 10.709
  },
  {
   "turn_id": "C24-D011",
   "turn_index": 10,
   "speaker": "木下",
   "source_text": "スマートフォンでも見られます。音も何度も聞けます。この画面で音量を設定して、ここで文字を拡大します。どうですか。",
   "sentence_ids": [
    "C24-D011-S01",
    "C24-D011-S02",
    "C24-D011-S03",
    "C24-D011-S04"
   ],
   "voice_id": "ja-jp-techagent-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 89.818,
   "end_sec": 98.082,
   "duration_sec": 8.264
  },
  {
   "turn_id": "C24-D012",
   "turn_index": 11,
   "speaker": "サラ",
   "source_text": "今は字幕も読めます。ピアノの音の説明もありますか。音の違いがどうしても分かりません。",
   "sentence_ids": [
    "C24-D012-S01",
    "C24-D012-S02",
    "C24-D012-S03"
   ],
   "voice_id": "ja-jp-storyteller-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 98.432,
   "end_sec": 106.471,
   "duration_sec": 8.039
  },
  {
   "turn_id": "C24-D013",
   "turn_index": 12,
   "speaker": "木下",
   "source_text": "字幕は先生の声だけです。音の説明はありません。手話の通訳もいません。分からないことは先生に相談してください。",
   "sentence_ids": [
    "C24-D013-S01",
    "C24-D013-S02",
    "C24-D013-S03",
    "C24-D013-S04"
   ],
   "voice_id": "ja-jp-techagent-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 106.821,
   "end_sec": 114.895,
   "duration_sec": 8.074
  },
  {
   "turn_id": "C24-D014",
   "turn_index": 13,
   "speaker": "サラ",
   "source_text": "友達が手話を使います。参加するかどうか、まだ決めていません。手振りや身振りだけでは話の内容を伝えられませんね。",
   "sentence_ids": [
    "C24-D014-S01",
    "C24-D014-S02",
    "C24-D014-S03"
   ],
   "voice_id": "ja-jp-storyteller-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 115.245,
   "end_sec": 124.971,
   "duration_sec": 9.726
  },
  {
   "turn_id": "C24-D015",
   "turn_index": 14,
   "speaker": "木下",
   "source_text": "ええ。書いて相談することはできますが、手話で話すことはできません。友達にもこの違いを伝えてください。",
   "sentence_ids": [
    "C24-D015-S01",
    "C24-D015-S02",
    "C24-D015-S03"
   ],
   "voice_id": "ja-jp-techagent-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 125.321,
   "end_sec": 132.711,
   "duration_sec": 7.39
  },
  {
   "turn_id": "C24-D016",
   "turn_index": 15,
   "speaker": "サラ",
   "source_text": "はい、相談します。家にはピアノがありません。土曜日の午後に、ここで練習したいです。授業の後で利用できますか。",
   "sentence_ids": [
    "C24-D016-S01",
    "C24-D016-S02",
    "C24-D016-S03",
    "C24-D016-S04"
   ],
   "voice_id": "ja-jp-storyteller-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 133.061,
   "end_sec": 143.87,
   "duration_sec": 10.809
  },
  {
   "turn_id": "C24-D017",
   "turn_index": 16,
   "speaker": "木下",
   "source_text": "午後一時から五時まで、一時間二百円です。入口にバスの時間の案内があります。先に確認しましょうか。",
   "sentence_ids": [
    "C24-D017-S01",
    "C24-D017-S02",
    "C24-D017-S03"
   ],
   "voice_id": "ja-jp-techagent-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 144.22,
   "end_sec": 151.523,
   "duration_sec": 7.303
  },
  {
   "turn_id": "C24-D018",
   "turn_index": 17,
   "speaker": "サラ",
   "source_text": "はい。家からはノンステップバスで来ます。駅から歩くコースも知りたいです。途中に階段はありますか。",
   "sentence_ids": [
    "C24-D018-S01",
    "C24-D018-S02",
    "C24-D018-S03",
    "C24-D018-S04"
   ],
   "voice_id": "ja-jp-storyteller-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 151.873,
   "end_sec": 160.217,
   "duration_sec": 8.344
  },
  {
   "turn_id": "C24-D019",
   "turn_index": 18,
   "speaker": "木下",
   "source_text": "駅の東の道にはありません。駅にはエレベーターもあります。こちらが地図です。では、受付に戻りましょう。",
   "sentence_ids": [
    "C24-D019-S01",
    "C24-D019-S02",
    "C24-D019-S03",
    "C24-D019-S04"
   ],
   "voice_id": "ja-jp-techagent-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 160.567,
   "end_sec": 167.66,
   "duration_sec": 7.093
  },
  {
   "turn_id": "C24-D020",
   "turn_index": 19,
   "speaker": "サラ",
   "source_text": "ありがとうございます。あの語学の本も見てもいいですか。日本語の知識はまだまだ十分ではありません。毎日の学習で役に立つ本が欲しいです。",
   "sentence_ids": [
    "C24-D020-S01",
    "C24-D020-S02",
    "C24-D020-S03",
    "C24-D020-S04"
   ],
   "voice_id": "ja-jp-storyteller-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 168.01,
   "end_sec": 179.941,
   "duration_sec": 11.931
  },
  {
   "turn_id": "C24-D021",
   "turn_index": 20,
   "speaker": "木下",
   "source_text": "どうぞ。これは中級の読解、隣は上級の問題集です。まず短文を読んで、レベルを確認してください。試験問題も少しあります。",
   "sentence_ids": [
    "C24-D021-S01",
    "C24-D021-S02",
    "C24-D021-S03",
    "C24-D021-S04"
   ],
   "voice_id": "ja-jp-techagent-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 180.291,
   "end_sec": 190.053,
   "duration_sec": 9.762
  },
  {
   "turn_id": "C24-D022",
   "turn_index": 21,
   "speaker": "サラ",
   "source_text": "この文法の参考書はどうですか。文型の知識はありますが、作文は下手です。一生懸命書いていますが、長い作文は一日ではできません。",
   "sentence_ids": [
    "C24-D022-S01",
    "C24-D022-S02",
    "C24-D022-S03"
   ],
   "voice_id": "ja-jp-storyteller-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 190.403,
   "end_sec": 202.478,
   "duration_sec": 12.075
  },
  {
   "turn_id": "C24-D023",
   "turn_index": 22,
   "speaker": "木下",
   "source_text": "この本には短い例があります。語彙も一緒に学べます。知っている言葉に丸をつけて、知らない言葉は辞書を引いてください。",
   "sentence_ids": [
    "C24-D023-S01",
    "C24-D023-S02",
    "C24-D023-S03"
   ],
   "voice_id": "ja-jp-techagent-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 202.828,
   "end_sec": 210.725,
   "duration_sec": 7.897
  },
  {
   "turn_id": "C24-D024",
   "turn_index": 23,
   "speaker": "サラ",
   "source_text": "熱心に勉強して、もっと日本語で話したいです。歌が一つ歌えますから、少し得意な気分です。でも、発音はまだまだです。",
   "sentence_ids": [
    "C24-D024-S01",
    "C24-D024-S02",
    "C24-D024-S03"
   ],
   "voice_id": "ja-jp-storyteller-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 211.075,
   "end_sec": 221.986,
   "duration_sec": 10.911
  },
  {
   "turn_id": "C24-D025",
   "turn_index": 24,
   "speaker": "木下",
   "source_text": "何度も聞いて、しっかり復習してください。会館のラジオ講座でも聴解の練習ができます。今日の案内はこれで終わりです。",
   "sentence_ids": [
    "C24-D025-S01",
    "C24-D025-S02",
    "C24-D025-S03"
   ],
   "voice_id": "ja-jp-techagent-10",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 222.336,
   "end_sec": 230.142,
   "duration_sec": 7.806
  },
  {
   "turn_id": "C24-D026",
   "turn_index": 25,
   "speaker": "サラ",
   "source_text": "わたしは教室で参加します。先生のピアノの左の席でお願いします。土曜日には、声をもう一度確認します。練習の時間はバスの時刻を見て決めます。",
   "sentence_ids": [
    "C24-D026-S01",
    "C24-D026-S02",
    "C24-D026-S03",
    "C24-D026-S04"
   ],
   "voice_id": "ja-jp-storyteller-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 230.492,
   "end_sec": 243.264,
   "duration_sec": 12.772
  },
  {
   "turn_id": "C24-D027",
   "turn_index": 26,
   "speaker": "木下",
   "source_text": "はい。十月十日の十時ですね。授業は一回五百円、動画は一週間見られます。名前を書いてください。",
   "sentence_ids": [
    "C24-D027-S01",
    "C24-D027-S02",
    "C24-D027-S03",
    "C24-D027-S04"
   ],
   "voice_id": "ja-jp-techagent-10",
   "status": "candidate",
   "review_needed": true,
   "review_flags": [
    "clip_asr_difference",
    "low_ASR_text_match"
   ],
   "start_sec": 243.614,
   "end_sec": 251.279,
   "duration_sec": 7.665
  },
  {
   "turn_id": "C24-D028",
   "turn_index": 27,
   "speaker": "サラ",
   "source_text": "書けました。家で毎晩十五分、動画を見て音を聞きます。土曜日はここでピアノを練習します。新しい学習を楽しめると思います。",
   "sentence_ids": [
    "C24-D028-S01",
    "C24-D028-S02",
    "C24-D028-S03",
    "C24-D028-S04"
   ],
   "voice_id": "ja-jp-storyteller-11",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 251.629,
   "end_sec": 262.774,
   "duration_sec": 11.145
  }
 ],
 "sentence_intervals": [
  {
   "sentence_id": "C24-D001-S01",
   "unit_id": "C24-D001",
   "section": "D",
   "speaker": "木下",
   "text": "こんにちは。",
   "start_sec": 0.0,
   "end_sec": 0.643,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D001-S02",
   "unit_id": "C24-D001",
   "section": "D",
   "speaker": "木下",
   "text": "ピアノの授業に参加しますか。",
   "start_sec": 0.793,
   "end_sec": 2.877,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D001-S03",
   "unit_id": "C24-D001",
   "section": "D",
   "speaker": "木下",
   "text": "教室と家のパソコンから選べます。",
   "start_sec": 3.027,
   "end_sec": 5.552,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D001-S04",
   "unit_id": "C24-D001",
   "section": "D",
   "speaker": "木下",
   "text": "今日は見学もできます。",
   "start_sec": 5.702,
   "end_sec": 7.31,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D002-S01",
   "unit_id": "C24-D002",
   "section": "D",
   "speaker": "サラ",
   "text": "ピアノを弾いたことがありますが、今は右の手でしか弾けません。",
   "start_sec": 7.66,
   "end_sec": 12.635,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D002-S02",
   "unit_id": "C24-D002",
   "section": "D",
   "speaker": "サラ",
   "text": "レベルは初級です。",
   "start_sec": 12.785,
   "end_sec": 14.102,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D002-S03",
   "unit_id": "C24-D002",
   "section": "D",
   "speaker": "サラ",
   "text": "このコースに参加してもいいですか。",
   "start_sec": 14.252,
   "end_sec": 16.565,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D003-S01",
   "unit_id": "C24-D003",
   "section": "D",
   "speaker": "木下",
   "text": "はい。",
   "start_sec": 16.915,
   "end_sec": 17.718,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D003-S02",
   "unit_id": "C24-D003",
   "section": "D",
   "speaker": "木下",
   "text": "ゆっくり練習します。",
   "start_sec": 17.868,
   "end_sec": 19.199,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D003-S03",
   "unit_id": "C24-D003",
   "section": "D",
   "speaker": "木下",
   "text": "教材の説明は短いです。",
   "start_sec": 19.349,
   "end_sec": 21.232,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D003-S04",
   "unit_id": "C24-D003",
   "section": "D",
   "speaker": "木下",
   "text": "紙もペンもここにあります。",
   "start_sec": 21.382,
   "end_sec": 23.005,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D004-S01",
   "unit_id": "C24-D004",
   "section": "D",
   "speaker": "サラ",
   "text": "左の耳では声がはっきり聞こえないんです。",
   "start_sec": 23.355,
   "end_sec": 26.802,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D004-S02",
   "unit_id": "C24-D004",
   "section": "D",
   "speaker": "サラ",
   "text": "先生が右に見える席はありますか。",
   "start_sec": 26.952,
   "end_sec": 29.894,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D004-S03",
   "unit_id": "C24-D004",
   "section": "D",
   "speaker": "サラ",
   "text": "目で手の動きも確認したいです。",
   "start_sec": 30.044,
   "end_sec": 32.507,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D005-S01",
   "unit_id": "C24-D005",
   "section": "D",
   "speaker": "木下",
   "text": "先生のピアノの左にあります。",
   "start_sec": 32.857,
   "end_sec": 35.072,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D005-S02",
   "unit_id": "C24-D005",
   "section": "D",
   "speaker": "木下",
   "text": "教室まで案内します。",
   "start_sec": 35.222,
   "end_sec": 36.651,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D005-S03",
   "unit_id": "C24-D005",
   "section": "D",
   "speaker": "木下",
   "text": "今日は先生もいますから、声を確認できます。",
   "start_sec": 36.801,
   "end_sec": 39.779,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D006-S01",
   "unit_id": "C24-D006",
   "section": "D",
   "speaker": "サラ",
   "text": "お願いします。",
   "start_sec": 40.129,
   "end_sec": 41.868,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D006-S02",
   "unit_id": "C24-D006",
   "section": "D",
   "speaker": "サラ",
   "text": "案内の文字は理解できますが、手の動きは文章ではよく分かりません。",
   "start_sec": 42.018,
   "end_sec": 48.117,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D006-S03",
   "unit_id": "C24-D006",
   "section": "D",
   "speaker": "サラ",
   "text": "実際に見たいです。",
   "start_sec": 48.267,
   "end_sec": 49.859,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D007-S01",
   "unit_id": "C24-D007",
   "section": "D",
   "speaker": "木下",
   "text": "この席です。",
   "start_sec": 50.209,
   "end_sec": 51.384,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D007-S02",
   "unit_id": "C24-D007",
   "section": "D",
   "speaker": "木下",
   "text": "黒板の文字と先生の手が見えますか。",
   "start_sec": 51.534,
   "end_sec": 54.344,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D007-S03",
   "unit_id": "C24-D007",
   "section": "D",
   "speaker": "木下",
   "text": "先生はチョークで音の名前を書きました。",
   "start_sec": 54.494,
   "end_sec": 57.257,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D007-S04",
   "unit_id": "C24-D007",
   "section": "D",
   "speaker": "木下",
   "text": "今、ピアノを弾いています。",
   "start_sec": 57.407,
   "end_sec": 59.005,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D008-S01",
   "unit_id": "C24-D008",
   "section": "D",
   "speaker": "サラ",
   "text": "はい、どれもはっきり見えます。",
   "start_sec": 59.355,
   "end_sec": 61.965,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D008-S02",
   "unit_id": "C24-D008",
   "section": "D",
   "speaker": "サラ",
   "text": "声も聞こえます。",
   "start_sec": 62.115,
   "end_sec": 63.76,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D008-S03",
   "unit_id": "C24-D008",
   "section": "D",
   "speaker": "サラ",
   "text": "先生はピアノが上手ですね。",
   "start_sec": 63.91,
   "end_sec": 66.584,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D008-S04",
   "unit_id": "C24-D008",
   "section": "D",
   "speaker": "サラ",
   "text": "わたしにはとてもできません。",
   "start_sec": 66.734,
   "end_sec": 68.813,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D009-S01",
   "unit_id": "C24-D009",
   "section": "D",
   "speaker": "木下",
   "text": "初めは一つずつ練習します。",
   "start_sec": 69.163,
   "end_sec": 71.203,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D009-S02",
   "unit_id": "C24-D009",
   "section": "D",
   "speaker": "木下",
   "text": "今はこの教室には三人しかいませんが、授業には八人参加します。",
   "start_sec": 71.353,
   "end_sec": 76.122,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D009-S03",
   "unit_id": "C24-D009",
   "section": "D",
   "speaker": "木下",
   "text": "土曜日にも声を確認してください。",
   "start_sec": 76.272,
   "end_sec": 78.409,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D010-S01",
   "unit_id": "C24-D010",
   "section": "D",
   "speaker": "サラ",
   "text": "はい。",
   "start_sec": 78.759,
   "end_sec": 79.615,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D010-S02",
   "unit_id": "C24-D010",
   "section": "D",
   "speaker": "サラ",
   "text": "新しい歌も少しずつしか覚えられません。",
   "start_sec": 79.765,
   "end_sec": 83.455,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D010-S03",
   "unit_id": "C24-D010",
   "section": "D",
   "speaker": "サラ",
   "text": "家では動画を見たいです。",
   "start_sec": 83.605,
   "end_sec": 85.699,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D010-S04",
   "unit_id": "C24-D010",
   "section": "D",
   "speaker": "サラ",
   "text": "パソコンは苦手ですが、スマートフォンは使えます。",
   "start_sec": 85.849,
   "end_sec": 89.468,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D011-S01",
   "unit_id": "C24-D011",
   "section": "D",
   "speaker": "木下",
   "text": "スマートフォンでも見られます。",
   "start_sec": 89.818,
   "end_sec": 91.504,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D011-S02",
   "unit_id": "C24-D011",
   "section": "D",
   "speaker": "木下",
   "text": "音も何度も聞けます。",
   "start_sec": 91.654,
   "end_sec": 93.166,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D011-S03",
   "unit_id": "C24-D011",
   "section": "D",
   "speaker": "木下",
   "text": "この画面で音量を設定して、ここで文字を拡大します。",
   "start_sec": 93.316,
   "end_sec": 97.147,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D011-S04",
   "unit_id": "C24-D011",
   "section": "D",
   "speaker": "木下",
   "text": "どうですか。",
   "start_sec": 97.297,
   "end_sec": 98.082,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D012-S01",
   "unit_id": "C24-D012",
   "section": "D",
   "speaker": "サラ",
   "text": "今は字幕も読めます。",
   "start_sec": 98.432,
   "end_sec": 100.433,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D012-S02",
   "unit_id": "C24-D012",
   "section": "D",
   "speaker": "サラ",
   "text": "ピアノの音の説明もありますか。",
   "start_sec": 100.583,
   "end_sec": 103.612,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D012-S03",
   "unit_id": "C24-D012",
   "section": "D",
   "speaker": "サラ",
   "text": "音の違いがどうしても分かりません。",
   "start_sec": 103.762,
   "end_sec": 106.471,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D013-S01",
   "unit_id": "C24-D013",
   "section": "D",
   "speaker": "木下",
   "text": "字幕は先生の声だけです。",
   "start_sec": 106.821,
   "end_sec": 109.015,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D013-S02",
   "unit_id": "C24-D013",
   "section": "D",
   "speaker": "木下",
   "text": "音の説明はありません。",
   "start_sec": 109.165,
   "end_sec": 110.615,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D013-S03",
   "unit_id": "C24-D013",
   "section": "D",
   "speaker": "木下",
   "text": "手話の通訳もいません。",
   "start_sec": 110.765,
   "end_sec": 112.354,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D013-S04",
   "unit_id": "C24-D013",
   "section": "D",
   "speaker": "木下",
   "text": "分からないことは先生に相談してください。",
   "start_sec": 112.504,
   "end_sec": 114.895,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D014-S01",
   "unit_id": "C24-D014",
   "section": "D",
   "speaker": "サラ",
   "text": "友達が手話を使います。",
   "start_sec": 115.245,
   "end_sec": 117.407,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D014-S02",
   "unit_id": "C24-D014",
   "section": "D",
   "speaker": "サラ",
   "text": "参加するかどうか、まだ決めていません。",
   "start_sec": 117.557,
   "end_sec": 120.578,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D014-S03",
   "unit_id": "C24-D014",
   "section": "D",
   "speaker": "サラ",
   "text": "手振りや身振りだけでは話の内容を伝えられませんね。",
   "start_sec": 120.728,
   "end_sec": 124.971,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D015-S01",
   "unit_id": "C24-D015",
   "section": "D",
   "speaker": "木下",
   "text": "ええ。",
   "start_sec": 125.321,
   "end_sec": 125.943,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D015-S02",
   "unit_id": "C24-D015",
   "section": "D",
   "speaker": "木下",
   "text": "書いて相談することはできますが、手話で話すことはできません。",
   "start_sec": 126.093,
   "end_sec": 130.416,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D015-S03",
   "unit_id": "C24-D015",
   "section": "D",
   "speaker": "木下",
   "text": "友達にもこの違いを伝えてください。",
   "start_sec": 130.566,
   "end_sec": 132.711,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D016-S01",
   "unit_id": "C24-D016",
   "section": "D",
   "speaker": "サラ",
   "text": "はい、相談します。",
   "start_sec": 133.061,
   "end_sec": 135.566,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D016-S02",
   "unit_id": "C24-D016",
   "section": "D",
   "speaker": "サラ",
   "text": "家にはピアノがありません。",
   "start_sec": 135.716,
   "end_sec": 137.686,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D016-S03",
   "unit_id": "C24-D016",
   "section": "D",
   "speaker": "サラ",
   "text": "土曜日の午後に、ここで練習したいです。",
   "start_sec": 137.836,
   "end_sec": 141.346,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D016-S04",
   "unit_id": "C24-D016",
   "section": "D",
   "speaker": "サラ",
   "text": "授業の後で利用できますか。",
   "start_sec": 141.496,
   "end_sec": 143.87,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D017-S01",
   "unit_id": "C24-D017",
   "section": "D",
   "speaker": "木下",
   "text": "午後一時から五時まで、一時間二百円です。",
   "start_sec": 144.22,
   "end_sec": 147.132,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D017-S02",
   "unit_id": "C24-D017",
   "section": "D",
   "speaker": "木下",
   "text": "入口にバスの時間の案内があります。",
   "start_sec": 147.282,
   "end_sec": 149.753,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D017-S03",
   "unit_id": "C24-D017",
   "section": "D",
   "speaker": "木下",
   "text": "先に確認しましょうか。",
   "start_sec": 149.903,
   "end_sec": 151.523,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D018-S01",
   "unit_id": "C24-D018",
   "section": "D",
   "speaker": "サラ",
   "text": "はい。",
   "start_sec": 151.873,
   "end_sec": 152.495,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D018-S02",
   "unit_id": "C24-D018",
   "section": "D",
   "speaker": "サラ",
   "text": "家からはノンステップバスで来ます。",
   "start_sec": 152.645,
   "end_sec": 155.457,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D018-S03",
   "unit_id": "C24-D018",
   "section": "D",
   "speaker": "サラ",
   "text": "駅から歩くコースも知りたいです。",
   "start_sec": 155.607,
   "end_sec": 158.034,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D018-S04",
   "unit_id": "C24-D018",
   "section": "D",
   "speaker": "サラ",
   "text": "途中に階段はありますか。",
   "start_sec": 158.184,
   "end_sec": 160.217,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D019-S01",
   "unit_id": "C24-D019",
   "section": "D",
   "speaker": "木下",
   "text": "駅の東の道にはありません。",
   "start_sec": 160.567,
   "end_sec": 162.582,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D019-S02",
   "unit_id": "C24-D019",
   "section": "D",
   "speaker": "木下",
   "text": "駅にはエレベーターもあります。",
   "start_sec": 162.732,
   "end_sec": 164.614,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D019-S03",
   "unit_id": "C24-D019",
   "section": "D",
   "speaker": "木下",
   "text": "こちらが地図です。",
   "start_sec": 164.764,
   "end_sec": 165.962,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D019-S04",
   "unit_id": "C24-D019",
   "section": "D",
   "speaker": "木下",
   "text": "では、受付に戻りましょう。",
   "start_sec": 166.112,
   "end_sec": 167.66,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D020-S01",
   "unit_id": "C24-D020",
   "section": "D",
   "speaker": "サラ",
   "text": "ありがとうございます。",
   "start_sec": 168.01,
   "end_sec": 169.43,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D020-S02",
   "unit_id": "C24-D020",
   "section": "D",
   "speaker": "サラ",
   "text": "あの語学の本も見てもいいですか。",
   "start_sec": 169.58,
   "end_sec": 172.831,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D020-S03",
   "unit_id": "C24-D020",
   "section": "D",
   "speaker": "サラ",
   "text": "日本語の知識はまだまだ十分ではありません。",
   "start_sec": 172.981,
   "end_sec": 176.464,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D020-S04",
   "unit_id": "C24-D020",
   "section": "D",
   "speaker": "サラ",
   "text": "毎日の学習で役に立つ本が欲しいです。",
   "start_sec": 176.614,
   "end_sec": 179.941,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D021-S01",
   "unit_id": "C24-D021",
   "section": "D",
   "speaker": "木下",
   "text": "どうぞ。",
   "start_sec": 180.291,
   "end_sec": 181.049,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D021-S02",
   "unit_id": "C24-D021",
   "section": "D",
   "speaker": "木下",
   "text": "これは中級の読解、隣は上級の問題集です。",
   "start_sec": 181.199,
   "end_sec": 185.09,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D021-S03",
   "unit_id": "C24-D021",
   "section": "D",
   "speaker": "木下",
   "text": "まず短文を読んで、レベルを確認してください。",
   "start_sec": 185.24,
   "end_sec": 188.292,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D021-S04",
   "unit_id": "C24-D021",
   "section": "D",
   "speaker": "木下",
   "text": "試験問題も少しあります。",
   "start_sec": 188.442,
   "end_sec": 190.053,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D022-S01",
   "unit_id": "C24-D022",
   "section": "D",
   "speaker": "サラ",
   "text": "この文法の参考書はどうですか。",
   "start_sec": 190.403,
   "end_sec": 193.773,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D022-S02",
   "unit_id": "C24-D022",
   "section": "D",
   "speaker": "サラ",
   "text": "文型の知識はありますが、作文は下手です。",
   "start_sec": 193.923,
   "end_sec": 197.636,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D022-S03",
   "unit_id": "C24-D022",
   "section": "D",
   "speaker": "サラ",
   "text": "一生懸命書いていますが、長い作文は一日ではできません。",
   "start_sec": 197.786,
   "end_sec": 202.478,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D023-S01",
   "unit_id": "C24-D023",
   "section": "D",
   "speaker": "木下",
   "text": "この本には短い例があります。",
   "start_sec": 202.828,
   "end_sec": 204.812,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D023-S02",
   "unit_id": "C24-D023",
   "section": "D",
   "speaker": "木下",
   "text": "語彙も一緒に学べます。",
   "start_sec": 204.962,
   "end_sec": 206.499,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D023-S03",
   "unit_id": "C24-D023",
   "section": "D",
   "speaker": "木下",
   "text": "知っている言葉に丸をつけて、知らない言葉は辞書を引いてください。",
   "start_sec": 206.649,
   "end_sec": 210.725,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D024-S01",
   "unit_id": "C24-D024",
   "section": "D",
   "speaker": "サラ",
   "text": "熱心に勉強して、もっと日本語で話したいです。",
   "start_sec": 211.075,
   "end_sec": 215.536,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D024-S02",
   "unit_id": "C24-D024",
   "section": "D",
   "speaker": "サラ",
   "text": "歌が一つ歌えますから、少し得意な気分です。",
   "start_sec": 215.686,
   "end_sec": 219.661,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D024-S03",
   "unit_id": "C24-D024",
   "section": "D",
   "speaker": "サラ",
   "text": "でも、発音はまだまだです。",
   "start_sec": 219.811,
   "end_sec": 221.986,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D025-S01",
   "unit_id": "C24-D025",
   "section": "D",
   "speaker": "木下",
   "text": "何度も聞いて、しっかり復習してください。",
   "start_sec": 222.336,
   "end_sec": 225.139,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D025-S02",
   "unit_id": "C24-D025",
   "section": "D",
   "speaker": "木下",
   "text": "会館のラジオ講座でも聴解の練習ができます。",
   "start_sec": 225.289,
   "end_sec": 228.205,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D025-S03",
   "unit_id": "C24-D025",
   "section": "D",
   "speaker": "木下",
   "text": "今日の案内はこれで終わりです。",
   "start_sec": 228.355,
   "end_sec": 230.142,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D026-S01",
   "unit_id": "C24-D026",
   "section": "D",
   "speaker": "サラ",
   "text": "わたしは教室で参加します。",
   "start_sec": 230.492,
   "end_sec": 233.028,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D026-S02",
   "unit_id": "C24-D026",
   "section": "D",
   "speaker": "サラ",
   "text": "先生のピアノの左の席でお願いします。",
   "start_sec": 233.178,
   "end_sec": 236.483,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D026-S03",
   "unit_id": "C24-D026",
   "section": "D",
   "speaker": "サラ",
   "text": "土曜日には、声をもう一度確認します。",
   "start_sec": 236.633,
   "end_sec": 239.812,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D026-S04",
   "unit_id": "C24-D026",
   "section": "D",
   "speaker": "サラ",
   "text": "練習の時間はバスの時刻を見て決めます。",
   "start_sec": 239.962,
   "end_sec": 243.264,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D027-S01",
   "unit_id": "C24-D027",
   "section": "D",
   "speaker": "木下",
   "text": "はい。",
   "start_sec": 243.614,
   "end_sec": 244.18,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D027-S02",
   "unit_id": "C24-D027",
   "section": "D",
   "speaker": "木下",
   "text": "十月十日の十時ですね。",
   "start_sec": 244.33,
   "end_sec": 246.222,
   "review_flags": [
    "low_ASR_text_match",
    "clip_asr_difference"
   ],
   "replacement": null
  },
  {
   "sentence_id": "C24-D027-S03",
   "unit_id": "C24-D027",
   "section": "D",
   "speaker": "木下",
   "text": "授業は一回五百円、動画は一週間見られます。",
   "start_sec": 246.372,
   "end_sec": 249.84,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D027-S04",
   "unit_id": "C24-D027",
   "section": "D",
   "speaker": "木下",
   "text": "名前を書いてください。",
   "start_sec": 249.99,
   "end_sec": 251.279,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D028-S01",
   "unit_id": "C24-D028",
   "section": "D",
   "speaker": "サラ",
   "text": "書けました。",
   "start_sec": 251.629,
   "end_sec": 252.873,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D028-S02",
   "unit_id": "C24-D028",
   "section": "D",
   "speaker": "サラ",
   "text": "家で毎晩十五分、動画を見て音を聞きます。",
   "start_sec": 253.023,
   "end_sec": 256.761,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D028-S03",
   "unit_id": "C24-D028",
   "section": "D",
   "speaker": "サラ",
   "text": "土曜日はここでピアノを練習します。",
   "start_sec": 256.911,
   "end_sec": 259.954,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C24-D028-S04",
   "unit_id": "C24-D028",
   "section": "D",
   "speaker": "サラ",
   "text": "新しい学習を楽しめると思います。",
   "start_sec": 260.104,
   "end_sec": 262.774,
   "review_flags": [],
   "replacement": null
  }
 ]
}
