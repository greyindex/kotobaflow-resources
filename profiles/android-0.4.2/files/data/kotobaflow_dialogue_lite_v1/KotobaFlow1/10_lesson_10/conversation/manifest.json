  {
   "turn_id": "C10-D002",
   "turn_index": 1,
   "speaker": "林梅",
   "source_text": "はい、二人です。あのテーブルですか。",
   "sentence_ids": [
    "C10-D002-S01",
    "C10-D002-S02"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
