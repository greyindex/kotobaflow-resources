   "end_sec": 5.851,
   "duration_sec": 3.216
  },
  {
   "turn_id": "C10-D003",
   "turn_index": 2,
   "speaker": "店の人",
   "source_text": "あのテーブルに三人います。こちらへどうぞ。メニューはここにあります。",
   "sentence_ids": [
    "C10-D003-S01",
    "C10-D003-S02",
    "C10-D003-S03"
   ],
   "voice_id": "ja-jp-storyteller-1",
   "status": "candidate",
   "review_needed": false,
