   "end_sec": 89.225,
   "duration_sec": 3.975
  },
  {
   "turn_id": "C10-D018",
   "turn_index": 17,
   "speaker": "店の人",
   "source_text": "この小さいのです。一個二百円です。卵のパンは四百円です。",
   "sentence_ids": [
    "C10-D018-S01",
    "C10-D018-S02",
    "C10-D018-S03"
   ],
   "voice_id": "ja-jp-storyteller-1",
