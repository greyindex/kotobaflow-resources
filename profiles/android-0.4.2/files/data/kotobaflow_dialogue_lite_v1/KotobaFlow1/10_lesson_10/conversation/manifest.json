  },
  {
   "turn_id": "C10-D022",
   "turn_index": 21,
   "speaker": "マテオ",
   "source_text": "いいえ、数が違います。二つだけです。袋は一枚ください。",
   "sentence_ids": [
    "C10-D022-S01",
    "C10-D022-S02",
