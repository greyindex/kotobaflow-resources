   "duration_sec": 7.724
  },
  {
   "turn_id": "C10-D015",
   "turn_index": 14,
   "speaker": "マテオ",
   "source_text": "パンも欲しいです。この大きいパンはいくらしますか。",
   "sentence_ids": [
    "C10-D015-S01",
    "C10-D015-S02"
   ],
   "voice_id": "ja-jp-commercial-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 79.583,
   "end_sec": 83.006,
   "duration_sec": 3.423
  },
  {
   "turn_id": "C10-D016",
   "turn_index": 15,
   "speaker": "店の人",
   "source_text": "一個五百円です。",
   "sentence_ids": [
    "C10-D016-S01"
   ],
   "voice_id": "ja-jp-storyteller-1",
   "status": "candidate",
   "review_needed": false,
