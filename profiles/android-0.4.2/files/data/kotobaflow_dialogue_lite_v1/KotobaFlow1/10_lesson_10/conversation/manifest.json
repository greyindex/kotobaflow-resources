  },
  {
   "turn_id": "C10-D019",
   "turn_index": 18,
   "speaker": "林梅",
   "source_text": "マテオさん、パンをいくつ買いますか。",
   "sentence_ids": [
    "C10-D019-S01"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
