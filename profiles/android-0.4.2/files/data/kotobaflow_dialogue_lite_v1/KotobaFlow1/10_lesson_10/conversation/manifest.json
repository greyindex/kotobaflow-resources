   "end_sec": 84.9,
   "duration_sec": 1.544
  },
  {
   "turn_id": "C10-D017",
   "turn_index": 16,
   "speaker": "マテオ",
   "source_text": "五百円もしますか。どのパンが安いですか。",
   "sentence_ids": [
    "C10-D017-S01",
    "C10-D017-S02"
   ],
   "voice_id": "ja-jp-commercial-4",
   "status": "candidate",
   "review_needed": false,
