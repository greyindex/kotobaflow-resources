   "end_sec": 185.165,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D026-S01",
   "unit_id": "C14-D026",
   "section": "D",
   "speaker": "マテオ",
   "text": "はい。",
