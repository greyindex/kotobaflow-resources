  },
  {
   "sentence_id": "C14-D023-S02",
   "unit_id": "C14-D023",
   "section": "D",
   "speaker": "リン",
   "text": "隣の教室で話しています。",
   "start_sec": 167.364,
   "end_sec": 169.367,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D023-S03",
   "unit_id": "C14-D023",
   "section": "D",
   "speaker": "リン",
   "text": "ここで待ちましょう。",
   "start_sec": 169.517,
   "end_sec": 170.791,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D024-S01",
   "unit_id": "C14-D024",
   "section": "D",
   "speaker": "マテオ",
   "text": "では、答えを書きます。",
   "start_sec": 171.141,
   "end_sec": 172.661,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D024-S02",
   "unit_id": "C14-D024",
   "section": "D",
   "speaker": "マテオ",
   "text": "家の食卓でよく勉強しています。",
   "start_sec": 172.811,
   "end_sec": 175.206,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D024-S03",
   "unit_id": "C14-D024",
   "section": "D",
   "speaker": "マテオ",
   "text": "コーヒーカップは別の机に置きます。",
   "start_sec": 175.356,
   "end_sec": 177.627,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D025-S01",
   "unit_id": "C14-D025",
   "section": "D",
   "speaker": "リン",
   "text": "飲み物は別の机ですね。",
