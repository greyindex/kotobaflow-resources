   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D026-S03",
   "unit_id": "C14-D026",
   "section": "D",
   "speaker": "マテオ",
   "text": "封筒に入れます。",
   "start_sec": 187.901,
   "end_sec": 188.97,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D026-S04",
   "unit_id": "C14-D026",
   "section": "D",
   "speaker": "マテオ",
   "text": "リンさんももう書きましたか。",
