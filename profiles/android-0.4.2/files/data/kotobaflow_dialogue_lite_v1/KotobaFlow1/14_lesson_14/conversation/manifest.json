   "end_sec": 182.997,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D025-S03",
   "unit_id": "C14-D025",
   "section": "D",
   "speaker": "リン",
   "text": "勉強の後は休憩しましょう。",
