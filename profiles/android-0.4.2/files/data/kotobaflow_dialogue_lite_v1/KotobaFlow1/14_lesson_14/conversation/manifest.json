   "end_sec": 195.991,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D029-S01",
   "unit_id": "C14-D029",
   "section": "D",
   "speaker": "マテオ",
   "text": "来週の授業はどの教室ですか。",
