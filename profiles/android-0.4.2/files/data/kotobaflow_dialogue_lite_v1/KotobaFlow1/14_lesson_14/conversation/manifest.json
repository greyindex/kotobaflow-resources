   "end_sec": 180.226,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D025-S02",
   "unit_id": "C14-D025",
   "section": "D",
   "speaker": "リン",
   "text": "私はインスタントのコーヒーをよく飲みます。",
