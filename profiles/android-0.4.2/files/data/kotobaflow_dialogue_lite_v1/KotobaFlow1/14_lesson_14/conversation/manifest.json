 "source_chapter": 14,
 "turns": [
  {
   "turn_id": "C14-D001",
   "turn_index": 0,
   "speaker": "林梅",
   "source_text": "すみません。家族との電話はもう終わりました。今、何をしていますか。",
   "sentence_ids": [
    "C14-D001-S01",
    "C14-D001-S02",
    "C14-D001-S03"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 0.0,
   "end_sec": 5.423,
   "duration_sec": 5.423
  },
  {
   "turn_id": "C14-D002",
   "turn_index": 1,
   "speaker": "マテオ",
   "source_text": "来週の授業の準備をしています。この二枚の紙を見てください。毎週の質問にはまだ答えていません。",
   "sentence_ids": [
    "C14-D002-S01",
    "C14-D002-S02",
    "C14-D002-S03"
   ],
   "voice_id": "ja-jp-commercial-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 5.773,
   "end_sec": 12.628,
   "duration_sec": 6.855
  },
  {
   "turn_id": "C14-D003",
   "turn_index": 2,
   "speaker": "林梅",
   "source_text": "一緒に読みましょう。「普段、どこで暮らしていますか」。町の名前だけでいいです。",
   "sentence_ids": [
    "C14-D003-S01",
    "C14-D003-S02",
    "C14-D003-S03"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 12.978,
   "end_sec": 18.576,
   "duration_sec": 5.598
  },
  {
   "turn_id": "C14-D004",
   "turn_index": 3,
   "speaker": "マテオ",
   "source_text": "みどり町です。今日の答えはもう書きました。毎週の答えはこれから書きます。",
   "sentence_ids": [
    "C14-D004-S01",
    "C14-D004-S02",
    "C14-D004-S03"
   ],
   "voice_id": "ja-jp-commercial-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 18.926,
   "end_sec": 24.192,
   "duration_sec": 5.266
  },
  {
   "turn_id": "C14-D005",
   "turn_index": 4,
   "speaker": "林梅",
   "source_text": "この町にずっと住んでいますか。私は去年から住んでいます。",
   "sentence_ids": [
    "C14-D005-S01",
    "C14-D005-S02"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 24.542,
   "end_sec": 29.015,
   "duration_sec": 4.473
  },
  {
   "turn_id": "C14-D006",
   "turn_index": 5,
   "speaker": "マテオ",
   "source_text": "はい、三年前からずっと住んでいます。私は大学生です。父は駅の近くの会社に勤めています。",
   "sentence_ids": [
    "C14-D006-S01",
    "C14-D006-S02",
    "C14-D006-S03"
   ],
   "voice_id": "ja-jp-commercial-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 29.365,
   "end_sec": 36.797,
   "duration_sec": 7.432
  },
  {
   "turn_id": "C14-D007",
   "turn_index": 6,
   "speaker": "林梅",
   "source_text": "お父さんは毎日、何時に出勤していますか。私は昼は学校で勉強しています。夜は家で過ごしています。",
   "sentence_ids": [
    "C14-D007-S01",
    "C14-D007-S02",
    "C14-D007-S03"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 37.147,
   "end_sec": 45.468,
   "duration_sec": 8.321
  },
  {
   "turn_id": "C14-D008",
   "turn_index": 7,
   "speaker": "マテオ",
   "source_text": "八時半です。父は毎朝きちんと八時に家を出ます。公園を通って、会社へ行きます。公園の中を十分ぐらい歩きます。",
   "sentence_ids": [
    "C14-D008-S01",
    "C14-D008-S02",
    "C14-D008-S03",
    "C14-D008-S04"
   ],
   "voice_id": "ja-jp-commercial-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 45.818,
   "end_sec": 54.746,
   "duration_sec": 8.928
  },
  {
   "turn_id": "C14-D009",
   "turn_index": 8,
   "speaker": "林梅",
   "source_text": "お父さんは毎朝歩いていますね。私は一週間に二回、公園で運動しています。毎年、町の運動会にも出ています。",
   "sentence_ids": [
    "C14-D009-S01",
    "C14-D009-S02",
    "C14-D009-S03"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 55.096,
   "end_sec": 63.849,
   "duration_sec": 8.753
  },
  {
   "turn_id": "C14-D010",
   "turn_index": 9,
   "speaker": "マテオ",
   "source_text": "私は時々です。夜はいつも日本語の練習をしています。机の文房具はきちんと並べます。電気スタンドは左に置きます。",
   "sentence_ids": [
    "C14-D010-S01",
    "C14-D010-S02",
    "C14-D010-S03",
    "C14-D010-S04"
   ],
   "voice_id": "ja-jp-commercial-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 64.199,
   "end_sec": 74.11,
   "duration_sec": 9.911
  },
  {
   "turn_id": "C14-D011",
   "turn_index": 10,
   "speaker": "林梅",
   "source_text": "夜は何時まで勉強していますか。私は大抵九時までです。深夜は勉強しません。",
   "sentence_ids": [
    "C14-D011-S01",
    "C14-D011-S02",
    "C14-D011-S03"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 74.46,
   "end_sec": 80.864,
   "duration_sec": 6.404
  },
  {
   "turn_id": "C14-D012",
   "turn_index": 11,
   "speaker": "マテオ",
   "source_text": "私も九時までです。夜中はいつも寝ています。夜食はめったに食べません。夕食は七時です。",
   "sentence_ids": [
    "C14-D012-S01",
    "C14-D012-S02",
    "C14-D012-S03",
    "C14-D012-S04"
   ],
   "voice_id": "ja-jp-commercial-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 81.214,
   "end_sec": 88.501,
   "duration_sec": 7.287
  },
  {
   "turn_id": "C14-D013",
   "turn_index": 12,
   "speaker": "林梅",
   "source_text": "夕食は家で食べていますか。私はたまに外食します。普段は家でおかずを作ります。",
   "sentence_ids": [
    "C14-D013-S01",
    "C14-D013-S02",
    "C14-D013-S03"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 88.851,
   "end_sec": 95.369,
   "duration_sec": 6.518
  },
  {
   "turn_id": "C14-D014",
   "turn_index": 13,
   "speaker": "マテオ",
   "source_text": "私も家で食べます。時にはレトルトのカレーを食べます。普段の昼食は大学の食堂です。即席めんはあまり食べません。",
   "sentence_ids": [
    "C14-D014-S01",
    "C14-D014-S02",
    "C14-D014-S03",
    "C14-D014-S04"
   ],
   "voice_id": "ja-jp-commercial-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 95.719,
   "end_sec": 103.918,
   "duration_sec": 8.199
  },
  {
   "turn_id": "C14-D015",
   "turn_index": 14,
   "speaker": "林梅",
   "source_text": "食事の後は何をしていますか。私はお風呂に入って、テレビを見ます。家族にもよく電話します。昨日は家族が留守でした。",
   "sentence_ids": [
    "C14-D015-S01",
    "C14-D015-S02",
    "C14-D015-S03",
    "C14-D015-S04"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 104.268,
   "end_sec": 114.265,
   "duration_sec": 9.997
  },
  {
   "turn_id": "C14-D016",
   "turn_index": 15,
   "speaker": "マテオ",
   "source_text": "今日はもう話しましたね。兄弟はいますか。私も今朝、家族に電話しました。",
   "sentence_ids": [
    "C14-D016-S01",
    "C14-D016-S02",
    "C14-D016-S03"
   ],
   "voice_id": "ja-jp-commercial-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 114.615,
   "end_sec": 119.836,
   "duration_sec": 5.221
  },
  {
   "turn_id": "C14-D017",
   "turn_index": 16,
   "speaker": "林梅",
   "source_text": "はい、二人姉妹です。家族は別の町に住んでいます。定期的に電話しています。家族は昼に働いています。",
   "sentence_ids": [
    "C14-D017-S01",
    "C14-D017-S02",
    "C14-D017-S03",
    "C14-D017-S04"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 120.186,
   "end_sec": 128.517,
   "duration_sec": 8.331
  },
  {
   "turn_id": "C14-D018",
   "turn_index": 17,
   "speaker": "マテオ",
   "source_text": "私は毎週、家族と話しています。家では日本語を全然話しません。センターでたくさん練習したいです。",
   "sentence_ids": [
    "C14-D018-S01",
    "C14-D018-S02",
    "C14-D018-S03"
   ],
   "voice_id": "ja-jp-commercial-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 128.867,
   "end_sec": 135.629,
   "duration_sec": 6.762
  },
  {
   "turn_id": "C14-D019",
   "turn_index": 18,
   "speaker": "林梅",
   "source_text": "ここでも質問していいですよ。私も先生に度々質問しています。お父さんは今日も仕事ですか。",
   "sentence_ids": [
    "C14-D019-S01",
    "C14-D019-S02",
    "C14-D019-S03"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 135.979,
   "end_sec": 143.207,
   "duration_sec": 7.228
  },
  {
   "turn_id": "C14-D020",
   "turn_index": 19,
   "speaker": "マテオ",
   "source_text": "父は今日は休みです。私は朝、家事をしました。洗濯機を使って、服を洗いました。パクさんは今日も働いていますか。",
   "sentence_ids": [
    "C14-D020-S01",
    "C14-D020-S02",
    "C14-D020-S03",
    "C14-D020-S04"
   ],
   "voice_id": "ja-jp-commercial-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 143.557,
   "end_sec": 152.172,
   "duration_sec": 8.615
  },
  {
   "turn_id": "C14-D021",
   "turn_index": 20,
   "speaker": "林梅",
   "source_text": "今日の予定は知りません。今、パクさんはここにいませんね。中村さんに聞きますか。",
   "sentence_ids": [
    "C14-D021-S01",
    "C14-D021-S02",
    "C14-D021-S03"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 152.522,
   "end_sec": 158.577,
   "duration_sec": 6.055
  },
  {
   "turn_id": "C14-D022",
   "turn_index": 21,
   "speaker": "マテオ",
   "source_text": "はい。中村さんともまだ話していません。もうすぐ二時半ですね。会議はもう終わりましたか。",
   "sentence_ids": [
    "C14-D022-S01",
    "C14-D022-S02",
    "C14-D022-S03",
    "C14-D022-S04"
   ],
   "voice_id": "ja-jp-commercial-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 158.927,
   "end_sec": 165.661,
   "duration_sec": 6.734
  },
  {
   "turn_id": "C14-D023",
   "turn_index": 22,
   "speaker": "林梅",
   "source_text": "いいえ、まだです。隣の教室で話しています。ここで待ちましょう。",
   "sentence_ids": [
    "C14-D023-S01",
    "C14-D023-S02",
    "C14-D023-S03"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 166.011,
   "end_sec": 170.791,
   "duration_sec": 4.78
  },
  {
   "turn_id": "C14-D024",
   "turn_index": 23,
   "speaker": "マテオ",
   "source_text": "では、答えを書きます。家の食卓でよく勉強しています。コーヒーカップは別の机に置きます。",
   "sentence_ids": [
    "C14-D024-S01",
    "C14-D024-S02",
    "C14-D024-S03"
   ],
   "voice_id": "ja-jp-commercial-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 171.141,
   "end_sec": 177.627,
   "duration_sec": 6.486
  },
  {
   "turn_id": "C14-D025",
   "turn_index": 24,
   "speaker": "林梅",
   "source_text": "飲み物は別の机ですね。私はインスタントのコーヒーをよく飲みます。勉強の後は休憩しましょう。",
   "sentence_ids": [
    "C14-D025-S01",
    "C14-D025-S02",
    "C14-D025-S03"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 177.977,
   "end_sec": 185.165,
   "duration_sec": 7.188
  },
  {
   "turn_id": "C14-D026",
   "turn_index": 25,
   "speaker": "マテオ",
   "source_text": "はい。答えはもう書きました。封筒に入れます。リンさんももう書きましたか。",
   "sentence_ids": [
    "C14-D026-S01",
    "C14-D026-S02",
    "C14-D026-S03",
    "C14-D026-S04"
   ],
   "voice_id": "ja-jp-commercial-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 185.515,
   "end_sec": 190.57,
   "duration_sec": 5.055
  },
  {
   "turn_id": "C14-D027",
   "turn_index": 26,
   "speaker": "林梅",
   "source_text": "はい、もう書きました。休憩は三時からです。今は教科書を読みます。",
   "sentence_ids": [
    "C14-D027-S01",
    "C14-D027-S02",
    "C14-D027-S03"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 190.92,
   "end_sec": 195.991,
   "duration_sec": 5.071
  },
  {
   "turn_id": "C14-D029",
   "turn_index": 27,
   "speaker": "マテオ",
   "source_text": "来週の授業はどの教室ですか。リンさんは知っていますか。ノートに書きたいです。",
   "sentence_ids": [
    "C14-D029-S01",
    "C14-D029-S02",
    "C14-D029-S03"
   ],
   "voice_id": "ja-jp-commercial-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 196.341,
   "end_sec": 201.79,
   "duration_sec": 5.449
  },
  {
   "turn_id": "C14-D030",
   "turn_index": 28,
   "speaker": "林梅",
   "source_text": "はい、この教室です。土曜日の午前十時からです。先生はユーリさんです。",
   "sentence_ids": [
    "C14-D030-S01",
    "C14-D030-S02",
    "C14-D030-S03"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 202.14,
   "end_sec": 207.49,
   "duration_sec": 5.35
  },
  {
   "turn_id": "C14-D028",
   "turn_index": 29,
   "speaker": "マテオ",
   "source_text": "ありがとうございます。まず中村さんに会場のことを聞きます。それから休憩しましょう。",
   "sentence_ids": [
    "C14-D028-S01",
    "C14-D028-S02",
    "C14-D028-S03"
   ],
   "voice_id": "ja-jp-commercial-4",
   "status": "candidate",
   "review_needed": false,
   "review_flags": [],
   "start_sec": 207.84,
   "end_sec": 213.078,
   "duration_sec": 5.238
  }
 ],
 "sentence_intervals": [
  {
   "sentence_id": "C14-D001-S01",
   "unit_id": "C14-D001",
   "section": "D",
   "speaker": "リン",
   "text": "すみません。",
   "start_sec": 0.0,
   "end_sec": 1.141,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D001-S02",
   "unit_id": "C14-D001",
   "section": "D",
   "speaker": "リン",
   "text": "家族との電話はもう終わりました。",
   "start_sec": 1.291,
   "end_sec": 3.686,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D001-S03",
   "unit_id": "C14-D001",
   "section": "D",
   "speaker": "リン",
   "text": "今、何をしていますか。",
   "start_sec": 3.836,
   "end_sec": 5.423,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D002-S01",
   "unit_id": "C14-D002",
   "section": "D",
   "speaker": "マテオ",
   "text": "来週の授業の準備をしています。",
   "start_sec": 5.773,
   "end_sec": 8.025,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D002-S02",
   "unit_id": "C14-D002",
   "section": "D",
   "speaker": "マテオ",
   "text": "この二枚の紙を見てください。",
   "start_sec": 8.175,
   "end_sec": 10.21,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D002-S03",
   "unit_id": "C14-D002",
   "section": "D",
   "speaker": "マテオ",
   "text": "毎週の質問にはまだ答えていません。",
   "start_sec": 10.36,
   "end_sec": 12.628,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D003-S01",
   "unit_id": "C14-D003",
   "section": "D",
   "speaker": "リン",
   "text": "一緒に読みましょう。",
   "start_sec": 12.978,
   "end_sec": 14.35,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D003-S02",
   "unit_id": "C14-D003",
   "section": "D",
   "speaker": "リン",
   "text": "「普段、どこで暮らしていますか」。",
   "start_sec": 14.5,
   "end_sec": 16.755,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D003-S03",
   "unit_id": "C14-D003",
   "section": "D",
   "speaker": "リン",
   "text": "町の名前だけでいいです。",
   "start_sec": 16.905,
   "end_sec": 18.576,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D004-S01",
   "unit_id": "C14-D004",
   "section": "D",
   "speaker": "マテオ",
   "text": "みどり町です。",
   "start_sec": 18.926,
   "end_sec": 19.987,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D004-S02",
   "unit_id": "C14-D004",
   "section": "D",
   "speaker": "マテオ",
   "text": "今日の答えはもう書きました。",
   "start_sec": 20.137,
   "end_sec": 22.024,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D004-S03",
   "unit_id": "C14-D004",
   "section": "D",
   "speaker": "マテオ",
   "text": "毎週の答えはこれから書きます。",
   "start_sec": 22.174,
   "end_sec": 24.192,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D005-S01",
   "unit_id": "C14-D005",
   "section": "D",
   "speaker": "リン",
   "text": "この町にずっと住んでいますか。",
   "start_sec": 24.542,
   "end_sec": 26.829,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D005-S02",
   "unit_id": "C14-D005",
   "section": "D",
   "speaker": "リン",
   "text": "私は去年から住んでいます。",
   "start_sec": 26.979,
   "end_sec": 29.015,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D006-S01",
   "unit_id": "C14-D006",
   "section": "D",
   "speaker": "マテオ",
   "text": "はい、三年前からずっと住んでいます。",
   "start_sec": 29.365,
   "end_sec": 32.358,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D006-S02",
   "unit_id": "C14-D006",
   "section": "D",
   "speaker": "マテオ",
   "text": "私は大学生です。",
   "start_sec": 32.508,
   "end_sec": 33.988,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D006-S03",
   "unit_id": "C14-D006",
   "section": "D",
   "speaker": "マテオ",
   "text": "父は駅の近くの会社に勤めています。",
   "start_sec": 34.138,
   "end_sec": 36.797,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D007-S01",
   "unit_id": "C14-D007",
   "section": "D",
   "speaker": "リン",
   "text": "お父さんは毎日、何時に出勤していますか。",
   "start_sec": 37.147,
   "end_sec": 40.715,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D007-S02",
   "unit_id": "C14-D007",
   "section": "D",
   "speaker": "リン",
   "text": "私は昼は学校で勉強しています。",
   "start_sec": 40.865,
   "end_sec": 43.54,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D007-S03",
   "unit_id": "C14-D007",
   "section": "D",
   "speaker": "リン",
   "text": "夜は家で過ごしています。",
   "start_sec": 43.69,
   "end_sec": 45.468,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D008-S01",
   "unit_id": "C14-D008",
   "section": "D",
   "speaker": "マテオ",
   "text": "八時半です。",
   "start_sec": 45.818,
   "end_sec": 47.125,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D008-S02",
   "unit_id": "C14-D008",
   "section": "D",
   "speaker": "マテオ",
   "text": "父は毎朝きちんと八時に家を出ます。",
   "start_sec": 47.275,
   "end_sec": 49.935,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D008-S03",
   "unit_id": "C14-D008",
   "section": "D",
   "speaker": "マテオ",
   "text": "公園を通って、会社へ行きます。",
   "start_sec": 50.085,
   "end_sec": 52.236,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D008-S04",
   "unit_id": "C14-D008",
   "section": "D",
   "speaker": "マテオ",
   "text": "公園の中を十分ぐらい歩きます。",
   "start_sec": 52.386,
   "end_sec": 54.746,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D009-S01",
   "unit_id": "C14-D009",
   "section": "D",
   "speaker": "リン",
   "text": "お父さんは毎朝歩いていますね。",
   "start_sec": 55.096,
   "end_sec": 57.566,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D009-S02",
   "unit_id": "C14-D009",
   "section": "D",
   "speaker": "リン",
   "text": "私は一週間に二回、公園で運動しています。",
   "start_sec": 57.716,
   "end_sec": 61.095,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D009-S03",
   "unit_id": "C14-D009",
   "section": "D",
   "speaker": "リン",
   "text": "毎年、町の運動会にも出ています。",
   "start_sec": 61.245,
   "end_sec": 63.849,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D010-S01",
   "unit_id": "C14-D010",
   "section": "D",
   "speaker": "マテオ",
   "text": "私は時々です。",
   "start_sec": 64.199,
   "end_sec": 66.108,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D010-S02",
   "unit_id": "C14-D010",
   "section": "D",
   "speaker": "マテオ",
   "text": "夜はいつも日本語の練習をしています。",
   "start_sec": 66.258,
   "end_sec": 69.018,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D010-S03",
   "unit_id": "C14-D010",
   "section": "D",
   "speaker": "マテオ",
   "text": "机の文房具はきちんと並べます。",
   "start_sec": 69.168,
   "end_sec": 71.869,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D010-S04",
   "unit_id": "C14-D010",
   "section": "D",
   "speaker": "マテオ",
   "text": "電気スタンドは左に置きます。",
   "start_sec": 72.019,
   "end_sec": 74.11,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D011-S01",
   "unit_id": "C14-D011",
   "section": "D",
   "speaker": "リン",
   "text": "夜は何時まで勉強していますか。",
   "start_sec": 74.46,
   "end_sec": 76.966,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D011-S02",
   "unit_id": "C14-D011",
   "section": "D",
   "speaker": "リン",
   "text": "私は大抵九時までです。",
   "start_sec": 77.116,
   "end_sec": 79.131,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D011-S03",
   "unit_id": "C14-D011",
   "section": "D",
   "speaker": "リン",
   "text": "深夜は勉強しません。",
   "start_sec": 79.281,
   "end_sec": 80.864,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D012-S01",
   "unit_id": "C14-D012",
   "section": "D",
   "speaker": "マテオ",
   "text": "私も九時までです。",
   "start_sec": 81.214,
   "end_sec": 82.772,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D012-S02",
   "unit_id": "C14-D012",
   "section": "D",
   "speaker": "マテオ",
   "text": "夜中はいつも寝ています。",
   "start_sec": 82.922,
   "end_sec": 84.946,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D012-S03",
   "unit_id": "C14-D012",
   "section": "D",
   "speaker": "マテオ",
   "text": "夜食はめったに食べません。",
   "start_sec": 85.096,
   "end_sec": 87.017,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D012-S04",
   "unit_id": "C14-D012",
   "section": "D",
   "speaker": "マテオ",
   "text": "夕食は七時です。",
   "start_sec": 87.167,
   "end_sec": 88.501,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D013-S01",
   "unit_id": "C14-D013",
   "section": "D",
   "speaker": "リン",
   "text": "夕食は家で食べていますか。",
   "start_sec": 88.851,
   "end_sec": 91.063,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D013-S02",
   "unit_id": "C14-D013",
   "section": "D",
   "speaker": "リン",
   "text": "私はたまに外食します。",
   "start_sec": 91.213,
   "end_sec": 93.077,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D013-S03",
   "unit_id": "C14-D013",
   "section": "D",
   "speaker": "リン",
   "text": "普段は家でおかずを作ります。",
   "start_sec": 93.227,
   "end_sec": 95.369,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D014-S01",
   "unit_id": "C14-D014",
   "section": "D",
   "speaker": "マテオ",
   "text": "私も家で食べます。",
   "start_sec": 95.719,
   "end_sec": 97.189,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D014-S02",
   "unit_id": "C14-D014",
   "section": "D",
   "speaker": "マテオ",
   "text": "時にはレトルトのカレーを食べます。",
   "start_sec": 97.339,
   "end_sec": 99.529,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D014-S03",
   "unit_id": "C14-D014",
   "section": "D",
   "speaker": "マテオ",
   "text": "普段の昼食は大学の食堂です。",
   "start_sec": 99.679,
   "end_sec": 101.943,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D014-S04",
   "unit_id": "C14-D014",
   "section": "D",
   "speaker": "マテオ",
   "text": "即席めんはあまり食べません。",
   "start_sec": 102.093,
   "end_sec": 103.918,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D015-S01",
   "unit_id": "C14-D015",
   "section": "D",
   "speaker": "リン",
   "text": "食事の後は何をしていますか。",
   "start_sec": 104.268,
   "end_sec": 106.766,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D015-S02",
   "unit_id": "C14-D015",
   "section": "D",
   "speaker": "リン",
   "text": "私はお風呂に入って、テレビを見ます。",
   "start_sec": 106.916,
   "end_sec": 110.292,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D015-S03",
   "unit_id": "C14-D015",
   "section": "D",
   "speaker": "リン",
   "text": "家族にもよく電話します。",
   "start_sec": 110.442,
   "end_sec": 112.231,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D015-S04",
   "unit_id": "C14-D015",
   "section": "D",
   "speaker": "リン",
   "text": "昨日は家族が留守でした。",
   "start_sec": 112.381,
   "end_sec": 114.265,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D016-S01",
   "unit_id": "C14-D016",
   "section": "D",
   "speaker": "マテオ",
   "text": "今日はもう話しましたね。",
   "start_sec": 114.615,
   "end_sec": 116.121,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D016-S02",
   "unit_id": "C14-D016",
   "section": "D",
   "speaker": "マテオ",
   "text": "兄弟はいますか。",
   "start_sec": 116.271,
   "end_sec": 117.492,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D016-S03",
   "unit_id": "C14-D016",
   "section": "D",
   "speaker": "マテオ",
   "text": "私も今朝、家族に電話しました。",
   "start_sec": 117.642,
   "end_sec": 119.836,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D017-S01",
   "unit_id": "C14-D017",
   "section": "D",
   "speaker": "リン",
   "text": "はい、二人姉妹です。",
   "start_sec": 120.186,
   "end_sec": 121.837,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D017-S02",
   "unit_id": "C14-D017",
   "section": "D",
   "speaker": "リン",
   "text": "家族は別の町に住んでいます。",
   "start_sec": 121.987,
   "end_sec": 124.332,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D017-S03",
   "unit_id": "C14-D017",
   "section": "D",
   "speaker": "リン",
   "text": "定期的に電話しています。",
   "start_sec": 124.482,
   "end_sec": 126.232,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D017-S04",
   "unit_id": "C14-D017",
   "section": "D",
   "speaker": "リン",
   "text": "家族は昼に働いています。",
   "start_sec": 126.382,
   "end_sec": 128.517,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D018-S01",
   "unit_id": "C14-D018",
   "section": "D",
   "speaker": "マテオ",
   "text": "私は毎週、家族と話しています。",
   "start_sec": 128.867,
   "end_sec": 131.079,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D018-S02",
   "unit_id": "C14-D018",
   "section": "D",
   "speaker": "マテオ",
   "text": "家では日本語を全然話しません。",
   "start_sec": 131.229,
   "end_sec": 133.489,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D018-S03",
   "unit_id": "C14-D018",
   "section": "D",
   "speaker": "マテオ",
   "text": "センターでたくさん練習したいです。",
   "start_sec": 133.639,
   "end_sec": 135.629,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D019-S01",
   "unit_id": "C14-D019",
   "section": "D",
   "speaker": "リン",
   "text": "ここでも質問していいですよ。",
   "start_sec": 135.979,
   "end_sec": 138.003,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D019-S02",
   "unit_id": "C14-D019",
   "section": "D",
   "speaker": "リン",
   "text": "私も先生に度々質問しています。",
   "start_sec": 138.153,
   "end_sec": 140.847,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D019-S03",
   "unit_id": "C14-D019",
   "section": "D",
   "speaker": "リン",
   "text": "お父さんは今日も仕事ですか。",
   "start_sec": 140.997,
   "end_sec": 143.207,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D020-S01",
   "unit_id": "C14-D020",
   "section": "D",
   "speaker": "マテオ",
   "text": "父は今日は休みです。",
   "start_sec": 143.557,
   "end_sec": 145.191,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D020-S02",
   "unit_id": "C14-D020",
   "section": "D",
   "speaker": "マテオ",
   "text": "私は朝、家事をしました。",
   "start_sec": 145.341,
   "end_sec": 147.376,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D020-S03",
   "unit_id": "C14-D020",
   "section": "D",
   "speaker": "マテオ",
   "text": "洗濯機を使って、服を洗いました。",
   "start_sec": 147.526,
   "end_sec": 149.878,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D020-S04",
   "unit_id": "C14-D020",
   "section": "D",
   "speaker": "マテオ",
   "text": "パクさんは今日も働いていますか。",
   "start_sec": 150.028,
   "end_sec": 152.172,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D021-S01",
   "unit_id": "C14-D021",
   "section": "D",
   "speaker": "リン",
   "text": "今日の予定は知りません。",
   "start_sec": 152.522,
   "end_sec": 154.433,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D021-S02",
   "unit_id": "C14-D021",
   "section": "D",
   "speaker": "リン",
   "text": "今、パクさんはここにいませんね。",
   "start_sec": 154.583,
   "end_sec": 156.65,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D021-S03",
   "unit_id": "C14-D021",
   "section": "D",
   "speaker": "リン",
   "text": "中村さんに聞きますか。",
   "start_sec": 156.8,
   "end_sec": 158.577,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D022-S01",
   "unit_id": "C14-D022",
   "section": "D",
   "speaker": "マテオ",
   "text": "はい。",
   "start_sec": 158.927,
   "end_sec": 159.696,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D022-S02",
   "unit_id": "C14-D022",
   "section": "D",
   "speaker": "マテオ",
   "text": "中村さんともまだ話していません。",
   "start_sec": 159.846,
   "end_sec": 162.04,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D022-S03",
   "unit_id": "C14-D022",
   "section": "D",
   "speaker": "マテオ",
   "text": "もうすぐ二時半ですね。",
   "start_sec": 162.19,
   "end_sec": 163.787,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D022-S04",
   "unit_id": "C14-D022",
   "section": "D",
   "speaker": "マテオ",
   "text": "会議はもう終わりましたか。",
   "start_sec": 163.937,
   "end_sec": 165.661,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C14-D023-S01",
   "unit_id": "C14-D023",
   "section": "D",
   "speaker": "リン",
   "text": "いいえ、まだです。",
   "start_sec": 166.011,
   "end_sec": 167.214,
