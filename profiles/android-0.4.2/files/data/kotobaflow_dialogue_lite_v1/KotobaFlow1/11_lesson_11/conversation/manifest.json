   "section": "D",
   "speaker": "マテオ",
   "text": "値段は安いです。",
   "start_sec": 51.852,
   "end_sec": 53.218,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D011-S03",
   "unit_id": "C11-D011",
   "section": "D",
   "speaker": "マテオ",
   "text": "スーパーの買い物の予算は千円です。",
   "start_sec": 53.368,
   "end_sec": 56.016,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D012-S01",
   "unit_id": "C11-D012",
   "section": "D",
   "speaker": "リン",
   "text": "何を買いますか。",
   "start_sec": 56.366,
   "end_sec": 58.093,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D012-S02",
   "unit_id": "C11-D012",
   "section": "D",
   "speaker": "リン",
   "text": "先週のメモもありますか。",
   "start_sec": 58.243,
   "end_sec": 60.339,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D013-S01",
   "unit_id": "C11-D013",
   "section": "D",
   "speaker": "マテオ",
   "text": "これは先週の日曜日のメモです。",
   "start_sec": 60.689,
   "end_sec": 63.205,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D013-S02",
   "unit_id": "C11-D013",
   "section": "D",
   "speaker": "マテオ",
   "text": "土曜日に卵とキャベツとジュースと水を買いました。",
   "start_sec": 63.355,
   "end_sec": 68.87,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D014-S01",
   "unit_id": "C11-D014",
   "section": "D",
   "speaker": "パク",
   "text": "ジュースは二本ですか。",
   "start_sec": 69.22,
   "end_sec": 71.025,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D014-S02",
   "unit_id": "C11-D014",
   "section": "D",
   "speaker": "パク",
   "text": "魚も買いましたか。",
   "start_sec": 71.175,
   "end_sec": 72.656,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D015-S01",
   "unit_id": "C11-D015",
   "section": "D",
   "speaker": "マテオ",
   "text": "いいえ、ジュースは一本です。",
   "start_sec": 73.006,
   "end_sec": 74.885,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D015-S02",
   "unit_id": "C11-D015",
   "section": "D",
   "speaker": "マテオ",
   "text": "魚は買いませんでした。",
   "start_sec": 75.035,
   "end_sec": 76.61,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D015-S03",
   "unit_id": "C11-D015",
   "section": "D",
   "speaker": "マテオ",
   "text": "高かったです。",
   "start_sec": 76.76,
   "end_sec": 77.868,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D015-S04",
   "unit_id": "C11-D015",
   "section": "D",
   "speaker": "マテオ",
   "text": "今週も魚は買いません。",
   "start_sec": 78.018,
   "end_sec": 79.955,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D016-S01",
   "unit_id": "C11-D016",
   "section": "D",
   "speaker": "リン",
   "text": "今週はパンも二つですね。",
   "start_sec": 80.305,
   "end_sec": 82.896,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D016-S02",
   "unit_id": "C11-D016",
   "section": "D",
   "speaker": "リン",
   "text": "牛乳は？",
   "start_sec": 83.046,
   "end_sec": 84.008,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D017-S01",
   "unit_id": "C11-D017",
   "section": "D",
   "speaker": "マテオ",
   "text": "牛乳も欲しいです。",
   "start_sec": 84.358,
   "end_sec": 85.793,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D017-S02",
   "unit_id": "C11-D017",
   "section": "D",
   "speaker": "マテオ",
   "text": "二つ買います。",
   "start_sec": 85.943,
   "end_sec": 86.886,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D017-S03",
   "unit_id": "C11-D017",
   "section": "D",
   "speaker": "マテオ",
   "text": "パンと牛乳は日曜日の朝ご飯です。",
   "start_sec": 87.036,
   "end_sec": 90.199,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D018-S01",
   "unit_id": "C11-D018",
   "section": "D",
   "speaker": "パク",
   "text": "メニューもありますよ。",
   "start_sec": 90.549,
   "end_sec": 91.938,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D018-S02",
   "unit_id": "C11-D018",
   "section": "D",
   "speaker": "パク",
   "text": "昼ご飯はどれですか。",
   "start_sec": 92.088,
   "end_sec": 93.604,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D019-S01",
   "unit_id": "C11-D019",
   "section": "D",
   "speaker": "リン",
   "text": "私は魚とご飯です。",
   "start_sec": 93.954,
   "end_sec": 96.652,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D019-S02",
   "unit_id": "C11-D019",
   "section": "D",
   "speaker": "リン",
   "text": "千百円ですね。",
   "start_sec": 96.802,
   "end_sec": 98.252,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D019-S03",
   "unit_id": "C11-D019",
   "section": "D",
   "speaker": "リン",
   "text": "ジュースは一杯五百円ですか。",
   "start_sec": 98.402,
   "end_sec": 100.994,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D020-S01",
   "unit_id": "C11-D020",
   "section": "D",
   "speaker": "パク",
   "text": "はい。",
   "start_sec": 101.344,
   "end_sec": 101.963,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D020-S02",
   "unit_id": "C11-D020",
   "section": "D",
   "speaker": "パク",
   "text": "一杯五百円です。",
   "start_sec": 102.113,
   "end_sec": 103.506,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D020-S03",
   "unit_id": "C11-D020",
   "section": "D",
   "speaker": "パク",
   "text": "安くないですね。",
   "start_sec": 103.656,
   "end_sec": 104.914,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D020-S04",
   "unit_id": "C11-D020",
   "section": "D",
   "speaker": "パク",
   "text": "水もありますよ。",
   "start_sec": 105.064,
   "end_sec": 106.338,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D021-S01",
   "unit_id": "C11-D021",
   "section": "D",
   "speaker": "マテオ",
   "text": "私はパンと牛乳です。",
   "start_sec": 106.688,
   "end_sec": 108.585,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D021-S02",
   "unit_id": "C11-D021",
   "section": "D",
   "speaker": "マテオ",
   "text": "二人でその店へ行きます。",
   "start_sec": 108.735,
   "end_sec": 110.341,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D021-S03",
   "unit_id": "C11-D021",
   "section": "D",
   "speaker": "マテオ",
   "text": "パクさんも行きますか。",
   "start_sec": 110.491,
   "end_sec": 111.563,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D022-S01",
   "unit_id": "C11-D022",
   "section": "D",
   "speaker": "パク",
   "text": "いいえ、午後は家で休みます。",
   "start_sec": 111.913,
   "end_sec": 114.202,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D022-S02",
   "unit_id": "C11-D022",
   "section": "D",
   "speaker": "パク",
   "text": "土曜日は仕事が休みです。",
   "start_sec": 114.352,
   "end_sec": 116.212,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D022-S03",
   "unit_id": "C11-D022",
   "section": "D",
   "speaker": "パク",
   "text": "午前はみどりセンターで勉強します。",
   "start_sec": 116.362,
   "end_sec": 118.667,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D022-S04",
   "unit_id": "C11-D022",
   "section": "D",
   "speaker": "パク",
   "text": "週末の宿題は二つですね。",
   "start_sec": 118.817,
   "end_sec": 120.838,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D023-S01",
   "unit_id": "C11-D023",
   "section": "D",
   "speaker": "マテオ",
   "text": "はい。",
   "start_sec": 121.188,
   "end_sec": 121.84,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D023-S02",
   "unit_id": "C11-D023",
   "section": "D",
   "speaker": "マテオ",
   "text": "土曜日の夜、家で宿題をします。",
   "start_sec": 121.99,
   "end_sec": 124.127,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D023-S03",
   "unit_id": "C11-D023",
   "section": "D",
   "speaker": "マテオ",
   "text": "中村さん、さくら駅の地図を一枚ください。",
   "start_sec": 124.277,
   "end_sec": 127.273,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D024-S01",
   "unit_id": "C11-D024",
   "section": "D",
   "speaker": "中村",
   "text": "はい、地図です。",
   "start_sec": 127.623,
   "end_sec": 129.177,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D024-S02",
   "unit_id": "C11-D024",
   "section": "D",
   "speaker": "中村",
   "text": "スーパーはここ、店はその隣です。",
   "start_sec": 129.327,
   "end_sec": 132.485,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D025-S01",
   "unit_id": "C11-D025",
   "section": "D",
   "speaker": "リン",
   "text": "ありがとうございます。",
   "start_sec": 132.835,
   "end_sec": 134.789,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D025-S02",
   "unit_id": "C11-D025",
   "section": "D",
   "speaker": "リン",
   "text": "土曜日は十二時に港駅ですね。",
   "start_sec": 134.939,
   "end_sec": 137.89,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D026-S01",
   "unit_id": "C11-D026",
   "section": "D",
   "speaker": "マテオ",
   "text": "はい。",
   "start_sec": 138.24,
   "end_sec": 138.943,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D026-S02",
   "unit_id": "C11-D026",
   "section": "D",
   "speaker": "マテオ",
   "text": "十二時半の電車ですね。",
   "start_sec": 139.093,
   "end_sec": 140.905,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C11-D026-S03",
   "unit_id": "C11-D026",
   "section": "D",
   "speaker": "マテオ",
   "text": "三時に電車で港駅へ帰ります。",
   "start_sec": 141.055,
   "end_sec": 143.339,
   "review_flags": [],
   "replacement": null
  }
 ]
}
