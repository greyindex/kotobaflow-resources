   "duration_sec": 4.863
  },
  {
   "turn_id": "C11-D005",
   "turn_index": 4,
   "speaker": "林梅",
   "source_text": "十一時半までみどりセンターで日本語を勉強しますよ。十一時はみどりセンターにいます。",
   "sentence_ids": [
    "C11-D005-S01",
    "C11-D005-S02"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
