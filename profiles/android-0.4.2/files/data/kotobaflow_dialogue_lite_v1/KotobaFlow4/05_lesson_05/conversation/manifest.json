 "turns": [
  {
   "turn_id": "C61-D001",
   "turn_index": 0,
   "speaker": "林梅",
   "source_text": "1月の表計算講座について伺います。",
   "sentence_ids": [
    "C61-D001-S01"
   ],
   "voice_id": "ja-jp-concierge-7",
   "status": "candidate",
   "review_needed": false,
