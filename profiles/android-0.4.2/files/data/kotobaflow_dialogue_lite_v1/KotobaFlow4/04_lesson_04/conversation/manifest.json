   "end_sec": 72.592,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D102-S01",
   "unit_id": "C60-D102",
   "section": "D",
   "speaker": "林梅（リン・メイ）",
   "text": "はい。",
   "start_sec": 72.942,
   "end_sec": 73.847,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D102-S02",
   "unit_id": "C60-D102",
   "section": "D",
   "speaker": "林梅（リン・メイ）",
   "text": "個人の家計から出すので、懐具合を考えて一人分1,000円までです。",
   "start_sec": 73.997,
   "end_sec": 79.374,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D102-S03",
   "unit_id": "C60-D102",
   "section": "D",
   "speaker": "林梅（リン・メイ）",
   "text": "住宅ローンもあり、あり金を使う余裕はありません。",
   "start_sec": 79.524,
   "end_sec": 83.393,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D103-S01",
   "unit_id": "C60-D103",
   "section": "D",
   "speaker": "ハサン",
   "text": "駅前の露店に物産展の品が並んでいました。",
   "start_sec": 83.743,
   "end_sec": 86.73,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D103-S02",
   "unit_id": "C60-D103",
   "section": "D",
   "speaker": "ハサン",
   "text": "大安売りと書いてありますが、特売の価格は消費税抜きです。",
   "start_sec": 86.88,
   "end_sec": 90.997,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D104-S01",
   "unit_id": "C60-D104",
   "section": "D",
   "speaker": "林梅（リン・メイ）",
   "text": "値引き後の金額に税を含めるんですね。",
   "start_sec": 91.347,
   "end_sec": 94.432,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D104-S02",
   "unit_id": "C60-D104",
   "section": "D",
   "speaker": "林梅（リン・メイ）",
   "text": "代金の支払いに商品券は使えますか。",
   "start_sec": 94.582,
   "end_sec": 97.328,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D105-S01",
   "unit_id": "C60-D105",
   "section": "D",
   "speaker": "ハサン",
   "text": "店で聞きましょう。",
   "start_sec": 97.678,
   "end_sec": 98.932,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D105-S02",
   "unit_id": "C60-D105",
   "section": "D",
   "speaker": "ハサン",
   "text": "見たのは銀色のメタリックアクセサリーで、銀製ではありません。",
   "start_sec": 99.082,
   "end_sec": 103.223,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D105-S03",
   "unit_id": "C60-D105",
   "section": "D",
   "speaker": "ハサン",
   "text": "金属製でも材料は違います。",
   "start_sec": 103.373,
   "end_sec": 105.62,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D106-S01",
   "unit_id": "C60-D106",
   "section": "D",
   "speaker": "林梅（リン・メイ）",
   "text": "銅の輪を使ったネックレスですか。",
   "start_sec": 105.97,
   "end_sec": 108.501,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D106-S02",
   "unit_id": "C60-D106",
   "section": "D",
   "speaker": "林梅（リン・メイ）",
   "text": "私は金色よりその色が好きです。",
   "start_sec": 108.651,
   "end_sec": 111.437,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D106-S03",
   "unit_id": "C60-D106",
   "section": "D",
   "speaker": "林梅（リン・メイ）",
   "text": "でもピアスは穴を開けていないので使えません。",
   "start_sec": 111.587,
   "end_sec": 114.609,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D107-S01",
   "unit_id": "C60-D107",
   "section": "D",
   "speaker": "ハサン",
   "text": "それなら、耳に穴がなくても使えるネックレスを借りるほうが得かもしれません。",
   "start_sec": 114.959,
   "end_sec": 120.706,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D107-S02",
   "unit_id": "C60-D107",
   "section": "D",
   "speaker": "ハサン",
   "text": "毎回買うと出費も馬鹿にならないし、飾りを求めたらきりがないです。",
   "start_sec": 120.856,
   "end_sec": 125.968,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D108-S01",
   "unit_id": "C60-D108",
   "section": "D",
   "speaker": "林梅（リン・メイ）",
   "text": "そうですね。",
   "start_sec": 126.318,
   "end_sec": 127.388,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D108-S02",
   "unit_id": "C60-D108",
   "section": "D",
   "speaker": "林梅（リン・メイ）",
   "text": "特別な優待より再利用を考えます。",
   "start_sec": 127.538,
   "end_sec": 130.394,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D108-S03",
   "unit_id": "C60-D108",
   "section": "D",
   "speaker": "林梅（リン・メイ）",
   "text": "贅沢な物は二の次です。",
   "start_sec": 130.544,
   "end_sec": 132.736,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D108-S04",
   "unit_id": "C60-D108",
   "section": "D",
   "speaker": "林梅（リン・メイ）",
   "text": "安さにつられてよけいに買えば損ですから。",
   "start_sec": 132.886,
   "end_sec": 135.532,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D109-S01",
   "unit_id": "C60-D109",
   "section": "D",
   "speaker": "ハサン",
   "text": "では、借りられるだけ借りて、不足分だけ買いましょう。",
   "start_sec": 135.882,
   "end_sec": 139.779,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D109-S02",
   "unit_id": "C60-D109",
   "section": "D",
   "speaker": "ハサン",
   "text": "選ぶ時間はたっぷりあります。",
   "start_sec": 139.929,
   "end_sec": 141.493,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D110-S01",
   "unit_id": "C60-D110",
   "section": "D",
   "speaker": "ハサン",
   "text": "勘定は小銭で払いたいので、札しか使えないと困ります。",
   "start_sec": 141.843,
   "end_sec": 146.725,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D110-S02",
   "unit_id": "C60-D110",
   "section": "D",
   "speaker": "ハサン",
   "text": "百円玉も使えるか聞きますね。",
   "start_sec": 146.875,
   "end_sec": 149.576,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D111-S01",
   "unit_id": "C60-D111",
   "section": "D",
   "speaker": "林梅（リン・メイ）",
   "text": "お願いします。",
   "start_sec": 149.926,
   "end_sec": 151.007,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D111-S02",
   "unit_id": "C60-D111",
   "section": "D",
   "speaker": "林梅（リン・メイ）",
   "text": "交通カードなら残高を見てからチャージします。",
   "start_sec": 151.157,
   "end_sec": 154.069,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D111-S03",
   "unit_id": "C60-D111",
   "section": "D",
   "speaker": "林梅（リン・メイ）",
   "text": "買えるだけ買うのではなく、必要な物を決めておきたいです。",
   "start_sec": 154.219,
   "end_sec": 158.066,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D112-S01",
   "unit_id": "C60-D112",
   "section": "D",
   "speaker": "ハサン",
   "text": "経済的な事情は人によって違いますしね。",
   "start_sec": 158.416,
   "end_sec": 161.654,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D112-S02",
   "unit_id": "C60-D112",
   "section": "D",
   "speaker": "ハサン",
   "text": "準備に時間を費やすばかりか、小物の代金が生活費にまで食い込んでは困ります。",
   "start_sec": 161.804,
   "end_sec": 167.412,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D113-S01",
   "unit_id": "C60-D113",
   "section": "D",
   "speaker": "林梅（リン・メイ）",
   "text": "はい。",
   "start_sec": 167.762,
   "end_sec": 168.472,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D113-S02",
   "unit_id": "C60-D113",
   "section": "D",
   "speaker": "林梅（リン・メイ）",
   "text": "借金なしで参加できることが大事です。",
   "start_sec": 168.622,
   "end_sec": 171.538,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D113-S03",
   "unit_id": "C60-D113",
   "section": "D",
   "speaker": "林梅（リン・メイ）",
   "text": "見栄のためにお金を使うのはやめましょう。",
   "start_sec": 171.688,
   "end_sec": 174.566,
   "review_flags": [],
   "replacement": null
  },
  {
   "sentence_id": "C60-D113-S04",
   "unit_id": "C60-D113",
   "section": "D",
   "speaker": "林梅（リン・メイ）",
   "text": "二人とも、持っている物を先に調べましょう。",
   "start_sec": 174.716,
   "end_sec": 177.552,
   "review_flags": [],
   "replacement": null
  }
 ]
}
