{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 77.6,
 "source_chapter": 43,
 "sentence_intervals": [
  {
   "sentence_id": "C43-A001-S01",
   "section": "A",
   "text": "十一月四日、老舗「ほんの森」で新発売の写真集『川のある町』を注文した。",
   "start_sec": 0.0,
   "end_sec": 7.313
  },
  {
   "sentence_id": "C43-A001-S02",
   "section": "A",
   "text": "作者は山本ゆりさんで、発明を紹介する記事は大学の先生によって書かれた。",
   "start_sec": 7.513,
   "end_sec": 14.325
  },
  {
   "sentence_id": "C43-A001-S03",
   "section": "A",
   "text": "店頭で読者の評価が公表され、応対が丁寧な店舗だと言われている。",
   "start_sec": 14.525,
   "end_sec": 20.464
  },
  {
   "sentence_id": "C43-A001-S04",
   "section": "A",
   "text": "十三日に友達と読む予定だ。",
   "start_sec": 20.664,
   "end_sec": 23.674
  },
  {
   "sentence_id": "C43-A001-S05",
   "section": "A",
   "text": "この店は出版社の直営店でも代理店でもなく、自分で本を仕入れる。",
   "start_sec": 23.874,
   "end_sec": 30.604
  },
  {
   "sentence_id": "C43-A001-S06",
   "section": "A",
   "text": "古い本も買い取るので、私は時々立ち寄る。",
   "start_sec": 30.804,
   "end_sec": 34.638
  },
  {
   "sentence_id": "C43-A001-S07",
   "section": "A",
   "text": "デリバリーは町の配送会社に頼んでいる。",
   "start_sec": 34.838,
   "end_sec": 38.655
  },
  {
   "sentence_id": "C43-A001-S08",
   "section": "A",
   "text": "店へは駅前の通りを通る。",
   "start_sec": 38.855,
   "end_sec": 41.309
  },
  {
   "sentence_id": "C43-A002-S01",
   "section": "A",
   "text": "七日は約束を断って待ったが、受け取れなかった。",
   "start_sec": 41.759,
   "end_sec": 45.835
  },
  {
   "sentence_id": "C43-A002-S02",
   "section": "A",
   "text": "盗まれたのか、無くされたのかと思ったが、夕方、田中さんが届けてくれた。",
   "start_sec": 46.035,
   "end_sec": 52.545
  },
  {
   "sentence_id": "C43-A002-S03",
   "section": "A",
   "text": "田中さんの郵便受けで見つかったのだ。",
   "start_sec": 52.745,
   "end_sec": 55.618
  },
  {
   "sentence_id": "C43-A002-S04",
   "section": "A",
   "text": "箱は濡れ、カバーも破れていて、直せない。",
   "start_sec": 55.818,
   "end_sec": 59.832
  },
  {
   "sentence_id": "C43-A003-S01",
   "section": "A",
   "text": "夜、被害を訴えるメールを書いた。",
   "start_sec": 60.282,
   "end_sec": 63.552
  },
  {
   "sentence_id": "C43-A003-S02",
   "section": "A",
   "text": "九日、電話がかかってきて、交換を頼んだ。",
   "start_sec": 63.752,
   "end_sec": 67.765
  },
  {
   "sentence_id": "C43-A003-S03",
   "section": "A",
   "text": "写真を褒められ、破れた本を保管するように言われた。",
   "start_sec": 67.965,
   "end_sec": 72.291
  },
  {
   "sentence_id": "C43-A003-S04",
   "section": "A",
   "text": "十一日の夜に交換できると聞き、安心感が感じられた。",
   "start_sec": 72.491,
   "end_sec": 77.594
  }
 ]
}
