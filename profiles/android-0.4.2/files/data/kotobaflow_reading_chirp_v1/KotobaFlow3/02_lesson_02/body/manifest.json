{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 72.711,
 "source_chapter": 38,
 "sentence_intervals": [
  {
   "sentence_id": "C38-A001-S01",
   "section": "A",
   "text": "日曜日の十時、原さんは桜市民センターの会議室Ｂに着きました。",
   "start_sec": 0.0,
   "end_sec": 6.173
  },
  {
   "sentence_id": "C38-A001-S02",
   "section": "A",
   "text": "旅の写真展は十三時から十六時までです。",
   "start_sec": 6.373,
   "end_sec": 10.327
  },
  {
   "sentence_id": "C38-A001-S03",
   "section": "A",
   "text": "土曜日の夜、パソコンを充電して、写真二十枚をUSBメモリに保存しておきました。",
   "start_sec": 10.527,
   "end_sec": 18.08
  },
  {
   "sentence_id": "C38-A001-S04",
   "section": "A",
   "text": "展示するのは、これまでの旅行で撮った写真です。",
   "start_sec": 18.28,
   "end_sec": 21.753
  },
  {
   "sentence_id": "C38-A001-S05",
   "section": "A",
   "text": "旅先で困った時の土産話も用意しました。",
   "start_sec": 21.953,
   "end_sec": 25.306
  },
  {
   "sentence_id": "C38-A002-S01",
   "section": "A",
   "text": "かばんからパソコンを取り出して接続しようとした時、ケーブルを家に置いたままだと気付きました。",
   "start_sec": 25.756,
   "end_sec": 32.71
  },
  {
   "sentence_id": "C38-A002-S02",
   "section": "A",
   "text": "さらに、USBメモリを開いては確かめましたが、写真がありません。",
   "start_sec": 32.91,
   "end_sec": 38.218
  },
  {
   "sentence_id": "C38-A002-S03",
   "section": "A",
   "text": "「しまった」。",
   "start_sec": 38.418,
   "end_sec": 39.388
  },
  {
   "sentence_id": "C38-A002-S04",
   "section": "A",
   "text": "うっかり消去してしまったのです。",
   "start_sec": 39.588,
   "end_sec": 42.054
  },
  {
   "sentence_id": "C38-A002-S05",
   "section": "A",
   "text": "今さら後悔しても始まりません。",
   "start_sec": 42.254,
   "end_sec": 44.87
  },
  {
   "sentence_id": "C38-A003-S01",
   "section": "A",
   "text": "幸い、金曜日に選んだ十七枚はパソコンに、土曜日に選んだ三枚はカメラに残っていました。",
   "start_sec": 45.32,
   "end_sec": 52.993
  },
  {
   "sentence_id": "C38-A003-S02",
   "section": "A",
   "text": "早速三枚を移して、十一時半までに準備をやり直しました。",
   "start_sec": 53.193,
   "end_sec": 58.581
  },
  {
   "sentence_id": "C38-A003-S03",
   "section": "A",
   "text": "予備のケーブルも借りて、開場に間に合いました。",
   "start_sec": 58.781,
   "end_sec": 62.597
  },
  {
   "sentence_id": "C38-A003-S04",
   "section": "A",
   "text": "USBメモリは一旦かばんにしまっておきます。",
   "start_sec": 62.797,
   "end_sec": 66.81
  },
  {
   "sentence_id": "C38-A003-S05",
   "section": "A",
   "text": "元の状態に戻せるかは不明です。",
   "start_sec": 67.01,
   "end_sec": 69.932
  },
  {
   "sentence_id": "C38-A003-S06",
   "section": "A",
   "text": "月曜日に小川さんに相談します。",
   "start_sec": 70.132,
   "end_sec": 72.705
  }
 ]
}
