{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 175.831,
 "source_chapter": 38,
 "sentence_intervals": [
  {
   "sentence_id": "C38-B001-S01",
   "section": "B",
   "text": "十月四日（日）十二時、担当・原の記録。",
   "start_sec": 0.0,
   "end_sec": 5.393
  },
  {
   "sentence_id": "C38-B001-S02",
   "section": "B",
   "text": "展覧会は十三時から十六時まで。",
   "start_sec": 5.593,
   "end_sec": 8.767
  },
  {
   "sentence_id": "C38-B001-S03",
   "section": "B",
   "text": "十七時までに片付けます。",
   "start_sec": 8.967,
   "end_sec": 11.222
  },
  {
   "sentence_id": "C38-B001-S04",
   "section": "B",
   "text": "事前の準備と後始末を分けて記録しました。",
   "start_sec": 11.422,
   "end_sec": 15.375
  },
  {
   "sentence_id": "C38-B002-S01",
   "section": "B",
   "text": "充電と写真の準備は完了。",
   "start_sec": 15.825,
   "end_sec": 18.976
  },
  {
   "sentence_id": "C38-B002-S02",
   "section": "B",
   "text": "写真は十七枚と三枚、計二十枚で、すべて確認済みです。",
   "start_sec": 19.176,
   "end_sec": 24.729
  },
  {
   "sentence_id": "C38-B002-S03",
   "section": "B",
   "text": "USBメモリの処理は未完了。",
   "start_sec": 24.929,
   "end_sec": 27.682
  },
  {
   "sentence_id": "C38-B002-S04",
   "section": "B",
   "text": "今日は使いません。",
   "start_sec": 27.882,
   "end_sec": 29.475
  },
  {
   "sentence_id": "C38-B002-S05",
   "section": "B",
   "text": "新しい写真も保存しません。",
   "start_sec": 29.675,
   "end_sec": 32.248
  },
  {
   "sentence_id": "C38-B003-S01",
   "section": "B",
   "text": "接続は予備のケーブルで済ませました。",
   "start_sec": 32.698,
   "end_sec": 35.872
  },
  {
   "sentence_id": "C38-B003-S02",
   "section": "B",
   "text": "壊れたフレームも取り替えました。",
   "start_sec": 36.072,
   "end_sec": 38.345
  },
  {
   "sentence_id": "C38-B003-S03",
   "section": "B",
   "text": "掛かっている写真はそのままにしておきます。",
   "start_sec": 38.545,
   "end_sec": 41.89
  },
  {
   "sentence_id": "C38-B003-S04",
   "section": "B",
   "text": "紙とペンも揃いました。",
   "start_sec": 42.09,
   "end_sec": 43.823
  },
  {
   "sentence_id": "C38-B003-S05",
   "section": "B",
   "text": "受付は十二時四十五分までに整えます。",
   "start_sec": 44.023,
   "end_sec": 48.125
  },
  {
   "sentence_id": "C38-B004-S01",
   "section": "B",
   "text": "終了後、電源を切ってケーブルを西田に返し、写真はフレームに入れたまま袋へ。",
   "start_sec": 48.575,
   "end_sec": 55.315
  },
  {
   "sentence_id": "C38-B004-S02",
   "section": "B",
   "text": "机と椅子を戻し、引き出しの忘れ物、窓、電気の消し忘れを二人で確かめます。",
   "start_sec": 55.515,
   "end_sec": 63.096
  },
  {
   "sentence_id": "C38-B004-S03",
   "section": "B",
   "text": "鍵も原が西田に返します。",
   "start_sec": 63.296,
   "end_sec": 65.87
  },
  {
   "sentence_id": "C38-B005-S01",
   "section": "B",
   "text": "壊れたフレームは西田が保管。",
   "start_sec": 66.32,
   "end_sec": 69.073
  },
  {
   "sentence_id": "C38-B005-S02",
   "section": "B",
   "text": "今日の修理申し込みは取り消しました。",
   "start_sec": 69.273,
   "end_sec": 72.026
  },
  {
   "sentence_id": "C38-B005-S03",
   "section": "B",
   "text": "修理は来週決めます。",
   "start_sec": 72.226,
   "end_sec": 74.151
  },
  {
   "sentence_id": "C38-B005-S04",
   "section": "B",
   "text": "写真の消去は原の不注意ですが、破損の原因は不明です。",
   "start_sec": 74.351,
   "end_sec": 80.291
  },
  {
   "sentence_id": "C38-B006-S01",
   "section": "B",
   "text": "最後の確認は後回しにしません。",
   "start_sec": 80.741,
   "end_sec": 83.435
  },
  {
   "sentence_id": "C38-B006-S02",
   "section": "B",
   "text": "忘れ物は放置しないでください。",
   "start_sec": 83.635,
   "end_sec": 85.908
  },
  {
   "sentence_id": "C38-B006-S03",
   "section": "B",
   "text": "ペンには蓋をしてください。",
   "start_sec": 86.108,
   "end_sec": 88.214
  },
  {
   "sentence_id": "C38-B006-S04",
   "section": "B",
   "text": "電気のつけっぱなしにも注意します。",
   "start_sec": 88.414,
   "end_sec": 91.213
  },
  {
   "sentence_id": "C38-B007-S01",
   "section": "B",
   "text": "添付・写真展の案内。",
   "start_sec": 91.663,
   "end_sec": 94.182
  },
  {
   "sentence_id": "C38-B007-S02",
   "section": "B",
   "text": "今回の主題は「乗り物で変わる旅」です。",
   "start_sec": 94.382,
   "end_sec": 97.719
  },
  {
   "sentence_id": "C38-B007-S03",
   "section": "B",
   "text": "見学者には入口でガイド・マップを渡します。",
   "start_sec": 97.919,
   "end_sec": 101.636
  },
  {
   "sentence_id": "C38-B007-S04",
   "section": "B",
   "text": "周遊の経路を写真と合わせて見てください。",
   "start_sec": 101.836,
   "end_sec": 105.309
  },
  {
   "sentence_id": "C38-B007-S05",
   "section": "B",
   "text": "最初は港の展望台から撮った客船です。",
   "start_sec": 105.509,
   "end_sec": 109.328
  },
  {
   "sentence_id": "C38-B007-S06",
   "section": "B",
   "text": "デッキの観光客は帰国の途中でした。",
   "start_sec": 109.528,
   "end_sec": 112.821
  },
  {
   "sentence_id": "C38-B007-S07",
   "section": "B",
   "text": "隣の写真は水上のボート。",
   "start_sec": 113.021,
   "end_sec": 115.775
  },
  {
   "sentence_id": "C38-B007-S08",
   "section": "B",
   "text": "船長がガイドもするリバー・クルーズで撮りました。",
   "start_sec": 115.975,
   "end_sec": 119.895
  },
  {
   "sentence_id": "C38-B008-S01",
   "section": "B",
   "text": "次は日帰りのガイド・ツアーです。",
   "start_sec": 120.345,
   "end_sec": 123.442
  },
  {
   "sentence_id": "C38-B008-S02",
   "section": "B",
   "text": "観光バスで高速道路とトンネルを通り、温泉へ行きました。",
   "start_sec": 123.642,
   "end_sec": 128.376
  },
  {
   "sentence_id": "C38-B008-S03",
   "section": "B",
   "text": "観光地は満員のバスが何台も来ていましたが、私たちの目的地は小さな宿でした。",
   "start_sec": 128.576,
   "end_sec": 135.394
  },
  {
   "sentence_id": "C38-B008-S04",
   "section": "B",
   "text": "そこには泊まらないで、入浴後に帰途につきました。",
   "start_sec": 135.594,
   "end_sec": 140.027
  },
  {
   "sentence_id": "C38-B008-S05",
   "section": "B",
   "text": "バス停の「かんこうバス」という表示も写真に残しました。",
   "start_sec": 140.227,
   "end_sec": 144.555
  },
  {
   "sentence_id": "C38-B009-S01",
   "section": "B",
   "text": "最後はヨーロッパに滞在した時の写真です。",
   "start_sec": 145.005,
   "end_sec": 148.538
  },
  {
   "sentence_id": "C38-B009-S02",
   "section": "B",
   "text": "ホームステイ先で手に入った地図を見て、新幹線とは違う列車に乗りました。",
   "start_sec": 148.738,
   "end_sec": 154.921
  },
  {
   "sentence_id": "C38-B009-S03",
   "section": "B",
   "text": "乗り継ぎに失敗し、手元の時刻表の「十時着」を再び確認しました。",
   "start_sec": 155.121,
   "end_sec": 161.505
  },
  {
   "sentence_id": "C38-B009-S04",
   "section": "B",
   "text": "道標を見て、ようやく宿にたどり着きました。",
   "start_sec": 161.705,
   "end_sec": 165.511
  },
  {
   "sentence_id": "C38-B009-S05",
   "section": "B",
   "text": "この失敗談も展示します。",
   "start_sec": 165.711,
   "end_sec": 167.959
  },
  {
   "sentence_id": "C38-B009-S06",
   "section": "B",
   "text": "帰りの航空機の写真では、大きなジャンボ・ジェット機と、私が乗った小型機を見比べてください。",
   "start_sec": 168.159,
   "end_sec": 175.825
  }
 ]
}
