{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 96.032,
 "source_chapter": 49,
 "sentence_intervals": [
  {
   "sentence_id": "C49-A001-S01",
   "section": "A",
   "text": "一月十六日、教室でカードの記録方法を試しました。",
   "start_sec": 0.0,
   "end_sec": 4.956
  },
  {
   "sentence_id": "C49-A001-S02",
   "section": "A",
   "text": "アナさんが考案した教材は、製造業と料理の説明を比べるものです。",
   "start_sec": 5.156,
   "end_sec": 11.689
  },
  {
   "sentence_id": "C49-A001-S03",
   "section": "A",
   "text": "図と文字を合わせることで、基本的な手順を学びます。",
   "start_sec": 11.889,
   "end_sec": 16.268
  },
  {
   "sentence_id": "C49-A001-S04",
   "section": "A",
   "text": "私は必要な物を用意し、薄い紙のカードを番号順に揃えました。",
   "start_sec": 16.468,
   "end_sec": 22.427
  },
  {
   "sentence_id": "C49-A002-S01",
   "section": "A",
   "text": "最初は紡績工場の写真です。",
   "start_sec": 22.877,
   "end_sec": 25.81
  },
  {
   "sentence_id": "C49-A002-S02",
   "section": "A",
   "text": "開発した装置を生産ラインに導入し、作業を合理化した例でした。",
   "start_sec": 26.01,
   "end_sec": 31.751
  },
  {
   "sentence_id": "C49-A002-S03",
   "section": "A",
   "text": "ベルトコンベヤーで材料を運ぶ方式なら、能率的に作業が進みます。",
   "start_sec": 31.951,
   "end_sec": 37.413
  },
  {
   "sentence_id": "C49-A002-S04",
   "section": "A",
   "text": "ただ、先進的なシステムでも、確認を省いてはいけません。",
   "start_sec": 37.613,
   "end_sec": 42.599
  },
  {
   "sentence_id": "C49-A002-S05",
   "section": "A",
   "text": "次の造船の図では、設計した船を造るとき、板を重ね合わせて溶接する箇所が示してありました。",
   "start_sec": 42.799,
   "end_sec": 50.445
  },
  {
   "sentence_id": "C49-A003-S01",
   "section": "A",
   "text": "佐藤さんはパソコンへの入力を選び、私は見本のとおりに記入しました。",
   "start_sec": 50.895,
   "end_sec": 56.816
  },
  {
   "sentence_id": "C49-A003-S02",
   "section": "A",
   "text": "必須の項目は同じです。",
   "start_sec": 57.016,
   "end_sec": 59.459
  },
  {
   "sentence_id": "C49-A003-S03",
   "section": "A",
   "text": "写真を取り込むには、文字だけの記録とは違う手段が必要でした。",
   "start_sec": 59.659,
   "end_sec": 64.891
  },
  {
   "sentence_id": "C49-A003-S04",
   "section": "A",
   "text": "写真のピントが合わず、私は一度に全部を写すのをやめました。",
   "start_sec": 65.091,
   "end_sec": 70.614
  },
  {
   "sentence_id": "C49-A003-S05",
   "section": "A",
   "text": "少し間を置くと、落ち着いて撮れました。",
   "start_sec": 70.814,
   "end_sec": 73.988
  },
  {
   "sentence_id": "C49-A004-S01",
   "section": "A",
   "text": "早く仕上げたくて、確認を省くつもりでしたが、比べたら番号が違っていました。",
   "start_sec": 74.438,
   "end_sec": 80.551
  },
  {
   "sentence_id": "C49-A004-S02",
   "section": "A",
   "text": "正しく記録する上で、確認は必要なのです。",
   "start_sec": 80.751,
   "end_sec": 84.822
  },
  {
   "sentence_id": "C49-A004-S03",
   "section": "A",
   "text": "誤りを直した上で提出しました。",
   "start_sec": 85.022,
   "end_sec": 88.195
  },
  {
   "sentence_id": "C49-A004-S04",
   "section": "A",
   "text": "指示書に従い、その都度じっくり確かめることがポイントです。",
   "start_sec": 88.395,
   "end_sec": 93.252
  },
  {
   "sentence_id": "C49-A004-S05",
   "section": "A",
   "text": "順番を守る理由が分かりました。",
   "start_sec": 93.452,
   "end_sec": 96.025
  }
 ]
}
