{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 121.823,
 "source_chapter": 44,
 "sentence_intervals": [
  {
   "sentence_id": "C44-A001-S01",
   "section": "A",
   "text": "私はミン。",
   "start_sec": 0.0,
   "end_sec": 1.361
  },
  {
   "sentence_id": "C44-A001-S02",
   "section": "A",
   "text": "大学二年生で、週に三回、本の店で働いている。",
   "start_sec": 1.561,
   "end_sec": 6.578
  },
  {
   "sentence_id": "C44-A001-S03",
   "section": "A",
   "text": "十二月は試験がある。",
   "start_sec": 6.778,
   "end_sec": 9.114
  },
  {
   "sentence_id": "C44-A001-S04",
   "section": "A",
   "text": "店長は働く日を私に選ばせてくれた。",
   "start_sec": 9.314,
   "end_sec": 13.176
  },
  {
   "sentence_id": "C44-A001-S05",
   "section": "A",
   "text": "試験の前の日に休むことも許してくれた。",
   "start_sec": 13.376,
   "end_sec": 16.669
  },
  {
   "sentence_id": "C44-A001-S06",
   "section": "A",
   "text": "自分の希望を話せて安心した。",
   "start_sec": 16.869,
   "end_sec": 19.862
  },
  {
   "sentence_id": "C44-A002-S01",
   "section": "A",
   "text": "しかし、十一月の会のあと、私は一人で片付けをさせられた。",
   "start_sec": 20.312,
   "end_sec": 26.0
  },
  {
   "sentence_id": "C44-A002-S02",
   "section": "A",
   "text": "命令調ではなくても、断りにくい圧力があった。",
   "start_sec": 26.2,
   "end_sec": 30.498
  },
  {
   "sentence_id": "C44-A002-S03",
   "section": "A",
   "text": "十一月二十七日の相談で話すと、代表のアナさんは「負担が大きすぎました」と言った。",
   "start_sec": 30.698,
   "end_sec": 37.889
  },
  {
   "sentence_id": "C44-A002-S04",
   "section": "A",
   "text": "相手の意思を聞く大切さを考えさせられた。",
   "start_sec": 38.089,
   "end_sec": 41.383
  },
  {
   "sentence_id": "C44-A003-S01",
   "section": "A",
   "text": "佐藤さんは日系企業の貿易会社で働く社会人だ。",
   "start_sec": 41.833,
   "end_sec": 46.755
  },
  {
   "sentence_id": "C44-A003-S02",
   "section": "A",
   "text": "営業部の新入社員のころ、上司に週末も働かせられた。",
   "start_sec": 46.955,
   "end_sec": 52.012
  },
  {
   "sentence_id": "C44-A003-S03",
   "section": "A",
   "text": "勤勉な部下に仕事を任せると、人員を増やさなくてもいいと考える経営者もいる。",
   "start_sec": 52.212,
   "end_sec": 58.715
  },
  {
   "sentence_id": "C44-A003-S04",
   "section": "A",
   "text": "「労働時間を減らしてほしいという要求は、わがままではありません。",
   "start_sec": 58.915,
   "end_sec": 63.827
  },
  {
   "sentence_id": "C44-A003-S05",
   "section": "A",
   "text": "立場が違っても尊重しましょう。」",
   "start_sec": 64.027,
   "end_sec": 66.3
  },
  {
   "sentence_id": "C44-A003-S06",
   "section": "A",
   "text": "私は同意した。",
   "start_sec": 66.5,
   "end_sec": 68.152
  },
  {
   "sentence_id": "C44-A004-S01",
   "section": "A",
   "text": "会社には工場もあり、研修生と実習生が来る。",
   "start_sec": 68.602,
   "end_sec": 73.035
  },
  {
   "sentence_id": "C44-A004-S02",
   "section": "A",
   "text": "事務の担当者が実習の説明役も兼ねると、仕事が重なる。",
   "start_sec": 73.235,
   "end_sec": 78.662
  },
  {
   "sentence_id": "C44-A004-S03",
   "section": "A",
   "text": "佐藤さんは自ら担当を替わることを提案した。",
   "start_sec": 78.862,
   "end_sec": 82.996
  },
  {
   "sentence_id": "C44-A004-S04",
   "section": "A",
   "text": "他社の方法も調べ、事業部の重役に説明した。",
   "start_sec": 83.196,
   "end_sec": 87.149
  },
  {
   "sentence_id": "C44-A004-S05",
   "section": "A",
   "text": "「一人に押し付けないで、部門を越えて助け合う」という行動が、会社を少し変えた。",
   "start_sec": 87.349,
   "end_sec": 93.839
  },
  {
   "sentence_id": "C44-A005-S01",
   "section": "A",
   "text": "私も十二月十一日の準備を休みたいと頼んだ。",
   "start_sec": 94.289,
   "end_sec": 98.589
  },
  {
   "sentence_id": "C44-A005-S02",
   "section": "A",
   "text": "アナさんは承諾し、受付を私に任せた。",
   "start_sec": 98.789,
   "end_sec": 102.598
  },
  {
   "sentence_id": "C44-A005-S03",
   "section": "A",
   "text": "片付けは三人で分担する。",
   "start_sec": 102.798,
   "end_sec": 105.371
  },
  {
   "sentence_id": "C44-A005-S04",
   "section": "A",
   "text": "私は納得した。",
   "start_sec": 105.571,
   "end_sec": 107.164
  },
  {
   "sentence_id": "C44-A005-S05",
   "section": "A",
   "text": "時間があれば自主的に手伝うが、引き受けるかどうかは自分の選択だ。",
   "start_sec": 107.364,
   "end_sec": 112.625
  },
  {
   "sentence_id": "C44-A005-S06",
   "section": "A",
   "text": "受付は十八時から三十分。",
   "start_sec": 112.825,
   "end_sec": 115.819
  },
  {
   "sentence_id": "C44-A005-S07",
   "section": "A",
   "text": "参加者を長く待たせないように、名前の確認方法を練習しておこう。",
   "start_sec": 116.019,
   "end_sec": 121.816
  }
 ]
}
