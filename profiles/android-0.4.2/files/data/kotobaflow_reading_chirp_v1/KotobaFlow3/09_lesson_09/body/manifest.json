{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 81.206,
 "source_chapter": 45,
 "sentence_intervals": [
  {
   "sentence_id": "C45-A001-S01",
   "section": "A",
   "text": "12月14日、アナさんは会社員の佐藤さんと敬語を練習しました。",
   "start_sec": 0.0,
   "end_sec": 5.933
  },
  {
   "sentence_id": "C45-A001-S02",
   "section": "A",
   "text": "16日に「ひかり食品」を訪問して、森さんと面会します。",
   "start_sec": 6.133,
   "end_sec": 11.226
  },
  {
   "sentence_id": "C45-A001-S03",
   "section": "A",
   "text": "佐藤さんは社外のお客さまの接待を担当し、取引先や得意先とよく話します。",
   "start_sec": 11.426,
   "end_sec": 19.219
  },
  {
   "sentence_id": "C45-A002-S01",
   "section": "A",
   "text": "「尊敬語は敬意を表したい人の行動に使います。",
   "start_sec": 19.669,
   "end_sec": 23.54
  },
  {
   "sentence_id": "C45-A002-S02",
   "section": "A",
   "text": "謙譲語は私から相手への行動に使います。",
   "start_sec": 23.74,
   "end_sec": 27.874
  },
  {
   "sentence_id": "C45-A002-S03",
   "section": "A",
   "text": "丁寧語は聞く人への敬意を表します。」",
   "start_sec": 28.074,
   "end_sec": 31.247
  },
  {
   "sentence_id": "C45-A002-S04",
   "section": "A",
   "text": "アナさんは言葉づかいを変えて名乗りました。",
   "start_sec": 31.447,
   "end_sec": 35.066
  },
  {
   "sentence_id": "C45-A002-S05",
   "section": "A",
   "text": "丁寧な言い方でも、社外には身内の課長や部長に敬称を付けないと習いました。",
   "start_sec": 35.266,
   "end_sec": 41.799
  },
  {
   "sentence_id": "C45-A002-S06",
   "section": "A",
   "text": "「申します」は聞く人に丁重に言う形です。",
   "start_sec": 41.999,
   "end_sec": 44.873
  },
  {
   "sentence_id": "C45-A003-S01",
   "section": "A",
   "text": "社内と社外で使い分けるのです。",
   "start_sec": 45.323,
   "end_sec": 47.656
  },
  {
   "sentence_id": "C45-A003-S02",
   "section": "A",
   "text": "尊敬と謙譲の違いを考えて、名刺の氏名と役職を確認し、宛名を「森様」に直しました。",
   "start_sec": 47.856,
   "end_sec": 55.829
  },
  {
   "sentence_id": "C45-A003-S03",
   "section": "A",
   "text": "目上の方にはお辞儀もしますが、マナーは形だけではありません。",
   "start_sec": 56.029,
   "end_sec": 60.958
  },
  {
   "sentence_id": "C45-A004-S01",
   "section": "A",
   "text": "佐藤さんは「礼儀は大切ですが、格式張る必要はありません。",
   "start_sec": 61.408,
   "end_sec": 66.892
  },
  {
   "sentence_id": "C45-A004-S02",
   "section": "A",
   "text": "世辞より、感謝を込めた一言を」と語りかけました。",
   "start_sec": 67.092,
   "end_sec": 71.493
  },
  {
   "sentence_id": "C45-A004-S03",
   "section": "A",
   "text": "アナさんは堂々と短い紹介をしました。",
   "start_sec": 71.693,
   "end_sec": 75.846
  },
  {
   "sentence_id": "C45-A004-S04",
   "section": "A",
   "text": "謙遜で自分を悪く言うことと、敬語の儀礼は同じではありません。",
   "start_sec": 76.046,
   "end_sec": 81.199
  }
 ]
}
