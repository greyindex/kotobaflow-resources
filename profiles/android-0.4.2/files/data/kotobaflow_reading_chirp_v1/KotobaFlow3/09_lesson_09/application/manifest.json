{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 153.915,
 "source_chapter": 45,
 "sentence_intervals": [
  {
   "sentence_id": "C45-B001-S01",
   "section": "B",
   "text": "12月16日夜／ひかり食品　森様／面会のお礼／国際交流会のアナ・ロペスです。",
   "start_sec": 0.0,
   "end_sec": 8.023
  },
  {
   "sentence_id": "C45-B001-S02",
   "section": "B",
   "text": "この度は誠にありがとうございました。",
   "start_sec": 8.223,
   "end_sec": 11.276
  },
  {
   "sentence_id": "C45-B001-S03",
   "section": "B",
   "text": "昨日お送りした文書をご覧になっていたので、相談が進みました。",
   "start_sec": 11.476,
   "end_sec": 16.09
  },
  {
   "sentence_id": "C45-B001-S04",
   "section": "B",
   "text": "重ねてお礼を申し上げます。",
   "start_sec": 16.29,
   "end_sec": 18.623
  },
  {
   "sentence_id": "C45-B001-S05",
   "section": "B",
   "text": "名刺を持っていなかったので、失礼しました。",
   "start_sec": 18.823,
   "end_sec": 21.996
  },
  {
   "sentence_id": "C45-B002-S01",
   "section": "B",
   "text": "今日伺った条件を改めて確認します。",
   "start_sec": 22.446,
   "end_sec": 25.56
  },
  {
   "sentence_id": "C45-B002-S02",
   "section": "B",
   "text": "見学は月曜日から金曜日、午後2時より1時間半、15人までです。",
   "start_sec": 25.76,
   "end_sec": 32.389
  },
  {
   "sentence_id": "C45-B002-S03",
   "section": "B",
   "text": "今は12人ですが、増えるかもしれません。",
   "start_sec": 32.589,
   "end_sec": 36.093
  },
  {
   "sentence_id": "C45-B002-S04",
   "section": "B",
   "text": "2月19日か26日の金曜日を希望しています。",
   "start_sec": 36.293,
   "end_sec": 40.889
  },
  {
   "sentence_id": "C45-B002-S05",
   "section": "B",
   "text": "工場のご都合は12月18日までに連絡するとおっしゃいました。",
   "start_sec": 41.089,
   "end_sec": 46.182
  },
  {
   "sentence_id": "C45-B002-S06",
   "section": "B",
   "text": "まだ日は決まっていません。",
   "start_sec": 46.382,
   "end_sec": 48.447
  },
  {
   "sentence_id": "C45-B003-S01",
   "section": "B",
   "text": "名簿は2月5日までに書面でお送りいたします。",
   "start_sec": 48.897,
   "end_sec": 52.851
  },
  {
   "sentence_id": "C45-B003-S02",
   "section": "B",
   "text": "氏名の読み方も書き添えます。",
   "start_sec": 53.051,
   "end_sec": 55.324
  },
  {
   "sentence_id": "C45-B003-S03",
   "section": "B",
   "text": "写真は禁止、運動靴が必要で、最後にパンを頂くこともできると伺いました。",
   "start_sec": 55.524,
   "end_sec": 63.231
  },
  {
   "sentence_id": "C45-B003-S04",
   "section": "B",
   "text": "私どもは電車で参ります。",
   "start_sec": 63.431,
   "end_sec": 65.854
  },
  {
   "sentence_id": "C45-B003-S05",
   "section": "B",
   "text": "駅から徒歩10分ですね。",
   "start_sec": 66.054,
   "end_sec": 68.088
  },
  {
   "sentence_id": "C45-B003-S06",
   "section": "B",
   "text": "地図もお待ちしております。",
   "start_sec": 68.288,
   "end_sec": 70.131
  },
  {
   "sentence_id": "C45-B003-S07",
   "section": "B",
   "text": "どうかよろしくお願いいたします。",
   "start_sec": 70.331,
   "end_sec": 72.424
  },
  {
   "sentence_id": "C45-B004-S01",
   "section": "B",
   "text": "国際交流会のみなさんへ／アナです。",
   "start_sec": 72.874,
   "end_sec": 75.928
  },
  {
   "sentence_id": "C45-B004-S02",
   "section": "B",
   "text": "工場見学の正式な日は未定です。",
   "start_sec": 76.128,
   "end_sec": 79.35
  },
  {
   "sentence_id": "C45-B004-S03",
   "section": "B",
   "text": "19日と26日のどちらに参加できますか。",
   "start_sec": 79.55,
   "end_sec": 83.734
  },
  {
   "sentence_id": "C45-B004-S04",
   "section": "B",
   "text": "両方可能な人も難しい人も、12月23日までに返事をお願いします。",
   "start_sec": 83.934,
   "end_sec": 90.584
  },
  {
   "sentence_id": "C45-B004-S05",
   "section": "B",
   "text": "15人を超えたら、森さんに相談します。",
   "start_sec": 90.784,
   "end_sec": 94.468
  },
  {
   "sentence_id": "C45-B004-S06",
   "section": "B",
   "text": "工場の返事は18日までに来ます。",
   "start_sec": 94.668,
   "end_sec": 97.721
  },
  {
   "sentence_id": "C45-B004-S07",
   "section": "B",
   "text": "予定の公表は今は差し控えます。",
   "start_sec": 97.921,
   "end_sec": 101.165
  },
  {
   "sentence_id": "C45-B004-S08",
   "section": "B",
   "text": "難しい場合は、遠慮しないで断ってください。",
   "start_sec": 101.365,
   "end_sec": 105.248
  },
  {
   "sentence_id": "C45-B005-S01",
   "section": "B",
   "text": "先日の忘年会で、教員の田中さんは本社の森さんへの手紙を私に託しました。",
   "start_sec": 105.698,
   "end_sec": 113.071
  },
  {
   "sentence_id": "C45-B005-S02",
   "section": "B",
   "text": "依頼どおり、今日お渡しできました。",
   "start_sec": 113.271,
   "end_sec": 115.843
  },
  {
   "sentence_id": "C45-B005-S03",
   "section": "B",
   "text": "田中さんは案内状をメールでも送るそうです。",
   "start_sec": 116.043,
   "end_sec": 120.056
  },
  {
   "sentence_id": "C45-B005-S04",
   "section": "B",
   "text": "見学とは別の式典なので、参加は自由です。",
   "start_sec": 120.256,
   "end_sec": 124.834
  },
  {
   "sentence_id": "C45-B005-S05",
   "section": "B",
   "text": "以下はその写しです。",
   "start_sec": 125.034,
   "end_sec": 126.828
  },
  {
   "sentence_id": "C45-B006-S01",
   "section": "B",
   "text": "拝啓　御無沙汰しております。",
   "start_sec": 127.278,
   "end_sec": 129.611
  },
  {
   "sentence_id": "C45-B006-S02",
   "section": "B",
   "text": "来たる1月10日、大学で小さな式典を開きます。",
   "start_sec": 129.811,
   "end_sec": 134.664
  },
  {
   "sentence_id": "C45-B006-S03",
   "section": "B",
   "text": "午後1時開会です。",
   "start_sec": 134.864,
   "end_sec": 136.711
  },
  {
   "sentence_id": "C45-B006-S04",
   "section": "B",
   "text": "教授のお話の後、聴衆のみなさまと歓談します。",
   "start_sec": 136.911,
   "end_sec": 140.865
  },
  {
   "sentence_id": "C45-B006-S05",
   "section": "B",
   "text": "宴席はありません。",
   "start_sec": 141.065,
   "end_sec": 142.61
  },
  {
   "sentence_id": "C45-B006-S06",
   "section": "B",
   "text": "その折り、夏に頂戴した暑中見舞いのお礼も申し上げたいと存じます。",
   "start_sec": 142.81,
   "end_sec": 148.621
  },
  {
   "sentence_id": "C45-B006-S07",
   "section": "B",
   "text": "末筆ながら、みなさまのご健康をお祈りいたします。",
   "start_sec": 148.821,
   "end_sec": 152.955
  },
  {
   "sentence_id": "C45-B006-S08",
   "section": "B",
   "text": "敬具",
   "start_sec": 153.155,
   "end_sec": 153.909
  }
 ]
}
