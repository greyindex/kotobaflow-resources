{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 96.854,
 "source_chapter": 51,
 "sentence_intervals": [
  {
   "sentence_id": "C51-A001-S01",
   "section": "A",
   "text": "三月六日、私たちは十二人の初参加者を集め、案内の体験会を開いた。",
   "start_sec": 0.0,
   "end_sec": 6.938
  },
  {
   "sentence_id": "C51-A001-S02",
   "section": "A",
   "text": "三つの机は撮影、ゲーム、手作りの順だ。",
   "start_sec": 7.138,
   "end_sec": 11.933
  },
  {
   "sentence_id": "C51-A001-S03",
   "section": "A",
   "text": "写真の多い二つ折り版とシンプルな一枚版を、来た順序で交互に渡し、各六人に使ってもらった。",
   "start_sec": 12.133,
   "end_sec": 20.627
  },
  {
   "sentence_id": "C51-A001-S04",
   "section": "A",
   "text": "両方を使った人はいない。",
   "start_sec": 20.827,
   "end_sec": 22.861
  },
  {
   "sentence_id": "C51-A001-S05",
   "section": "A",
   "text": "私は三時間かけた二つ折り版に期待していた。",
   "start_sec": 23.061,
   "end_sec": 27.301
  },
  {
   "sentence_id": "C51-A001-S06",
   "section": "A",
   "text": "一枚版の制作は一時間だった。",
   "start_sec": 27.501,
   "end_sec": 30.564
  },
  {
   "sentence_id": "C51-A002-S01",
   "section": "A",
   "text": "苦労して準備したというのに、印刷機が止まった。",
   "start_sec": 31.014,
   "end_sec": 35.125
  },
  {
   "sentence_id": "C51-A002-S02",
   "section": "A",
   "text": "やっと印刷が終わり、十四時の開始予定は十分遅れた。",
   "start_sec": 35.325,
   "end_sec": 40.239
  },
  {
   "sentence_id": "C51-A002-S03",
   "section": "A",
   "text": "四十分の体験は十四時五十分に終わった。",
   "start_sec": 40.439,
   "end_sec": 44.74
  },
  {
   "sentence_id": "C51-A002-S04",
   "section": "A",
   "text": "せっかく早く来てくれたのに、待たせてしまって残念だった。",
   "start_sec": 44.94,
   "end_sec": 49.522
  },
  {
   "sentence_id": "C51-A003-S01",
   "section": "A",
   "text": "二つ折り版は手間をかけたわりに、最初の机が分かりにくかった。",
   "start_sec": 49.972,
   "end_sec": 55.425
  },
  {
   "sentence_id": "C51-A003-S02",
   "section": "A",
   "text": "六人中四人が質問し、一枚版では一人だった。",
   "start_sec": 55.625,
   "end_sec": 60.108
  },
  {
   "sentence_id": "C51-A003-S03",
   "section": "A",
   "text": "一時間で作ったにしては案外使いやすい。",
   "start_sec": 60.308,
   "end_sec": 63.812
  },
  {
   "sentence_id": "C51-A003-S04",
   "section": "A",
   "text": "写真を増やし、親切にしたつもりだったが、かえって入口の表示が小さくなった。",
   "start_sec": 64.012,
   "end_sec": 71.093
  },
  {
   "sentence_id": "C51-A003-S05",
   "section": "A",
   "text": "予想と現実は違い、私はがっかりした。",
   "start_sec": 71.293,
   "end_sec": 74.946
  },
  {
   "sentence_id": "C51-A004-S01",
   "section": "A",
   "text": "アナさんは「直す場所が分かって助かった」と言った。",
   "start_sec": 75.396,
   "end_sec": 79.13
  },
  {
   "sentence_id": "C51-A004-S02",
   "section": "A",
   "text": "質問の数だけでは成功か失敗か判断できない。",
   "start_sec": 79.33,
   "end_sec": 84.671
  },
  {
   "sentence_id": "C51-A004-S03",
   "section": "A",
   "text": "努力を無駄にせず、写真を残して表示を直そう。",
   "start_sec": 84.871,
   "end_sec": 89.162
  },
  {
   "sentence_id": "C51-A004-S04",
   "section": "A",
   "text": "ちょっとした変更でも、結果的に効率が上がるかもしれない。",
   "start_sec": 89.362,
   "end_sec": 94.034
  },
  {
   "sentence_id": "C51-A004-S05",
   "section": "A",
   "text": "意外な結果にも学ぶ価値がある。",
   "start_sec": 94.234,
   "end_sec": 96.848
  }
 ]
}
