{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 156.228,
 "source_chapter": 51,
 "sentence_intervals": [
  {
   "sentence_id": "C51-B001-S01",
   "section": "B",
   "text": "三月七日、アナの記録。",
   "start_sec": 0.0,
   "end_sec": 2.459
  },
  {
   "sentence_id": "C51-B001-S02",
   "section": "B",
   "text": "入口の質問と各机での感想は別々に確認します。",
   "start_sec": 2.659,
   "end_sec": 8.833
  },
  {
   "sentence_id": "C51-B001-S03",
   "section": "B",
   "text": "昨日は写真を多くすれば理想的な案内になると予想しましたが、見かけの豪華さだけでは評価できません。",
   "start_sec": 9.033,
   "end_sec": 17.93
  },
  {
   "sentence_id": "C51-B001-S04",
   "section": "B",
   "text": "時間に相応の成果が出たかは未確認です。",
   "start_sec": 18.13,
   "end_sec": 21.903
  },
  {
   "sentence_id": "C51-B001-S05",
   "section": "B",
   "text": "十二人の記録では根拠が不十分で、質問しなかった人が満足したとも言えません。",
   "start_sec": 22.103,
   "end_sec": 29.274
  },
  {
   "sentence_id": "C51-B001-S06",
   "section": "B",
   "text": "準備を十分したつもりでも、確認には落ちがありました。",
   "start_sec": 29.474,
   "end_sec": 33.908
  },
  {
   "sentence_id": "C51-B002-S01",
   "section": "B",
   "text": "撮影の机では、近所で見かけるカメラマンに借りたアルバムを開きました。",
   "start_sec": 34.358,
   "end_sec": 39.871
  },
  {
   "sentence_id": "C51-B002-S02",
   "section": "B",
   "text": "フィルムで撮った湖の自然美に、参加者の目が釘付けになりました。",
   "start_sec": 40.071,
   "end_sec": 45.928
  },
  {
   "sentence_id": "C51-B002-S03",
   "section": "B",
   "text": "プロだけあって、実に見事な一枚です。",
   "start_sec": 46.128,
   "end_sec": 49.43
  },
  {
   "sentence_id": "C51-B002-S04",
   "section": "B",
   "text": "しかし、高級なブランドの道具でなくても撮影はできます。",
   "start_sec": 49.63,
   "end_sec": 54.26
  },
  {
   "sentence_id": "C51-B002-S05",
   "section": "B",
   "text": "借りたデジカメでツーショットを撮ると、二人は「写真屋で撮ったみたい」と笑いました。",
   "start_sec": 54.46,
   "end_sec": 60.753
  },
  {
   "sentence_id": "C51-B002-S06",
   "section": "B",
   "text": "このショットは思いがけない記念になりました。",
   "start_sec": 60.953,
   "end_sec": 64.486
  },
  {
   "sentence_id": "C51-B003-S01",
   "section": "B",
   "text": "ゲームの机には冒険の物語を読むパズルを置きました。",
   "start_sec": 64.936,
   "end_sec": 69.486
  },
  {
   "sentence_id": "C51-B003-S02",
   "section": "B",
   "text": "謎謎を解くと先へ進めます。",
   "start_sec": 69.686,
   "end_sec": 72.596
  },
  {
   "sentence_id": "C51-B003-S03",
   "section": "B",
   "text": "暇つぶしのつもりで始めた人も、スリルのある最後の問題には手に汗を握っていました。",
   "start_sec": 72.796,
   "end_sec": 79.51
  },
  {
   "sentence_id": "C51-B003-S04",
   "section": "B",
   "text": "答えを読むと落ちが付く仕組みで、笑いが沸き起こりました。",
   "start_sec": 79.71,
   "end_sec": 84.743
  },
  {
   "sentence_id": "C51-B003-S05",
   "section": "B",
   "text": "ゲーム狂を自称する人も「これは名作だ」と褒め立てました。",
   "start_sec": 84.943,
   "end_sec": 89.34
  },
  {
   "sentence_id": "C51-B003-S06",
   "section": "B",
   "text": "ただし、受けがよいことと案内が分かりやすいことは別です。",
   "start_sec": 89.54,
   "end_sec": 94.609
  },
  {
   "sentence_id": "C51-B004-S01",
   "section": "B",
   "text": "手作りの机では、毛糸で小物を編みました。",
   "start_sec": 95.059,
   "end_sec": 98.923
  },
  {
   "sentence_id": "C51-B004-S02",
   "section": "B",
   "text": "運良く経験のある人がいて、難しい所を教えてくれました。",
   "start_sec": 99.123,
   "end_sec": 103.917
  },
  {
   "sentence_id": "C51-B004-S03",
   "section": "B",
   "text": "初めは容易にできると思った人も、一つ作るのがやっとでした。",
   "start_sec": 104.117,
   "end_sec": 109.612
  },
  {
   "sentence_id": "C51-B004-S04",
   "section": "B",
   "text": "上等な道具のセットを使っても、たやすい作業だとは言えません。",
   "start_sec": 109.812,
   "end_sec": 114.537
  },
  {
   "sentence_id": "C51-B004-S05",
   "section": "B",
   "text": "「下手の横好きです」と話した人の作品にも味があります。",
   "start_sec": 114.737,
   "end_sec": 119.058
  },
  {
   "sentence_id": "C51-B004-S06",
   "section": "B",
   "text": "審査員のように優勝を決める会ではないので、全員を同じ速さで比べるのは不公平です。",
   "start_sec": 119.258,
   "end_sec": 126.464
  },
  {
   "sentence_id": "C51-B005-S01",
   "section": "B",
   "text": "ミンさんは「期待を裏切る結果に失望した」と言いました。",
   "start_sec": 126.914,
   "end_sec": 131.289
  },
  {
   "sentence_id": "C51-B005-S02",
   "section": "B",
   "text": "しかし、苦心して選んだ写真を捨てるのは惜しいです。",
   "start_sec": 131.489,
   "end_sec": 135.857
  },
  {
   "sentence_id": "C51-B005-S03",
   "section": "B",
   "text": "努力が報われるよう、次は入口の表示を直し、前日に印刷します。",
   "start_sec": 136.057,
   "end_sec": 142.788
  },
  {
   "sentence_id": "C51-B005-S04",
   "section": "B",
   "text": "三人で確認すれば改善の甲斐があるでしょう。",
   "start_sec": 142.988,
   "end_sec": 146.943
  },
  {
   "sentence_id": "C51-B005-S05",
   "section": "B",
   "text": "次の日時と参加者は未定です。",
   "start_sec": 147.143,
   "end_sec": 149.815
  },
  {
   "sentence_id": "C51-B005-S06",
   "section": "B",
   "text": "写真への意見もまだ集めていないので、「大成功を収めた」と誉め称えるのは早いです。",
   "start_sec": 150.015,
   "end_sec": 156.222
  }
 ]
}
