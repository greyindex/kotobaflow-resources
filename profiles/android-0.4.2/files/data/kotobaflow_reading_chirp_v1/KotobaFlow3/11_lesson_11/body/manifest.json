{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 91.728,
 "source_chapter": 47,
 "sentence_intervals": [
  {
   "sentence_id": "C47-A001-S01",
   "section": "A",
   "text": "一月六日、私はアナさんと佐藤さんに相談した。",
   "start_sec": 0.0,
   "end_sec": 4.984
  },
  {
   "sentence_id": "C47-A001-S02",
   "section": "A",
   "text": "日本語で短い報告ができるように、十二月から週に三回、一分間の録音を続けている。",
   "start_sec": 5.184,
   "end_sec": 13.006
  },
  {
   "sentence_id": "C47-A001-S03",
   "section": "A",
   "text": "今日も家を出る直前に録音を終えた。",
   "start_sec": 13.206,
   "end_sec": 17.039
  },
  {
   "sentence_id": "C47-A001-S04",
   "section": "A",
   "text": "その直後、言えなかったことを一つ書いた。",
   "start_sec": 17.239,
   "end_sec": 20.792
  },
  {
   "sentence_id": "C47-A001-S05",
   "section": "A",
   "text": "始めて以来、早くも一か月が経つ。",
   "start_sec": 20.992,
   "end_sec": 24.179
  },
  {
   "sentence_id": "C47-A002-S01",
   "section": "A",
   "text": "当初の目標は二分間話し続けることだった。",
   "start_sec": 24.629,
   "end_sec": 28.582
  },
  {
   "sentence_id": "C47-A002-S02",
   "section": "A",
   "text": "しかし、最近は速さだけを考え、話がますます分かりにくくなった。",
   "start_sec": 28.782,
   "end_sec": 35.104
  },
  {
   "sentence_id": "C47-A002-S03",
   "section": "A",
   "text": "目標に近づくつもりで、伝える目的から遠ざかっていた。",
   "start_sec": 35.304,
   "end_sec": 40.038
  },
  {
   "sentence_id": "C47-A002-S04",
   "section": "A",
   "text": "一時期、練習が一時止まったこともある。",
   "start_sec": 40.238,
   "end_sec": 43.715
  },
  {
   "sentence_id": "C47-A003-S01",
   "section": "A",
   "text": "三人で録音を聞くと、話せることが徐々に増えてきたのが分かった。",
   "start_sec": 44.165,
   "end_sec": 49.954
  },
  {
   "sentence_id": "C47-A003-S02",
   "section": "A",
   "text": "途中で黙る時間も次第に減り、とうとう一つの話を最後まで伝えられた。",
   "start_sec": 50.154,
   "end_sec": 56.267
  },
  {
   "sentence_id": "C47-A003-S03",
   "section": "A",
   "text": "やがて質問にも答えたいが、一回の成功だけで飛躍的な進歩とは言えない。",
   "start_sec": 56.467,
   "end_sec": 63.072
  },
  {
   "sentence_id": "C47-A003-S04",
   "section": "A",
   "text": "話せた瞬間だけで判断しないようにと、アナさんが言った。",
   "start_sec": 63.272,
   "end_sec": 67.825
  },
  {
   "sentence_id": "C47-A004-S01",
   "section": "A",
   "text": "まだ始めたばかりで、続けやすい方法を探しているところだ。",
   "start_sec": 68.275,
   "end_sec": 73.185
  },
  {
   "sentence_id": "C47-A004-S02",
   "section": "A",
   "text": "短期目標は一月末までに一分間で伝えたいことを話すこと、長期目標は質問に答える力を身に付けることにした。",
   "start_sec": 73.385,
   "end_sec": 83.9
  },
  {
   "sentence_id": "C47-A004-S03",
   "section": "A",
   "text": "理解が深まる過程も記録する。",
   "start_sec": 84.1,
   "end_sec": 86.969
  },
  {
   "sentence_id": "C47-A004-S04",
   "section": "A",
   "text": "今後も成長を確かめながら、新たな段階へ進んでいきたい。",
   "start_sec": 87.169,
   "end_sec": 91.722
  }
 ]
}
