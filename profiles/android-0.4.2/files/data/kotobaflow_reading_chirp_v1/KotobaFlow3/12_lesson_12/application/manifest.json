{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 129.549,
 "source_chapter": 48,
 "sentence_intervals": [
  {
   "sentence_id": "C48-B001-S01",
   "section": "B",
   "text": "一月十三日　アナからみどり印刷店へ\n田中様\n",
   "start_sec": 0.0,
   "end_sec": 5.684
  },
  {
   "sentence_id": "C48-B001-S02",
   "section": "B",
   "text": "今日お電話したアナ・ロペスと申します。",
   "start_sec": 5.884,
   "end_sec": 8.562
  },
  {
   "sentence_id": "C48-B001-S03",
   "section": "B",
   "text": "注文二十五番の案内について、ご相談しました。",
   "start_sec": 8.762,
   "end_sec": 12.896
  },
  {
   "sentence_id": "C48-B001-S04",
   "section": "B",
   "text": "お話を聞いてくださって、ありがとうございました。",
   "start_sec": 13.096,
   "end_sec": 16.389
  },
  {
   "sentence_id": "C48-B001-S05",
   "section": "B",
   "text": "電話で確認したことをお送りします。",
   "start_sec": 16.589,
   "end_sec": 19.162
  },
  {
   "sentence_id": "C48-B002-S01",
   "section": "B",
   "text": "一月十二日にミンが案内三十枚を受け取り、店を出る前にアドレスの間違いを確認しました。",
   "start_sec": 19.612,
   "end_sec": 28.966
  },
  {
   "sentence_id": "C48-B002-S02",
   "section": "B",
   "text": "そのとき店員の方に原稿を見せました。",
   "start_sec": 29.166,
   "end_sec": 32.339
  },
  {
   "sentence_id": "C48-B002-S03",
   "section": "B",
   "text": "三十枚ともまだ配っていません。",
   "start_sec": 32.539,
   "end_sec": 35.174
  },
  {
   "sentence_id": "C48-B002-S04",
   "section": "B",
   "text": "今は私たちの手元に残してあります。",
   "start_sec": 35.374,
   "end_sec": 39.062
  },
  {
   "sentence_id": "C48-B002-S05",
   "section": "B",
   "text": "ほかの被害は、今の段階では確認できていません。",
   "start_sec": 39.262,
   "end_sec": 43.515
  },
  {
   "sentence_id": "C48-B003-S01",
   "section": "B",
   "text": "今日は授業があるので、店に伺うことができません。",
   "start_sec": 43.965,
   "end_sec": 48.024
  },
  {
   "sentence_id": "C48-B003-S02",
   "section": "B",
   "text": "代わりに、注文前に送った原稿と案内の写真を添付しました。",
   "start_sec": 48.224,
   "end_sec": 54.07
  },
  {
   "sentence_id": "C48-B003-S03",
   "section": "B",
   "text": "書類を比べて、アドレスを確認していただけませんか。",
   "start_sec": 54.27,
   "end_sec": 58.163
  },
  {
   "sentence_id": "C48-B003-S04",
   "section": "B",
   "text": "写真の文字が小さくて読めなかったら、大きい写真を送ります。",
   "start_sec": 58.363,
   "end_sec": 63.769
  },
  {
   "sentence_id": "C48-B003-S05",
   "section": "B",
   "text": "紙の案内は捨てないで残しておくつもりです。",
   "start_sec": 63.969,
   "end_sec": 67.742
  },
  {
   "sentence_id": "C48-B003-S06",
   "section": "B",
   "text": "必要な資料がほかにもあったら、お知らせください。",
   "start_sec": 67.942,
   "end_sec": 71.78
  },
  {
   "sentence_id": "C48-B004-S01",
   "section": "B",
   "text": "一月三十日の合宿で使うために、二十八日までに正しい案内を受け取りたいと思っています。",
   "start_sec": 72.23,
   "end_sec": 80.275
  },
  {
   "sentence_id": "C48-B004-S02",
   "section": "B",
   "text": "もう一度印刷するかどうか、料金と受け取りの日程はまだ決まっていません。",
   "start_sec": 80.475,
   "end_sec": 86.753
  },
  {
   "sentence_id": "C48-B004-S03",
   "section": "B",
   "text": "一月十五日午後五時までに経過をメールで知らせていただく予定です。",
   "start_sec": 86.953,
   "end_sec": 93.039
  },
  {
   "sentence_id": "C48-B004-S04",
   "section": "B",
   "text": "確認の途中でも、ご連絡をお願いします。",
   "start_sec": 93.239,
   "end_sec": 96.892
  },
  {
   "sentence_id": "C48-B004-S05",
   "section": "B",
   "text": "電話と違うことが書いてあったら、ご返信ください。",
   "start_sec": 97.092,
   "end_sec": 101.067
  },
  {
   "sentence_id": "C48-B004-S06",
   "section": "B",
   "text": "アナ・ロペス",
   "start_sec": 101.267,
   "end_sec": 102.33
  },
  {
   "sentence_id": "C48-B005-S01",
   "section": "B",
   "text": "一月十三日　田中からアナへ\nアナ・ロペス様\n",
   "start_sec": 102.78,
   "end_sec": 107.678
  },
  {
   "sentence_id": "C48-B005-S02",
   "section": "B",
   "text": "原稿と写真を受け取り、今、確認しているところです。",
   "start_sec": 107.878,
   "end_sec": 112.533
  },
  {
   "sentence_id": "C48-B005-S03",
   "section": "B",
   "text": "メールに書いてあることに間違いはありません。",
   "start_sec": 112.733,
   "end_sec": 115.727
  },
  {
   "sentence_id": "C48-B005-S04",
   "section": "B",
   "text": "今日は店にいらっしゃらなくても大丈夫です。",
   "start_sec": 115.927,
   "end_sec": 119.22
  },
  {
   "sentence_id": "C48-B005-S05",
   "section": "B",
   "text": "一月十五日午後五時までに経過をご連絡します。",
   "start_sec": 119.42,
   "end_sec": 124.116
  },
  {
   "sentence_id": "C48-B005-S06",
   "section": "B",
   "text": "ご迷惑をおかけして、申し訳ありません。",
   "start_sec": 124.316,
   "end_sec": 127.429
  },
  {
   "sentence_id": "C48-B005-S07",
   "section": "B",
   "text": "みどり印刷店　田中",
   "start_sec": 127.629,
   "end_sec": 129.542
  }
 ]
}
