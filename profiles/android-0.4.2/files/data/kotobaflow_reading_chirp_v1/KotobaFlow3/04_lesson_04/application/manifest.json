{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 163.849,
 "source_chapter": 40,
 "sentence_intervals": [
  {
   "sentence_id": "C40-B001-S01",
   "section": "B",
   "text": "日本語の会のみなさんへ。",
   "start_sec": 0.0,
   "end_sec": 2.153
  },
  {
   "sentence_id": "C40-B001-S02",
   "section": "B",
   "text": "十月十六日、二十一時三十分。",
   "start_sec": 2.353,
   "end_sec": 6.258
  },
  {
   "sentence_id": "C40-B001-S03",
   "section": "B",
   "text": "アナ・ロペスです。",
   "start_sec": 6.458,
   "end_sec": 7.749
  },
  {
   "sentence_id": "C40-B001-S04",
   "section": "B",
   "text": "今日の十二時に、掲示の連絡先に電話し、最新情報を確認しました。",
   "start_sec": 7.949,
   "end_sec": 14.161
  },
  {
   "sentence_id": "C40-B001-S05",
   "section": "B",
   "text": "書き出しに確認の日時を入れたので、保存するときも日付を残してください。",
   "start_sec": 14.361,
   "end_sec": 19.934
  },
  {
   "sentence_id": "C40-B002-S01",
   "section": "B",
   "text": "十三日に市が延期を発表しました。",
   "start_sec": 20.384,
   "end_sec": 23.624
  },
  {
   "sentence_id": "C40-B002-S02",
   "section": "B",
   "text": "掲示によると、広場の工事は十八日まで続くそうです。",
   "start_sec": 23.824,
   "end_sec": 28.682
  },
  {
   "sentence_id": "C40-B002-S03",
   "section": "B",
   "text": "お祭りの開催日は二十五日、場所はさくら市民センター前の広場です。",
   "start_sec": 28.882,
   "end_sec": 35.632
  },
  {
   "sentence_id": "C40-B002-S04",
   "section": "B",
   "text": "十五日に市が公表した予定によれば、十一時から十五時までだそうです。",
   "start_sec": 35.832,
   "end_sec": 42.131
  },
  {
   "sentence_id": "C40-B002-S05",
   "section": "B",
   "text": "準備は十時からできるとのことです。",
   "start_sec": 42.331,
   "end_sec": 45.494
  },
  {
   "sentence_id": "C40-B003-S01",
   "section": "B",
   "text": "森さんは「中止ではありません」と言いました。",
   "start_sec": 45.944,
   "end_sec": 49.598
  },
  {
   "sentence_id": "C40-B003-S02",
   "section": "B",
   "text": "これは森さんの言葉の引用です。",
   "start_sec": 49.798,
   "end_sec": 52.971
  },
  {
   "sentence_id": "C40-B003-S03",
   "section": "B",
   "text": "今のところ、雨の日の予定は決まっていません。",
   "start_sec": 53.171,
   "end_sec": 56.982
  },
  {
   "sentence_id": "C40-B003-S04",
   "section": "B",
   "text": "二十二日に公式ホームページで知らせるということです。",
   "start_sec": 57.182,
   "end_sec": 61.646
  },
  {
   "sentence_id": "C40-B003-S05",
   "section": "B",
   "text": "森さんは、私に二十四日までに何人参加するかを連絡するように言いました。",
   "start_sec": 61.846,
   "end_sec": 68.441
  },
  {
   "sentence_id": "C40-B003-S06",
   "section": "B",
   "text": "参加できる人は二十三日までに私に連絡してください。",
   "start_sec": 68.641,
   "end_sec": 73.735
  },
  {
   "sentence_id": "C40-B004-S01",
   "section": "B",
   "text": "古い記事の出典は、十日の「さくら市だより」です。",
   "start_sec": 74.185,
   "end_sec": 78.115
  },
  {
   "sentence_id": "C40-B004-S02",
   "section": "B",
   "text": "この記事の後で予定が変わったので、誤報とは言いません。",
   "start_sec": 78.315,
   "end_sec": 82.8
  },
  {
   "sentence_id": "C40-B004-S03",
   "section": "B",
   "text": "地元の放送局も、今日のニュースで訂正を伝えました。",
   "start_sec": 83.0,
   "end_sec": 87.013
  },
  {
   "sentence_id": "C40-B004-S04",
   "section": "B",
   "text": "放送の録音を聞くと、記者は最後に「市によると、工事は十八日まで続くという」と話しています。",
   "start_sec": 87.213,
   "end_sec": 95.297
  },
  {
   "sentence_id": "C40-B004-S05",
   "section": "B",
   "text": "放送も市の発表を紹介していますが、今後の変更は市のホームページで確認してください。",
   "start_sec": 95.497,
   "end_sec": 102.69
  },
  {
   "sentence_id": "C40-B005-S01",
   "section": "B",
   "text": "原さんが受信した非公式のメールには、「お祭り中止の速報」という見出しがありました。",
   "start_sec": 103.14,
   "end_sec": 109.751
  },
  {
   "sentence_id": "C40-B005-S02",
   "section": "B",
   "text": "発信した人の名前はなく、中止という内容は事実と違います。",
   "start_sec": 109.951,
   "end_sec": 115.593
  },
  {
   "sentence_id": "C40-B005-S03",
   "section": "B",
   "text": "だれが最初に書いたかは、今も謎です。",
   "start_sec": 115.793,
   "end_sec": 119.306
  },
  {
   "sentence_id": "C40-B005-S04",
   "section": "B",
   "text": "市は情報が広まった経路を調べて、原因を解明する予定だそうです。",
   "start_sec": 119.506,
   "end_sec": 125.426
  },
  {
   "sentence_id": "C40-B005-S05",
   "section": "B",
   "text": "調査の結果が出る前に、ある人の名前を出して責めないようにしましょう。",
   "start_sec": 125.626,
   "end_sec": 131.319
  },
  {
   "sentence_id": "C40-B006-S01",
   "section": "B",
   "text": "以上は確認した情報です。",
   "start_sec": 131.769,
   "end_sec": 134.072
  },
  {
   "sentence_id": "C40-B006-S02",
   "section": "B",
   "text": "ここからは私の考えです。",
   "start_sec": 134.272,
   "end_sec": 136.425
  },
  {
   "sentence_id": "C40-B006-S03",
   "section": "B",
   "text": "工事が長くなったら、予定がまた変わるかもしれません。",
   "start_sec": 136.625,
   "end_sec": 140.628
  },
  {
   "sentence_id": "C40-B006-S04",
   "section": "B",
   "text": "これは市の発表ではありません。",
   "start_sec": 140.828,
   "end_sec": 143.401
  },
  {
   "sentence_id": "C40-B006-S05",
   "section": "B",
   "text": "二十二日に雨の日の予定を調べて、もう一度伝えます。",
   "start_sec": 143.601,
   "end_sec": 148.907
  },
  {
   "sentence_id": "C40-B006-S06",
   "section": "B",
   "text": "写真の会の連絡方法はまだ明らかではありません。",
   "start_sec": 149.107,
   "end_sec": 153.567
  },
  {
   "sentence_id": "C40-B006-S07",
   "section": "B",
   "text": "原さんが月曜日に森さんに聞く予定です。",
   "start_sec": 153.767,
   "end_sec": 157.301
  },
  {
   "sentence_id": "C40-B006-S08",
   "section": "B",
   "text": "マスコミの評判だけで情報を信じないで、内容と日付を確かめたいと思います。",
   "start_sec": 157.501,
   "end_sec": 163.843
  }
 ]
}
