{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 69.403,
 "source_chapter": 40,
 "sentence_intervals": [
  {
   "sentence_id": "C40-A001-S01",
   "section": "A",
   "text": "十月十七日、私は昨日確認した知らせを読み直しました。",
   "start_sec": 0.0,
   "end_sec": 5.153
  },
  {
   "sentence_id": "C40-A001-S02",
   "section": "A",
   "text": "十日の記事によると、さくら市のお祭りは十八日の十時からだということでした。",
   "start_sec": 5.353,
   "end_sec": 11.647
  },
  {
   "sentence_id": "C40-A001-S03",
   "section": "A",
   "text": "記者は六日に取材をし、市の担当者にインタビューをしたそうです。",
   "start_sec": 11.847,
   "end_sec": 17.0
  },
  {
   "sentence_id": "C40-A001-S04",
   "section": "A",
   "text": "十三日の掲示では二十五日に延期になり、十五日の公式ホームページでは開始が十一時に変わりました。",
   "start_sec": 17.2,
   "end_sec": 26.524
  },
  {
   "sentence_id": "C40-A002-S01",
   "section": "A",
   "text": "私は十六日の十二時に担当の森さんに電話しました。",
   "start_sec": 26.974,
   "end_sec": 32.679
  },
  {
   "sentence_id": "C40-A002-S02",
   "section": "A",
   "text": "森さんの話では、中止ではないそうです。",
   "start_sec": 32.879,
   "end_sec": 36.113
  },
  {
   "sentence_id": "C40-A002-S03",
   "section": "A",
   "text": "その夜、私は日本語の会にメールで報告しました。",
   "start_sec": 36.313,
   "end_sec": 40.746
  },
  {
   "sentence_id": "C40-A002-S04",
   "section": "A",
   "text": "古い報道と新しい発表、未確認の噂を分けて書きました。",
   "start_sec": 40.946,
   "end_sec": 46.339
  },
  {
   "sentence_id": "C40-A002-S05",
   "section": "A",
   "text": "聞き手には、話し手と情報源の区別が大切です。",
   "start_sec": 46.539,
   "end_sec": 50.649
  },
  {
   "sentence_id": "C40-A003-S01",
   "section": "A",
   "text": "うわさ話はすぐ広まります。",
   "start_sec": 51.099,
   "end_sec": 53.253
  },
  {
   "sentence_id": "C40-A003-S02",
   "section": "A",
   "text": "町中に知れ渡った話でも、事実かどうか確認が必要です。",
   "start_sec": 53.453,
   "end_sec": 58.306
  },
  {
   "sentence_id": "C40-A003-S03",
   "section": "A",
   "text": "情報の伝達には責任があると思います。",
   "start_sec": 58.506,
   "end_sec": 62.201
  },
  {
   "sentence_id": "C40-A003-S04",
   "section": "A",
   "text": "私はこれからも、人に伝える前に、いつ、だれが言ったかを確かめようと思います。",
   "start_sec": 62.401,
   "end_sec": 69.397
  }
 ]
}
