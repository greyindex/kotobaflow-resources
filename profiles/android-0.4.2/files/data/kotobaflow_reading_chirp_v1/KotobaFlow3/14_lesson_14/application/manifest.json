{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 187.166,
 "source_chapter": 50,
 "sentence_intervals": [
  {
   "sentence_id": "C50-B001-S01",
   "section": "B",
   "text": "二月六日（土）十四時から十六時、会議室Ａでカードを作ります。",
   "start_sec": 0.0,
   "end_sec": 6.692
  },
  {
   "sentence_id": "C50-B001-S02",
   "section": "B",
   "text": "定員十二人、無料です。",
   "start_sec": 6.892,
   "end_sec": 9.439
  },
  {
   "sentence_id": "C50-B001-S03",
   "section": "B",
   "text": "アナが紙とペンを用意し、予備も残します。",
   "start_sec": 9.639,
   "end_sec": 13.571
  },
  {
   "sentence_id": "C50-B001-S04",
   "section": "B",
   "text": "予算の限度は三千円です。",
   "start_sec": 13.771,
   "end_sec": 16.567
  },
  {
   "sentence_id": "C50-B001-S05",
   "section": "B",
   "text": "見本用の道具は借りた物で、当日必要な材料は最小限にします。",
   "start_sec": 16.767,
   "end_sec": 22.642
  },
  {
   "sentence_id": "C50-B001-S06",
   "section": "B",
   "text": "予算に制限があるので、新しい機械は買いません。",
   "start_sec": 22.842,
   "end_sec": 26.795
  },
  {
   "sentence_id": "C50-B002-S01",
   "section": "B",
   "text": "申込みの期限は二月三日（水）十八時です。",
   "start_sec": 27.245,
   "end_sec": 32.372
  },
  {
   "sentence_id": "C50-B002-S02",
   "section": "B",
   "text": "名前と連絡先をアナに知らせてください。",
   "start_sec": 32.572,
   "end_sec": 35.746
  },
  {
   "sentence_id": "C50-B002-S03",
   "section": "B",
   "text": "メールを使わない場合は電話で申し込めます。",
   "start_sec": 35.946,
   "end_sec": 39.539
  },
  {
   "sentence_id": "C50-B002-S04",
   "section": "B",
   "text": "期限までに参加を決められない場合は、同じ時間までに相談してください。",
   "start_sec": 39.739,
   "end_sec": 45.163
  },
  {
   "sentence_id": "C50-B002-S05",
   "section": "B",
   "text": "一日の猶予があり、二月四日（木）十八時まで返事を待ちます。",
   "start_sec": 45.363,
   "end_sec": 51.662
  },
  {
   "sentence_id": "C50-B003-S01",
   "section": "B",
   "text": "受付番号は今回だけ有効です。",
   "start_sec": 52.112,
   "end_sec": 55.053
  },
  {
   "sentence_id": "C50-B003-S02",
   "section": "B",
   "text": "中止の場合は無効になります。",
   "start_sec": 55.253,
   "end_sec": 57.572
  },
  {
   "sentence_id": "C50-B003-S03",
   "section": "B",
   "text": "延期なら番号を残し、新しい日に参加できるか再確認します。",
   "start_sec": 57.772,
   "end_sec": 63.026
  },
  {
   "sentence_id": "C50-B003-S04",
   "section": "B",
   "text": "会議室Ａが使える限り予定どおり開き、使えなければ延期します。",
   "start_sec": 63.226,
   "end_sec": 68.949
  },
  {
   "sentence_id": "C50-B003-S05",
   "section": "B",
   "text": "今回は別室を借りる代案は選びません。",
   "start_sec": 69.149,
   "end_sec": 73.042
  },
  {
   "sentence_id": "C50-B003-S06",
   "section": "B",
   "text": "日程を決めない限り申込みは再開しません。",
   "start_sec": 73.242,
   "end_sec": 77.256
  },
  {
   "sentence_id": "C50-B004-S01",
   "section": "B",
   "text": "自分で書けなくても、口で伝えられさえすればミンが代わりに書きます。",
   "start_sec": 77.706,
   "end_sec": 83.552
  },
  {
   "sentence_id": "C50-B004-S02",
   "section": "B",
   "text": "この条件に該当しない場合も、適切な方法を一緒に考えます。",
   "start_sec": 83.752,
   "end_sec": 89.18
  },
  {
   "sentence_id": "C50-B004-S03",
   "section": "B",
   "text": "一言でも紹介してもらえればうれしいです。",
   "start_sec": 89.38,
   "end_sec": 92.553
  },
  {
   "sentence_id": "C50-B004-S04",
   "section": "B",
   "text": "参加方法の希望には、可能な範囲で応じます。",
   "start_sec": 92.753,
   "end_sec": 96.855
  },
  {
   "sentence_id": "C50-B005-S01",
   "section": "B",
   "text": "変更はアナが連絡網で知らせます。",
   "start_sec": 97.305,
   "end_sec": 100.959
  },
  {
   "sentence_id": "C50-B005-S02",
   "section": "B",
   "text": "必ず返事をしてください。",
   "start_sec": 101.159,
   "end_sec": 103.051
  },
  {
   "sentence_id": "C50-B005-S03",
   "section": "B",
   "text": "返事がない人には電話します。",
   "start_sec": 103.251,
   "end_sec": 106.004
  },
  {
   "sentence_id": "C50-B005-S04",
   "section": "B",
   "text": "たとえ参加者が少なくても、連絡と部屋の担当を少なくとも二人確保します。",
   "start_sec": 106.204,
   "end_sec": 113.013
  },
  {
   "sentence_id": "C50-B005-S05",
   "section": "B",
   "text": "二人未満では開きません。",
   "start_sec": 113.213,
   "end_sec": 115.35
  },
  {
   "sentence_id": "C50-B005-S06",
   "section": "B",
   "text": "これは準備の前提です。",
   "start_sec": 115.55,
   "end_sec": 117.775
  },
  {
   "sentence_id": "C50-B006-S01",
   "section": "B",
   "text": "悪天候で来られない時は無理をしないでください。",
   "start_sec": 118.225,
   "end_sec": 122.26
  },
  {
   "sentence_id": "C50-B006-S02",
   "section": "B",
   "text": "欠席の連絡はメールが原則です。",
   "start_sec": 122.46,
   "end_sec": 125.489
  },
  {
   "sentence_id": "C50-B006-S03",
   "section": "B",
   "text": "緊急の場合は例外ですが、電話でも受け付けます。",
   "start_sec": 125.689,
   "end_sec": 130.029
  },
  {
   "sentence_id": "C50-B006-S04",
   "section": "B",
   "text": "海を渡る船で来る人は運航情報に留意してください。",
   "start_sec": 130.229,
   "end_sec": 135.093
  },
  {
   "sentence_id": "C50-B006-S05",
   "section": "B",
   "text": "海が荒れ、波が高い日は、風速の数字だけで移動を決めないでください。",
   "start_sec": 135.293,
   "end_sec": 141.577
  },
  {
   "sentence_id": "C50-B007-S01",
   "section": "B",
   "text": "担当者は停電・断水を想定した別の練習資料も読んでください。",
   "start_sec": 142.027,
   "end_sec": 148.26
  },
  {
   "sentence_id": "C50-B007-S02",
   "section": "B",
   "text": "警報の確認先と避難の案内が載っています。",
   "start_sec": 148.46,
   "end_sec": 152.293
  },
  {
   "sentence_id": "C50-B007-S03",
   "section": "B",
   "text": "支障があれば早急に施設の担当者に相談し、対処の方法を確認します。",
   "start_sec": 152.493,
   "end_sec": 159.807
  },
  {
   "sentence_id": "C50-B007-S04",
   "section": "B",
   "text": "開催できるかは施設の状況次第です。",
   "start_sec": 160.007,
   "end_sec": 163.3
  },
  {
   "sentence_id": "C50-B007-S05",
   "section": "B",
   "text": "これは架空の会の資料で、実際の避難指示ではありません。",
   "start_sec": 163.5,
   "end_sec": 168.15
  },
  {
   "sentence_id": "C50-B008-S01",
   "section": "B",
   "text": "片付けでは借りた道具の数を確認します。",
   "start_sec": 168.6,
   "end_sec": 172.493
  },
  {
   "sentence_id": "C50-B008-S02",
   "section": "B",
   "text": "何でも箱に入れるだけでは、返却の条件を満たせません。",
   "start_sec": 172.693,
   "end_sec": 177.339
  },
  {
   "sentence_id": "C50-B008-S03",
   "section": "B",
   "text": "糸の切れ端を除き、のりは直射日光を避けて保管します。",
   "start_sec": 177.539,
   "end_sec": 182.836
  },
  {
   "sentence_id": "C50-B008-S04",
   "section": "B",
   "text": "数が合わなければ、担当者にでも相談してください。",
   "start_sec": 183.036,
   "end_sec": 187.16
  }
 ]
}
