{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 171.048,
 "source_chapter": 52,
 "sentence_intervals": [
  {
   "sentence_id": "C52-B001-1",
   "section": "B",
   "text": "この報告は授業用の架空の調査資料をまとめたものです。",
   "start_sec": 0.0,
   "end_sec": 4.907
  },
  {
   "sentence_id": "C52-B001-2",
   "section": "B",
   "text": "対象は自分の意思で参加した同じ二十人で、回答に名前はありません。",
   "start_sec": 5.107,
   "end_sec": 11.588
  },
  {
   "sentence_id": "C52-B001-3",
   "section": "B",
   "text": "基準週は通常の時間、試行週は使える時間を長くした一週間です。",
   "start_sec": 11.788,
   "end_sec": 18.218
  },
  {
   "sentence_id": "C52-B001-4",
   "section": "B",
   "text": "利用頻度の項目を三つの組に分け、集計しました。",
   "start_sec": 18.418,
   "end_sec": 22.961
  },
  {
   "sentence_id": "C52-B001-5",
   "section": "B",
   "text": "実際の二十人と延べ人数は異なり、同じ人を利用のたびに数える方法は使っていません。",
   "start_sec": 23.161,
   "end_sec": 31.127
  },
  {
   "sentence_id": "C52-B002-1",
   "section": "B",
   "text": "基準週は、三日以上が八人、一日か二日が七人、零日が五人でした。",
   "start_sec": 31.577,
   "end_sec": 38.894
  },
  {
   "sentence_id": "C52-B002-2",
   "section": "B",
   "text": "試行週は、三日以上が十二人、一日か二日が六人、零日が二人でした。",
   "start_sec": 39.094,
   "end_sec": 46.423
  },
  {
   "sentence_id": "C52-B002-3",
   "section": "B",
   "text": "どちらも合計は二十人です。",
   "start_sec": 46.623,
   "end_sec": 49.187
  },
  {
   "sentence_id": "C52-B002-4",
   "section": "B",
   "text": "三日以上使った人は、基準週に比べて四人増えています。",
   "start_sec": 49.387,
   "end_sec": 54.25
  },
  {
   "sentence_id": "C52-B002-5",
   "section": "B",
   "text": "その割合は四十パーセントから六十パーセントになりました。",
   "start_sec": 54.45,
   "end_sec": 59.217
  },
  {
   "sentence_id": "C52-B002-6",
   "section": "B",
   "text": "試行週では、半分より多くなっています。",
   "start_sec": 59.417,
   "end_sec": 62.93
  },
  {
   "sentence_id": "C52-B003-1",
   "section": "B",
   "text": "二つの割合の差は二十ポイントです。",
   "start_sec": 63.38,
   "end_sec": 66.71
  },
  {
   "sentence_id": "C52-B003-2",
   "section": "B",
   "text": "基準週の割合を基準にすると、五十パーセントの増加です。",
   "start_sec": 66.91,
   "end_sec": 71.779
  },
  {
   "sentence_id": "C52-B003-3",
   "section": "B",
   "text": "試行週の割合は、基準週の一・五倍になりました。",
   "start_sec": 71.979,
   "end_sec": 76.705
  },
  {
   "sentence_id": "C52-B003-4",
   "section": "B",
   "text": "「二十パーセント増えた」という報告では、この変化を正確に伝えられません。",
   "start_sec": 76.905,
   "end_sec": 82.839
  },
  {
   "sentence_id": "C52-B003-5",
   "section": "B",
   "text": "一日か二日使った人は、一人減りました。",
   "start_sec": 83.039,
   "end_sec": 86.736
  },
  {
   "sentence_id": "C52-B003-6",
   "section": "B",
   "text": "零日の人も三人減少しています。",
   "start_sec": 86.936,
   "end_sec": 90.417
  },
  {
   "sentence_id": "C52-B003-7",
   "section": "B",
   "text": "二日以下の組の合計は、基準週が十二人、試行週が八人です。",
   "start_sec": 90.617,
   "end_sec": 96.923
  },
  {
   "sentence_id": "C52-B004-1",
   "section": "B",
   "text": "基準週に使った十五人の一回に使った時間の平均は、六十分です。",
   "start_sec": 97.373,
   "end_sec": 104.662
  },
  {
   "sentence_id": "C52-B004-2",
   "section": "B",
   "text": "最小は二十分、最大は百二十分でした。",
   "start_sec": 104.862,
   "end_sec": 108.81
  },
  {
   "sentence_id": "C52-B004-3",
   "section": "B",
   "text": "平均が六十分でも、多くの人が約六十分使ったかどうかは、この資料では分かりません。",
   "start_sec": 109.01,
   "end_sec": 116.747
  },
  {
   "sentence_id": "C52-B004-4",
   "section": "B",
   "text": "試行週の使った時間の平均の数値がないので、二つの週の時間を比べることはできません。",
   "start_sec": 116.947,
   "end_sec": 123.951
  },
  {
   "sentence_id": "C52-B005-1",
   "section": "B",
   "text": "今回の結果は、この二十人の中で、使う頻度の高い組が増えたことを示しています。",
   "start_sec": 124.401,
   "end_sec": 131.014
  },
  {
   "sentence_id": "C52-B005-2",
   "section": "B",
   "text": "しかし、標本は小さく、比べるための別の組もありません。",
   "start_sec": 131.214,
   "end_sec": 136.386
  },
  {
   "sentence_id": "C52-B005-3",
   "section": "B",
   "text": "二回の記録だけでは、長期の推移や通常の変動は分かりません。",
   "start_sec": 136.586,
   "end_sec": 142.322
  },
  {
   "sentence_id": "C52-B005-4",
   "section": "B",
   "text": "使える時間を長くしたことが変化の原因だとは言えませんし、使う人全体の傾向とも言えません。",
   "start_sec": 142.522,
   "end_sec": 150.315
  },
  {
   "sentence_id": "C52-B005-5",
   "section": "B",
   "text": "少数の回答も有効回答で、人数が少ないという理由で消してはいけません。",
   "start_sec": 150.515,
   "end_sec": 156.884
  },
  {
   "sentence_id": "C52-B005-6",
   "section": "B",
   "text": "長期の変更を決める前に、参加しなかった人にも意見を聞き、管理する人の人数と作業時間を計算する必要があります。",
   "start_sec": 157.084,
   "end_sec": 167.069
  },
  {
   "sentence_id": "C52-B005-7",
   "section": "B",
   "text": "少数の回答も全体の一部です。",
   "start_sec": 167.268,
   "end_sec": 171.042
  }
 ]
}
