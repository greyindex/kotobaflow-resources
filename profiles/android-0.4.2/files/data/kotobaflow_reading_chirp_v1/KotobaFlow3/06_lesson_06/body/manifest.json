 "sentence_intervals": [
  {
   "sentence_id": "C42-A001-S01",
   "section": "A",
   "text": "十一月一日、西田さんはセンターのカメラを点検した。",
   "start_sec": 0.0,
   "end_sec": 5.09
  },
  {
   "sentence_id": "C42-A001-S02",
   "section": "A",
   "text": "前の日に原さんが返したカメラだ。",
   "start_sec": 5.29,
   "end_sec": 8.553
  },
  {
   "sentence_id": "C42-A001-S03",
   "section": "A",
   "text": "電池のふたが開いている。",
   "start_sec": 8.753,
   "end_sec": 10.711
  },
  {
   "sentence_id": "C42-A001-S04",
   "section": "A",
   "text": "手で押せば閉まるが、軽く振るとまた開く。",
   "start_sec": 10.911,
   "end_sec": 14.692
  },
  {
   "sentence_id": "C42-A001-S05",
   "section": "A",
   "text": "ふたが壊れているようだ。",
   "start_sec": 14.892,
   "end_sec": 16.565
  },
  {
   "sentence_id": "C42-A002-S01",
   "section": "A",
   "text": "記録には「ふたが閉まる」と書いてある。",
   "start_sec": 17.015,
   "end_sec": 20.26
  },
  {
   "sentence_id": "C42-A002-S02",
   "section": "A",
   "text": "原さんによると、小川さんがカメラを落としてしまったそうだ。",
   "start_sec": 20.46,
   "end_sec": 24.99
  },
  {
   "sentence_id": "C42-A002-S03",
   "section": "A",
   "text": "でも、落としたことが原因だという証拠はない。",
   "start_sec": 25.19,
   "end_sec": 29.03
  },
  {
   "sentence_id": "C42-A002-S04",
   "section": "A",
   "text": "西田さんは写真と伝言を比べ、事実と推測を分けて報告を書くことにした。",
   "start_sec": 29.23,
   "end_sec": 35.583
  }
 ]
}
