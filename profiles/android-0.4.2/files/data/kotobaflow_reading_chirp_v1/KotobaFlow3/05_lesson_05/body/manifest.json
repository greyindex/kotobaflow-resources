 "duration_sec": 42.212,
 "source_chapter": 41,
 "sentence_intervals": [
  {
   "sentence_id": "C41-A001-S01",
   "section": "A",
   "text": "十月二十日、市民センターへ向かう道で、太陽が沈むのを見た。",
   "start_sec": 0.0,
   "end_sec": 5.444
  },
  {
   "sentence_id": "C41-A001-S02",
   "section": "A",
   "text": "雲が所々空を覆い、日光が雲の端できらりと光った。",
   "start_sec": 5.644,
   "end_sec": 11.943
  },
  {
   "sentence_id": "C41-A001-S03",
   "section": "A",
   "text": "たそがれの川は穏やかで、きらきら光る水面に橋の影が落ちていた。",
   "start_sec": 12.143,
   "end_sec": 18.363
  },
  {
   "sentence_id": "C41-A001-S04",
   "section": "A",
   "text": "岸の赤い葉はいかにも秋らしい。",
   "start_sec": 18.563,
   "end_sec": 21.366
  },
  {
   "sentence_id": "C41-A001-S05",
   "section": "A",
   "text": "岸では鳥が鳴き、浅い水の上を真っ白な羽が漂っていた。",
   "start_sec": 21.566,
   "end_sec": 27.454
  },
  {
   "sentence_id": "C41-A001-S06",
   "section": "A",
   "text": "昼の写真では眩しいほど明るい場所も、日が暮れると妙に寂しく見える。",
   "start_sec": 27.654,
   "end_sec": 34.607
  },
  {
   "sentence_id": "C41-A001-S07",
   "section": "A",
   "text": "写真と同じような景色だが、雰囲気が違う。",
   "start_sec": 34.807,
   "end_sec": 38.712
  },
  {
   "sentence_id": "C41-A001-S08",
   "section": "A",
   "text": "印象だけで判断しないようにしようと思った。",
   "start_sec": 38.912,
   "end_sec": 42.206
  }
 ]
}
