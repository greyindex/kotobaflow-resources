{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 113.432,
 "source_chapter": 64,
 "sentence_intervals": [
  {
   "sentence_id": "C64-A001-S01",
   "section": "A",
   "text": "日刊の地方紙「緑町新聞」は12月10日、図書館の電子書籍について報道した。",
   "start_sec": 0.0,
   "end_sec": 7.557
  },
  {
   "sentence_id": "C64-A001-S02",
   "section": "A",
   "text": "11月1日に始まった貸出は、最初の1か月で3,100冊になった。",
   "start_sec": 7.757,
   "end_sec": 13.623
  },
  {
   "sentence_id": "C64-A001-S03",
   "section": "A",
   "text": "図書館が12月9日に発表した統計によると、利用したのは1,240人、登録者は約18,000人である。",
   "start_sec": 13.823,
   "end_sec": 25.85
  },
  {
   "sentence_id": "C64-A001-S04",
   "section": "A",
   "text": "利用者の約60%は30代から50代だった。",
   "start_sec": 26.05,
   "end_sec": 30.921
  },
  {
   "sentence_id": "C64-A001-S05",
   "section": "A",
   "text": "貸出は紙の本と同じように無料である。",
   "start_sec": 31.121,
   "end_sec": 34.95
  },
  {
   "sentence_id": "C64-A002-S01",
   "section": "A",
   "text": "図書館に登録している人なら、住所がほかの町でも利用できる。",
   "start_sec": 35.4,
   "end_sec": 40.279
  },
  {
   "sentence_id": "C64-A002-S02",
   "section": "A",
   "text": "一人が同時に借りられるのは2冊までで、期限は2週間である。",
   "start_sec": 40.479,
   "end_sec": 45.734
  },
  {
   "sentence_id": "C64-A002-S03",
   "section": "A",
   "text": "期限が来ると、本は自動的に返却される。",
   "start_sec": 45.934,
   "end_sec": 49.407
  },
  {
   "sentence_id": "C64-A002-S04",
   "section": "A",
   "text": "電子書籍は約2,000種類ある。",
   "start_sec": 49.607,
   "end_sec": 53.406
  },
  {
   "sentence_id": "C64-A002-S05",
   "section": "A",
   "text": "他の町の図書館カードで利用できるかどうかは、まだ決まっていない。",
   "start_sec": 53.606,
   "end_sec": 58.52
  },
  {
   "sentence_id": "C64-A003-S01",
   "section": "A",
   "text": "70代の女性は「家から出なくても借りられるので助かる」と話す。",
   "start_sec": 58.97,
   "end_sec": 64.043
  },
  {
   "sentence_id": "C64-A003-S02",
   "section": "A",
   "text": "しかし、41歳の会社員の男性は「読みたい本は予約しても、なかなか借りられない」と話した。",
   "start_sec": 64.243,
   "end_sec": 72.026
  },
  {
   "sentence_id": "C64-A003-S03",
   "section": "A",
   "text": "図書館によると、人気の本には40人以上が予約しているものもあり、長い場合は2か月ほど待つ。",
   "start_sec": 72.226,
   "end_sec": 80.313
  },
  {
   "sentence_id": "C64-A003-S04",
   "section": "A",
   "text": "人気の本を追加するかどうかは、今後検討するそうだ。",
   "start_sec": 80.513,
   "end_sec": 85.187
  },
  {
   "sentence_id": "C64-A004-S01",
   "section": "A",
   "text": "紙の本の11月の貸出は前年同月より2%減ったが、電子書籍の影響かどうかは不明だ。",
   "start_sec": 85.637,
   "end_sec": 94.21
  },
  {
   "sentence_id": "C64-A004-S02",
   "section": "A",
   "text": "責任者の木村さんは、来館が難しい人にとっても必要なサービスだと説明した。",
   "start_sec": 94.41,
   "end_sec": 101.404
  },
  {
   "sentence_id": "C64-A004-S03",
   "section": "A",
   "text": "来年4月からの1年間で500種類増やす予定だ。",
   "start_sec": 101.604,
   "end_sec": 106.212
  },
  {
   "sentence_id": "C64-A004-S04",
   "section": "A",
   "text": "全国紙や出版業界の専門紙からも問い合わせがあり、この地方の取り組みは注目されている。",
   "start_sec": 106.412,
   "end_sec": 113.425
  }
 ]
}
