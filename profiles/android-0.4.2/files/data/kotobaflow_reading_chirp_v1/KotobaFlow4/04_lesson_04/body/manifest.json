{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 102.802,
 "source_chapter": 60,
 "sentence_intervals": [
  {
   "sentence_id": "C60-A001-S01",
   "section": "A",
   "text": "11月27日の会の後、表計算を学びたい人が4人から8人に増えた。",
   "start_sec": 0.0,
   "end_sec": 7.073
  },
  {
   "sentence_id": "C60-A001-S02",
   "section": "A",
   "text": "会社の予算は3月末まで16,000円で、使用を講座と教材に限る。",
   "start_sec": 7.273,
   "end_sec": 14.287
  },
  {
   "sentence_id": "C60-A001-S03",
   "section": "A",
   "text": "限られた資源をどう配分するか。",
   "start_sec": 14.487,
   "end_sec": 17.24
  },
  {
   "sentence_id": "C60-A003-S01",
   "section": "A",
   "text": "公民館の講座は住民に限らず町で働く人にも提供される。",
   "start_sec": 17.69,
   "end_sec": 23.383
  },
  {
   "sentence_id": "C60-A003-S02",
   "section": "A",
   "text": "8人全員に資格があるが、二人は土曜午前に来られない。",
   "start_sec": 23.583,
   "end_sec": 28.495
  },
  {
   "sentence_id": "C60-A003-S03",
   "section": "A",
   "text": "仕事への対応も必要だ。",
   "start_sec": 28.695,
   "end_sec": 30.965
  },
  {
   "sentence_id": "C60-A004-S01",
   "section": "A",
   "text": "オンラインなら時間を選べるが、無料の特典には条件がある。",
   "start_sec": 31.415,
   "end_sec": 36.502
  },
  {
   "sentence_id": "C60-A004-S02",
   "section": "A",
   "text": "図書館の本で不足を補う方法もある。",
   "start_sec": 36.702,
   "end_sec": 40.296
  },
  {
   "sentence_id": "C60-A005-S01",
   "section": "A",
   "text": "一部の人を除かず、全員が続けられることを優先する。",
   "start_sec": 40.746,
   "end_sec": 45.782
  },
  {
   "sentence_id": "C60-A005-S02",
   "section": "A",
   "text": "費用の節約はもちろん、時間の余裕も考えて選択したい。",
   "start_sec": 45.982,
   "end_sec": 50.715
  },
  {
   "sentence_id": "C60-A006-S01",
   "section": "A",
   "text": "練習には町の織物産業の記事を使う。",
   "start_sec": 51.165,
   "end_sec": 55.215
  },
  {
   "sentence_id": "C60-A006-S02",
   "section": "A",
   "text": "中小企業は資金力も労働力も十分ではない。",
   "start_sec": 55.415,
   "end_sec": 60.557
  },
  {
   "sentence_id": "C60-A006-S03",
   "section": "A",
   "text": "機の現代化には大金が要るが、使わない設備は宝の持ち腐れになる。",
   "start_sec": 60.757,
   "end_sec": 66.709
  },
  {
   "sentence_id": "C60-A007-S01",
   "section": "A",
   "text": "記事では、人的な支援を受けられるインキュベーション施設を紹介している。",
   "start_sec": 67.159,
   "end_sec": 72.853
  },
  {
   "sentence_id": "C60-A007-S02",
   "section": "A",
   "text": "商業用地を借りて工場を建てる前に、共同の設備で国産の布を作り、国内外の需要を調べる。",
   "start_sec": 73.053,
   "end_sec": 81.607
  },
  {
   "sentence_id": "C60-A007-S03",
   "section": "A",
   "text": "余剰の布は農家の作業着に使う。",
   "start_sec": 81.807,
   "end_sec": 85.4
  },
  {
   "sentence_id": "C60-A007-S04",
   "section": "A",
   "text": "電力の消費を抑える省エネルギーは、コストの削減にもなる。",
   "start_sec": 85.6,
   "end_sec": 90.371
  },
  {
   "sentence_id": "C60-A007-S05",
   "section": "A",
   "text": "貿易会社と協力して輸出を試みる企業もあるが、価格の安さだけで競争力が決まるわけではない。",
   "start_sec": 90.571,
   "end_sec": 98.964
  },
  {
   "sentence_id": "C60-A007-S06",
   "section": "A",
   "text": "地域の経済を数字から考える練習だ。",
   "start_sec": 99.164,
   "end_sec": 102.795
  }
 ]
}
