{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 65.222,
 "source_chapter": 73,
 "sentence_intervals": [
  {
   "sentence_id": "C73-A101-S01",
   "section": "A",
   "text": "青波市の文化展をめぐる二つの意見を読む。",
   "start_sec": 0.0,
   "end_sec": 3.797
  },
  {
   "sentence_id": "C73-A101-S02",
   "section": "A",
   "text": "そもそも、目的は国の優劣を決めることではなく、異なる暮らしへの理解を深めることだ。",
   "start_sec": 3.997,
   "end_sec": 11.462
  },
  {
   "sentence_id": "C73-A101-S03",
   "section": "A",
   "text": "ところが、展示を増やせば理解も深まるという結論には、慎重な意見が出た。",
   "start_sec": 11.662,
   "end_sec": 18.347
  },
  {
   "sentence_id": "C73-A101-S04",
   "section": "A",
   "text": "以下で両者の立場を確かめよう。",
   "start_sec": 18.547,
   "end_sec": 21.703
  },
  {
   "sentence_id": "C73-A102-S01",
   "section": "A",
   "text": "要約する時は、各段落の要点を整理し、主張と論拠を区別する。",
   "start_sec": 22.153,
   "end_sec": 28.253
  },
  {
   "sentence_id": "C73-A102-S02",
   "section": "A",
   "text": "「この負担」が何を指すかも確認する。",
   "start_sec": 28.453,
   "end_sec": 31.087
  },
  {
   "sentence_id": "C73-A102-S03",
   "section": "A",
   "text": "共通点は交流の目的への賛成で、相違点は重視する条件だ。",
   "start_sec": 31.287,
   "end_sec": 37.644
  },
  {
   "sentence_id": "C73-A102-S04",
   "section": "A",
   "text": "従って、賛成と反対の対立として論じるのは適切ではない。",
   "start_sec": 37.844,
   "end_sec": 43.043
  },
  {
   "sentence_id": "C73-A103-S01",
   "section": "A",
   "text": "接続の表現を選ぶ時にも、何と何を対比するかを考える。",
   "start_sec": 43.493,
   "end_sec": 49.216
  },
  {
   "sentence_id": "C73-A103-S02",
   "section": "A",
   "text": "一部を省略しても判断の範囲は残す。",
   "start_sec": 49.416,
   "end_sec": 53.309
  },
  {
   "sentence_id": "C73-A103-S03",
   "section": "A",
   "text": "「掛け橋」という比喩には人を結ぶ含意があるが、「交流の機会」と言い換えることもできる。",
   "start_sec": 53.509,
   "end_sec": 60.342
  },
  {
   "sentence_id": "C73-A103-S04",
   "section": "A",
   "text": "資料の共有だけで理解が持続するというものではない。",
   "start_sec": 60.542,
   "end_sec": 65.216
  }
 ]
}
