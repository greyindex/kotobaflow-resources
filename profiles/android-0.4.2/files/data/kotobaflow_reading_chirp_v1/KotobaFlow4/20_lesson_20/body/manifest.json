{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 102.719,
 "source_chapter": 76,
 "sentence_intervals": [
  {
   "sentence_id": "C76-A001-01",
   "section": "A",
   "text": "地域の人が一緒に勉強する会場を、六か月間使う計画がある。",
   "start_sec": 0.0,
   "end_sec": 6.236
  },
  {
   "sentence_id": "C76-A001-02",
   "section": "A",
   "text": "会場の選択には三つの条件がある。",
   "start_sec": 6.436,
   "end_sec": 10.092
  },
  {
   "sentence_id": "C76-A001-03",
   "section": "A",
   "text": "毎週少なくとも二回開くこと、設備を含む月の総費用が予算の六万円以下であること、段差のない経路で行けることだ。",
   "start_sec": 10.292,
   "end_sec": 19.646
  },
  {
   "sentence_id": "C76-A001-04",
   "section": "A",
   "text": "資料AとBは、この課のために作ったもので、実際の調査報告ではない。",
   "start_sec": 19.846,
   "end_sec": 26.667
  },
  {
   "sentence_id": "C76-A002-01",
   "section": "A",
   "text": "A案は駅に近い同じ部屋を毎週三回使う。",
   "start_sec": 27.117,
   "end_sec": 32.044
  },
  {
   "sentence_id": "C76-A002-02",
   "section": "A",
   "text": "部屋代は月六万円で、設備の追加料金は不明だ。",
   "start_sec": 32.244,
   "end_sec": 37.162
  },
  {
   "sentence_id": "C76-A002-03",
   "section": "A",
   "text": "段差のない経路も未確認である。",
   "start_sec": 37.362,
   "end_sec": 39.816
  },
  {
   "sentence_id": "C76-A002-04",
   "section": "A",
   "text": "駅に近くても、誰もが行きやすいとは限らない。",
   "start_sec": 40.016,
   "end_sec": 43.789
  },
  {
   "sentence_id": "C76-A002-05",
   "section": "A",
   "text": "部屋代だけに基づいて予算内だとは判断できない。",
   "start_sec": 43.989,
   "end_sec": 48.734
  },
  {
   "sentence_id": "C76-A003-01",
   "section": "A",
   "text": "B案は公共施設の空いている部屋を毎週二回使う。",
   "start_sec": 49.184,
   "end_sec": 54.283
  },
  {
   "sentence_id": "C76-A003-02",
   "section": "A",
   "text": "月の会場費三万円と提示された設備費五千円の合計は三万五千円だ。",
   "start_sec": 54.483,
   "end_sec": 61.594
  },
  {
   "sentence_id": "C76-A003-03",
   "section": "A",
   "text": "この二つの費用の合計は予算内だが、会場は毎月変わる可能性があり、候補ごとに経路の確認が必要だ。",
   "start_sec": 61.794,
   "end_sec": 70.907
  },
  {
   "sentence_id": "C76-A004-01",
   "section": "A",
   "text": "共通点は、予定の回数が週二回以上であることだ。",
   "start_sec": 71.357,
   "end_sec": 76.604
  },
  {
   "sentence_id": "C76-A004-02",
   "section": "A",
   "text": "相違点は、会場の変更、費用の情報、回数にある。",
   "start_sec": 76.804,
   "end_sec": 82.547
  },
  {
   "sentence_id": "C76-A004-03",
   "section": "A",
   "text": "経路はどちらも未確認だ。",
   "start_sec": 82.747,
   "end_sec": 85.003
  },
  {
   "sentence_id": "C76-A004-04",
   "section": "A",
   "text": "三か月目の末に出席状況と利用者の負担を調べ、その後の三か月の調整を検討する。",
   "start_sec": 85.203,
   "end_sec": 92.966
  },
  {
   "sentence_id": "C76-A004-05",
   "section": "A",
   "text": "六か月の計画を三か月で終えるのではない。",
   "start_sec": 93.166,
   "end_sec": 97.36
  },
  {
   "sentence_id": "C76-A004-06",
   "section": "A",
   "text": "費用の比較と利用できるかどうかの判断は、分けて記録する。",
   "start_sec": 97.56,
   "end_sec": 102.713
  }
 ]
}
