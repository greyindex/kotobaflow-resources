{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 190.014,
 "source_chapter": 63,
 "sentence_intervals": [
  {
   "sentence_id": "C63-B001-S01",
   "section": "B",
   "text": "三人に休息について書いてもらいました。",
   "start_sec": 0.0,
   "end_sec": 3.473
  },
  {
   "sentence_id": "C63-B001-S02",
   "section": "B",
   "text": "以下は本人が公開に同意した文章です。",
   "start_sec": 3.673,
   "end_sec": 7.488
  },
  {
   "sentence_id": "C63-B001-S03",
   "section": "B",
   "text": "記録と感想を区別して読み、他人の方法をそのまま健康の基準にはしないでください。",
   "start_sec": 7.688,
   "end_sec": 14.642
  },
  {
   "sentence_id": "C63-B002-S01",
   "section": "B",
   "text": "大野です。",
   "start_sec": 15.092,
   "end_sec": 16.285
  },
  {
   "sentence_id": "C63-B002-S02",
   "section": "B",
   "text": "注文の確認は神経を使い、同じ質問が続くと苛立つことがあります。",
   "start_sec": 16.485,
   "end_sec": 22.813
  },
  {
   "sentence_id": "C63-B002-S03",
   "section": "B",
   "text": "忘れっぽくなった自分にも不満でした。",
   "start_sec": 23.013,
   "end_sec": 25.855
  },
  {
   "sentence_id": "C63-B002-S04",
   "section": "B",
   "text": "休みの日は刺激の少ない部屋で小説を読みます。",
   "start_sec": 26.055,
   "end_sec": 30.401
  },
  {
   "sentence_id": "C63-B002-S05",
   "section": "B",
   "text": "今読んでいるのは、安月給で暮らす若者の話です。",
   "start_sec": 30.601,
   "end_sec": 35.45
  },
  {
   "sentence_id": "C63-B002-S06",
   "section": "B",
   "text": "主人公には優雅な暮らしが高嶺の花に見えますが、衣食住に困る友人をまめまめしく助けます。",
   "start_sec": 35.65,
   "end_sec": 44.403
  },
  {
   "sentence_id": "C63-B002-S07",
   "section": "B",
   "text": "初恋の相手に一目惚れしてから、ずっと一途に思いを寄せています。",
   "start_sec": 44.603,
   "end_sec": 49.876
  },
  {
   "sentence_id": "C63-B002-S08",
   "section": "B",
   "text": "奔放な友人は「プレーボーイ」と呼ばれていますが、主人公は人のうわさだけで判断しません。",
   "start_sec": 50.076,
   "end_sec": 57.71
  },
  {
   "sentence_id": "C63-B002-S09",
   "section": "B",
   "text": "恋する喜びやら失う不安やらが描かれ、二人が初めてキスをする場面では私もどきどきしました。",
   "start_sec": 57.91,
   "end_sec": 66.104
  },
  {
   "sentence_id": "C63-B002-S10",
   "section": "B",
   "text": "若いころを思い出して胸がときめきます。",
   "start_sec": 66.304,
   "end_sec": 69.952
  },
  {
   "sentence_id": "C63-B002-S11",
   "section": "B",
   "text": "経済的には苦しい主人公が、人とのつながりから幸福を感じる結末です。",
   "start_sec": 70.152,
   "end_sec": 76.826
  },
  {
   "sentence_id": "C63-B002-S12",
   "section": "B",
   "text": "お金だけが豊かさではない、と満足して本を閉じました。",
   "start_sec": 77.026,
   "end_sec": 81.631
  },
  {
   "sentence_id": "C63-B003-S01",
   "section": "B",
   "text": "石田です。",
   "start_sec": 82.081,
   "end_sec": 83.058
  },
  {
   "sentence_id": "C63-B003-S02",
   "section": "B",
   "text": "昼食後に20分歩く習慣はありますが、先週は三日だけでした。",
   "start_sec": 83.258,
   "end_sec": 89.312
  },
  {
   "sentence_id": "C63-B003-S03",
   "section": "B",
   "text": "体がだるい日は休みます。",
   "start_sec": 89.512,
   "end_sec": 91.665
  },
  {
   "sentence_id": "C63-B003-S04",
   "section": "B",
   "text": "食欲がない時、脂っこい油物より、あっさりしたスープを選ぶと食べやすく感じます。",
   "start_sec": 91.865,
   "end_sec": 98.698
  },
  {
   "sentence_id": "C63-B003-S05",
   "section": "B",
   "text": "野菜の持ち味や旨味をゆっくり味わう時間も好きです。",
   "start_sec": 98.898,
   "end_sec": 103.558
  },
  {
   "sentence_id": "C63-B003-S06",
   "section": "B",
   "text": "栄養士の記事には、脂肪や糖分の量は料理によって違い、高脂質と高カロリーは同じ意味ではないとありました。",
   "start_sec": 103.758,
   "end_sec": 113.832
  },
  {
   "sentence_id": "C63-B003-S07",
   "section": "B",
   "text": "肉に偏る食事を見直そうと思います。",
   "start_sec": 114.032,
   "end_sec": 117.085
  },
  {
   "sentence_id": "C63-B003-S08",
   "section": "B",
   "text": "ただ、体形だけで栄養状態を判断したり、肥満や糖尿病の治療法を決めたりはできません。",
   "start_sec": 117.285,
   "end_sec": 125.606
  },
  {
   "sentence_id": "C63-B003-S09",
   "section": "B",
   "text": "体調の深刻な変化は専門家に相談します。",
   "start_sec": 125.806,
   "end_sec": 129.699
  },
  {
   "sentence_id": "C63-B003-S10",
   "section": "B",
   "text": "長生きしたいからこそ、「これだけで長寿になれる」という広告は確かめたいのです。",
   "start_sec": 129.899,
   "end_sec": 135.352
  },
  {
   "sentence_id": "C63-B004-S01",
   "section": "B",
   "text": "ハッサンです。",
   "start_sec": 135.802,
   "end_sec": 136.901
  },
  {
   "sentence_id": "C63-B004-S02",
   "section": "B",
   "text": "家族への電話が遅くなりがちで、生活のリズムも乱れがちです。",
   "start_sec": 137.101,
   "end_sec": 142.134
  },
  {
   "sentence_id": "C63-B004-S03",
   "section": "B",
   "text": "孤独な夜もありますが、病と決めつけてほしくありません。",
   "start_sec": 142.334,
   "end_sec": 146.576
  },
  {
   "sentence_id": "C63-B004-S04",
   "section": "B",
   "text": "母の愛情が伝わる声を聞くと落ち着きます。",
   "start_sec": 146.776,
   "end_sec": 150.446
  },
  {
   "sentence_id": "C63-B004-S05",
   "section": "B",
   "text": "祖父は今も達者で、老後の読書会を楽しんでいます。",
   "start_sec": 150.646,
   "end_sec": 155.112
  },
  {
   "sentence_id": "C63-B004-S06",
   "section": "B",
   "text": "私は日曜にフットサルをして気分転換をします。",
   "start_sec": 155.312,
   "end_sec": 159.369
  },
  {
   "sentence_id": "C63-B004-S07",
   "section": "B",
   "text": "先日は帰宅後、部屋をごてごて飾るのをやめ、こざっぱり片付けました。",
   "start_sec": 159.569,
   "end_sec": 165.862
  },
  {
   "sentence_id": "C63-B004-S08",
   "section": "B",
   "text": "快適な寛ぎの場所ができ、精神的にも気楽になりました。",
   "start_sec": 166.062,
   "end_sec": 170.855
  },
  {
   "sentence_id": "C63-B004-S09",
   "section": "B",
   "text": "友人に恵まれていますが、一人の余暇も大切です。",
   "start_sec": 171.055,
   "end_sec": 175.188
  },
  {
   "sentence_id": "C63-B004-S10",
   "section": "B",
   "text": "失敗をくよくよと思い返す日は、祖父の「短気は損気」という言葉を思い出します。",
   "start_sec": 175.388,
   "end_sec": 183.262
  },
  {
   "sentence_id": "C63-B004-S11",
   "section": "B",
   "text": "今の暮らしに喜ばしい変化があると気づき、生き生きと過ごしたい気持ちが湧き上がります。",
   "start_sec": 183.462,
   "end_sec": 190.008
  }
 ]
}
