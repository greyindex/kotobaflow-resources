{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 67.883,
 "source_chapter": 18,
 "sentence_intervals": [
  {
   "sentence_id": "C18-A001-S01",
   "section": "A",
   "text": "今日は十一月六日、金曜日です。",
   "start_sec": 0.0,
   "end_sec": 3.293
  },
  {
   "sentence_id": "C18-A001-S02",
   "section": "A",
   "text": "明日の午後、港図書館で友達の集まりがあります。",
   "start_sec": 3.493,
   "end_sec": 8.047
  },
  {
   "sentence_id": "C18-A001-S03",
   "section": "A",
   "text": "午後二時から三時までです。",
   "start_sec": 8.247,
   "end_sec": 10.343
  },
  {
   "sentence_id": "C18-A001-S04",
   "section": "A",
   "text": "マテオとリンは日本語の会話を練習しに行きます。",
   "start_sec": 10.543,
   "end_sec": 14.807
  },
  {
   "sentence_id": "C18-A001-S05",
   "section": "A",
   "text": "二人は毎週、一緒に練習しています。",
   "start_sec": 15.007,
   "end_sec": 18.503
  },
  {
   "sentence_id": "C18-A001-S06",
   "section": "A",
   "text": "図書館は港駅の近くにあります。",
   "start_sec": 18.703,
   "end_sec": 21.637
  },
  {
   "sentence_id": "C18-A001-S07",
   "section": "A",
   "text": "図書館の入口の右に受付があります。",
   "start_sec": 21.837,
   "end_sec": 25.953
  },
  {
   "sentence_id": "C18-A001-S08",
   "section": "A",
   "text": "教室は受付の隣です。",
   "start_sec": 26.153,
   "end_sec": 28.521
  },
  {
   "sentence_id": "C18-A002-S01",
   "section": "A",
   "text": "マテオは明日の午前中、家にいます。",
   "start_sec": 28.971,
   "end_sec": 32.457
  },
  {
   "sentence_id": "C18-A002-S02",
   "section": "A",
   "text": "リンも午後は時間があります。",
   "start_sec": 32.657,
   "end_sec": 35.23
  },
  {
   "sentence_id": "C18-A002-S03",
   "section": "A",
   "text": "パクは午後、仕事があります。",
   "start_sec": 35.43,
   "end_sec": 38.095
  },
  {
   "sentence_id": "C18-A002-S04",
   "section": "A",
   "text": "マテオは今日、二人に連絡します。",
   "start_sec": 38.295,
   "end_sec": 41.086
  },
  {
   "sentence_id": "C18-A002-S05",
   "section": "A",
   "text": "中村さんは図書館で働いています。",
   "start_sec": 41.286,
   "end_sec": 44.459
  },
  {
   "sentence_id": "C18-A002-S06",
   "section": "A",
   "text": "集まりの前に、中村さんに電話します。",
   "start_sec": 44.659,
   "end_sec": 47.995
  },
  {
   "sentence_id": "C18-A002-S07",
   "section": "A",
   "text": "明日の予定はメッセージにも書きます。",
   "start_sec": 48.195,
   "end_sec": 51.288
  },
  {
   "sentence_id": "C18-A003-S01",
   "section": "A",
   "text": "駅の出口で会って、一緒に図書館へ行きます。",
   "start_sec": 51.738,
   "end_sec": 55.511
  },
  {
   "sentence_id": "C18-A003-S02",
   "section": "A",
   "text": "集まりの後で、公園でパンを食べます。",
   "start_sec": 55.711,
   "end_sec": 59.004
  },
  {
   "sentence_id": "C18-A003-S03",
   "section": "A",
   "text": "パンや水はまだ買っていません。",
   "start_sec": 59.204,
   "end_sec": 61.73
  },
  {
   "sentence_id": "C18-A003-S04",
   "section": "A",
   "text": "買い物のお金は六百円です。",
   "start_sec": 61.93,
   "end_sec": 64.743
  },
  {
   "sentence_id": "C18-A003-S05",
   "section": "A",
   "text": "準備の順番も友達と話します。",
   "start_sec": 64.943,
   "end_sec": 67.877
  }
 ]
}
