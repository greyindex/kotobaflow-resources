 "sentence_intervals": [
  {
   "sentence_id": "C06-B001-S01",
   "section": "B",
   "text": "地図の番号：１みなと駅、２バス停、３公園、４みどりセンター、５スーパー、６病院。",
   "start_sec": 0.0,
   "end_sec": 9.689
  },
  {
   "sentence_id": "C06-B002-S01",
   "section": "B",
   "text": "駅の出口の前にバス停があります。",
   "start_sec": 10.139,
   "end_sec": 13.315
  },
  {
   "sentence_id": "C06-B002-S02",
   "section": "B",
   "text": "バス停の前に公園があります。",
   "start_sec": 13.515,
   "end_sec": 16.088
  },
  {
   "sentence_id": "C06-B002-S03",
   "section": "B",
   "text": "公園の右にみどりセンターがあります。",
   "start_sec": 16.288,
   "end_sec": 18.922
  },
  {
   "sentence_id": "C06-B002-S04",
   "section": "B",
   "text": "駅の左にスーパーがあります。",
   "start_sec": 19.122,
   "end_sec": 21.335
  },
  {
   "sentence_id": "C06-B002-S05",
   "section": "B",
   "text": "病院はスーパーの後ろです。",
   "start_sec": 21.535,
   "end_sec": 23.808
  },
  {
   "sentence_id": "C06-B003-S01",
   "section": "B",
   "text": "入口に机があります。",
   "start_sec": 24.258,
   "end_sec": 26.532
  },
  {
   "sentence_id": "C06-B003-S02",
   "section": "B",
   "text": "机の上に時計や教室の鍵があります。",
   "start_sec": 26.732,
   "end_sec": 30.673
  },
  {
   "sentence_id": "C06-B003-S03",
   "section": "B",
   "text": "教室は図書館の隣です。",
   "start_sec": 30.873,
   "end_sec": 33.71
  },
  {
   "sentence_id": "C06-B004-S01",
   "section": "B",
   "text": "みどりセンター：月曜日から金曜日は午前九時から午後九時まで。",
   "start_sec": 34.16,
   "end_sec": 40.396
  },
  {
   "sentence_id": "C06-B004-S02",
   "section": "B",
   "text": "土曜日と日曜日は午前九時から午後五時まで。",
   "start_sec": 40.596,
   "end_sec": 45.09
  },
  {
   "sentence_id": "C06-B004-S03",
   "section": "B",
   "text": "図書館：毎日午前十時から午後四時まで。",
   "start_sec": 45.29,
   "end_sec": 49.635
  },
  {
   "sentence_id": "C06-B005-S01",
   "section": "B",
   "text": "日本語クラス：火曜日は午後二時から三時半まで。",
   "start_sec": 50.085,
   "end_sec": 54.725
  },
  {
   "sentence_id": "C06-B005-S02",
   "section": "B",
   "text": "木曜日は午後七時から八時半まで。",
   "start_sec": 54.925,
   "end_sec": 58.219
  }
 ]
}
