 "sentence_intervals": [
  {
   "sentence_id": "C06-A001-S01",
   "section": "A",
   "text": "マテオさん、こんばんは。",
   "start_sec": 0.0,
   "end_sec": 1.6
  },
  {
   "sentence_id": "C06-A001-S02",
   "section": "A",
   "text": "リンです。",
   "start_sec": 1.8,
   "end_sec": 2.694
  },
  {
   "sentence_id": "C06-A001-S03",
   "section": "A",
   "text": "今日は十月一日、木曜日です。",
   "start_sec": 2.894,
   "end_sec": 6.187
  },
  {
   "sentence_id": "C06-A001-S04",
   "section": "A",
   "text": "わたしはみなと大学の学生です。",
   "start_sec": 6.387,
   "end_sec": 9.186
  },
  {
   "sentence_id": "C06-A001-S05",
   "section": "A",
   "text": "マテオさんもみなと大学の学生です。",
   "start_sec": 9.386,
   "end_sec": 12.735
  },
  {
   "sentence_id": "C06-A002-S01",
   "section": "A",
   "text": "日本語クラスの先生は森先生とユーリ先生です。",
   "start_sec": 13.185,
   "end_sec": 17.558
  },
  {
   "sentence_id": "C06-A002-S02",
   "section": "A",
   "text": "パクさんは会社員です。",
   "start_sec": 17.758,
   "end_sec": 19.989
  },
  {
   "sentence_id": "C06-A002-S03",
   "section": "A",
   "text": "アナンドさんも会社員です。",
   "start_sec": 20.189,
   "end_sec": 22.39
  },
  {
   "sentence_id": "C06-A002-S04",
   "section": "A",
   "text": "木曜日のクラスは午後七時から八時半までです。",
   "start_sec": 22.59,
   "end_sec": 26.984
  },
  {
   "sentence_id": "C06-A002-S05",
   "section": "A",
   "text": "今週の土曜日のクラスは午前十時から十一時半までです。",
   "start_sec": 27.184,
   "end_sec": 31.977
  },
  {
   "sentence_id": "C06-A002-S06",
   "section": "A",
   "text": "ユーリ先生のクラスです。",
   "start_sec": 32.177,
   "end_sec": 33.91
  },
  {
   "sentence_id": "C06-A003-S01",
   "section": "A",
   "text": "マテオさんの本はみどりセンターの入口の机の上にあります。",
   "start_sec": 34.361,
   "end_sec": 39.474
  },
  {
   "sentence_id": "C06-A003-S02",
   "section": "A",
   "text": "明日は二日です。",
   "start_sec": 39.674,
   "end_sec": 41.148
  },
  {
   "sentence_id": "C06-A003-S03",
   "section": "A",
   "text": "明日の午後三時、わたしはみなと駅の出口にいます。",
   "start_sec": 41.348,
   "end_sec": 45.59
  }
 ]
}
