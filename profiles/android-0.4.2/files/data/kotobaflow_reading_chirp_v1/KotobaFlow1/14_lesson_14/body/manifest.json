 "source_chapter": 14,
 "sentence_intervals": [
  {
   "sentence_id": "C14-A001-S01",
   "section": "A",
   "text": "十一月一日、日曜日の午後二時です。",
   "start_sec": 0.0,
   "end_sec": 3.593
  },
  {
   "sentence_id": "C14-A001-S02",
   "section": "A",
   "text": "マテオさんはセンターで予習をしています。",
   "start_sec": 3.793,
   "end_sec": 6.949
  },
  {
   "sentence_id": "C14-A001-S03",
   "section": "A",
   "text": "教科書の十ページを読んでいます。",
   "start_sec": 7.149,
   "end_sec": 9.542
  },
  {
   "sentence_id": "C14-A001-S04",
   "section": "A",
   "text": "机の上に二枚の紙があります。",
   "start_sec": 9.742,
   "end_sec": 12.722
  },
  {
   "sentence_id": "C14-A001-S05",
   "section": "A",
   "text": "一枚は普段の日常生活、もう一枚は今日の質問です。",
   "start_sec": 12.922,
   "end_sec": 18.373
  },
  {
   "sentence_id": "C14-A001-S06",
   "section": "A",
   "text": "名前はもう書きました。",
   "start_sec": 18.573,
   "end_sec": 20.227
  },
  {
   "sentence_id": "C14-A001-S07",
   "section": "A",
   "text": "毎週の答えはまだ書いていません。",
   "start_sec": 20.427,
   "end_sec": 23.001
  },
  {
   "sentence_id": "C14-A002-S01",
   "section": "A",
   "text": "マテオさんはみどり町に住んでいます。",
   "start_sec": 23.451,
   "end_sec": 26.553
  },
  {
   "sentence_id": "C14-A002-S02",
   "section": "A",
   "text": "一人暮らしです。",
   "start_sec": 26.753,
   "end_sec": 28.006
  },
  {
   "sentence_id": "C14-A002-S03",
   "section": "A",
   "text": "毎週土曜日にセンターに通っています。",
   "start_sec": 28.206,
   "end_sec": 30.72
  },
  {
   "sentence_id": "C14-A002-S04",
   "section": "A",
   "text": "家でもよく自習をしています。",
   "start_sec": 30.92,
   "end_sec": 33.342
  },
  {
   "sentence_id": "C14-A002-S05",
   "section": "A",
   "text": "日曜日は時々公園で運動しています。",
   "start_sec": 33.542,
   "end_sec": 37.255
  },
  {
   "sentence_id": "C14-A002-S06",
   "section": "A",
   "text": "今日は公園へ行きませんでした。",
   "start_sec": 37.455,
   "end_sec": 40.029
  },
  {
   "sentence_id": "C14-A003-S01",
   "section": "A",
   "text": "入口でリンさんが電話しています。",
   "start_sec": 40.479,
   "end_sec": 42.812
  },
  {
   "sentence_id": "C14-A003-S02",
   "section": "A",
   "text": "マテオさんはリンさんを待っています。",
   "start_sec": 43.012,
   "end_sec": 45.968
  },
  {
   "sentence_id": "C14-A003-S03",
   "section": "A",
   "text": "隣の教室は会議中です。",
   "start_sec": 46.168,
   "end_sec": 48.982
  },
  {
   "sentence_id": "C14-A003-S04",
   "section": "A",
   "text": "中村さんの会議は二時半までです。",
   "start_sec": 49.182,
   "end_sec": 52.542
  },
  {
   "sentence_id": "C14-A003-S05",
   "section": "A",
   "text": "休憩は三時からです。",
   "start_sec": 52.742,
   "end_sec": 54.567
  }
 ]
}
