 "source_chapter": 14,
 "sentence_intervals": [
  {
   "sentence_id": "C14-B001-S01",
   "section": "B",
   "text": "来週の授業の準備：まず文房具を机に出してください。",
   "start_sec": 0.0,
   "end_sec": 4.904
  },
  {
   "sentence_id": "C14-B001-S02",
   "section": "B",
   "text": "ボールペンか万年筆で名前を書いてください。",
   "start_sec": 5.104,
   "end_sec": 8.757
  },
  {
   "sentence_id": "C14-B001-S03",
   "section": "B",
   "text": "家の番号や家族の名前は書きません。",
   "start_sec": 8.957,
   "end_sec": 12.31
  },
  {
   "sentence_id": "C14-B001-S04",
   "section": "B",
   "text": "質問をきちんと読んで、答えてください。",
   "start_sec": 12.51,
   "end_sec": 16.036
  },
  {
   "sentence_id": "C14-B001-S05",
   "section": "B",
   "text": "二枚の紙は最後に封筒に入れてください。",
   "start_sec": 16.236,
   "end_sec": 19.699
  },
  {
   "sentence_id": "C14-B002-S01",
   "section": "B",
   "text": "一枚目：毎週、何をしていますか。",
   "start_sec": 20.149,
   "end_sec": 23.808
  },
  {
   "sentence_id": "C14-B002-S02",
   "section": "B",
   "text": "一週間に何度、運動していますか。",
   "start_sec": 24.008,
   "end_sec": 27.334
  },
  {
   "sentence_id": "C14-B002-S03",
   "section": "B",
   "text": "食事はどこでしていますか。",
   "start_sec": 27.534,
   "end_sec": 29.328
  },
  {
   "sentence_id": "C14-B002-S04",
   "section": "B",
   "text": "家事はいつしていますか。",
   "start_sec": 29.528,
   "end_sec": 31.201
  },
  {
   "sentence_id": "C14-B002-S05",
   "section": "B",
   "text": "二枚目：今、何をしていますか。",
   "start_sec": 31.401,
   "end_sec": 35.414
  },
  {
   "sentence_id": "C14-B002-S06",
   "section": "B",
   "text": "今日、もう何をしましたか。",
   "start_sec": 35.614,
   "end_sec": 38.068
  },
  {
   "sentence_id": "C14-B002-S07",
   "section": "B",
   "text": "今日の答えと毎週の答えは別々に書いてください。",
   "start_sec": 38.268,
   "end_sec": 42.878
  },
  {
   "sentence_id": "C14-B003-S01",
   "section": "B",
   "text": "マテオ：朝、家族に電話しました。",
   "start_sec": 43.328,
   "end_sec": 46.961
  },
  {
   "sentence_id": "C14-B003-S02",
   "section": "B",
   "text": "昼食は家で食べました。",
   "start_sec": 47.161,
   "end_sec": 49.195
  },
  {
   "sentence_id": "C14-B003-S03",
   "section": "B",
   "text": "今は勉強中です。",
   "start_sec": 49.395,
   "end_sec": 51.145
  },
  {
   "sentence_id": "C14-B003-S04",
   "section": "B",
   "text": "中村さんとはまだ話していません。",
   "start_sec": 51.345,
   "end_sec": 53.679
  },
  {
   "sentence_id": "C14-B003-S05",
   "section": "B",
   "text": "まず答えを書きます。",
   "start_sec": 53.879,
   "end_sec": 55.47
  },
  {
   "sentence_id": "C14-B003-S06",
   "section": "B",
   "text": "それから、中村さんと話します。",
   "start_sec": 55.67,
   "end_sec": 58.423
  }
 ]
}
