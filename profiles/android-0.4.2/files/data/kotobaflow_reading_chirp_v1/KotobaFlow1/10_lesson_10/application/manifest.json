 "duration_sec": 68.155,
 "source_chapter": 10,
 "sentence_intervals": [
  {
   "sentence_id": "C10-B001-S01",
   "section": "B",
   "text": "港駅の前の小さいカフェです。",
   "start_sec": 0.0,
   "end_sec": 3.091
  },
  {
   "sentence_id": "C10-B001-S02",
   "section": "B",
   "text": "月曜日から金曜日までは午前七時から午後三時までです。",
   "start_sec": 3.291,
   "end_sec": 8.395
  },
  {
   "sentence_id": "C10-B001-S03",
   "section": "B",
   "text": "土曜日と日曜日は午前十一時から午後三時までです。",
   "start_sec": 8.595,
   "end_sec": 13.568
  },
  {
   "sentence_id": "C10-B001-S04",
   "section": "B",
   "text": "メニューの値段は税込です。",
   "start_sec": 13.768,
   "end_sec": 16.102
  },
  {
   "sentence_id": "C10-B002-S01",
   "section": "B",
   "text": "魚とご飯は千円です。",
   "start_sec": 16.552,
   "end_sec": 19.189
  },
  {
   "sentence_id": "C10-B002-S02",
   "section": "B",
   "text": "肉とご飯も千円です。",
   "start_sec": 19.389,
   "end_sec": 21.423
  },
  {
   "sentence_id": "C10-B002-S03",
   "section": "B",
   "text": "どちらも野菜があります。",
   "start_sec": 21.623,
   "end_sec": 24.137
  },
  {
   "sentence_id": "C10-B002-S04",
   "section": "B",
   "text": "野菜とご飯は九百円で、卵もあります。",
   "start_sec": 24.337,
   "end_sec": 28.436
  },
  {
   "sentence_id": "C10-B002-S05",
   "section": "B",
   "text": "卵とパンは五百円です。",
   "start_sec": 28.636,
   "end_sec": 30.845
  },
  {
   "sentence_id": "C10-B002-S06",
   "section": "B",
   "text": "卵は二つ、パンは一つです。",
   "start_sec": 31.045,
   "end_sec": 33.633
  },
  {
   "sentence_id": "C10-B002-S07",
   "section": "B",
   "text": "スープは一杯百円です。",
   "start_sec": 33.833,
   "end_sec": 36.52
  },
  {
   "sentence_id": "C10-B002-S08",
   "section": "B",
   "text": "辛いスープではありません。",
   "start_sec": 36.72,
   "end_sec": 38.574
  },
  {
   "sentence_id": "C10-B002-S09",
   "section": "B",
   "text": "箸はテーブルの上にあります。",
   "start_sec": 38.774,
   "end_sec": 41.707
  },
  {
   "sentence_id": "C10-B003-S01",
   "section": "B",
   "text": "コーヒーは一杯四百円、ジュースは一杯五百円、牛乳は一杯二百円です。",
   "start_sec": 42.157,
   "end_sec": 50.66
  },
  {
   "sentence_id": "C10-B003-S02",
   "section": "B",
   "text": "小さいパンは一個二百円、大きいパンは一個五百円、卵のパンは一個四百円です。",
   "start_sec": 50.86,
   "end_sec": 60.334
  },
  {
   "sentence_id": "C10-B003-S03",
   "section": "B",
   "text": "今日は小さいパンが五つあります。",
   "start_sec": 60.534,
   "end_sec": 63.171
  },
  {
   "sentence_id": "C10-B003-S04",
   "section": "B",
   "text": "袋は一枚十円です。",
   "start_sec": 63.371,
   "end_sec": 65.719
  },
  {
   "sentence_id": "C10-B003-S05",
   "section": "B",
   "text": "ジュースはオレンジのジュースです。",
   "start_sec": 65.919,
   "end_sec": 68.148
  }
 ]
}
