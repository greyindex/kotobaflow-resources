{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 56.088,
 "source_chapter": 20,
 "sentence_intervals": [
  {
   "sentence_id": "C20-A001-S01",
   "section": "A",
   "text": "私は小林です。",
   "start_sec": 0.0,
   "end_sec": 1.807
  },
  {
   "sentence_id": "C20-A001-S02",
   "section": "A",
   "text": "大学の受付で働いています。",
   "start_sec": 2.007,
   "end_sec": 4.46
  },
  {
   "sentence_id": "C20-A001-S03",
   "section": "A",
   "text": "昨日の会議では、外国での生活の話をしました。",
   "start_sec": 4.66,
   "end_sec": 8.793
  },
  {
   "sentence_id": "C20-A001-S04",
   "section": "A",
   "text": "日本人も外国人も、自分の家族の写真を持っていました。",
   "start_sec": 8.993,
   "end_sec": 14.192
  },
  {
   "sentence_id": "C20-A001-S05",
   "section": "A",
   "text": "会議の後で、席の下に落とし物がありました。",
   "start_sec": 14.392,
   "end_sec": 18.33
  },
  {
   "sentence_id": "C20-A001-S06",
   "section": "A",
   "text": "紺色のかばんが二つ、透明な袋が一つ、ペンが二本です。",
   "start_sec": 18.53,
   "end_sec": 23.804
  },
  {
   "sentence_id": "C20-A002-S01",
   "section": "A",
   "text": "二つのかばんは形が似ています。",
   "start_sec": 24.254,
   "end_sec": 27.002
  },
  {
   "sentence_id": "C20-A002-S02",
   "section": "A",
   "text": "一つはしまの模様、もう一つは水玉の模様です。",
   "start_sec": 27.202,
   "end_sec": 31.687
  },
  {
   "sentence_id": "C20-A002-S03",
   "section": "A",
   "text": "ペンは一本が太くて長いです。",
   "start_sec": 31.887,
   "end_sec": 34.52
  },
  {
   "sentence_id": "C20-A002-S04",
   "section": "A",
   "text": "もう一本は細くて短いです。",
   "start_sec": 34.72,
   "end_sec": 38.206
  },
  {
   "sentence_id": "C20-A003-S01",
   "section": "A",
   "text": "落とし物を探している人は受付に来ます。",
   "start_sec": 38.656,
   "end_sec": 42.249
  },
  {
   "sentence_id": "C20-A003-S02",
   "section": "A",
   "text": "私は持ち主の名前と物の特徴を確認します。",
   "start_sec": 42.449,
   "end_sec": 47.401
  },
  {
   "sentence_id": "C20-A003-S03",
   "section": "A",
   "text": "色や形、それから目印も聞きます。",
   "start_sec": 47.601,
   "end_sec": 50.595
  },
  {
   "sentence_id": "C20-A003-S04",
   "section": "A",
   "text": "持ち主はまだ来ていません。",
   "start_sec": 50.795,
   "end_sec": 52.708
  },
  {
   "sentence_id": "C20-A003-S05",
   "section": "A",
   "text": "今日の午後、学校のチャットで知らせます。",
   "start_sec": 52.908,
   "end_sec": 56.081
  }
 ]
}
