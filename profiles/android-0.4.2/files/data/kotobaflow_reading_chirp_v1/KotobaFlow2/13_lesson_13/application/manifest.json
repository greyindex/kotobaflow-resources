{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 65.02,
 "source_chapter": 31,
 "sentence_intervals": [
  {
   "sentence_id": "C31-B001-S01",
   "section": "B",
   "text": "木曜日の買い物の案内。",
   "start_sec": 0.0,
   "end_sec": 2.273
  },
  {
   "sentence_id": "C31-B001-S02",
   "section": "B",
   "text": "読書会で、土曜日の午前十時に東町の集会室で使います。",
   "start_sec": 2.473,
   "end_sec": 8.007
  },
  {
   "sentence_id": "C31-B001-S03",
   "section": "B",
   "text": "スピーカーは一台です。",
   "start_sec": 8.207,
   "end_sec": 10.212
  },
  {
   "sentence_id": "C31-B001-S04",
   "section": "B",
   "text": "予算は三千円です。",
   "start_sec": 10.412,
   "end_sec": 12.603
  },
  {
   "sentence_id": "C31-B001-S05",
   "section": "B",
   "text": "スピーカーと交通費、送料、手数料の合計です。",
   "start_sec": 12.803,
   "end_sec": 17.715
  },
  {
   "sentence_id": "C31-B002-S01",
   "section": "B",
   "text": "駅前店：二千八百円。",
   "start_sec": 18.165,
   "end_sec": 20.846
  },
  {
   "sentence_id": "C31-B002-S02",
   "section": "B",
   "text": "歩いて片道十分、往復二十分。",
   "start_sec": 21.046,
   "end_sec": 24.673
  },
  {
   "sentence_id": "C31-B002-S03",
   "section": "B",
   "text": "交通費はゼロ円。",
   "start_sec": 24.873,
   "end_sec": 26.606
  },
  {
   "sentence_id": "C31-B002-S04",
   "section": "B",
   "text": "現金かカードで払えます。",
   "start_sec": 26.806,
   "end_sec": 29.0
  },
  {
   "sentence_id": "C31-B002-S05",
   "section": "B",
   "text": "午後七時まで買い物ができます。",
   "start_sec": 29.2,
   "end_sec": 31.884
  },
  {
   "sentence_id": "C31-B003-S01",
   "section": "B",
   "text": "北町店：二千四百円。",
   "start_sec": 32.334,
   "end_sec": 35.217
  },
  {
   "sentence_id": "C31-B003-S02",
   "section": "B",
   "text": "バスの所要時間は片道二十分。",
   "start_sec": 35.417,
   "end_sec": 38.69
  },
  {
   "sentence_id": "C31-B003-S03",
   "section": "B",
   "text": "乗り換えなし。",
   "start_sec": 38.89,
   "end_sec": 39.903
  },
  {
   "sentence_id": "C31-B003-S04",
   "section": "B",
   "text": "料金は一人片道三百円、往復六百円。",
   "start_sec": 40.103,
   "end_sec": 44.885
  },
  {
   "sentence_id": "C31-B003-S05",
   "section": "B",
   "text": "現金で払います。",
   "start_sec": 45.085,
   "end_sec": 46.676
  },
  {
   "sentence_id": "C31-B003-S06",
   "section": "B",
   "text": "午後六時までです。",
   "start_sec": 46.876,
   "end_sec": 48.712
  },
  {
   "sentence_id": "C31-B004-S01",
   "section": "B",
   "text": "通販：二千六百円。",
   "start_sec": 49.162,
   "end_sec": 51.555
  },
  {
   "sentence_id": "C31-B004-S02",
   "section": "B",
   "text": "送料は無料。",
   "start_sec": 51.755,
   "end_sec": 53.249
  },
  {
   "sentence_id": "C31-B004-S03",
   "section": "B",
   "text": "現金で払うときは手数料が三百円。",
   "start_sec": 53.449,
   "end_sec": 57.215
  },
  {
   "sentence_id": "C31-B004-S04",
   "section": "B",
   "text": "カードの手数料は無料。",
   "start_sec": 57.415,
   "end_sec": 59.449
  },
  {
   "sentence_id": "C31-B004-S05",
   "section": "B",
   "text": "金曜日か土曜日に届けます。",
   "start_sec": 59.649,
   "end_sec": 61.922
  },
  {
   "sentence_id": "C31-B004-S06",
   "section": "B",
   "text": "三つの店には割引がありません。",
   "start_sec": 62.122,
   "end_sec": 65.013
  }
 ]
}
