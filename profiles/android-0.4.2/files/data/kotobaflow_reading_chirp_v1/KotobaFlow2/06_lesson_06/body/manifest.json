{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 64.019,
 "source_chapter": 24,
 "sentence_intervals": [
  {
   "sentence_id": "C24-A001-S01",
   "section": "A",
   "text": "わたしはサラ・オルテガです。",
   "start_sec": 0.0,
   "end_sec": 2.153
  },
  {
   "sentence_id": "C24-A001-S02",
   "section": "A",
   "text": "北市民会館の近くに住んでいます。",
   "start_sec": 2.353,
   "end_sec": 4.927
  },
  {
   "sentence_id": "C24-A001-S03",
   "section": "A",
   "text": "日本語が話せます。",
   "start_sec": 5.127,
   "end_sec": 6.5
  },
  {
   "sentence_id": "C24-A001-S04",
   "section": "A",
   "text": "名前も書けます。",
   "start_sec": 6.7,
   "end_sec": 8.275
  },
  {
   "sentence_id": "C24-A001-S05",
   "section": "A",
   "text": "長い文章は苦手ですが、短文は読めます。",
   "start_sec": 8.475,
   "end_sec": 12.969
  },
  {
   "sentence_id": "C24-A001-S06",
   "section": "A",
   "text": "語学のテキストと辞書で学習しています。",
   "start_sec": 13.169,
   "end_sec": 16.462
  },
  {
   "sentence_id": "C24-A001-S07",
   "section": "A",
   "text": "毎晩、復習してメモを取ります。",
   "start_sec": 16.662,
   "end_sec": 19.415
  },
  {
   "sentence_id": "C24-A001-S08",
   "section": "A",
   "text": "去年は会館の畑でも学びました。",
   "start_sec": 19.615,
   "end_sec": 22.447
  },
  {
   "sentence_id": "C24-A001-S09",
   "section": "A",
   "text": "野菜がよくできました。",
   "start_sec": 22.647,
   "end_sec": 24.621
  },
  {
   "sentence_id": "C24-A002-S01",
   "section": "A",
   "text": "十二歳から十五歳まで、毎週ピアノを習いました。",
   "start_sec": 25.071,
   "end_sec": 29.361
  },
  {
   "sentence_id": "C24-A002-S02",
   "section": "A",
   "text": "今は右の手でしか弾けません。",
   "start_sec": 29.561,
   "end_sec": 32.178
  },
  {
   "sentence_id": "C24-A002-S03",
   "section": "A",
   "text": "歌は得意ですが、ピアノはまだ下手です。",
   "start_sec": 32.378,
   "end_sec": 35.717
  },
  {
   "sentence_id": "C24-A002-S04",
   "section": "A",
   "text": "ピアノの知識も必要です。",
   "start_sec": 35.917,
   "end_sec": 37.95
  },
  {
   "sentence_id": "C24-A002-S05",
   "section": "A",
   "text": "技術も学びたいです。",
   "start_sec": 38.15,
   "end_sec": 39.824
  },
  {
   "sentence_id": "C24-A002-S06",
   "section": "A",
   "text": "一生懸命練習して、少しずつ覚えます。",
   "start_sec": 40.024,
   "end_sec": 43.797
  },
  {
   "sentence_id": "C24-A003-S01",
   "section": "A",
   "text": "左の耳では声がはっきり聞こえません。",
   "start_sec": 44.247,
   "end_sec": 47.735
  },
  {
   "sentence_id": "C24-A003-S02",
   "section": "A",
   "text": "静かな教室で先生の手を見たいです。",
   "start_sec": 47.935,
   "end_sec": 51.408
  },
  {
   "sentence_id": "C24-A003-S03",
   "section": "A",
   "text": "運転はできませんから、バスで行きます。",
   "start_sec": 51.608,
   "end_sec": 54.661
  },
  {
   "sentence_id": "C24-A003-S04",
   "section": "A",
   "text": "家にはピアノがありません。",
   "start_sec": 54.861,
   "end_sec": 56.938
  },
  {
   "sentence_id": "C24-A003-S05",
   "section": "A",
   "text": "家では毎晩十五分、動画を見ます。",
   "start_sec": 57.138,
   "end_sec": 60.459
  },
  {
   "sentence_id": "C24-A003-S06",
   "section": "A",
   "text": "土曜日には先生と相談して頑張ります。",
   "start_sec": 60.659,
   "end_sec": 64.013
  }
 ]
}
