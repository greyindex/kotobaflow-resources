{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 88.395,
 "source_chapter": 27,
 "sentence_intervals": [
  {
   "sentence_id": "C27-B001-S01",
   "section": "B",
   "text": "共用キッチンを使うみなさんへ。",
   "start_sec": 0.0,
   "end_sec": 2.5
  },
  {
   "sentence_id": "C27-B001-S02",
   "section": "B",
   "text": "入口の掲示と次の六つのルールを確認してください。",
   "start_sec": 2.7,
   "end_sec": 7.406
  },
  {
   "sentence_id": "C27-B002-S01",
   "section": "B",
   "text": "一、予約制で、定員は16人です。",
   "start_sec": 7.856,
   "end_sec": 11.733
  },
  {
   "sentence_id": "C27-B002-S02",
   "section": "B",
   "text": "予約の締切は使用日の7日前です。",
   "start_sec": 11.933,
   "end_sec": 15.502
  },
  {
   "sentence_id": "C27-B002-S03",
   "section": "B",
   "text": "3時間600円を当日受付で払わなければなりません。",
   "start_sec": 15.702,
   "end_sec": 20.678
  },
  {
   "sentence_id": "C27-B002-S04",
   "section": "B",
   "text": "会費は別です。",
   "start_sec": 20.878,
   "end_sec": 22.191
  },
  {
   "sentence_id": "C27-B003-S01",
   "section": "B",
   "text": "二、鍵は必ず受付に返してください。",
   "start_sec": 22.641,
   "end_sec": 26.528
  },
  {
   "sentence_id": "C27-B003-S02",
   "section": "B",
   "text": "期限は当日21時です。",
   "start_sec": 26.728,
   "end_sec": 29.488
  },
  {
   "sentence_id": "C27-B003-S03",
   "section": "B",
   "text": "ただし、次の予約がある日はその開始前に返してください。",
   "start_sec": 29.688,
   "end_sec": 34.598
  },
  {
   "sentence_id": "C27-B003-S04",
   "section": "B",
   "text": "紛失の連絡は必要ですが、罰金はありません。",
   "start_sec": 34.798,
   "end_sec": 38.519
  },
  {
   "sentence_id": "C27-B004-S01",
   "section": "B",
   "text": "三、館内はすべて禁煙です。",
   "start_sec": 38.969,
   "end_sec": 41.602
  },
  {
   "sentence_id": "C27-B004-S02",
   "section": "B",
   "text": "喫煙も飲酒も禁止です。",
   "start_sec": 41.802,
   "end_sec": 44.376
  },
  {
   "sentence_id": "C27-B004-S03",
   "section": "B",
   "text": "隣の会議室は土足禁止で、飲食もできません。",
   "start_sec": 44.576,
   "end_sec": 49.31
  },
  {
   "sentence_id": "C27-B004-S04",
   "section": "B",
   "text": "夜間も同じです。",
   "start_sec": 49.51,
   "end_sec": 50.982
  },
  {
   "sentence_id": "C27-B005-S01",
   "section": "B",
   "text": "四、ごみは分別してください。",
   "start_sec": 51.432,
   "end_sec": 54.052
  },
  {
   "sentence_id": "C27-B005-S02",
   "section": "B",
   "text": "紙くずは入口の箱に捨ててください。",
   "start_sec": 54.252,
   "end_sec": 57.536
  },
  {
   "sentence_id": "C27-B005-S03",
   "section": "B",
   "text": "生ゴミは持ち帰らなければなりません。",
   "start_sec": 57.736,
   "end_sec": 60.627
  },
  {
   "sentence_id": "C27-B005-S04",
   "section": "B",
   "text": "ここは家庭ごみの捨て場ではありません。",
   "start_sec": 60.827,
   "end_sec": 64.026
  },
  {
   "sentence_id": "C27-B006-S01",
   "section": "B",
   "text": "五、机と椅子の使用は自由です。",
   "start_sec": 64.476,
   "end_sec": 67.706
  },
  {
   "sentence_id": "C27-B006-S02",
   "section": "B",
   "text": "使った後で片づけてください。",
   "start_sec": 67.906,
   "end_sec": 70.469
  },
  {
   "sentence_id": "C27-B006-S03",
   "section": "B",
   "text": "共用の物品を勝手に持ち帰ってはいけません。",
   "start_sec": 70.669,
   "end_sec": 74.622
  },
  {
   "sentence_id": "C27-B007-S01",
   "section": "B",
   "text": "六、清掃は利用者の責任です。",
   "start_sec": 75.072,
   "end_sec": 78.868
  },
  {
   "sentence_id": "C27-B007-S02",
   "section": "B",
   "text": "最後に窓と電気を確認してください。",
   "start_sec": 79.068,
   "end_sec": 82.481
  },
  {
   "sentence_id": "C27-B007-S03",
   "section": "B",
   "text": "暖房器具の周りに物を置いてはいけません。",
   "start_sec": 82.681,
   "end_sec": 86.515
  },
  {
   "sentence_id": "C27-B007-S04",
   "section": "B",
   "text": "火事に注意してください。",
   "start_sec": 86.715,
   "end_sec": 88.389
  }
 ]
}
