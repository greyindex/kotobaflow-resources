{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 70.724,
 "source_chapter": 27,
 "sentence_intervals": [
  {
   "sentence_id": "C27-A001-S01",
   "section": "A",
   "text": "12月12日、初めて西町の料理の会に参加した。",
   "start_sec": 0.0,
   "end_sec": 4.733
  },
  {
   "sentence_id": "C27-A001-S02",
   "section": "A",
   "text": "公共の施設「西町センター」は広場の前にある。",
   "start_sec": 4.933,
   "end_sec": 9.282
  },
  {
   "sentence_id": "C27-A001-S03",
   "section": "A",
   "text": "正門から入って、ホールの告知板を見た。",
   "start_sec": 9.482,
   "end_sec": 13.223
  },
  {
   "sentence_id": "C27-A001-S04",
   "section": "A",
   "text": "注意事項を読んで、管理人の石井さんに挨拶した。",
   "start_sec": 13.423,
   "end_sec": 18.09
  },
  {
   "sentence_id": "C27-A002-S01",
   "section": "A",
   "text": "共用キッチンの責任者は村田さんだ。",
   "start_sec": 18.54,
   "end_sec": 21.833
  },
  {
   "sentence_id": "C27-A002-S02",
   "section": "A",
   "text": "私は13時から仕事があるので、12時20分に出なければならない。",
   "start_sec": 22.033,
   "end_sec": 27.367
  },
  {
   "sentence_id": "C27-A002-S03",
   "section": "A",
   "text": "後の掃除はしなくてもいいが、9時45分から準備を手伝う。",
   "start_sec": 27.567,
   "end_sec": 32.898
  },
  {
   "sentence_id": "C27-A002-S04",
   "section": "A",
   "text": "村田さんは机と椅子を運んで、私は野菜を洗った。",
   "start_sec": 33.098,
   "end_sec": 37.772
  },
  {
   "sentence_id": "C27-A003-S01",
   "section": "A",
   "text": "食べた後で、生ゴミと包み紙を分別した。",
   "start_sec": 38.222,
   "end_sec": 42.098
  },
  {
   "sentence_id": "C27-A003-S02",
   "section": "A",
   "text": "村田さんは「めいめいの当たり前は違います。",
   "start_sec": 42.298,
   "end_sec": 46.27
  },
  {
   "sentence_id": "C27-A003-S03",
   "section": "A",
   "text": "決まりを一緒に確認しましょう」と言った。",
   "start_sec": 46.47,
   "end_sec": 49.22
  },
  {
   "sentence_id": "C27-A003-S04",
   "section": "A",
   "text": "厳しい注意だとは思わなかった。",
   "start_sec": 49.42,
   "end_sec": 51.809
  },
  {
   "sentence_id": "C27-A003-S05",
   "section": "A",
   "text": "次に使う他人への配慮だ。",
   "start_sec": 52.009,
   "end_sec": 54.343
  },
  {
   "sentence_id": "C27-A003-S06",
   "section": "A",
   "text": "私は決してルールを破らない。",
   "start_sec": 54.543,
   "end_sec": 56.696
  },
  {
   "sentence_id": "C27-A004-S01",
   "section": "A",
   "text": "夜、「窓を閉めて、電気を消しました。",
   "start_sec": 57.146,
   "end_sec": 60.799
  },
  {
   "sentence_id": "C27-A004-S02",
   "section": "A",
   "text": "鍵をかけて、受付に返しました」と連絡が来た。",
   "start_sec": 60.999,
   "end_sec": 65.073
  },
  {
   "sentence_id": "C27-A004-S03",
   "section": "A",
   "text": "次は1月9日。",
   "start_sec": 65.273,
   "end_sec": 67.344
  },
  {
   "sentence_id": "C27-A004-S04",
   "section": "A",
   "text": "仕事の日程はまだ確認していない。",
   "start_sec": 67.544,
   "end_sec": 70.717
  }
 ]
}
