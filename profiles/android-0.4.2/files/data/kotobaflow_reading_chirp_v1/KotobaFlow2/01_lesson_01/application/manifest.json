{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 76.547,
 "source_chapter": 19,
 "sentence_intervals": [
  {
   "sentence_id": "C19-B001-S01",
   "section": "B",
   "text": "次の読書会の相談です。",
   "start_sec": 0.0,
   "end_sec": 2.106
  },
  {
   "sentence_id": "C19-B001-S02",
   "section": "B",
   "text": "14日の土曜日、公園で会いませんか。",
   "start_sec": 2.306,
   "end_sec": 5.576
  },
  {
   "sentence_id": "C19-B001-S03",
   "section": "B",
   "text": "10時から12時までです。",
   "start_sec": 5.776,
   "end_sec": 7.955
  },
  {
   "sentence_id": "C19-B001-S04",
   "section": "B",
   "text": "外で本を読みたいです。",
   "start_sec": 8.155,
   "end_sec": 10.19
  },
  {
   "sentence_id": "C19-B001-S05",
   "section": "B",
   "text": "きっと楽しいと思います。",
   "start_sec": 10.39,
   "end_sec": 11.884
  },
  {
   "sentence_id": "C19-B002-S01",
   "section": "B",
   "text": "賛成。",
   "start_sec": 12.334,
   "end_sec": 13.304
  },
  {
   "sentence_id": "C19-B002-S02",
   "section": "B",
   "text": "公園は静かだから、いいと思う。",
   "start_sec": 13.504,
   "end_sec": 16.31
  },
  {
   "sentence_id": "C19-B002-S03",
   "section": "B",
   "text": "私は14日の午前は大丈夫です。",
   "start_sec": 16.51,
   "end_sec": 19.863
  },
  {
   "sentence_id": "C19-B003-S01",
   "section": "B",
   "text": "私も14日は大丈夫です。",
   "start_sec": 20.313,
   "end_sec": 22.935
  },
  {
   "sentence_id": "C19-B003-S02",
   "section": "B",
   "text": "場所は明日返事をします。",
   "start_sec": 23.135,
   "end_sec": 25.454
  },
  {
   "sentence_id": "C19-B003-S03",
   "section": "B",
   "text": "料理の本はどうですか。",
   "start_sec": 25.654,
   "end_sec": 27.568
  },
  {
   "sentence_id": "C19-B003-S04",
   "section": "B",
   "text": "私は食文化に関心があります。",
   "start_sec": 27.768,
   "end_sec": 31.065
  },
  {
   "sentence_id": "C19-B003-S05",
   "section": "B",
   "text": "料理の本は、料理の技術を読者に伝えます。",
   "start_sec": 31.265,
   "end_sec": 35.461
  },
  {
   "sentence_id": "C19-B003-S06",
   "section": "B",
   "text": "これは素晴らしいと思います。",
   "start_sec": 35.661,
   "end_sec": 37.514
  },
  {
   "sentence_id": "C19-B004-S01",
   "section": "B",
   "text": "森さん、提案ありがとうございます。",
   "start_sec": 37.965,
   "end_sec": 40.838
  },
  {
   "sentence_id": "C19-B004-S02",
   "section": "B",
   "text": "私個人の意見です。",
   "start_sec": 41.038,
   "end_sec": 42.771
  },
  {
   "sentence_id": "C19-B004-S03",
   "section": "B",
   "text": "公園には机がありません。",
   "start_sec": 42.971,
   "end_sec": 44.991
  },
  {
   "sentence_id": "C19-B004-S04",
   "section": "B",
   "text": "しかし、今回は感想を書きます。",
   "start_sec": 45.191,
   "end_sec": 48.558
  },
  {
   "sentence_id": "C19-B004-S05",
   "section": "B",
   "text": "14日はセンター、10月の土曜日は公園で会いませんか。",
   "start_sec": 48.758,
   "end_sec": 53.842
  },
  {
   "sentence_id": "C19-B004-S06",
   "section": "B",
   "text": "確か、14日の午前はセンターで会議はありません。",
   "start_sec": 54.042,
   "end_sec": 58.81
  },
  {
   "sentence_id": "C19-B004-S07",
   "section": "B",
   "text": "明日確認して、知らせます。",
   "start_sec": 59.01,
   "end_sec": 61.506
  },
  {
   "sentence_id": "C19-B005-S01",
   "section": "B",
   "text": "なるほど。",
   "start_sec": 61.956,
   "end_sec": 62.929
  },
  {
   "sentence_id": "C19-B005-S02",
   "section": "B",
   "text": "机は重要ですね。",
   "start_sec": 63.129,
   "end_sec": 64.622
  },
  {
   "sentence_id": "C19-B005-S03",
   "section": "B",
   "text": "私は今も、外の読書会はいいと思っています。",
   "start_sec": 64.822,
   "end_sec": 68.701
  },
  {
   "sentence_id": "C19-B005-S04",
   "section": "B",
   "text": "明日、全員で場所を決めましょう。",
   "start_sec": 68.901,
   "end_sec": 71.654
  },
  {
   "sentence_id": "C19-B005-S05",
   "section": "B",
   "text": "料理の本もいいアイディアですね。",
   "start_sec": 71.854,
   "end_sec": 74.188
  },
  {
   "sentence_id": "C19-B005-S06",
   "section": "B",
   "text": "詳しい内容を教えてください。",
   "start_sec": 74.388,
   "end_sec": 76.541
  }
 ]
}
