{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 68.124,
 "source_chapter": 36,
 "sentence_intervals": [
  {
   "sentence_id": "C36-A001-S01",
   "section": "A",
   "text": "リー、青木、小野は、一月十六日に東町公民館で小さい会をしようと思っています。",
   "start_sec": 0.0,
   "end_sec": 8.265
  },
  {
   "sentence_id": "C36-A001-S02",
   "section": "A",
   "text": "三人と友達三人が参加します。",
   "start_sec": 8.465,
   "end_sec": 11.938
  },
  {
   "sentence_id": "C36-A001-S03",
   "section": "A",
   "text": "時間は午後二時から三時半までです。",
   "start_sec": 12.138,
   "end_sec": 15.591
  },
  {
   "sentence_id": "C36-A001-S04",
   "section": "A",
   "text": "小野が予約した部屋は一時半から四時まで使えます。",
   "start_sec": 15.791,
   "end_sec": 20.149
  },
  {
   "sentence_id": "C36-A001-S05",
   "section": "A",
   "text": "予算は千八百円です。",
   "start_sec": 20.349,
   "end_sec": 22.72
  },
  {
   "sentence_id": "C36-A002-S01",
   "section": "A",
   "text": "計画は二つあります。",
   "start_sec": 23.17,
   "end_sec": 25.076
  },
  {
   "sentence_id": "C36-A002-S02",
   "section": "A",
   "text": "一つは町を歩く会、もう一つは写真を見ながら話す会です。",
   "start_sec": 25.276,
   "end_sec": 30.526
  },
  {
   "sentence_id": "C36-A002-S03",
   "section": "A",
   "text": "散歩は無料です。",
   "start_sec": 30.726,
   "end_sec": 32.34
  },
  {
   "sentence_id": "C36-A002-S04",
   "section": "A",
   "text": "しかし、雨が降ったら計画の変更が必要です。",
   "start_sec": 32.54,
   "end_sec": 36.996
  },
  {
   "sentence_id": "C36-A002-S05",
   "section": "A",
   "text": "写真の会は雨でもできます。",
   "start_sec": 37.196,
   "end_sec": 40.161
  },
  {
   "sentence_id": "C36-A002-S06",
   "section": "A",
   "text": "六人で話すので、一人で話しすぎないほうがいいでしょう。",
   "start_sec": 40.361,
   "end_sec": 45.209
  },
  {
   "sentence_id": "C36-A003-S01",
   "section": "A",
   "text": "青木は「紙の写真を十二枚持っていけます」と言いました。",
   "start_sec": 45.659,
   "end_sec": 50.392
  },
  {
   "sentence_id": "C36-A003-S02",
   "section": "A",
   "text": "リーは準備を手伝ったことがありますが、写真の会で話したことはありません。",
   "start_sec": 50.592,
   "end_sec": 56.563
  },
  {
   "sentence_id": "C36-A003-S03",
   "section": "A",
   "text": "小野は二人の意見を聞いてから役割を決めるつもりです。",
   "start_sec": 56.763,
   "end_sec": 61.737
  },
  {
   "sentence_id": "C36-A003-S04",
   "section": "A",
   "text": "三人で全員に「準備を手伝えますか」と聞きます。",
   "start_sec": 61.937,
   "end_sec": 66.064
  },
  {
   "sentence_id": "C36-A003-S05",
   "section": "A",
   "text": "無理な計画は選びません。",
   "start_sec": 66.264,
   "end_sec": 68.118
  }
 ]
}
