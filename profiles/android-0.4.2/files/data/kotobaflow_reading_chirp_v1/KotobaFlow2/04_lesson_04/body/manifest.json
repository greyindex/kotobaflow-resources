 "sentence_intervals": [
  {
   "sentence_id": "C22-A001-S01",
   "section": "A",
   "text": "私の趣味は写真を撮ることと読書です。",
   "start_sec": 0.0,
   "end_sec": 3.711
  },
  {
   "sentence_id": "C22-A001-S02",
   "section": "A",
   "text": "最近は、土曜日に海の近くの公園で散歩をしています。",
   "start_sec": 3.911,
   "end_sec": 8.465
  },
  {
   "sentence_id": "C22-A001-S03",
   "section": "A",
   "text": "家では、写真を見たり、旅行の本を読んだりします。",
   "start_sec": 8.665,
   "end_sec": 13.098
  },
  {
   "sentence_id": "C22-A002-S01",
   "section": "A",
   "text": "一度、山に登ったことがあります。",
   "start_sec": 13.548,
   "end_sec": 16.456
  },
  {
   "sentence_id": "C22-A002-S02",
   "section": "A",
   "text": "2024年の5月に友達と登って、山の上の宿に泊まりました。",
   "start_sec": 16.656,
   "end_sec": 23.041
  },
  {
   "sentence_id": "C22-A002-S03",
   "section": "A",
   "text": "海で泳いだことはありません。",
   "start_sec": 23.241,
   "end_sec": 25.616
  },
  {
   "sentence_id": "C22-A002-S04",
   "section": "A",
   "text": "釣りの経験もありません。",
   "start_sec": 25.816,
   "end_sec": 27.759
  },
  {
   "sentence_id": "C22-A002-S05",
   "section": "A",
   "text": "今度は、会社の田村さんと釣りに挑戦したいです。",
   "start_sec": 27.959,
   "end_sec": 31.973
  }
 ]
}
