 "sentence_intervals": [
  {
   "sentence_id": "C21-B001-S01",
   "section": "B",
   "text": "2026年7月3日。",
   "start_sec": 0.0,
   "end_sec": 2.573
  },
  {
   "sentence_id": "C21-B001-S02",
   "section": "B",
   "text": "みなみ市民会館の料理教室は、明日（あす）7月4日から18日に延期します。",
   "start_sec": 2.773,
   "end_sec": 9.902
  },
  {
   "sentence_id": "C21-B001-S03",
   "section": "B",
   "text": "延期するのは、オーブンが故障したからです。",
   "start_sec": 10.102,
   "end_sec": 13.38
  },
  {
   "sentence_id": "C21-B001-S04",
   "section": "B",
   "text": "工事は6日から10日までです。",
   "start_sec": 13.58,
   "end_sec": 16.153
  },
  {
   "sentence_id": "C21-B001-S05",
   "section": "B",
   "text": "11日は別の人が教室を使います。",
   "start_sec": 16.353,
   "end_sec": 19.696
  },
  {
   "sentence_id": "C21-B001-S06",
   "section": "B",
   "text": "急な変更で申し訳ありません。",
   "start_sec": 19.896,
   "end_sec": 22.409
  },
  {
   "sentence_id": "C21-B002-S01",
   "section": "B",
   "text": "新しい日時は18日10時から12時までです。",
   "start_sec": 22.859,
   "end_sec": 27.369
  },
  {
   "sentence_id": "C21-B002-S02",
   "section": "B",
   "text": "8歳から10歳の子ども12人が参加します。",
   "start_sec": 27.569,
   "end_sec": 31.513
  },
  {
   "sentence_id": "C21-B002-S03",
   "section": "B",
   "text": "参加のキャンセルは14日17時まで、電話かメールでお願いします。",
   "start_sec": 31.713,
   "end_sec": 37.259
  },
  {
   "sentence_id": "C21-B002-S04",
   "section": "B",
   "text": "欠席の事情は電話で話してもいいです。",
   "start_sec": 37.459,
   "end_sec": 40.633
  },
  {
   "sentence_id": "C21-B002-S05",
   "section": "B",
   "text": "欠席届は必要ありません。",
   "start_sec": 40.833,
   "end_sec": 43.141
  },
  {
   "sentence_id": "C21-B002-S06",
   "section": "B",
   "text": "電話は毎日9時から18時までです。",
   "start_sec": 43.341,
   "end_sec": 47.152
  },
  {
   "sentence_id": "C21-B003-S01",
   "section": "B",
   "text": "当日は駅の近くで工事があります。",
   "start_sec": 47.602,
   "end_sec": 50.895
  },
  {
   "sentence_id": "C21-B003-S02",
   "section": "B",
   "text": "混雑やバスの遅れ、渋滞に注意してください。",
   "start_sec": 51.095,
   "end_sec": 54.749
  },
  {
   "sentence_id": "C21-B003-S03",
   "section": "B",
   "text": "雨の日も中止しません。",
   "start_sec": 54.949,
   "end_sec": 56.922
  },
  {
   "sentence_id": "C21-B003-S04",
   "section": "B",
   "text": "8月1日の教室は変更しません。",
   "start_sec": 57.122,
   "end_sec": 60.235
  }
 ]
}
