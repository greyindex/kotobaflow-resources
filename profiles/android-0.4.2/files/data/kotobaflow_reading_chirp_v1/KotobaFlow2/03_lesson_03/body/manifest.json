{
 "schema": 1,
 "mode": "section",
 "voice": "ja-JP-Chirp3-HD-Aoede",
 "duration_sec": 73.131,
 "source_chapter": 21,
 "sentence_intervals": [
  {
   "sentence_id": "C21-A001-S01",
   "section": "A",
   "text": "7月3日の金曜日、私はみなみ市民会館で石井さんと料理教室の準備をする約束がありました。",
   "start_sec": 0.0,
   "end_sec": 9.293
  },
  {
   "sentence_id": "C21-A001-S02",
   "section": "A",
   "text": "約束は6時半でした。",
   "start_sec": 9.493,
   "end_sec": 11.71
  },
  {
   "sentence_id": "C21-A001-S03",
   "section": "A",
   "text": "電車が20分遅れたので、急いで会館へ行きました。",
   "start_sec": 11.91,
   "end_sec": 16.488
  },
  {
   "sentence_id": "C21-A001-S04",
   "section": "A",
   "text": "入口は込み合っていました。",
   "start_sec": 16.688,
   "end_sec": 18.602
  },
  {
   "sentence_id": "C21-A001-S05",
   "section": "A",
   "text": "遅刻は今回が初めてです。",
   "start_sec": 18.802,
   "end_sec": 20.835
  },
  {
   "sentence_id": "C21-A001-S06",
   "section": "A",
   "text": "寝坊ではありませんが、恥ずかしかったです。",
   "start_sec": 21.035,
   "end_sec": 24.295
  },
  {
   "sentence_id": "C21-A002-S01",
   "section": "A",
   "text": "石井さんは入口で待っていました。",
   "start_sec": 24.745,
   "end_sec": 27.637
  },
  {
   "sentence_id": "C21-A002-S02",
   "section": "A",
   "text": "「どうしたの？」と聞きました。",
   "start_sec": 27.837,
   "end_sec": 29.87
  },
  {
   "sentence_id": "C21-A002-S03",
   "section": "A",
   "text": "「遅れました。すみません」と私は答えました。",
   "start_sec": 30.07,
   "end_sec": 34.259
  },
  {
   "sentence_id": "C21-A002-S04",
   "section": "A",
   "text": "石井さんは「それが、教室も延期なんです」と言いました。",
   "start_sec": 34.459,
   "end_sec": 39.525
  },
  {
   "sentence_id": "C21-A002-S05",
   "section": "A",
   "text": "私は慌ててお知らせを読みました。",
   "start_sec": 39.725,
   "end_sec": 42.598
  },
  {
   "sentence_id": "C21-A002-S06",
   "section": "A",
   "text": "オーブンの故障で、4日の教室は18日です。",
   "start_sec": 42.798,
   "end_sec": 46.914
  },
  {
   "sentence_id": "C21-A002-S07",
   "section": "A",
   "text": "数秒、何も言いませんでした。",
   "start_sec": 47.114,
   "end_sec": 49.808
  },
  {
   "sentence_id": "C21-A003-S01",
   "section": "A",
   "text": "私は困りました。",
   "start_sec": 50.258,
   "end_sec": 51.871
  },
  {
   "sentence_id": "C21-A003-S02",
   "section": "A",
   "text": "18日は友だちと会う約束と重なるのです。",
   "start_sec": 52.071,
   "end_sec": 56.381
  },
  {
   "sentence_id": "C21-A003-S03",
   "section": "A",
   "text": "半年会っていません。",
   "start_sec": 56.581,
   "end_sec": 58.314
  },
  {
   "sentence_id": "C21-A003-S04",
   "section": "A",
   "text": "日程の変更に悩みましたが、18日の教室は休んで、代わりに17日に準備を手伝いたいと思いました。",
   "start_sec": 58.514,
   "end_sec": 67.09
  },
  {
   "sentence_id": "C21-A003-S05",
   "section": "A",
   "text": "石井さんと話した後で、「明日の朝、原田さんに連絡します」と言いました。",
   "start_sec": 67.29,
   "end_sec": 73.124
  }
 ]
}
